Actor EliteArmor : BasicArmorPickup
{
	Game Doom
	SpawnID 7090
	Radius 20
	Height 20
	Scale 1.30
	+FLOORCLIP
	+DONTGIB
	Inventory.Pickupmessage "Picked up the Elite Recon Armor"
	Inventory.PickupSound "items/armor4"
	Inventory.Icon "4RM4A0"
	Armor.Savepercent 75
	Armor.Saveamount 300
	States
	{
	Spawn:
		TNT1 A 0 A_CheckSight("Spawn2")
		TNT1 A 0 A_JumpIfInventory("PB_PickupAuraSpawned", 1, "SpawnAnim")
		TNT1 A 0 A_SpawnItemEx("PB_PickupAuraRed", 0, 0, 0, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveInventory("PB_PickupAuraSpawned", 1)
	SpawnAnim:
		4RM4 AA 6 bright
		4RM4 BBCCBB 3
		loop
	Spawn2:
		4RM4 ABC 10
		Goto Spawn
	}
}

Actor EliteArmorForUltraSphere : EliteArmor
{
	Armor.SavePercent 75
	Armor.Saveamount 300
}

Actor PristineArmor : BasicArmorPickup
{
	Game Doom
	SpawnID 7091
	Radius 20
	Height 20
	Scale 1.30
	+FLOORCLIP
	+DONTGIB
	Inventory.Pickupmessage "Picked up the Golden Power Armor"
	Inventory.PickupSound "items/armor5"
	Inventory.Icon "4RM5A0"
	Armor.Savepercent 90
	Armor.Saveamount 400
	States
	{
	Spawn:
		TNT1 A 0 A_CheckSight("Spawn2")
		TNT1 A 0 A_JumpIfInventory("PB_PickupAuraSpawned", 1, "SpawnAnim")
		TNT1 A 0 A_SpawnItemEx("PB_PickupAuraYellow", 0, 0, 0, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveInventory("PB_PickupAuraSpawned", 1)
	SpawnAnim:
		4RM5 AA 6 bright
		4RM5 BBCCBB 3
		loop
	Spawn2:
		4RM5 ABC 10
		Goto Spawn
	}
}

ACTOR NewLifeSphere : CustomInventory
{
	+COUNTITEM
	+INVENTORY.ALWAYSPICKUP
	+DONTGIB
	+FloatBob
	+NoGravity
	Inventory.PickupMessage "Greater Soulsphere!"
	Inventory.PickupSound "items/sphere4"
	States
	{
	Spawn:
		TNT1 A 0 A_CheckSight("Spawn2")
		TNT1 A 0 A_JumpIfInventory("PB_PickupAuraSpawned", 1, "SpawnLoop")
		TNT1 A 0 A_SpawnItemEx("PB_PickupAuraRedHigh", 0, 0, 0, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveInventory("PB_PickupAuraSpawned", 1)
	SpawnLoop:
		GZUL ABCD 2 Bright
		Loop
	Spawn2:
		GZUL ABCD 2 BRIGHT
		Goto Spawn
	Pickup:
		TNT1 AAAAAAAAAAAAA 0 A_CustomMissile("ShinnySmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_GiveInventory("GreaterSoulSphereHealth", 1)
		Stop
	}
}

ACTOR GreaterSoulSphereHealth : Health
{
	Inventory.Amount 200
	Inventory.MaxAmount 400
	+INVENTORY.ALWAYSPICKUP
}

ACTOR UltraSphere : CustomInventory
{
	+COUNTITEM
	+DONTGIB
	+FloatBob
	+NoGravity
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage "Ultrasphere"
	Inventory.PickupSound "items/sphere5"
	States
	{
	Spawn:
		TNT1 A 0 A_CheckSight("Spawn2")
		TNT1 A 0 A_JumpIfInventory("PB_PickupAuraSpawned", 1, "SpawnLoop")
		TNT1 A 0 A_SpawnItemEx("PB_PickupAuraLensHigh", 0, 0, 0, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveInventory("PB_PickupAuraSpawned", 1)
	SpawnLoop:
		ULTR ABCD 2 BRIGHT
		Loop
	Spawn2:
		ULTR ABCD 2 BRIGHT
		Goto Spawn
	Pickup:
		TNT1 AAAAAAAAAAAAA 0 A_CustomMissile("ShinnySmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_GiveInventory("EliteArmorForUltraSphere", 1)
		TNT1 AA 0 A_GiveInventory("GreaterSoulSphereHealth", 1)
		Stop
	}
}
