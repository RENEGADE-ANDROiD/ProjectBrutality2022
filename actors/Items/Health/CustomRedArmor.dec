// DarkShadow — Custom Red Armor (from Custom Red Armor.wad; ZScript spawners not used in PB2022).
ACTOR PB_RedArmor : PB_BodyArmorPickup
{
	Game Doom
	Radius 20
	Height 20
	Scale 1.30
	SpawnID 7085
	+FLOORCLIP
	+DONTGIB
	+BRIGHT
	Inventory.PickupMessage "$PB_PICKUP_REDARMOR"
	Inventory.PickupSound "ARMOR"
	Inventory.Icon "4RM3A0"
	Armor.SavePercent 60
	Armor.SaveAmount 250
	States
	{
	Spawn:
		TNT1 A 0 A_CheckSight ("Spawn2")
		TNT1 A 0 A_JumpIfInventory("PB_PickupAuraSpawned", 1, "SpawnAnim")
		TNT1 A 0 A_SpawnItemEx("PB_PickupAuraRed", 0, 0, 0, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveInventory("PB_PickupAuraSpawned", 1)
	SpawnAnim:
		4RM3 AA 6 bright
		4RM3 BB 3
		loop
	Spawn2:
		4RM3 AB 10 bright
		Goto Spawn
	}
}
