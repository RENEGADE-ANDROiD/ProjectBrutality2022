Tag "Heavy Rocket SentryGun"
obituary "%o was ventilated by an auto-sentry."
radius 20
height 60
mass 100000
Scale 0.60
speed 0
PainChance 255
PainSound "Sentry/Pain"
tag "Sentrygun Heavy Rocket"
MONSTER
+FLOORCLIP
+FRIENDLY
+NOBLOOD
+USESPECIAL
Activation THINGSPEC_Activate
+QUICKTORETALIATE
+LOOKALLAROUND
+NEVERRESPAWN
+STANDSTILL
+MISSILEMORE
+MISSILEEVENMORE
States
{

Spawn:
TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
FTRT A 0 BRIGHT A_ChangeFlag ("Solid",1)
TNT1 A 0 A_TakeInventory ("IsFiring",1)
FTRT AAAAAAAAAA 1 A_Look
TNT1 A 0 A_SetAngle(angle + 45)
SENT A 0 A_PlaySound ("Song")
FTRT AAAAAAAAAA 1 A_Look
TNT1 A 0 A_SetAngle(angle - 45)
FTRT AAAAAAAAAA 1 A_Look
SET1 A 0 A_SetAngle(angle - 45)
SENT A 0 A_PlaySound ("Song")
FTRT AAAAAAAAAA 1 A_Look
TNT1 A 0 A_SetAngle(angle + 45)
loop

Active:
TNT1 A 2
TNT1 A 0 A_NoBlocking
SENT A 0 A_PlaySound ("Mont")
TNT1 A 0 A_ChangeFLag ("SHOOTABLE", 0)
TNT1 A 0 A_ChangeFLag ("SOLID", 0)
TNT1 A 0 A_SpawnItemEx ("PB_SentryBox_HeavyRocket",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
TNT1 A 0
Stop

See:
TNT1 A 0 A_TakeInventory ("IsFiring",1)
FTRT AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
SET1 E 0 BRIGHT A_ChangeFlag ("Solid",1)
loop

Missile:
TNT1 A 0 A_GiveInventory("IsFiring", 1)
TTR1 A 0 A_PlaySound ("beePB")
FTRT AA 10 A_FaceTarget
TNT1 A 0 A_PlaySound ("RPGFIRE", 1)
TNT1 A 0 A_CustomMissile("PB_Sentry_MissileRocket",85,-45,0)
TNT1 A 0 A_CustomMissile("PB_Sentry_MissileRocket",85,45,0)
FTRT BC 3 Bright A_FaceTarget
FTRT AAAAAA 5 A_FaceTarget
Goto See

Pain:
TNT1 A 0 A_Pain
SET1 A 0 BRIGHT A_ChangeFlag ("Solid",1)
TNT1 A 0 A_JumpIfInventory("IsFiring", 1, "Pain.IsFiring")
TNT1 A 0 A_TakeInventory("IsFiring", 1)
Goto See
Pain.IsFiring:
FTRT AA 10 A_FaceTarget
TNT1 A 0 A_PlaySound ("RPGFIRE", 1)
TNT1 A 0 A_CustomMissile("PB_Sentry_MissileRocket",85,-45,0)
TNT1 A 0 A_CustomMissile("PB_Sentry_MissileRocket",85,45,0)
FTRT BC 3 Bright A_FaceTarget
FTRT AAAAAA 5 A_FaceTarget
Goto See

Death:
FTRT Z 1 A_PlaySoundEx ("Sentry/Death", "SoundSlot5")
FTRT Z 0 A_PlaySoundEx ("Explosion", "SoundSlot6")
FTRT Z 0 A_SpawnItem ("PB_SentryBoom", 0, 48)
FTRT Z 512
FadeOut:
FTRT Z 2 A_FadeOut (0.1)
loop
}
}


