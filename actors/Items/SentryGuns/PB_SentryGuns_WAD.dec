WARF GGHHII 1 Bright A_spawnItemEx("PB_Sentry_NapalmFlarePart",random(-6,6),random(-6,6),random(0,3),random(-2,2),random(-2,2),random(2,7),random(0,360))
TNT1 A 0 A_Explode(4,64)
TNT1 A 0 A_Jump(127,2)
TNT1 AA 0 A_CountDown
TNT1 A 0 A_JumpIf(waterlevel > 1,"Death")
WARF KKLLMM 1 Bright A_spawnItemEx("PB_Sentry_NapalmFlarePart",random(-6,6),random(-6,6),random(0,3),random(-2,2),random(-2,2),random(2,7),random(0,360))
