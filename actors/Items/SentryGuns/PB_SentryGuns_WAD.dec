Actor PB_SentryGun_PlasmaCaster : SwitchableDecoration
{
Health 1000
MaxTargetRange 10000
DamageFactor 0.65
RadiusDamageFactor 0.75
Tag "Plasma Caster Sentry Gun"
obituary "%o was ventilated by an auto-sentry."
radius 20
height 60
mass 100000
Scale 0.60
speed 0
PainChance 255
PainSound "Sentry/Pain"
MONSTER
+FLOORCLIP
+FRIENDLY
+NOBLOOD
+USESPECIAL
Activation THINGSPEC_Activate
+QUICKTORETALIATE
+LOOKALLAROUND
+NEVERRESPAWN
+STANDSTILL
+MISSILEMORE
+MISSILEEVENMORE
States
{


Spawn:
TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
PTRT A 0 BRIGHT A_ChangeFlag ("Solid",1)
TNT1 A 0 A_TakeInventory ("IsFiring",1)
PTRT AAAAAAAAAA 1 A_Look
TNT1 A 0 A_SetAngle(angle + 45)
SENT A 0 A_PlaySound ("Song")
PTRT AAAAAAAAAA 1 A_Look
TNT1 A 0 A_SetAngle(angle - 45)
PTRT AAAAAAAAAA 1 A_Look
SET1 A 0 A_SetAngle(angle - 45)
SENT A 0 A_PlaySound ("Song")
PTRT AAAAAAAAAA 1 A_Look
TNT1 A 0 A_SetAngle(angle + 45)
loop

Active:
TNT1 A 2
TNT1 A 0 A_NoBlocking
SENT A 0 A_PlaySound ("Mont")
TNT1 A 0 A_ChangeFLag ("SHOOTABLE", 0)
TNT1 A 0 A_ChangeFLag ("SOLID", 0)
TNT1 A 0 A_SpawnItemEx ("PB_SentryBox_PlasmaCaster",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
TNT1 A 0
Stop

See:
TNT1 A 0 A_TakeInventory ("IsFiring",1)
PTRT AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
SET1 E 0 BRIGHT A_ChangeFlag ("Solid",1)
loop

Missile:
TNT1 A 0 A_GiveInventory("IsFiring", 1)
TTR1 A 0 A_PlaySound ("beePB")
PTRT AA 10 A_FaceTarget
TNT1 A 0 A_PlaySound("PlasmaCaster/Full")
TNT1 A 0 A_PlaySound("PlasmaCaster/Charge",5)
PTRT AAA 4 A_FaceTarget
MissileGo:
TNT1 A 0 A_PlayWeaponSound("PlasmaCaster/Shot")
TNT1 AAAAAA 0 A_CustomMissile("Plasma_Ball",85,45,0,CMF_OFFSETPITCH,random(-120,120)/100.00)
PTRT B 4 Bright A_FaceTarget
PTRT AAA 3 A_FaceTarget
TNT1 A 0 A_PlayWeaponSound("PlasmaCaster/Shot")
TNT1 AAAAAA 0 A_CustomMissile("Plasma_Ball",85,-45,0,CMF_OFFSETPITCH,random(-120,120)/100.00)
PTRT C 4 Bright A_FaceTarget
PTRT AAA 3 A_FaceTarget
TNT1 A 0 A_CposRefire
Loop

Pain:
TNT1 A 0 A_Pain
SET1 A 0 BRIGHT A_ChangeFlag ("Solid",1)
TNT1 A 0 A_JumpIfInventory("IsFiring", 1, "Pain.IsFiring")
TNT1 A 0 A_TakeInventory("IsFiring", 1)
Goto See
Pain.IsFiring:
PTRT AA 10 A_FaceTarget
TNT1 A 0 A_PlaySound("PlasmaCaster/Full")
TNT1 A 0 A_PlaySound("PlasmaCaster/Charge",5)
PTRT AAA 4 A_FaceTarget
MissileGo:
TNT1 A 0 A_PlayWeaponSound("PlasmaCaster/Shot")
TNT1 AAAAAA 0 A_CustomMissile("Plasma_Ball",85,45,0,CMF_OFFSETPITCH,random(-120,120)/100.00)
PTRT B 4 Bright A_FaceTarget
PTRT AAA 3 A_FaceTarget
TNT1 A 0 A_PlayWeaponSound("PlasmaCaster/Shot")
TNT1 AAAAAA 0 A_CustomMissile("Plasma_Ball",85,-45,0,CMF_OFFSETPITCH,random(-120,120)/100.00)
PTRT C 4 Bright A_FaceTarget
PTRT AAA 3 A_FaceTarget
TNT1 A 0 A_CposRefire
Loop

Death:
PTRT Z 1 A_PlaySoundEx ("Sentry/Death", "SoundSlot5")
PTRT Z 0 A_PlaySoundEx ("Explosion", "SoundSlot6")
PTRT Z 0 A_SpawnItem ("PB_SentryBoom", 0, 48)
PTRT Z 512
FadeOut:
PTRT Z 2 A_FadeOut (0.1)
loop
}
}


