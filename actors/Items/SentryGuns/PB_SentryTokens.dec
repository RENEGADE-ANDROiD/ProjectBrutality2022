ACTOR PB_SentryAmmo_Basic : Ammo
{
	Inventory.Amount 1
	Inventory.MaxAmount 3
	Ammo.BackpackAmount 1
	Ammo.BackpackMaxAmount 3
	Inventory.Icon "SENBB0"
	+INVENTORY.IGNORESKILL
}

