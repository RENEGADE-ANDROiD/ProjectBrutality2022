// PB3.0 folder Sentry Guns — basic + pulse (PB remaps)

Actor PB_SentryBoom
{
	Radius 2
	Height 2
	Renderstyle Add
	+NOINTERACTION
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		XPL1 ABCDEFG 3 Bright
		Stop
	}
}

Actor PB_SentryGunTracer
{
	Speed 320
	Mass 75
	Radius 1
	Height 2
	Projectile
	Damage 5
	+GETOWNER
	+NODAMAGETHRUST
	+NOEXTREMEDEATH
	+FORCERADIUSDMG
	+BLOODSPLATTER
	+HITTRACER
	+NOBOSSRIP
	+RIPPER
	-NOGRAVITY
	RenderStyle Add
	Decal "BulletChip"
	Scale 0.15
	States
	{
	Spawn:
		TRAC A -1 Bright
		Stop
	Death:
		TNT1 A 0 A_SpawnProjectile("HitPuff",0,0,0,0)
		TNT1 A 0
		Stop
	}
}

Actor PB_SentryGun
{
	Obituary "%o was ventilated by an auto-sentry."
	Health 250
	Radius 20
	Height 56
	Mass 100000
	Speed 0
	MaxTargetRange 2048
	AttackSound "Sentry/Attack"
	Tag "Sentry Gun"
	MONSTER
	+FLOORCLIP
	+FRIENDLY
	+NOBLOOD
	+LOOKALLAROUND
	+NEVERRESPAWN
	+STANDSTILL
	States
	{
	Spawn:
		TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
		SENT A 4 A_Look
		SENT A 4 A_Look
		SENT A 4 A_Look
		SENT A 4 A_Look
		SENT A 0 A_PlaySound("Sentry/Active")
		Loop
	See:
		SENT A 4 A_Chase
		SENT A 4 A_Chase
		SENT A 4 A_Chase
		SENT A 4 A_Chase
		SENT A 0 A_PlaySound("Sentry/Active")
		Loop
	Missile:
		SENT A 16 A_FaceTarget
		SENT B 2 Bright A_CPosAttack
		TNT1 A 0 A_SpawnItemEx("YellowFlareSpawn", 0, 0, 42, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CustomMissile("PB_SentryGunTracer", 42, 6, random(-4, 4), 0)
		SENT A 2 A_CposRefire
		Goto Missile+1
	Death:
		SENT C 1 A_PlaySoundEx("Sentry/Death", "SoundSlot5")
		SENT C 0 A_PlaySoundEx("weapons/rocklx", "SoundSlot6")
		SENT C 0 A_SpawnItem("PB_SentryBoom", 0, 48)
		SENT C 512
	FadeOut:
		SENT C 2 A_FadeOut(0.1)
		Loop
	PDA_Preview:
		SENT A 3
		SENT A 3
		SENT B 3 Bright
		SENT B 3 Bright
		SENT C 4
		Stop
	}
}

Actor PB_PulseSentryGun : SwitchableDecoration
{
	Obituary "%o was ventilated by a pulse auto-sentry."
	Health 300
	Radius 20
	Height 56
	Mass 100000
	Speed 0
	MaxTargetRange 2048
	AttackSound "weapons/minigunfire2"
	Tag "Pulse Sentry Gun"
	MONSTER
	+FLOORCLIP
	+FRIENDLY
	+NOBLOOD
	+USESPECIAL
	Activation THINGSPEC_Activate
	+QUICKTORETALIATE
	+LOOKALLAROUND
	+NEVERRESPAWN
	+STANDSTILL
	+MISSILEMORE
	+MISSILEEVENMORE
	States
	{
	Spawn:
		TNT1 A 0 A_GiveInventory("TargetIsAMarine", 1)
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		TNT1 A 0 A_SetAngle(angle + 45)
		PLSN A 0 A_PlaySound("Sentry/Scan")
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		PLSN A 1 A_Look
		TNT1 A 0 A_SetAngle(angle - 45)
		Loop
	ForgetTarget:
		TNT1 A 0 A_ClearTarget
	See:
		PLSN A 1 A_Chase
		PLSN A 1 A_Chase
		PLSN A 1 A_Chase
		PLSN A 1 A_Chase
		PLSN A 0 A_PlaySound("Sentry/Scan")
		Loop
	Active:
		TNT1 A 2
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_SpawnItemEx("PB_SentryBox_Pulse", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		Stop
	Missile:
		PLSN A 0 A_PlaySound("Sentry/Acquire", 2)
		PLSN A 1 A_FaceTarget
		PLSN A 1 A_FaceTarget
		PLSN A 1 A_FaceTarget
	MissileContinue:
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "ForgetTarget")
		PLSN A 2 A_FaceTarget
		TNT1 A 0 A_PlaySound("weapons/plasmaf")
		PLSN A 1 Bright A_CustomMissile("ChexBall", 42, 6, random(-4, 4), 0)
		PLSN A 2 A_FaceTarget
		TNT1 A 0 A_PlaySound("weapons/plasmaf")
		PLSN A 1 Bright A_CustomMissile("ChexBall", 42, -6, random(-4, 4), 0)
		PLSN A 2 A_FaceTarget
		TNT1 A 0 A_PlaySound("weapons/plasmaf")
		PLSN A 1 Bright A_CustomMissile("ChexBall", 42, 6, random(-4, 4), 0)
		PLSN A 0 A_MonsterRefire(32, "See")
		Goto MissileContinue
	Death:
		SENT C 1 A_PlaySoundEx("Sentry/Death", "SoundSlot5")
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		SENT C 0 A_PlaySoundEx("weapons/rocklx", "SoundSlot6")
		SENT C 0 A_SpawnItemEx("BarrelKaboom", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItem("PB_SentryBoom", 0, 48)
		SENT C 8 A_CustomMissile("PlasmaSmoke", 24, 0, random(0, 180), 2, random(0, 180))
		SENT C 8 A_CustomMissile("PlasmaSmoke", 24, 0, random(0, 180), 2, random(0, 180))
		SENT C 8 A_CustomMissile("PlasmaSmoke", 24, 0, random(0, 180), 2, random(0, 180))
		SENT C -1
	FadeOut:
		SENT C 2 A_FadeOut(0.1)
		Loop
	PDA_Preview:
		PLSN A 3
		PLSN A 3 Bright
		PLSN A 3 Bright
		SENT C 4
		Stop
	}
}

// Map pickups — grant ammo (deploy via equipment wheel)
Actor PB_SentryBox : CustomInventory 12369
{
	+COUNTITEM
	+DONTGIB
	Inventory.MaxAmount 0
	Inventory.PickupMessage "$PB_PICKUP_SENTRY_BASIC"
	Inventory.PickupSound "Sentry/BoxUp"
	Inventory.Icon "SENBB0"
	Tag "Sentry Gun"
	States
	{
	Spawn:
		SENB A -1
		Stop
	Pickup:
		TNT1 A 0 A_GiveInventory("PB_SentryAmmo_Basic", 1)
		Stop
	}
}

Actor PB_SentryBox_Pulse : CustomInventory 31004
{
	+COUNTITEM
	+DONTGIB
	Inventory.MaxAmount 0
	Inventory.PickupMessage "$PB_PICKUP_SENTRY_PULSE"
	Inventory.PickupSound "Sentry/BoxUp"
	Inventory.Icon "PLSPA0"
	Tag "Pulse Sentry Gun"
	States
	{
	Spawn:
		PLSP AABBCCDDEEDDCCBB 1 Bright
		Loop
	Pickup:
		TNT1 A 0 A_GiveInventory("PB_SentryAmmo_Pulse", 1)
		Stop
	}
}
