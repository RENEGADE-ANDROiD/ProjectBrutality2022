// Invisible lottery droppers for sentry kits + Cat's Frozen specialty (monster DropItem).

ACTOR PB_SentryDrop_Common
{
	+NOBLOCKMAP
	+NOINTERACTION
	+NOCLIP
	+NOGRAVITY
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256, "Basic", "Pulse", "Heavy")
	Basic:
		TNT1 A 0 A_SpawnItemEx("PB_SentryBox", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Stop
	Pulse:
		TNT1 A 0 A_SpawnItemEx("PB_SentryBox_Pulse", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Stop
	Heavy:
		TNT1 A 0 A_SpawnItemEx("PB_SentryBox_Heavy", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Stop
	}
}

