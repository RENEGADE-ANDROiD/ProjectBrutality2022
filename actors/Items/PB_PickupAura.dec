// Steady lens-flare auras for world pickups (pairs with ARMOR*/PICKUP* GLDEFS).
// Spawn once: A_SpawnItemEx(..., SXF_SETMASTER|SXF_NOCHECKPOSITION) + give PB_PickupAuraSpawned.

ACTOR PB_PickupAuraSpawned : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR PB_PickupAuraGreen : Flare_General
{
	+FORCEXYBILLBOARD
	Alpha 0.35
	Scale 0.32
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(!master, "Null")
	AuraLoop:
		TNT1 A 0 A_JumpIf(!master, "Null")
		LENG A 3 Bright A_Warp(AAPTR_MASTER, 0, 0, 12, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_JumpIf(!master, "Null")
		LENG B 3 Bright A_Warp(AAPTR_MASTER, 0, 0, 12, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		Loop
	}
}

