Actor CacoDemonSpawner replaces Cacodemon
{
	+LOOKALLAROUND
	States
	{
	Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("CacoPackSpawner",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	TNT1 A 1 ACS_NamedExecuteAlways("SpawnerScript",0)
	Deciding:
	TNT1 A 1
	loop
	DiceRandom:
	TNT1 A 0 A_RadiusGive("IsPlayingChaoticRandom", 290, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	Stop
	DiceMain:	// Default spawn preset with a slight difficulty curve. Tier 1-4 Monster presets are contained here to provide more variety.
	EarlyLevelMob:
	TNT1 A 0 A_Jump(13,"AfritPack")
	TNT1 A 0 A_Jump(27,"InfernalPack")
	TNT1 A 0 A_Jump(256,"CacoPack")
	LowLevelMob:
	TNT1 A 0 A_Jump(26,"AfritPack")
	TNT1 A 0 A_Jump(71,"InfernalPack")
	TNT1 A 0 A_Jump(256,"CacoPack")	
	MidLevelMob:
	TNT1 A 0 A_RadiusGive("IsProgGuestLate", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	TNT1 A 0 A_Jump(8,"BabyCacoPack")
	TNT1 A 0 A_Jump(32,"AfritPack")
	TNT1 A 0 A_Jump(110,"InfernalPack")
	TNT1 A 0 A_Jump(256,"CacoPack")
	HighLevelMob:
	TNT1 A 0 A_RadiusGive("IsProgGuestLate", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	TNT1 A 0 A_Jump(8,"BabyCacoPack")
	TNT1 A 0 A_Jump(36,"AfritPack")
	TNT1 A 0 A_Jump(119,"InfernalPack")
	TNT1 A 0 A_Jump(256,"CacoPack")
	DiceProg:	// Progressive spawn preset enforces strict spawning rules by excluding monsters until they are presented in later levels.
	DiceTier1:
	DiceTier2:
	TNT1 A 0 A_Jump(256,"CacoPack")
	DiceTier3:
	TNT1 A 0 A_RadiusGive("IsProgGuestLate", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	TNT1 A 0 A_Jump(8,"BabyCacoPack")
	TNT1 A 0 A_Jump(16,"AfritPack")
	TNT1 A 0 A_Jump(51,"InfernalPack")
	TNT1 A 0 A_Jump(256,"CacoPack")
	DiceTier4:
	TNT1 A 0 A_RadiusGive("IsProgGuestLate", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	TNT1 A 0 A_Jump(8,"BabyCacoPack")
	TNT1 A 0 A_Jump(37,"AfritPack")
	TNT1 A 0 A_Jump(49,"InfernalPack")
	TNT1 A 0 A_Jump(256,"CacoPack")
	DiceDeathWish:
	TNT1 A 0 A_RadiusGive("IsProgGuestLate", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	TNT1 A 0 A_Jump(8,"BabyCacoPack")
	TNT1 A 0 A_Jump(40,"AfritPack")
	TNT1 A 0 A_Jump(108,"InfernalPack")
	TNT1 A 0 A_Jump(256,"CacoPack")
	BabyCacoPack:
	TNT1 A 0 A_RadiusGive("IsRealm667BabyCaco", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	Stop
	AfritPack:	// This is where the pack tokens are distributed
	TNT1 A 0 A_RadiusGive("IsAfritCaco", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	Stop
	InfernalPack:
	TNT1 A 0 A_RadiusGive("IsMagCaco", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	Stop
	CacoPack:
	ReplaceVanilla:
	ReplaceVanilla:
		
	TNT1 A 0 A_RadiusGive("IsNormalCaco", 540, RGF_GIVESELF | RGF_MONSTERS | RGF_ITEMS | RGF_NOSIGHT, 1)
	Stop
	}
}

Actor CacoPackSpawner : Demonpickup
{
	+LOOKALLAROUND
	States
	{
	Spawn: 	// Checks for the tokens distributed above and spawns the correct monster accordingly
	TNT1 A 3
	// FrostBrain stays ungated guest; BabyCaco is Mid/High + Tier3+ via IsRealm667BabyCaco.
	TNT1 A 0 A_JumpIf(GetCvar("pb_disablenewenemies")==1, "Realm667Skip")
	TNT1 A 0 A_Jump(8, "SpawnPB_FrostBrain")
	Realm667Skip:
	TNT1 A 0 A_JumpIfInventory("IsPlayingChaoticRandom", 1, "RandomSpawn")
	TNT1 A 0 A_JumpIfInventory("IsRealm667BabyCaco", 1, "SpawnRealm667BabyCaco")
	TNT1 A 0 A_JumpIfInventory("IsAfritCaco", 1, "SpawnAfrit")
	TNT1 A 0 A_JumpIfInventory("IsMagCaco", 1, "SpawnInfernalCaco")
	TNT1 A 0 A_JumpIfInventory("IsNormalCaco", 1, "SpawnCacodemon")
	Loop
	SpawnRealm667BabyCaco:
	TNT1 A 0 A_JumpIf(GetCvar("NoBabyCaco")==1, "BabyCacoBlocked")
	TNT1 A 0 A_SpawnItemEx("PB_Realm667_BabyCacoGK",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	Stop
	BabyCacoBlocked:
	TNT1 A 0 A_TakeInventory("IsRealm667BabyCaco", 1)
	Goto Realm667Skip
	RandomSpawn:
	TNT1 A 0 A_Jump(256, "SpawnAfrit", "SpawnInfernalCaco", "SpawnCacodemon")
	SpawnAfrit:
	TNT1 A 0 A_Jump(256, "SpawnAfrit1", "SpawnAfrit2")
	stop
	SpawnAfrit1:
	TNT1 A 1 ACS_NamedExecuteAlways("ToggleAfrit",0)
	TNT1 A 0 A_SpawnItemEx("PB_Afrit",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	Stop
	SpawnAfrit2:
	TNT1 A 1 ACS_NamedExecuteAlways("ToggleAfrit",0)
	TNT1 A 0 A_SpawnItemEx("PB_Afrit",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	TNT1 A 0 A_JumpIfInventory("IsProgGuestLate", 1, 1)
	Goto Afrit2Done
	TNT1 A 0 A_JumpIf(GetCvar("NoCrackodemon") == 1, "Afrit2Done")
	TNT1 A 0 A_SpawnItemEx("CrackoDemon",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	Afrit2Done:
	stop
	SpawnInfernalCaco:
	TNT1 A 0 A_Jump(256, "SpawnInfernalCaco1", "SpawnInfernalCaco2")
	stop
	SpawnInfernalCaco1:
	TNT1 A 1 ACS_NamedExecuteAlways("ToggleMagCaco",0)
	TNT1 A 0 A_SpawnItemEx("PB_InfernalCaco",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	stop
	SpawnInfernalCaco2:
	TNT1 A 1 ACS_NamedExecuteAlways("ToggleMagCaco",0)
	TNT1 A 0 A_SpawnItemEx("PB_InfernalCaco",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	TNT1 A 0 A_JumpIfInventory("IsProgGuestLate", 1, 1)
	Goto InfernalC2Done
	TNT1 A 0 A_JumpIf(GetCvar("NoCrackodemon") == 1, "InfernalC2Done")
	TNT1 A 0 A_SpawnItemEx("CrackoDemon",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	InfernalC2Done:
	Stop
	SpawnCacodemon:
	ReplaceToggle:
	TNT1 A 0 A_Jump(256, "SpawnCacodemon1", "SpawnCacodemon2")
	stop
	SpawnCacodemon1:
	TNT1 A 0 A_SpawnItemEx("PB_Cacodemon",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	stop
	SpawnCacodemon2:
	TNT1 A 0 A_SpawnItemEx("PB_Cacodemon",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	TNT1 A 0 A_JumpIfInventory("IsProgGuestLate", 1, 1)
	Goto Caco2Done
	TNT1 A 0 A_JumpIf(GetCvar("NoCrackodemon") == 1, "Caco2Done")
	TNT1 A 0 A_SpawnItemEx("CrackoDemon",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	Caco2Done:
	Stop
	SpawnPB_FrostBrain:
	TNT1 A 0 A_JumpIf(GetCvar("pb_NoFrostBrain")==1, "Realm667Skip")
	TNT1 A 0 A_SpawnItemEx("PB_FrostBrain",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | SXF_TRANSFERPOINTERS | 288,0,tid)
	Stop
	}
}
