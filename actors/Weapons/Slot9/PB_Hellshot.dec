// PB_Hellshot support (mode tokens, wheel slices, alt projectiles).
// Weapon logic: zscript/Weapons/Slot9/Hellshot/PB_Hellshot.zs

ACTOR PB_HellshotAcidMode : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
	-INVENTORY.INVBAR
}

ACTOR Select_PB_Hellshot_Inferno : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
	-INVENTORY.INVBAR
}

ACTOR Select_PB_Hellshot_Caustic : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
	-INVENTORY.INVBAR
}

// Inferno alt: three seeking blood orbs (HSMP; was MSP2 — renamed to avoid Demon Tech clash).
ACTOR PB_Hellshot_BloodBall
{
	Projectile
	+SEEKERMISSILE
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	Radius 6
	Height 6
	Speed 28
	Damage 18
	DamageType Fire
	RenderStyle Add
	Alpha 0.9
	Scale 0.35
	DeathSound "weapons/Hellshot/Change"
	States
	{
	Spawn:
		HSMP ABCDEFGH 2 Bright A_SeekerMissile(12, 24, SMF_LOOK)
		Loop
	Death:
		HSMP I 3 Bright A_Explode(48, 80)
		TNT1 A 0 A_SpawnItem("RedFlare", 0)
		TNT1 AAA 0 A_SpawnItemEx("ObeliskTrailSpark", random(-8, 8), random(-8, 8), random(-2, 2), 0, 0, 0, 0, 128, 0)
		Stop
	}
}

// Caustic alt: bouncing slime ray (HSRY; was R049 — renamed to avoid Railgun clash).
ACTOR PB_Hellshot_DeathRay
{
	Projectile
	+FORCEXYBILLBOARD
	+CANBOUNCEWATER
	+NODAMAGETHRUST
	BounceType "Hexen"
	BounceCount 4
	BounceFactor 1.0
	WallBounceFactor 1.0
	Radius 3
	Height 3
	Speed 45
	Damage 20
	DamageType Slime
	RenderStyle Add
	Alpha 0.85
	Scale 0.25
	DeathSound "weapons/Hellshot/Change"
	States
	{
	Spawn:
		HSRY A 1 Bright
		HSRY BCDE 2 Bright
		Loop
	Death:
		HSRY F 4 Bright A_Explode(96, 128)
		HSRY GHIJ 3 Bright
		HSRY KLMNOPQR 2 Bright
		Stop
	}
}
