// PBWP IN fold — FX / support actors referenced by folded IN weapons (staging parity, PB2022 assets)

// --- Distant rifle audio cue (AssaultRifle) ---
Actor DistantRifleFireSound : OrangeLensFlareAlt
{
	States
	{
	Spawn:
		LEYS O 0 Bright
		TNT1 A 0 A_PlaySound("LightDistantGunshot")
		TNT1 A 0 A_Stop
		LEYS O 0 Bright
		TNT1 A 60
		Stop
	}
}

// --- Ejected magazine / clip physics ---
ACTOR PBWP_DroppedClip
{
	Height 4
	Radius 4
	Speed 7
	Scale 0.4
	BounceFactor 0.5
	BounceType "Doom"
	+MISSILE
	+NOBLOCKMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DOOMBOUNCE
	-NOGRAVITY
	SeeSound "weapons/smallmagdrop"
	DeathSound "weapons/smallmagdrop"
	States
	{
	Spawn:
		BR9R A 4
		BR9R A 35 A_SetRoll(Roll - 45)
		Stop
	}
}

ACTOR DeathPistolClip : PBWP_DroppedClip
{
}

ACTOR ClasicDeathClip : PBWP_DroppedClip
{
}

ACTOR PlasmaDeathClip : PBWP_DroppedClip
{
	States
	{
	Spawn:
		CELL A 4
		CELL A 35 A_SetRoll(Roll - 45)
		Stop
	}
}

ACTOR EmptyPistolClipSpawn
{
	Speed 20
	PROJECTILE
	+NOCLIP
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 1 A_CustomMissile("DeathPistolClip", 1, 0, random(85, 115), 2, random(30, 60))
		Stop
	}
}

// --- Plasma rifle / rail siege FX ---
ACTOR GunFireSmokeBig : GunFireSmoke1
{
	Alpha 0.65
	Scale 1.15
	Speed 22
}

ACTOR NeonPlasma_Ball : Plasma_Ball
{
}

ACTOR GaussSiegeDamageAndPuff : FastProjectile
{
	Speed 4000
	Radius 2
	Height 2
	RenderStyle None
	Damage 20
	+RIPPER
	-CANNOTPUSH
	+NODAMAGETHRUST
	+EXTREMEDEATH
	+FORCERADIUSDMG
	DamageType SSG
	States
	{
	Spawn:
		TNT1 A 1
		Loop
	Death:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_Explode(120, 15)
		TNT1 A 0 A_SpawnItem("WhiteShockwave")
		TNT1 A 0 A_SpawnItemEx("RailgunImpactExplosionSFX", 0, 0, 0, 0, 0, 0, 0, 128)
		TNT1 A 0 A_SpawnItemEx("DetectFloorCrater", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("DetectCeilCrater", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("ExplosionFlareSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 AA 0 A_CustomMissile("FireworkSFXType2", 0, 0, random(0, 360), 2, random(30, 60))
		TNT1 AAA 10 A_CustomMissile("BigBlackSmoke", 0, 0, random(0, 360), 2, random(40, 160))
		Stop
	}
}

ACTOR DoomerGaussShot : DoomerRailShot
{
}

ACTOR DoomerGaussSiegeShot : DoomerGaussShot
{
	Scale 4
	Radius 10
	Height 10
}

ACTOR HeatBlastEffect1
{
	Speed 0
	Height 0
	Radius 1
	Scale 0.03
	RenderStyle Add
	Alpha 0.9
	+NOINTERACTION
	+NOGRAVITY
	+ROLLSPRITE
	Translation "0:255=%[0,0,0]:[0,0.6,1]"
	States
	{
	Spawn:
		X060 A 1 Bright
		{
			A_FadeOut(0.04);
			A_SetRoll(Roll - 2);
			A_SetScale(ScaleX + 0.08, ScaleY + 0.08);
		}
		Loop
	}
}

ACTOR HeatBlastEffect2 : HeatBlastEffect1
{
	Scale 0.01
	Alpha 0.99
	States
	{
	Spawn:
		X060 B 1 Bright
		{
			A_FadeOut(0.04);
			A_SetRoll(Roll - 5);
			A_SetScale(ScaleX + 0.04, ScaleY + 0.04);
		}
		Loop
	}
}

ACTOR HeatBlastEffect3
{
	Speed 0
	Height 0
	Radius 1
	Scale 0.03
	RenderStyle Add
	Alpha 0.99
	+NOINTERACTION
	+NOGRAVITY
	+FLATSPRITE
	Translation "0:255=%[0,0,0]:[0,0.6,1]"
	States
	{
	Spawn:
		X060 A 1 Bright
		{
			A_FadeOut(0.05);
			A_SetScale(ScaleX + 0.3, ScaleY + 0.3);
		}
		Loop
	}
}

ACTOR M1_HeatWave
{
	Speed 25
	Radius 12
	Height 12
	Damage 10
	DamageType Plasma
	RenderStyle Add
	Alpha 0.4
	Projectile
	+RIPPER
	-CANNOTPUSH
	-NODAMAGETHRUST
	+ROLLSPRITE
	+NOGRAVITY
	ReactionTime 7
	Scale 0.3
	States
	{
	Spawn:
		TNT1 A 1 NoDelay A_RadiusThrust(5000, 150, 0, 100)
		DB19 BCDEF 1 Bright
		{
			A_SetScale(ScaleX + 0.02, ScaleY + 0.02);
			A_Explode(60, 180, 0, 0, 150);
			A_SpawnItemEx("HeatBlastEffect2", 0, 0, 0, 0, 0, 0, 0, 128);
			A_CustomMissile("RailGunTrailSpark_Fast", 0, 0, random(0, 360), 2, random(0, 360));
		}
		Goto Fly
	Fly:
		TNT1 A 1 Bright
		{
			A_SetScale(ScaleX + 0.02, ScaleY + 0.02);
			A_CountDown;
			A_Explode(60, 180, 0, 0, 150);
			A_SpawnItemEx("HeatBlastEffect1", 0, 0, 0, 0, 0, 0, 0, 128);
			A_SpawnItemEx("HeatBlastEffect2", 0, 0, 0, 0, 0, 0, 0, 128);
			A_CustomMissile("RailGunTrailSpark_Fast", 0, 0, random(0, 360), 2, random(0, 360));
		}
		Loop
	Death:
		TNT1 A 1 Bright A_FadeOut(0.1)
		Loop
	}
}

