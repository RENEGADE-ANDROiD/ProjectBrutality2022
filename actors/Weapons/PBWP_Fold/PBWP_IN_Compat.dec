// Thunder Carrier rail trail (A_RailAttack third arg — avoid RailGunTrail name clash).
ACTOR PBWP_RailGunTrail : Actor
{
	+NOBLOCKMAP
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 1
		Stop
	}
}
