Actor UseEquipment: Inventory {Inventory.maxamount 1}
Actor ToggleEquipment: Inventory{Inventory.maxamount 1}

Actor FragGrenadeSelected : Inventory {inventory.maxamount 1}
Actor ProximityMineSelected : Inventory {inventory.maxamount 1}
Actor StunGrenadeSelected : Inventory {inventory.maxamount 1}
Actor ShieldGrenadeSelected : Inventory {inventory.maxamount 1}
Actor VoidGrenadeSelected : Inventory {inventory.maxamount 1}
Actor LeechSelected : Inventory {inventory.maxamount 1}
Actor RevGunSelected : Inventory {inventory.maxamount 1}

Actor WW_FragGrenadeSelected : Inventory {inventory.maxamount 1}
Actor WW_ProximityMineSelected : Inventory {inventory.maxamount 1}
Actor WW_StunGrenadeSelected : Inventory {inventory.maxamount 1}
Actor WW_ShieldGrenadeSelected : Inventory {inventory.maxamount 1}
Actor WW_VoidGrenadeSelected : Inventory {inventory.maxamount 1}
Actor WW_LeechSelected : Inventory {inventory.maxamount 1}
Actor WW_RevGunSelected : Inventory {inventory.maxamount 1}
Actor HookSelected : Inventory {inventory.maxamount 1}
Actor WW_HookSelected : Inventory {inventory.maxamount 1}

Actor DualFiring: Inventory {Inventory.maxamount 1}
Actor DualFireReload: Inventory {Inventory.maxamount 2}

//Actions observed by the AI!
Actor PlayerIsThrowingAGrenade : Inventory {inventory.maxamount 1}
Actor CantWeaponSpecial : Inventory {inventory.maxamount 1}



Actor PB_Weapon : PB_WeaponBase
{

	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.4
	Weapon.UpSound "none"
	Weapon.Kickback 100
	-WEAPON.MELEEWEAPON	

States
{
	Select:
		TNT1 A 1 A_Raise
		Wait
		
	Fire:
	Ready:
	SelectAnimation:
		Goto GoingToReady
	Deselect:
		TNT1 A 0 PB_ClearOrphanedExecutionLockOnDeselect()
		TNT1 A 1 A_Lower
		Wait

	Flash:
		TNT1 A 1
		Stop
	
	
	
	// Mini event handler overlays live on PB_WeaponBase (BaseWeapon.zc) so DECORATE PB_Weapon and ZScript-only weapons share one implementation.
		
	// Initialize Weapon upon selection
	GoingToReady:
	SelectingAnimation:
		// Possession mounts override Ready but inherit SelectAnimation→GoingToReady;
		// Ready3→SelectAnimation would soft-lock without this short-circuit.
		TNT1 A 0 { return PB_PossessionRideGotoReady(); }
		TNT1 A 0 A_JumpIfInventory("Hayulti", 1, "Hayulti")
		TNT1 A 0 A_JumpIfInventory("Hayberserk", 1, "Hayberserk")
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 {
			A_TakeInventory("KeepLaserDeactivated",1);
			A_TakeInventory("DoGrenade",1);
			A_TakeInventory("IsRunning",1);
			A_TakeInventory("Reloading",1);
			PB_RestoreWeaponMiniOverlays();
			
			// New 
			PB_SetUsingKick(false);
			PB_SetUsingMelee(false);
			PB_SetUsingEquipment(false);
			// Full Unset if Token/FLY still armed — bare SetExecutingEnemy(false) orphans PROP_FLY.
			// Leave locks alone while GoFatality (3rd-person) is held.
			// g4.14: brace-less if/else rejected in anonymous DECORATE blocks.
			if (CountInv("GoFatality") < 1)
			{
				if (CountInv("ExecutionToken") >= 1 || PB_executingEnemy())
				{
					PB_UnsetPlayerExecutionProperties();
				}
				else
				{
					PB_SetExecutingEnemy(false);
				}
			}
			
		}
		TNT1 A 0 A_Jump(255,"Ready4")
		TNT1 AAAA 1 A_Jump(255, "Ready3")
		Loop

	// Brutal Doom Plus Hayulti (SegundaOportunidad) / Hayberserk theatrics — shared for all PB_Weapon children
	Hayulti:
		TNT1 A 0 { return PB_AbortHayultiOnPossessionRide(); }
		TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1)
		TNT1 A 0 SetPlayerProperty(0, 1, 0)
		TNT1 A 0 A_PlayerScream
		JOJO A 1 A_Print("$PB_HAYULTI_FURY")
		JOJO BC 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO DE 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO FG 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO HI 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO PQ 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO RS 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO TU 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO PQ 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO RS 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO PQ 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO RS 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO TU 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO PQ 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO RS 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO TU 1
		JOJO PQ 1
		JOJO PQ 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO RS 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO TU 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO PQ 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO RS 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO PQ 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO RS 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO TU 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		JOJO TU 1
		JOJO VW 1
		JOJO XY 1
		JOJO Z 1
		JOJP AB 1
		TNT1 A 0 A_GiveInventory("PowerStrength", 1)
		TNT1 A 0 A_ChangeFlag("INVULNERABLE", 0)
		TNT1 A 0 SetPlayerProperty(0, 0, 0)
		TNT1 A 0 SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN)
		TNT1 A 0 A_TakeInventory("Hayulti", 1)
		TNT1 A 0 PB_RestoreWeaponMiniOverlays()
		TNT1 A 0 A_Jump(256, "GoingToReady")
		TNT1 A 0 A_Jump(256, "SelectContinue")
		TNT1 A 0 A_Jump(256, "Ready3")
		Goto Ready

	Hayberserk:
		TNT1 A 0 { return PB_AbortHayberserkOnPossessionRide(); }
		TNT1 A 0 A_SelectWeapon("Melee_Attacks")
		TNT1 A 0 A_GiveInventory("PB_HayberserkInvuln", 1)
		TNT1 A 0 A_Jump(100, "HayberserkAlt")
		TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1)
		TNT1 A 0 SetPlayerProperty(0, 1, 0)
		TNT1 A 0 A_AlertMonsters
		MIPA ABCEGI 1
		MIPA JK 1
		TNT1 A 0 A_Print("$PB_RIP_AND_TEAR_ANIM")
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		MIPA JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA JK 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA LM 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA NO 1
		TNT1 A 0 A_Quake(2, 8, 0, 256)
		MIPA IGECBA 1
		TNT1 A 0 A_ChangeFlag("INVULNERABLE", 0)
		TNT1 A 0 SetPlayerProperty(0, 0, 0)
		TNT1 A 0 SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN)
		TNT1 A 0 A_TakeInventory("Hayberserk", 1)
		TNT1 A 0 PB_RestoreWeaponMiniOverlays()
		TNT1 A 0 A_Jump(256, "GoingToReady")
		TNT1 A 0 A_Jump(256, "SelectContinue")
		TNT1 A 0 A_Jump(256, "Ready3")
		Goto Ready

	HayberserkAlt:
		TNT1 A 0 { return PB_AbortHayberserkOnPossessionRide(); }
		TNT1 A 0 A_SelectWeapon("Melee_Attacks")
		TNT1 A 0 A_GiveInventory("PB_HayberserkInvuln", 1)
		TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1)
		TNT1 A 0 SetPlayerProperty(0, 1, 0)
		TNT1 A 0 A_Print("$PB_RIP_AND_TEAR_ANIM")
		TNT1 A 0 A_AlertMonsters
		PONG RQP 1
		PUNS CDEEF 1
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_PlaySound("KNUCKLED")
		PUNS G 1
		PUNS G 1
		PUNS G 1
		PUNS G 2
		PUNS FE 1
		PUNS D 7
		PUNS IJKKL 1
		TNT1 A 0 A_PlaySound("KNUCKLED")
		PUNS M 1
		TNT1 A 0 A_AlertMonsters
		PUNS M 1
		PUNS M 1
		PUNS M 7
		PUNS A 0
		PUNS LKJ 1
		PUNS I 2
		PUNS BA 1
		PONG PQR 1
		TNT1 A 0 A_ChangeFlag("INVULNERABLE", 0)
		TNT1 A 0 SetPlayerProperty(0, 0, 0)
		TNT1 A 0 SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN)
		TNT1 A 0 A_TakeInventory("Hayberserk", 1)
		TNT1 A 0 PB_RestoreWeaponMiniOverlays()
		TNT1 A 0 A_Jump(256, "GoingToReady")
		TNT1 A 0 A_Jump(256, "SelectContinue")
		TNT1 A 0 A_Jump(256, "Ready3")
		Goto Ready
	
	// SelectFirstPersonLegs is on PB_WeaponBase (BaseWeapon.zc); DECORATE PB_Weapon and ZScript-only weapons Goto it.
		
	TryToSelectDrum:
		TNT1 AAAA 1 A_Jump(255, "Ready3")
		TNT1 AAAA 1 A_Jump(255, "BeltReady")
		Loop
		
    
	// Glory Kill
		
	DoFatality:
		TNT1 A 0 A_Takeinventory("Fear",1)
		TNT1 A 0
		{
			if(GetCvar("be_Protection") == 1)
			{
				A_Giveinventory("Superarmor",1);
			}
		}
		Goto GloryKillPunchWait

	GloryKillPunchWait:
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		TNT1 A 1 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		Goto PB_FinisherCleanup
		
	DoingFatality:
		TNT1 A 1 SetPlayerProperty(0,1,0)
		TNT1 A 0
		{
			if(GetCvar("be_Protection") == 1)
			{
				A_Giveinventory("Superarmor",1);
			}
		}
		TNT1 A 0 {PB_SetUsingMelee(false);}
		TNT1 A 0 A_JumpIfInventory("GoFatality",1,"DoingFatality")
		Goto PB_FinisherCleanup
		
	PermormGloryKill:
		TNT1 A 0
		{
			A_PlaySound("GloryKill", CHAN_UI);
			if(GetCvar("be_Protection") == 1)
			{
				A_Giveinventory("Superarmor",1);
			}
			if(GetCvar("be_Fear") == 1)
			{
				A_Giveinventory("Fear",1);
			}
		}
		TNT1 A 0 {PB_SetUsingMelee(false);}
		TNT1 A 0 A_CustomPunch(10000,1,0,"GloryKillPuff",150,0,0)
		TNT1 A 0
		"####" "#" 0 { return ResolveState("DoFatality"); }	
	
	// Glory Melee
	
	GloryMelee:
		SAWG G 0
		{	
			if(CountInv("CrucibleEnergy") > 0)
			{
				A_TakeInventory("Zoomed",1);
				A_ZoomFactor(1.0);
				A_TakeInventory("ADSmode",1);
				A_StopSound(1);
				A_StopSound(6);
				return ResolveState("Crucible");
			}
				A_Print("\cgDemon energy \c-insufficient for equipment");
				A_PlaySound("Beep");
				A_TakeInventory("DoGloryMelee",1);
				return ResolveState("");
		}
		Goto GoingToReady
		
	
	// Blood Punch
	
	BloodPunch:
		SCL0 A 0 A_ClearOverlays(-5, 80)
		SCL0 A 0 A_GunFlash("Null")
		SCL0 A 0 A_StopSound(1)
		SCL0 A 0 A_StopSound(6)
		P1NK ABCD 1 {
			if (CountInv("PowerBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P2NK");}
			if (CountInv("PowerBlueBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P3NK");}
			if (CountInv("PowerGreenBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P4NK");}
			A_SetRoll(roll+2);
		}
		TNT1 A 1 A_SetRoll(roll+2)
		TNT1 A 2
		TNT1 A 0 A_PlaySound("weapons/ultrwhoosh", 5)
		P1NK EF 1 {
			if (CountInv("PowerBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P2NK");}
			if (CountInv("PowerBlueBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P3NK");}
			if (CountInv("PowerGreenBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P4NK");}
			A_SetRoll(roll-2);
		}
		TNT1 A 0 {
				A_Saw("", "player/cyborg/fist", 120, "BloodPunchPuff", SF_NOPULLIN | SF_NOTURN , 128);
		}
		P1NK G 1 {
			if (CountInv("PowerBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P2NK");}
			if (CountInv("PowerBlueBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P3NK");}
			if (CountInv("PowerGreenBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P4NK");}
		}
		P1NK HIJKLMNO 1 {
			if (CountInv("PowerBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P2NK");}
			if (CountInv("PowerBlueBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P3NK");}
			if (CountInv("PowerGreenBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P4NK");}
			A_SetRoll(roll-1);
			}
		P1NK O 1 {
			if (CountInv("PowerBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P2NK");}
			if (CountInv("PowerBlueBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P3NK");}
			if (CountInv("PowerGreenBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P4NK");}
		}
		P1NK PQ 1 {
			if (CountInv("PowerBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P2NK");}
			if (CountInv("PowerBlueBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P3NK");}
			if (CountInv("PowerGreenBloodOnVisor") >= 1 ) { A_SetWeaponSprite("P4NK");}
			A_SetRoll(roll+2);
		}
		TNT1 A 0 A_SetRoll(0)
		TNT1 A 0 {
			if(CountInv("BloodPunchKilled"))
			{
				A_PlaySound("BloodPunch", CHAN_AUTO);
				A_TakeInventory("BloodPunchKilled");
				A_TakeInventory("BPtoken");
				A_Explode(125, 200, 0, true, 200 ,0 ,0, BPImpactPuff, "BloodPunch");
			}
		}
		TNT1 A 0 {PB_SetUsingMelee(false);}
		TNT1 A 0 A_TakeInventory("DoGloryMelee", 1)
		TNT1 A 1 A_Raise
		Goto GoingToReady
	
	
	// Crucible (Glory-kill path only; no Player.WeaponSlot / number key)
		
	Crucible:
		SCL0 A 0 A_ClearOverlays(-5, 80)
		SCL0 A 0 A_GunFlash("Null")
		CRCB A 1 A_StartSound("Crucible_Select", CHAN_WEAPON, CHANF_OVERLAP)
		CRCB AABBCCJJ 2 bright A_WeaponOffset(-1, 2, WOF_ADD)
		CRCB D 1 bright
		{
			A_StartSound("Crucible_Deploy", CHAN_WEAPON, CHANF_OVERLAP);
			A_WeaponOffset(-2, 4, WOF_ADD);
			A_TakeInventory("CrucibleEnergy",1);
		}
		CRCB D 3 bright A_WeaponOffset(-2, 4, WOF_ADD)
		CRCB DDD 1 bright A_WeaponOffset(3, -6, WOF_ADD)
		CRCB D 1 bright A_WeaponOffset(0.5, 4, WOF_ADD)
		Goto HoldCrucible
		
	HoldCrucible:	
		CRCB D 1 bright A_StartSound("Crucible_Idle",3,CHANF_LOOP|CHANF_OVERLAP,0.2)
		CRCB D 1 bright
		{
			A_WeaponReady;
			if (!countinv(DoGloryMelee))
			{
				return ResolveState("DoCrucible");
			}
			return ResolveState("");
		}
		Goto HoldCrucible+1
		
	DoCrucible:
		CRCB D 1 
		{
			A_StartSound("Crucible_Swing", CHAN_WEAPON, CHANF_OVERLAP);
			A_WeaponOffset(10,2, WOF_ADD);
		}
		CRCB D 1 A_WeaponOffset(20, 4, WOF_ADD)
		CRCB D 1 A_WeaponOffset(30, 6, WOF_ADD)
		CRCB D 1 A_WeaponOffset(40, 8, WOF_ADD)
		CRCB D 1 A_WeaponOffset(50,10, WOF_ADD)
		CRCB D 1 A_WeaponOffset(60,12, WOF_ADD)
		TNT1 A 0 A_WeaponReady(WRF_NoFire|WRF_NoSwitch)
		
		//First Swing
		
		CRCB EEF 1 
		{
			A_Saw("", "Crucible_Slice", 300, "CruciblePuff", SF_NOPULLIN | SF_NOTURN , 150, 32);
		}
		CRCB G 1
		{
			A_WeaponOffset(-40, 0, WOF_ADD);
			A_Saw("", "Crucible_Slice", 300, "CruciblePuff", SF_NOPULLIN | SF_NOTURN , 150, 32);
			A_SpawnItemEx("CrucibleBladeWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH);
		}
		
		TNT1 A 0 A_WeaponReady(WRF_NoFire|WRF_NoSwitch)
		
		CRCB HII 1 
		{
			A_WeaponOffset(-40, 8, WOF_ADD);
			A_Saw("", "Crucible_Slice", 300, "CruciblePuff", SF_NOPULLIN | SF_NOTURN , 150, 32);
		}
		CRCB D 0 A_WeaponOffset(325, 24, WOF_ADD)
		
		TNT1 A 10
		
		TNT1 A 0
		{
			A_TakeInventory("DoGloryMelee",1);
		}
		
		CRCB D 1 A_WeaponOffset(-60, -12, WOF_ADD)
		CRCB D 1 A_WeaponOffset(-50, -10, WOF_ADD)
		CRCB D 1 A_WeaponOffset(-40, -8, WOF_ADD)
		CRCB D 1 A_WeaponOffset(-30, -6, WOF_ADD)
		CRCB D 1 A_WeaponOffset(-20, -4, WOF_ADD)
		
		CRCB D 1 bright A_WeaponOffset(-0.5, -4, WOF_ADD)
		CRCB DDD 1 bright A_WeaponOffset(-3, 6, WOF_ADD)
		CRCB D 3 bright A_WeaponOffset(2, -4, WOF_ADD)
		
		CRCB D 1 bright A_WeaponOffset(2, -4, WOF_ADD)
		
		CRCB JJCCBBAA 2 bright A_WeaponOffset(1, -2, WOF_ADD)
		CRCB A 1 A_StopSound(3)
		CRCB A 1 A_StartSound("Crucible_Deselect", CHAN_WEAPON, CHANF_OVERLAP)
		CRCB A 5
		TNT1 A 1 A_Raise
		Goto GoingToReady
		
	// Shoulder Cannon
		
	FireShoulderCannon:
		TNT1 A 0
		{
			A_TakeInventory("Zoomed",1);
			A_ZoomFactor(1.0);
			A_TakeInventory("ADSmode",1);
			A_StopSound(CHAN_WEAPON);
			A_StopSound(CHAN_6);
			if (CountInv("FlameBelchSelected") > 0 && CountInv("FlameBelchReady") > 0)
			{
				return ResolveState("FireFlameBelch");
			}
			if (CountInv("IceBombSelected") > 0 && CountInv("IceBombReady") > 0)
			{
				return ResolveState("FireIceBomb");
			}
			if (CountInv("FlameBelchSelected") > 0 && CountInv("FlameBelchReady") < 1 && CountInv("IceBombReady") > 0)
			{
				A_SetInventory("IceBombSelected", 1);
				A_SetInventory("FlameBelchSelected", 0);
				return ResolveState("FireIceBomb");
			}
			if (CountInv("IceBombSelected") > 0 && CountInv("IceBombReady") < 1 && CountInv("FlameBelchReady") > 0)
			{
				A_SetInventory("FlameBelchSelected", 1);
				A_SetInventory("IceBombSelected", 0);
				return ResolveState("FireFlameBelch");
			}
			if (CountInv("FlameBelchReady") > 0)
			{
				return ResolveState("FireFlameBelch");
			}
			if (CountInv("IceBombReady") > 0)
			{
				return ResolveState("FireIceBomb");
			}
			return ResolveState("EmptyCannon");
		}
		
	FireFlameBelch:
		TNT1 A 0
		{
			if (countinv("FlameBelchReady") < 1)
			{
				return ResolveState("EmptyCannon");
			}
			if (GetCvar("be_UseELammo") == 1 && countinv("Gas") < 50)
			{
				return ResolveState("EmptyCannon");
			}
			if (GetCvar("be_FBperformance") == 1)
			{
				return ResolveState("FireFlameBelchSimple");
			}
			return ResolveState("FireFlameBelch_Fire");
		}

	FireFlameBelch_Fire:
		TNT1 A 0 {
			A_TakeInventory("Zoomed",1);
			A_ZoomFactor(1.0);
			A_TakeInventory("ADSmode",1);
		}
		SCL0 A 0 A_ClearOverlays(-5, 80)
		SCL0 A 0 A_GunFlash("Null")
		SCL0 ABCD 1 A_PlaySound("Equip_Activate", CHAN_ITEM)
		SCL0 EFGHIJ 1
		SCL0 K 1 A_Quake(8, 8, 0, 32)
		TNT1 A 0 A_Recoil (4)
		TNT1 A 0 A_PlaySoundEx("Flamebelch", "Weapon")
		SCF0 A 5 bright A_GunFlash
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_TakeInventory("FlameBelchReady",1)
		TNT1 A 0 A_PB_AchShoulderFlame
		TNT1 A 0
		{
			if (GetCvar("be_UseELammo") == 1)
			{
				A_TakeInventory("Gas",50);
			}
		}
		SCF0 BCDBCDBCD 1 bright {
			A_FireCustomMissile("GloryFireMissile", -3, 0, Random(-25, -20), 12, FPF_NOAUTOAIM, 0);
		}
		SCF0 EF 1
		SCL0 KJIHGFEDCBA 1
		TNT1 A 0 A_TakeInventory("DoShoulderCannon", 1)
		TNT1 A 1 A_Raise	
		Goto GoingToReady

	FireFlameBelchSimple:
		SCL0 A 0 A_ClearOverlays(-5, 80)
		SCL0 A 0 A_GunFlash("Null")
		SCL0 ABCD 1 A_PlaySound("Equip_Activate", CHAN_ITEM)
		SCL0 EFGHIJ 1
		SCL0 K 1 A_Quake(8, 8, 0, 32)
		TNT1 A 0 A_Recoil (4)
		TNT1 A 0 A_PlaySoundEx("Flamebelch", "Weapon")
		SCF0 A 5 bright A_GunFlash
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_TakeInventory("FlameBelchReady",1)
		TNT1 A 0 A_PB_AchShoulderFlame
		TNT1 A 0
		{
			if (GetCvar("be_UseELammo") == 1)
			{
				A_TakeInventory("Gas",50);
			}
		}
		SCF0 BCD 1 bright {
			A_FireCustomMissile("GloryFireMissile", -3, 0, Random(-25, -20), 12, FPF_NOAUTOAIM, 0);
		}
		SCF0 BCD 1 bright {
			A_FireCustomMissile("GloryFireMissile", -3, 0, Random(-25, -20), 12, FPF_NOAUTOAIM, 0);
		}
		SCF0 EF 1
		SCL0 KJIHGFEDCBA 1
		TNT1 A 0 A_TakeInventory("DoShoulderCannon", 1)
		TNT1 A 1 A_Raise
		Goto GoingToReady
		
	FireIceBomb:
		TNT1 A 0 {
			if (countinv("IceBombReady") < 1)
			{
				return ResolveState("EmptyCannon");
			}
			if (GetCvar("be_UseELammo") == 1 && countinv("RocketAmmo") < 1)
			{
				return ResolveState("EmptyCannon");
			}
			return ResolveState("FireIceBomb_Fire");
		}

	FireIceBomb_Fire:
		TNT1 A 0 {
			A_TakeInventory("Zoomed",1);
			A_ZoomFactor(1.0);
			A_TakeInventory("ADSmode",1);
		}
		LCL0 A 0 A_ClearOverlays(-5, 80)
		LCL0 A 0 A_GunFlash("Null")
		LCL0 ABCD 1 A_PlaySound("Equip_Activate", CHAN_ITEM)
		LCL0 EFGHIJ 1
		LCL0 K 1 A_Quake(8, 8, 0, 32)
		TNT1 A 0 A_Recoil (4)
		LCF0 A 3 bright A_GunFlash
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_TakeInventory("IceBombReady",1)
		TNT1 A 0 A_PB_AchShoulderIce
		TNT1 A 0
		{
			if (GetCvar("be_UseELammo") == 1)
			{
				A_TakeInventory("RocketAmmo",1);
			}
		}
		LCF0 BC 1 bright
		LCF0 D 1 bright {
			A_PlaySound("IceBomb/icebombfire", CHAN_WEAPON);
			A_FireCustomMissile("SC_CryoGrenade", 1, 0, Random(18, 22), 12, FPF_NOAUTOAIM, 0);
		}
		LCF0 EF 1
		LCL0 KJIHGFEDCBA 1
		TNT1 A 0 A_TakeInventory("DoShoulderCannon", 1)
		TNT1 A 1 A_Raise
		Goto GoingToReady
		
	EmptyCannon:
		TNT1 A 0 A_StopSoundEx("Weapon")
		TNT1 A 0 A_PlaySound("Equip_notready")
		TNT1 A 0 A_TakeInventory("DoShoulderCannon", 1)
		Goto GoingToReady
		
	// Glory Kill End
	
	//First Person Legs in Doom
	FirstPersonLegsKickRight:
		STAN A 0
		"####" A 0
		"####" A 0 A_GiveInventory("KeepLaserDeactivated",1)
		"####" A 0 A_JumpIf(Height < 54, "FirstPersonLegsHide")
		"####" A 0 A_JumpIfInventory("FPSLegChecker", 1, 2)
		"####" O 1
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Loop
		"####" P 1
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Loop
	FirstPersonLegsKickLeft:
		STAL A 0
		"####" A 0
		"####" A 0 A_GiveInventory("KeepLaserDeactivated",1)
		"####" A 0 A_JumpIf(Height < 54, "FirstPersonLegsHide")
		"####" A 0 A_JumpIfInventory("FPSLegChecker", 1, 2)
		"####" P 1
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			
			
			
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
			
		}
		Loop
		"####" O 1
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Loop
	FirstPersonLegsHide:
		"####" Q 1 
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Loop
	FirstPersonLegsStand:
		TNT1 A 0 
		TNT1 A 0 A_JumpIf(momx > 0.8 || momx < -0.8 || momy > 0.8 || momy < -0.8, "FirstPersonLegsWalk1")
		TNT1 A 0 A_JumpIf(momZ != 0, "FirstPersonLegsJump")
		TNT1 A 0 A_JumpIf(Height < 54, "FirstPersonLegsCrouch")
		TNT1 A 0 A_JumpIfInventory("FPSLegChecker", 1, 2)
		STAN A 1 
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Loop
		TNT1 A 0 
		TNT1 A 0 A_JumpIf(Height < 54, "FirstPersonLegsCrouch")
		TNT1 A 0 A_JumpIf(momZ != 0, "FirstPersonLegsJump")
		STAN M 1 
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Loop
		
	FirstPersonLegsCrouch:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("IronSights", 0) //Sound when player crouches
		FirstPersonLegsCrouchContinue:
		TNT1 A 0 A_JumpIf(momZ != 0, "FirstPersonLegsJump")
		TNT1 A 0 A_JumpIf(momx > 0.8 || momx < -0.8 || momy > 0.8 || momy < -0.8, "FirstPersonLegsWalk1")
		TNT1 A 0 A_JumpIf(Height > 54, "FirstPersonLegsStand")
		STAN N 1 
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Loop
		
	FirstPersonLegsWalk1:
		TNT1 A 0
		TNT1 A 0 A_JumpIf(momZ != 0, "FirstPersonLegsJump")
		TNT1 A 0 A_JumpIfInventory("FPSLegChecker", 1, "FirstPersonLegsWalk2")
		TNT1 A 0 A_JumpIf(momZ != 0, "FirstPersonLegsJump")
		TNT1 A 0 A_GiveInventory("FPSLegChecker",1)
		STAN BCCDDEEFF 1
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
			return A_JumpIf(momZ != 0, "FirstPersonLegsJump");
		}
		Goto FirstPersonLegsStand
		
	FirstPersonLegsWalk2:
		TNT1 A 0
		TNT1 A 0 A_JumpIf(momZ != 0, "FirstPersonLegsJump")
		TNT1 A 0 A_TakeInventory("FPSLegChecker",1)
		STAN GHHIIJJKLL 1 
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
			return A_JumpIf(momZ != 0, "FirstPersonLegsJump");
		}
		Goto FirstPersonLegsStand
			
	FirstPersonLegsJump:
		TNT1 A 0 
		STAN I 5
		{
			A_OverlayFlags(-10, PSPF_ADDWEAPON, False);
			A_OverlayFlags(-10, PSPF_PLAYERTRANSLATED, True);
			A_OverlayOffset(-10, 0, (-pitch*2)+230);
			if(PB_executingEnemy()) {
				A_SetOverlaySprite(-10, "TNT1");
			}
		}
		Goto FirstPersonLegsStand
			
		
	
			
			
			
			
			
			
	// The quick melee is going to be reworked, knife combos are tacky and bloat the code
	// The quick melee should have a primary purpose of executing enemies or finishing them off to the point where they can be executed
	QuickMelee:
		TNT1 A 0
		{
			if(PB_GloryKillOpportunityReady())
			{
				A_TakeInventory("Zoomed",1);
				A_ZoomFactor(1.0);
				A_TakeInventory("ADSmode",1);
				return ResolveState("PermormGloryKill");
			}
			if(countinv("BPToken") == 5){
				A_TakeInventory("Zoomed",1);
				A_ZoomFactor(1.0);
				A_TakeInventory("ADSmode",1);
				A_TakeInventory("BloodPunchKilled");
				return ResolveState("BloodPunch");
			}
			return ResolveState("");
		}
		TNT1 A 0 A_ClearOverlays(3,65)
		TNT1 A 0 A_Gunflash("Null")
		TNT1 A 1 { return PB_Execute(); }
		TNT1 A 0 A_JumpIfInventory("ShieldSawThrown", 1, "GoMeleePunchSetup")
		TNT1 A 0 {
			if (PB_QuickMeleeAimWithinPunchRange()) { return ResolveState("GoMeleePunchSetup"); }
			return state("");
		}
		TNT1 A 0 A_JumpIfCloser(128, "GoMeleePunchSetup")
		"####" "#" 0 { return PB_ResolveQuickMeleeShieldThrow(); }
		TNT1 A 0 A_JumpIfInventory("ShieldSawThrown", 1, "GoMeleePunchSetup")
		TNT1 A 0 {
			if (PB_QuickMeleeAimWithinPunchRange()) { return ResolveState("GoMeleePunchSetup"); }
			return state("");
		}
		TNT1 A 0 A_JumpIfCloser(128, "GoMeleePunchSetup")
	GoMeleePunchSetup:
		TNT1 A 0 A_ClearOverlays(PSP_FLASH, PSP_FLASH, false)
		TNT1 A 0 { return PB_PickRandomQuickMelee(); }
	
	ThrowShieldSaw:
		TNT1 A 1 { return PB_Execute(); }
		TNT1 A 0 {
			if (PB_QuickMeleeAimWithinPunchRange()) { return ResolveState("GoMeleePunchSetup"); }
			return state("");
		}
		TNT1 A 0 A_JumpIfCloser(128, "GoMeleePunchSetup")
		TNT1 A 0 A_JumpIfInventory("ShieldSawThrown", 1, "GoMeleePunchSetup")
		TNT1 A 0 A_JumpIfInventory("ShieldSawReady", 1, 1)
		Goto GoMeleePunchSetup
		TNT1 A 0 PB_UnsetPlayerExecutionProperties()
		TNT1 A 0 SetPlayerProperty(0,0,0)
		TNT1 A 0 SetPlayerProperty(0,0,PROP_TOTALLYFROZEN)
		TNT1 A 0 A_JumpIfInventory("PlayerIsDead",1,"FailOverlay")
		TNT1 A 0 A_JumpIfHealthLower(0, "FailOverlay")
		TNT1 A 0 {
			A_WeaponOffset(0, 32);
			A_SetRoll(0);
			A_ClearOverlays(1006, 1006, false);
			PB_StartShieldSawThrowAnim();
		}
		SHIE I 0 {
			A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
			A_ClearOverlays(3,65);
			if(CountInv("GrabbedBarrel") == 1 || CountInv("GrabbedIceBarrel") == 1 || CountInv("GrabbedBurningBarrel") == 1) {
				A_Overlay(PSP_WEAPON, "FlashBarrelKicking");
			}
			A_GiveInventory("HasCutingWeapon", 1);
			A_TakeInventory("Zoomed",1);
			A_ZoomFactor(1.0);
			A_TakeInventory("ADSmode",1);
			A_Setangle(angle - 1,SPF_INTERPOLATE);
			A_SetPitch(pitch + 1,SPF_INTERPOLATE);
			A_SetRoll(roll-2);
			A_StopSoundEx("Soundslot5");
		}
		SHIE J 1 A_WeaponOffset(20,74)
		SHIE K 1 A_WeaponOffset(50,74)
		SHIE J 1 A_WeaponOffset(70,74)
		SHIE K 1 A_WeaponOffset(100,74)
		SHIE J 2 A_WeaponOffset(140,96)
		SHIE K 2 A_WeaponOffset(160,118)
		SHIE K 0 A_PlaySoundEx("ShieldSawSwing","Soundslot6")
		SHIE K 0 A_AlertMonsters
		SHIE K 0 A_StartSound("ShieldSawThrow",1,1)
		TNT1 A 0 PB_FireShieldSawThrown()
		TNT1 A 0 PB_WeaponRecoil(-1.20,+0.20)
		TNT1 A 0 {
			A_TakeInventory("ShieldSaw_token",1);
			A_TakeInventory("ShieldSawReady",1);
			A_GiveInventory("CoolShieldSaw",1);
			A_GiveInventory("ShieldSawThrown",1);
			A_TakeInventory("HasCutingWeapon", 1);
			PB_EndShieldSawThrowAnim();
			A_ClearOverlays(1006, 1006, false);
			A_WeaponOffset(0,32);
			PB_UnsetPlayerExecutionProperties();
			SetPlayerProperty(0,0,0);
			SetPlayerProperty(0,0,PROP_TOTALLYFROZEN);
		}
		TNT1 A 0 {
			A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
			PB_RestoreWeaponMiniOverlays();
		}
		Goto ReturnFromShieldSawAnim

	ReturnFromShieldSawAnim:
		"####" "#" 0 { return PB_ReturnFromShieldSawToReady(); }
		Stop

	ShieldSawCatchAnim:
		TNT1 A 0 {
			A_WeaponOffset(0, 32);
			A_SetRoll(0);
			A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
			A_ClearOverlays(1006, 1006, false);
			PB_StartShieldSawThrowAnim();
			A_GiveInventory("HasCutingWeapon", 1);
		}
		SHIE K 2 A_WeaponOffset(160,118)
		SHIE J 2 A_WeaponOffset(140,96)
		SHIE K 1 A_WeaponOffset(100,74)
		SHIE J 1 A_WeaponOffset(70,74)
		SHIE K 1 A_WeaponOffset(50,74)
		SHIE J 1 A_WeaponOffset(20,74)
		SHIE I 0 {
			A_WeaponOffset(0,32);
			A_StartSound("ShieldSawBack", 5, CHANF_DEFAULT, 1.0, 1.5);
		}
		TNT1 A 0 {
			A_TakeInventory("HasCutingWeapon", 1);
			PB_EndShieldSawThrowAnim();
			A_ClearOverlays(1006, 1006, false);
			A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
		}
		TNT1 A 0 PB_RestoreWeaponMiniOverlays()
		Goto ReturnFromShieldSawAnim

    DoKick:
		TNT1 A 0 {
			A_Overlay(-10, "FirstPersonLegsKickRight");
			A_TakeInventory("Zoomed",1);
			A_TakeInventory("ADSmode",1);
			A_ZoomFactor(1.0);
			A_GiveInventory("Kicking",1);
			}
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("CanSlideKick", 1, "SlideKick")
		TNT1 A 0 A_JumpIf (velZ != 0, "AirKick")
		TNT1 A 0 A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED, true)
		KIC1 A 1 {
			A_PlaySoundEx("KICK", "Auto");
			SetPlayerProperty(0,1,0);
			PB_KickOverlayWeaponFlash(0);
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll-2);
			A_ZoomFactor(0.98);
			}
		KIC1 B 1 {
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll-2);
			A_ZoomFactor(0.970);
			}
		KIC1 C 1 {
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll-2);
			A_ZoomFactor(0.965);
		}
		KIC1 D 1 { 
			A_SetPitch(+1.25 + pitch, SPF_INTERPOLATE);
			A_ZoomFactor(0.950);
			}
        KIC1 E 1 A_Recoil(-1)
        KIC1 F 1 { //No more unneeded Super states here, this now unified into a single state with an if else statement.
			A_PB_KickClientsideEjecta(88, 7);
			if(CountInv("PowerStrength") == 1) {
				A_FireCustomMissile("SuperKickAttack", 0, 0, 0, -7);
			}
			else{
				A_FireCustomMissile("KickAttack", 0, 0, 0, -7);
			}
		}
        KIC1 GG 1 
		KIC1 I 1 {
			A_ZoomFactor(0.965);
			A_SetAngle(+1 + angle, SPF_INTERPOLATE);
			A_TakeInventory("Kicking",1);
			}
		KIC1 H 1 {
			A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
			A_SetAngle(+1 + angle, SPF_INTERPOLATE);
			A_SetRoll(roll+2);
			A_ZoomFactor(0.970);
		}
		KIC1 J 1 {
			A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll+2);
			A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
			A_ZoomFactor(0.98);
			}
		KIC1 K 1 {
			A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll+2);
			A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
			A_ZoomFactor(0.99);
		}
		KIC1 L 1 {
			A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
			A_ZoomFactor(1.0);
			}
		KIC1 A 1 {
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(-1.25 + pitch, SPF_INTERPOLATE);
			SetPlayerProperty(0,0,0);
			SetPlayerProperty(0,0,PROP_TOTALLYFROZEN);
			PB_SetUsingKick(false);
		}
		TNT1 A 0 {
			A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED, false);
			A_Overlay(-10, "FirstPersonLegsStand");
			PB_KickRestoreWeaponLayer();
		}
		Stop
	
	FailOverlay:
		TNT1 A 0 A_JumpIf(Health > 0, 2)
		TNT1 A 1 {
			PB_SetUsingKick(false);
			PB_SetUsingMelee(false);
			PB_SetUsingEquipment(false);
			PB_SetExecutingEnemy(false);
			}
		Loop
	StopFail:
		TNT1 A 0
		TNT1 A 1
		Stop
		
	SlideKick:
		TNT1 A 0 {
			A_GiveInventory("KeepLaserDeactivated",1);
			A_GiveInventory("IsSlideKicking", 1);
			PB_KickOverlayWeaponFlash(2);
			A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED, true);
			}
		SLDK A 1 A_ZoomFactor(0.90)
		SLDK B 1 A_ZoomFactor(0.85)
		SLDK C 1 A_ZoomFactor(0.80)
		SLDK D 1 A_ZoomFactor(0.75)
		SLDK EF 1
		TNT1 A 0 A_JumpIf(Height > 54, "LowerKick")
		TNT1 A 0 A_JumpIfInventory("KickHasHitAnObject", 1, "LowerKick")
		SLDK GHIJKLMNMLKJ 1 {
			if(CountInv("PowerStrength") == 1) {
				A_FireCustomMissile("SuperKickAttack", 0, 0, 0, -31);
			}
			else{
				A_FireCustomMissile("KickAttack", 0, 0, 0, -31);
			}
			if (CountInv("KickHasHitAnObject") == 1) { return state("LowerKick"); }
			if (Height > 50) { return state("LowerKick"); }
			return state("");
		}
	LowerKick:
		TNT1 A 0 {
			PB_KickOverlayWeaponFlash(3);
			A_ZoomFactor(1.0);
			A_PlaySoundEx("SlideKick/End", "Auto");
			A_Takeinventory("Kicking",1);
			A_Takeinventory("KickHasHitAnObject",1);
			A_TakeInventory("IsSlideKicking", 1);
			A_Takeinventory("PB_LockScreenTilt",1);
			PB_SetUsingKick(false);
			A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED, true);
		}
		SLDK OPQRSTU 1
		TNT1 A 0 {
			A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED, false);
			A_Overlay(-10, "FirstPersonLegsStand");
			PB_KickRestoreWeaponLayer();
		}
		Stop
	AirKick:
		TNT1 A 0 {
			A_PlaySound("KICK", 6);
			A_PB_AirMeleeLunge(20);
			A_Recoil (-6);
			PB_KickOverlayWeaponFlash(1);
			A_ZoomFactor(0.95);
			A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED, true);
		}
		AKCK A 1 A_SetRoll(roll-2, SPF_INTERPOLATE)
		AKCK B 1 A_SetRoll(roll-2, SPF_INTERPOLATE)
		AKCK C 1 A_SetRoll(roll-2, SPF_INTERPOLATE)
		AKCK DEFGH 1
        RIFF A 0 {
			if(CountInv("PowerStrength") == 1) {
				A_FireCustomMissile("SuperAirKickAttack", 0, 0, 0, -31);
			}
			else{
			A_FireCustomMissile("AirKickAttack", 0, 0, 0, -31);
			}
		}
		TNT1 A 0 A_ZoomFactor(0.975)
        AKCK IJK 1
		TNT1 A 0 A_ZoomFactor(0.995)
		TNT1 A 0 A_TakeInventory("Kicking",1)
		AKCK LM 1
		AKCK N 1 A_SetRoll(roll+2, SPF_INTERPOLATE)
		AKCK O 1 A_SetRoll(roll+2, SPF_INTERPOLATE)
		TNT1 A 1 A_SetRoll(roll+2, SPF_INTERPOLATE)
		TNT1 A 0 {
			A_ZoomFactor(1.0);
			A_Takeinventory("PB_LockScreenTilt",1);
			A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED, false);
			PB_SetUsingKick(false);
			A_Overlay(-10, "FirstPersonLegsStand");
			PB_KickRestoreWeaponLayer();
		}
		Stop
		
	GrabEnemy:	
	    TNT1 A 0
		TNT1 A 0 A_ClearOverlays(3,65)
	    TNT1 A 0 A_PlaySound("weapons/fistwhoosh")
        PKUP ABCDEF 1
		TNT1 AAAAAAAAAAAAAAAAAAA 0 A_Lower
		Wait
	// Legacy entry; Staging hold path keeps Grabbed* on the current weapon.
	// Never strip tokens or select BarrelThrower from here.
	GrabBarrel:
		TNT1 A 0 A_JumpIfInventory("HasBarrel", 1, "ReadyBarrel")
		TNT1 A 0 A_JumpIfInventory("HasBurningBarrel", 1, "ReadyFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("HasIceBarrel", 1, "ReadyIceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		Goto GoingToReady
		
	Steady:
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("GoFatality",1,"Steady")
		TNT1 A 0 { PB_UnsetPlayerExecutionProperties(); }
		Goto GoingToReady
	
	// This portion of the class will expand as we add executions
	// ZScript Functions (currently in BaseWeapon.zc) will handle to execution logic and set the according state)
	


	}
}

Actor PB_DualWeapon : PB_Weapon
{
States
	{
	 ThrowMine:
	 ThrowGrenade:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_TakeInventory("ADSMode", 1)
		TNT1 A 0 A_TakeInventory("DoGrenade", 1)
		TNT1 A 0 A_TakeInventory("DoMine", 1)
		TNT1 A 0
		TNT1 A 0 A_Print("\ckYou can't \ctthrow \c-right now!")
		Goto GoingToReady
	}
}


ACTOR MagTG
{
	Projectile
	+BLOODLESSIMPACT
	+NOBLOCKMAP
	+DOOMBOUNCE
	+USEBOUNCESTATE
	+MOVEWITHSECTOR
	+NOTRIGGER
	+BOUNCEONWALLS
	+BOUNCEONACTORS
renderstyle Normal
}

Actor ECS
{
  Scale 0.1
    States
  {
  Spawn:
  TNT1 A 0
  Stop
  Disappear:
  TNT1 A 0
  Stop
  }
}
