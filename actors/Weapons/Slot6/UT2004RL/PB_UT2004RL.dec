// UT2004 Triple Rocket Launcher — Flammable4444 (UT2004RocketLauncher_V1.wad).
// PB fold: PB_Weapon slot 6, magazine UT2004Rounds (3), fires PB_Rocket.

Actor UT2004Rounds : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 3
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 3
	+IGNORESKILL
}

ACTOR PB_UT2004RL : PB_Weapon
{
	Game Doom
	Tag "UT2004 Triple Rocket Launcher"
	Weapon.SelectionOrder 1650
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 6
	Weapon.AmmoGive2 3
	Weapon.AmmoType1 "RocketAmmo"
	Weapon.AmmoType2 "UT2004Rounds"
	Weapon.SlotNumber 6
	Weapon.SlotPriority 0.15
	+WEAPON.NOAUTOAIM
	+WEAPON.NOALERT
	+WEAPON.NOAUTOFIRE
	Inventory.PickupSound "misc/rockboxa"
	Inventory.PickupMessage "$PB_PICKUP_PB_UT2004RL"
	Inventory.Icon "UTRLA0"
	Inventory.AltHUDIcon "UTRLA0"
	Scale 0.25
	States
	{
	Spawn:
		UTRL A -1
		Stop

	Ready:
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_PlaySound("RLANDRAW")
		UNRS ABCD 1
	Ready3:
		TNT1 A 0 PB_HandleCrosshair(78)
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 1, 2)
		UNRG H 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		Goto Ready3
		UNRG A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		Goto Ready3

	Deselect:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_TakeInventory("HasUnloaded", 1)
		UNRG H 1 A_Lower
		Wait

	Select:
		TNT1 A 0 A_TakeInventory("HasBarrel", 1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel", 1)
		TNT1 A 0 A_TakeInventory("HasBurningBarrel", 1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel", 1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel", 1)
		TNT1 A 0 A_TakeInventory("GrabbedBurningBarrel", 1)
		TNT1 A 0 A_GiveInventory("RocketLauncherSelected", 1)
		TNT1 A 0 A_TakeInventory("ShotgunSelected", 1)
		Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_Raise
		Wait

	Fire:
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "ThrowBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "ThrowFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "ThrowIceBarrel")
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 1, 2)
		Goto Reload
		TNT1 AAAA 0
		TNT1 A 0 A_FireCustomMissile("RedFlareSpawn", -5, 0, 0, 0)
		TNT1 A 0 A_PlaySound("DSRFIRE")
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 BRIGHT A_FireCustomMissile("Alerter")
		UNRF A 1 BRIGHT A_FireCustomMissile("PB_Rocket", 0, 0, 0, -5)
		TNT1 A 0 A_TakeInventory("UT2004Rounds", 1)
		TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
		UNRF BCD 1 BRIGHT
		Goto FireRecovery

	FireRecovery:
		UNRH B 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH C 1
		UNRH D 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH E 1
		UNRG A 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRG A 1
		TNT1 A 0 A_Refire
		Goto Ready3

	AltFire:
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 3, "TripleFire")
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 2, "DoubleFire")
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 1, "Fire")
		Goto Reload

	TripleFire:
		TNT1 A 0 A_FireCustomMissile("RedFlareSpawn", -5, 0, 0, 0)
		TNT1 AAA 0 A_PlaySound("DSRFIRE")
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("Alerter")
		UNRT A 1 BRIGHT
		UNRT A 0 A_FireCustomMissile("PB_Rocket", 0, 0, 0, 0)
		UNRT A 0 A_FireCustomMissile("PB_Rocket", 0, 0, 5, -5)
		UNRT A 0 A_FireCustomMissile("PB_Rocket", 0, 0, -5, -5)
		TNT1 A 0 A_TakeInventory("UT2004Rounds", 3)
		TNT1 AAA 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
		UNRT BCD 1 BRIGHT
		UNRH B 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH C 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH D 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH E 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRG A 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRG A 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		Goto Ready3

	DoubleFire:
		TNT1 A 0 A_FireCustomMissile("RedFlareSpawn", -5, 0, 0, 0)
		TNT1 AAA 0 A_PlaySound("DSRFIRE")
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("Alerter")
		UNRD A 1 BRIGHT
		UNRD A 0 A_FireCustomMissile("PB_Rocket", 0, 0, 0, 0)
		UNRD A 0 A_FireCustomMissile("PB_Rocket", 0, 0, 5, -5)
		TNT1 A 0 A_TakeInventory("UT2004Rounds", 2)
		TNT1 AAA 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
		UNRD BCD 1 BRIGHT
		UNRH B 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH C 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH D 1
		UNRH E 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRG A 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		TNT1 A 0 A_Refire
		Goto Ready3

	WeaponSpecial:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_TakeInventory("GoWeaponSpecialAbility", 1)
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 2, "SpecialShot")
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 1, "Fire")
		Goto Reload

	SpecialShot:
		TNT1 A 0 A_FireCustomMissile("RedFlareSpawn", -5, 0, 0, 0)
		TNT1 AAA 0 A_PlaySound("DSRFIRE")
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("Alerter")
		UNRE A 1 BRIGHT
		UNRE A 0 A_FireCustomMissile("PB_Rocket", 0, 0, 5, -5)
		UNRE A 0 A_FireCustomMissile("PB_Rocket", 0, 0, -5, -5)
		TNT1 A 0 A_TakeInventory("UT2004Rounds", 2)
		TNT1 AAA 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
		UNRE BCD 1 BRIGHT
		UNRH B 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH C 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRH D 1
		UNRH E 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		UNRG A 1 A_FireCustomMissile("SmokeSpawner", 0, 0, 0, 5)
		TNT1 A 0 A_Refire
		Goto Ready3

	Unload:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_TakeInventory("Unloading", 1)
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 1, 2)
		Goto Ready3
		TNT1 A 0
		UNRR ABCDE 2
		UNRR M 3 A_PlaySound("weapons/ut2004rl/load")
		UNRR NLE 3
		UNRR M 3 A_PlaySound("weapons/ut2004rl/load")
		UNRR NLE 3
		UNRR M 3 A_PlaySound("weapons/ut2004rl/load")
		UNRR NLE 4
		UNRR EDCBA 2
	UnloadLoop:
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 1, 2)
		Goto Ready3
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("UT2004Rounds", 1)
		TNT1 A 0 A_GiveInventory("RocketAmmo", 1)
		Goto UnloadLoop

	Reload:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_TakeInventory("Reloading", 1)
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 3, "Ready3")
		TNT1 A 0 A_JumpIfInventory("RocketAmmo", 1, "ReloadStart")
		Goto NoAmmo
	ReloadStart:
		UNRR AABBCCDDEEEEEEEE 1
		Goto InsertRound
	InsertRound:
		TNT1 A 0 A_JumpIfInventory("UT2004Rounds", 3, "ReloadFinish")
		TNT1 A 0 A_JumpIfInventory("RocketAmmo", 1, 2)
		Goto ReloadFinish
		TNT1 A 0
		UNRR FGHII 1
		TNT1 A 0 A_PlaySound("weapons/ut2004rl/load2")
		UNRR JK 2
		TNT1 A 0 A_GiveInventory("UT2004Rounds", 1)
		TNT1 A 0 A_TakeInventory("RocketAmmo", 1)
		UNRR E 1
		UNRR L 2 A_PlaySound("weapons/ut2004rl/load")
		UNRR NME 2
		UNRR EEEEEE 1
		Goto InsertRound
	ReloadFinish:
		UNRR EEEEEEEE 1
		UNRR DDCCBBAA 1
		TNT1 A 0 A_PlaySound("BEPBEP")
		Goto Ready3

	NoAmmo:
		TNT1 A 0 A_PlaySound("weapons/ut2004rl/empty")
		UNRG HHHAHHHA 1
		Goto Ready3

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		UNRG AAAA 1
		Goto Ready3
	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		UNRG AAAA 1
		Goto Ready3
	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		UNRG AAAA 1
		Goto Ready3
	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelSlideKickingStop")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKickingStop")
		UNRG AA 1
		Goto Ready3
	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		UNRG AAAA 1
		Goto Ready3
	}
}
