// Random Quick Melee strike projectiles (fist / saw CustomMelee ports)

ACTOR QM_BackhandStrike : KickAttack
{
	DamageType Kick
	Damage (random(48,58))
	Speed 35
	ProjectileKickBack 280
	-NOEXTREMEDEATH
	States
	{
	Spawn:
		TNT1 A 1 BRIGHT
		TNT1 A 1
		Stop
	Death:
	XDeath:
		TNT1 A 0 A_PlaySound("player/cyborg/fist", 3)
		TNT1 A 0 A_SpawnItemEx("PLOFT2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		EXPL AAAAAA 0 A_CustomMissile("MeleeSmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_GiveToTarget("KickHasHit", 1)
		TNT1 A 0 Radius_Quake(3, 8, 0, 6, 0)
		TNT1 A 10
		Stop
	}
}

ACTOR QM_UppercutStrike : MeleeStrike1
{
	Damage 90
	DamageType Decapitate
	Speed 28
	Height 12
	-NOEXTREMEDEATH
	+BLOODSPLATTER
	States
	{
	Spawn:
		TNT1 A 1 BRIGHT
		TNT1 A 1
		Stop
	Death:
	XDeath:
		TNT1 A 0 A_PlaySound("player/cyborg/fist", 3)
		TNT1 A 0 A_SpawnItemEx("PLOFT2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		EXPL AAAAAA 0 A_CustomMissile("MeleeSmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 Radius_Quake(3, 8, 0, 6, 0)
		TNT1 A 10
		Stop
	}
}

ACTOR QM_SawSwing : FastProjectile
{
	Radius 6
	Height 6
	DamageType Cut
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+NODAMAGETHRUST
	+FORCEPAIN
	-NOEXTREMEDEATH
	Damage 110
	Speed 40
	Decal "SawDecalNew1"
	Obituary "%o was carved up by %k"
	SeeSound "none"
	DeathSound "none"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 1
		Stop
	XDeath:
		TNT1 A 0 A_PlaySound("Machete/Yum", 3)
		TNT1 A 0 Radius_Quake(3, 8, 0, 8, 0)
		TNT1 A 1
		Stop
	Death:
	Crash:
		TNT1 A 0 A_SpawnItemEx("SSawPuff3",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 Radius_Quake(2, 6, 0, 5, 0)
		TNT1 A 1
		Stop
	}
}
