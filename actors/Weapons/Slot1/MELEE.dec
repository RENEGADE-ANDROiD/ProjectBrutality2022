		TNT1 A 1 {
				if (PB_FistSlamChordHeld()) { return state("FistSlam"); }
				return state("");
			}
		TNT1 A 0 {
				if (PB_FistSlamChordHeld()) { return state("FistSlam"); }
				if ((CountInv("PSeq2") >= 1 || CountInv("PSeq3") >= 1) && random(1, 256) <= 128) { return state("FistSlam"); }
				if (CountInv("PSeq4") >= 1 ) { return state("RightBackHand"); }
				if (CountInv("PSeq3") >= 1 ) { return state("RightHook"); }
				if (CountInv("PSeq2") >= 1 ) { return state("FistSlam"); }
				if (CountInv("PSeq1") >= 2 ) { return state("RightHook"); }
				return state("");
			}
		
		
