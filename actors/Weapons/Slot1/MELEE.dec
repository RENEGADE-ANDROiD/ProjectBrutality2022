		KIC6 F 1 A_FireCustomMissile("SuperKickAttack", 10, 0, 0, -8)
		KIC6 G 1 A_FireCustomMissile("SuperKickAttack", 0, 0, 0, -2)
		KIC6 H 1 A_FireCustomMissile("SuperKickAttack", -10, 0, 0, -8)
		TNT1 A 0
