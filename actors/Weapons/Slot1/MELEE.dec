	// Abyssal Crown BloodBonk FPS (BONK A-V) — Fire+Alt / combo ground slam
	FistSlam:
		TNT1 A 0 A_GiveInventory("Punching",1)
		TNT1 A 0 A_TakeInventory("PSeq1",3)
		TNT1 A 0 A_TakeInventory("PSeq2",3)
		TNT1 A 0 A_TakeInventory("PSeq3",3)
		TNT1 A 0 A_TakeInventory("PSeq4",3)
		TNT1 A 0 A_OverlayFlags(1,PSPF_PLAYERTRANSLATED, false)
		TNT1 A 0 A_OverlayFlags(PSP_WEAPON,PSPF_PLAYERTRANSLATED, false)
		TNT1 A 0 A_WeaponOffset(0, 32)
		BONK A 1
		BONK B 1
		BONK C 1
		BONK D 1 A_Recoil(-2)
		BONK E 1
		TNT1 A 0 A_PlaySound("Melee/SwingStrong", 5)
		BONK F 1
		BONK G 1
		BONK H 1
		TNT1 A 0 A_ZoomFactor(0.96)
		TNT1 A 0 A_PlaySound("weapons/fists_smash", 5)
		TNT1 A 0 A_PlaySound("weapons/bloodbonk/boom", 6)
		TNT1 A 0 {
			if (CountInv("PowerStrength") >= 1 )
			{
				if (CountInv("NoFatality") >= 1 ) { A_FireCustomMissile("MeleeStrike2Smash", 0, 0, 0, 0); }
				else { A_FireCustomMissile("MeleeStrike1Fatality", 0, 0, 0, 0); }
			}
			else { A_FireCustomMissile("MeleeStrike1Smash", 0, 0, 0, 0); }
			A_FireCustomMissile("ShakeYourAss", 0, 0, 0, 0);
		}
		TNT1 A 0 Radius_Quake(3, 12, 0, 24, 0)
		TNT1 A 0 A_SpawnItemEx("PLOFT2", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 AAAAAA 0 A_SpawnItemEx("MeleeSmoke", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), random(0, 360))
		TNT1 AA 0 A_SpawnItemEx("SmallExplosionFlames", 48, 0, 0)
		BONK I 1
		BONK JJJ 1
		TNT1 A 0 A_ZoomFactor(1.0)
		BONK K 1
		BONK LL 1
		BONK M 1
		BONK N 1
		BONK O 1
		BONK P 1
		BONK QQ 1
		BONK R 1
		BONK S 1
		BONK T 1
		BONK U 1
		BONK V 1
		TNT1 A 0 PB_ResetFistWeaponPresentation()
		Goto ReadyFists
		
