		TNT1 A 0 A_JumpIfInventory("GrabbedACommando",1,"ShieldCommando")
		TNT1 A 0 A_JumpIfInventory("GrabbedAPlasmaZombie",1,"ShieldPlasmaZombie")
		TNT1 A 0 A_JumpIfInventory("GrabbedAPB_NailgunGuy",1,"ShieldNailgunGuy")
		TNT1 A 0 A_JumpIfInventory("GrabbedAZombieScientist",1,"ShieldZombieScientist")
		TNT1 A 0 A_JumpIfInventory("GrabbedASavageImp",1,"ShieldSavageImp")
