// Brutal Doom Plus–style berserk live meatshield grab (tokens + probe).
// Carry / throw / weaponize states live on Melee_Attacks in MELEE.dec.

Actor PressedLiveMeatGrab : Inventory { Inventory.MaxAmount 1 }

Actor GrabbedAZombieman : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedAShotgunguy : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedAImp : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedADarkImp : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedAASGguy : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedACarbineZombie : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedACommando : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedAPlasmaZombie : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedAPB_NailgunGuy : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedAZombieScientist : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedASavageImp : Inventory { Inventory.MaxAmount 1 }
Actor GrabbedATriclopsImp : Inventory { Inventory.MaxAmount 1 }

// DECORATE-safe clear (weapon states cannot call PB_LiveMeatGrab.ClearGrabbed).
ACTOR ClearLiveMeatGrabTokens : CustomInventory
{
	Inventory.Amount 1
	Inventory.MaxAmount 0
	+INVENTORY.ALWAYSPICKUP
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("GrabbedAZombieman", 1)
		TNT1 A 0 A_TakeInventory("GrabbedAShotgunguy", 1)
		TNT1 A 0 A_TakeInventory("GrabbedAImp", 1)
		TNT1 A 0 A_TakeInventory("GrabbedADarkImp", 1)
		TNT1 A 0 A_TakeInventory("GrabbedAASGguy", 1)
		TNT1 A 0 A_TakeInventory("GrabbedACarbineZombie", 1)
		TNT1 A 0 A_TakeInventory("GrabbedACommando", 1)
		TNT1 A 0 A_TakeInventory("GrabbedAPlasmaZombie", 1)
		TNT1 A 0 A_TakeInventory("GrabbedAPB_NailgunGuy", 1)
		TNT1 A 0 A_TakeInventory("GrabbedAZombieScientist", 1)
		TNT1 A 0 A_TakeInventory("GrabbedASavageImp", 1)
		TNT1 A 0 A_TakeInventory("GrabbedATriclopsImp", 1)
		Stop
	}
}

ACTOR BerserkGrabAttack : KickAttack
{
	Damage (random(2, 3))
	DamageType MeatGrab
	+NOPAIN
	+THRUGHOST
	+GHOST
	Speed 90
	Radius 16
	Height 16
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 1
		Stop
	Death:
	Crash:
	XDeath:
		TNT1 A 1
		Stop
	}
}
