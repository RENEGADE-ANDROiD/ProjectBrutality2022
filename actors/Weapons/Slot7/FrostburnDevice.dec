// Pro-Surv Frostburn Device  folded from Project Survival.
// Shared Unmaker sprite prefixes remapped: UNHD/UNHF/UNHG/UNHL/UNHS -> FBHD/FBHF/FBHG/FBHL/FBHS
// so PB Unmaker art is not overwritten. Ammo: HellAmmo (DemonTech). Slot 7.
Actor RespectFrostburnDevice: Inventory { Inventory.MaxAmount 1 }
Actor FrostburnDeviceIsEmpty: Inventory { Inventory.MaxAmount 1 }
Actor FrostburnDeviceHasUnloaded: Inventory { Inventory.MaxAmount 1 }
Actor FrostburnDeviceSelected: Inventory { Inventory.MaxAmount 1 }
ACTOR FrostburnModeIncendiary : Inventory { Inventory.MaxAmount 1 }
ACTOR FrostburnModeCryo : Inventory { Inventory.MaxAmount 1 }
ACTOR Select_Frostburn_Incendiary : Inventory { Inventory.MaxAmount 1 }
ACTOR Select_Frostburn_Cryo : Inventory { Inventory.MaxAmount 1 }

ACTOR FrostburnDevice : PB_Weapon
{
	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.4
	Weapon.SelectionOrder 1300
	Weapon.SlotNumber 7
	Weapon.SlotPriority 0.12
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive 40
	+FLOORCLIP
	+DONTGIB
	Scale 0.4
	Weapon.AmmoType "HellAmmo"
	Inventory.PickupMessage "$PB_PICKUP_FrostburnDevice"
	Inventory.PickupSound "misc/rockboxa"
	Inventory.Icon "FBHDA0"
	Inventory.AltHUDIcon "FBHDA0"
	Inventory.Amount 1
	Inventory.MaxAmount 3
	Obituary "%k Zapped %o with a Frostburn Device"
	AttackSound "None"
	Tag "$PB_TAG_FrostburnDevice"
	+WEAPON.EXPLOSIVE
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	PB_WeaponBase.UnloaderToken "FrostburnDeviceHasUnloaded"
	PB_WeaponBase.RespectItem "RespectFrostburnDevice"
	States
	{
		Steady:
			Goto PB_FinisherCleanup

		Ready:
			TNT1 A 0 {	
				A_Takeinventory("Unloading",1);
				A_ZoomFactor(1.0);
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
			}
			TNT1 A 0 A_JumpIfInventory("RespectFrostburnDevice", 1, "SelectAnimation")
		Respect:
			"####" "#" 0 A_GiveInventory("RespectFrostburnDevice")
			TNT1 A 0 {
				A_SetCrosshair(5);
				A_Giveinventory("PB_LockScreenTilt",1);
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
				A_PlaySoundEx("weapons/sgl/inspect1","Auto");
			}
			TNT1 A 2
			UNHZ DCBA 1 
			UNHH O 0
			TNT1 A 0 A_ClearOverlays(5,9)
			TNT1 A 0 A_Playsound("UNMSWTC")
			TNT1 A 0 A_GiveInventory("FrostburnModeIncendiary",1)
			TNT1 A 0 A_TakeInventory("FrostburnModeCryo",1)
			FBHS FGHI 2 BRIGHT
			TNT1 A 0 A_Playsound("UNOCFIR2")
			TNT1 AAAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(1,3))
			TNT1 A 0 A_FireCustomMissile("MancubusSwitchModeEffect", 0, 0, 0, random(1,3))
			TNT1 AAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-5,5), 0, random(-3,3),random(1,3))
			FBHS JKLM 2 BRIGHT
			Goto Ready3
			
		SelectAnimation:
			TNT1 A 0 A_Playsound("UNMUP")
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SelectEmpty")
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary", 1, "SelectIncendiary")
			TNT1 A 0 A_JumpIfInventory("FrostburnModeCryo", 1, "SelectCryo")
		SelectEmpty:
			TNT1 A 2
			UNHZ DCBA 1 
			UNHH O 0
			Goto Ready3
		SelectIncendiary:
			TNT1 A 2
			UNOL PONM 1 
			UNOG A 1
			Goto Ready3
		SelectCryo:
			TNT1 A 2
			FBHS QPON 1
			FBHG A 1
			Goto Ready3

		Ready3:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "ReadyEmpty")
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary",1, "Ready3Incendiary")
			TNT1 A 0 {
			A_SetCrosshair(92);
			A_Overlay(7,"IdleScreen");
			A_Overlay(5,"CoreIdle");
			}
		ReadyCryo:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "ReadyEmpty")
			TNT1 A 0 A_TakeInventory("FrostburnModeIncendiary",1)
			TNT1 A 0 A_GiveInventory("FrostburnModeCryo",1)
			TNT1 A 0 A_StartSound("UNMIDL", 6, CHANF_LOOPING)
			FBHG AABCDEFGHIJKLLMMMNNNNNMMLKJIHGFEDCBARQPPOOOOOPPQQR 2 A_DoPBWeaponAction
			Goto ReadyCryo
		
		Ready3Incendiary:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "ReadyEmpty")
			TNT1 A 0 {
			A_ClearOverlays(5);
			A_Overlay(7,"InfernoScreen");
			}
		ReadyIncendiary:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "ReadyEmpty")
			TNT1 A 0 A_GiveInventory("FrostburnModeIncendiary",1)
			TNT1 A 0 A_TakeInventory("FrostburnModeCryo",1)
			TNT1 A 0 A_PlaySound("UNOCIDL", 6,1,1)
			TNT1 A 0 A_ClearOverlays(5)
			UNOG ABCDEFGHIJ 2 A_DoPBWeaponAction
			TNT1 A 0 A_ClearOverlays(5)
			UNOG KLMNOPQRST 2 A_DoPBWeaponAction
			Goto ReadyIncendiary
			
		ReadyEmpty:
			TNT1 A 0 A_JumpIfInventory("HellAmmo", 1, "Reactivate")
			TNT1 A 0 A_StopSOund(1)
			TNT1 A 0 A_StopSOund(6)
			TNT1 A 0 A_ClearOverlays(5,9)
			UNHH O 1 A_DoPBWeaponAction
			Goto ReadyEmpty
			
		Reactivate:
			UNHH ONMLK 1
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary",1, "SwitchToIncendiary")
			Goto SwitchToCryo
			
		WeaponSpecial:
			TNT1 A 0 {
				A_Takeinventory("GoWeaponSpecialAbility",1);
				A_GiveInventory("PB_LockScreenTilt",1);
				A_SetCrosshair(5);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("Select_Frostburn_Incendiary", 1, "WheelToIncendiary")
			TNT1 A 0 A_JumpIfInventory("Select_Frostburn_Cryo", 1, "WheelToCryo")
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary",1, "SwitchToCryo")
			TNT1 A 0 A_JumpIfInventory("FrostburnModeCryo",1, "SwitchToIncendiary")
			Goto Ready3
		WheelToIncendiary:
			TNT1 A 0 A_TakeInventory("Select_Frostburn_Incendiary", 1)
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary", 1, "Ready3")
			Goto SwitchToIncendiary
		WheelToCryo:
			TNT1 A 0 A_TakeInventory("Select_Frostburn_Cryo", 1)
			TNT1 A 0 A_JumpIfInventory("FrostburnModeCryo", 1, "Ready3")
			Goto SwitchToCryo
			
		SwitchToEmpty:
			TNT1 A 0 A_StopSOund(1)
			TNT1 A 0 A_StopSOund(6)
			TNT1 A 0 A_ClearOverlays(5,9)
			UNHH KLMNO 1
			Goto Ready3
			
		SwitchToIncendiary:
			TNT1 A 0 A_ClearOverlays(5,9)
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
			TNT1 A 0 A_Playsound("UNMSWTC")
			TNT1 A 0 A_Print("Firemode: Incendiary")
			TNT1 A 0 A_GiveInventory("FrostburnModeIncendiary",1)
			TNT1 A 0 A_TakeInventory("FrostburnModeCryo",1)
			FBHS FGHI 2 BRIGHT
			TNT1 A 0 A_SetBlend("Orange",0.3,12)
			TNT1 A 0 A_Playsound("UNOCFIR2")
			TNT1 AAAAA 0 A_FireCustomMissile("GunFireSmoke", random(-5,5), 0, random(-3,3),random(1,3))
			TNT1 A 0 A_FireCustomMissile("MancubusSwitchModeEffect", 0, 0, 0, random(1,3))
			TNT1 AAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-5,5), 0, random(-3,3),random(1,3))
			FBHS JKLM 2 BRIGHT 
			Goto Ready3
			
		SwitchToCryo:
			TNT1 A 0 A_ClearOverlays(5,9)
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
			TNT1 A 0 A_ClearOverlays(5,9)
			TNT1 A 0 A_Print("Firemode: Cryo")
			TNT1 A 0 A_TakeInventory("FrostburnModeIncendiary",1)
			TNT1 A 0 A_GiveInventory("FrostburnModeCryo",1)
			FBHS MLKJ 2 BRIGHT
			TNT1 A 0 A_SetBlend("LightBlue",0.3,12)
			TNT1 A 0 A_Overlay(6,"RespectLightning")
			TNT1 A 0 A_FireCustomMissile("FrostburnDeviceSwitchModeEffect", 0, 0, 0, random(1,3))
			TNT1 A 0 A_Playsound("UNMSWT2",3)
			FBHS IHGF 2 BRIGHT //A_ClearOverlays(9)
			Goto Ready3
		
		Deselect:
			TNT1 A 0 A_ClearOverlays
			TNT1 A 0 A_StopSOund(1)
			TNT1 A 0 A_StopSOund(6)
			TNT1 A 0 A_StopSOund(CHAN_AUTO)
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "DeselectEmpty")
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary", 1, "DeselectIncendiary")
			TNT1 A 0 A_JumpIfInventory("FrostburnModeCryo", 1, "DeselectCryo")
		DeselectEmpty:
			UNHH O 0
			UNHZ ABCD 1 
			TNT1 A 2
			Goto FinishDeselect
		DeselectIncendiary:
			UNOG A 1
			UNOL MNOP 1 
			TNT1 A 2
			Goto FinishDeselect
		DeselectCryo:
			FBHG A 1
			FBHS NOPQ 1
			TNT1 A 2
			Goto FinishDeselect
		FinishDeselect:
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
			Wait

		Select:
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(92);
				A_WeaponOffset(0,32);
				A_TakeInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_Takeinventory("Unloading",1)
			TNT1 A 0 A_TakeInventory("HasBarrel",1)
			TNT1 A 0 A_TakeInventory("HasIceBarrel",1)
			TNT1 A 0 A_TakeInventory("HasBurningBarrel",1)
			TNT1 A 0 A_TakeInventory("GrabbedBarrel",1)
			TNT1 A 0 A_TakeInventory("GrabbedIceBarrel",1)
			TNT1 A 0 A_TakeInventory("GrabbedBurningBarrel",1)
			Goto SelectFirstPersonLegs
		SelectContinue:
			TNT1 A 0 A_GiveInventory("FrostburnDeviceSelected",1)
			TNT1 A 0 A_JumpIfInventory("RespectFrostburnDevice", 1, "SelectAnimation")
			Goto Respect
		
		Fire:
			TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "ThrowBarrel")
			TNT1 A 0 A_JumpIfInventory ("GrabbedBurningBarrel", 1, "ThrowFlameBarrel")
			TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "ThrowIceBarrel")
			TNT1 A 0 A_ClearOverlays(5,7)
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary", 1, "FireIncendiary")
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
			TNT1 A 0 A_Takeinventory("HitboxFireDamage",1)
			TNT1 A 0 A_Giveinventory("HitboxIceDamage",1)
		Hold:	
			TNT1 A 0 A_ClearOverlays(5,7)
			TNT1 A 0 A_JumpIfInventory("FrostburnModeIncendiary", 1, "FireIncendiary")
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
			FBHF ABCD 1
			TNT1 A 0 A_PlaySOund("UNMCHG", 1)
			TNT1 A 0 A_PlaySOund("UNMSTA", 3)
			FBHF EFGHHIJJKLLMNNOPPQRR 1 BRIGHT
		Fire1:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR A 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_Overlay(6,"FiringLightning");
			A_OverlayFlags(6,PSPF_FLIP|PSPF_MIRROR,random(false,true));
			A_OverlayOffset(6,frandom(-2,2),frandom(-4,3));
			A_OverlayPivotAlign(6,PSPA_CENTER,PSPA_CENTER);
			A_OverlayRotate(6,frandom(-20,20));
			A_PlaySOund("UNMLOP", 6, 1, 1);
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0); 
			A_TakeInventory("HellAmmo", 1);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire2")
			Goto StopPrimaryCryo
		Fire2:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR B 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire3")
			Goto StopPrimaryCryo
		Fire3:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR C 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			A_TakeInventory("HellAmmo", 1);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire4")
			Goto StopPrimaryCryo
		Fire4:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR D 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire5")
			Goto StopPrimaryCryo
		Fire5:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR E 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			A_TakeInventory("HellAmmo", 1);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire6")
			Goto StopPrimaryCryo
		Fire6:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR F 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_Overlay(-2,"FiringLightning");
			A_OverlayFlags(-2,PSPF_FLIP|PSPF_MIRROR,random(false,true));
			A_OverlayOffset(-2,frandom(-5,5),frandom(-7,7));
			A_OverlayPivotAlign(-2,PSPA_CENTER,PSPA_CENTER);
			A_OverlayRotate(-2,frandom(-20,20));
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire7")
			Goto StopPrimaryCryo
		Fire7:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR G 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			A_TakeInventory("HellAmmo", 1);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire8")
			Goto StopPrimaryCryo
		Fire8:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR H 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire9")
			Goto StopPrimaryCryo
		Fire9:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR I 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			A_TakeInventory("HellAmmo", 1);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire10")
			Goto StopPrimaryCryo
		Fire10:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "StopPrimaryCryo")
			UNHR J 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("Fire1")
		StopPrimaryCryo:
			TNT1 A 0
			TNT1 A 0 A_StopSOund(1)
			TNT1 A 0 A_StopSOund(6)
			UNHR B 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(-3,"MuzzleFlashNormal");
			A_FireCustomMissile("CryoLaser", 0, 0, 0, 0, 0, 0);
			A_TakeInventory("HellAmmo", 1);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_PlaySOund("weapons/freezer/powerdown", 3)
			FBHF DCBA 3 A_DoPBWeaponAction
			TNT1 A 0 A_ClearOverlays(5,7)
			TNT1 A 0 A_PlaySOund("UNMRLS", 1)
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
			Goto Ready3
			
		FireIncendiary:
			TNT1 A 0 A_ClearOverlays(5,7)
			TNT1 A 0 A_WeaponOffset(0,32)
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
			TNT1 A 0 A_Giveinventory("HitboxFireDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxDemonicDamage",1)
			UNOF JKLM 1
			TNT1 A 0 A_Overlay(-2,"InfernoCharge")
			TNT1 A 0 A_OverlayFlags(-2,PSPF_FLIP|PSPF_MIRROR,true)
			TNT1 A 0 A_PlaySOund("UNMCHG", 1)
			TNT1 A 0 A_PlaySOund("UNMSTA", 3)
			TNT1 A 0 A_Playsound("UNOCFIR",5)
			UNOF NOPQRRSTTUVVWWXXYZZ 1 BRIGHT
		HoldIncendiary:	
			TNT1 A 0 A_ClearOverlays(5,7)
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "SwitchToEmpty")
		FireIncendiary1:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "InfernoStopPrimary")
			UNOF A 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_Overlay(6,"InfernoLightning");
			A_OverlayFlags(6,PSPF_FLIP|PSPF_MIRROR,random(false,true));
			A_OverlayOffset(6,frandom(-2,2),frandom(-4,3));
			A_OverlayPivotAlign(6,PSPA_CENTER,PSPA_CENTER);
			A_OverlayRotate(6,frandom(-20,20));
			A_PlaySOund("UNMLOP", 1, 1, 1);
			A_Overlay(-3,"MuzzleFlashInferno");
			A_PlaySOund("UNOCLOP", 6, 1, 1);
			A_FireCustomMissile("IncendiaryLaser", 0, 0, 0, 0, 0, 0);
			A_TakeInventory("HellAmmo", 1);
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("FireIncendiary2")
			Goto InfernoStopPrimary
		FireIncendiary2:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "InfernoStopPrimary")
			UNOF B 1 BRIGHT {
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			A_Overlay(-3,"MuzzleFlashInferno");
			A_WeaponOffset(frandom(-1,1),frandom(-1,1),WOF_INTERPOLATE|WOF_ADD);
			A_FireCustomMissile("IncendiaryLaser", 0, 0, 0, 0, 0, 0);
			A_FireCustomMissile("IncendiaryLaser", frandom(-10,10), 0, 0, 0, 0,frandom(-2,5));
			PB_WeaponRecoil(-0.3,random(1, -1));
			}
			TNT1 A 0 A_Refire("FireIncendiary3")
			Goto InfernoStopPrimary
		FireIncendiary3:
			TNT1 A 0 A_JumpIf(CountInv("HellAmmo") < 1, "InfernoStopPrimary")
