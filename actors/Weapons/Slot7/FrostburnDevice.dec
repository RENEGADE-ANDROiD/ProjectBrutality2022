			FBHL IJKKLLL 1 BRIGHT
			Stop
			
		InfernoLightning:
			TNT1 A 0 A_Jump(256,"InfernoLightning1","InfernoLightning2","InfernoLightning3")
		InfernoLightning1:
			UNOL ABCD 1 BRIGHT
			Stop
		InfernoLightning2:
			UNOL EFGH 1 BRIGHT
			Stop
		InfernoLightning3:
			UNOL IJKL 1 BRIGHT
			Stop
		InfernoCharge:
			UNOM ABCDEFGHIJKLMNOPQRSTUVW 1 BRIGHT
			Stop
			
		RespectLightning:
			FBHL MNOPQPRSTU 3 BRIGHT
			Stop
		RespectLightning2:
			FBHL NMPOPGDJ 3 BRIGHT
			Stop

		PDA_Preview_FrostburnFire:
			UNOG A 1
			UNOF A 1 BRIGHT
			UNOF B 1 BRIGHT
			UNOF C 1 BRIGHT
			Stop
		PDA_Preview_FrostburnCryo:
			FBHG A 1
			UNHR A 1 BRIGHT
			UNHR B 1 BRIGHT
			UNHR C 1 BRIGHT
			Stop

	}
}
		
