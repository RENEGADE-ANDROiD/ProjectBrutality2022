// Reilsss Flak Cannon support (ammo, mode tokens, flak chunks / grenades).
// Ironblast-style trail/impact FX from PBGuncasterV2 (patches FKFR/FKTR/FKEM/FKSM).
// Weapon logic: zscript/Weapons/Slot5/FlakCannon/PB_FlakCannon.zs

ACTOR FlakCannonAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 10
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 10
	+INVENTORY.IGNORESKILL
	Inventory.Icon "FKCUA0"
}

ACTOR PB_FlakLongRangeMode : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
	-INVENTORY.INVBAR
}

ACTOR Select_PB_FlakCannon_Short : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
	-INVENTORY.INVBAR
}

ACTOR Select_PB_FlakCannon_Long : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
	-INVENTORY.INVBAR
}

// --- Ironblast-style clientside trail / impact particles ---

ACTOR PB_FlakFXBasis
{
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	RenderStyle Add
	Alpha 0
	Scale 0
}

ACTOR PB_FlakSpawnerBasis
{
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	+CLIENTSIDEONLY
}

ACTOR PB_FlakTrailFlare : PB_FlakFXBasis
{
	States
	{
	Spawn:
		TNT1 AA 0 A_FadeIn(frandom(0.9, 0.99))
		TNT1 A 0 A_SetScale(frandom(0.15, 0.2))
		TNT1 A 0 A_Jump(256, "SpriteA", "SpriteB", "SpriteC", "SpriteD")
	SpriteA:
		FKFR A 0
		Goto Fade
	SpriteB:
		FKFR B 0
		Goto Fade
	SpriteC:
		FKFR C 0
		Goto Fade
	SpriteD:
		FKFR D 0
	Fade:
		"####" "#" 0 A_JumpIf(ScaleX <= 0, "NULL")
		"####" "#" 0 A_SetScale(ScaleX - frandom(0.03, 0.04))
		"####" "#" 1 Bright A_FadeOut(frandom(0.1, 0.05))
		Loop
	}
}

ACTOR PB_FlakTrailSmoke : PB_FlakFXBasis
{
	States
	{
	Spawn:
		TNT1 AA 0 A_SetScale(frandom(0.03, 0.045), ScaleX)
		TNT1 A 0 A_Jump(256, "SpriteA", "SpriteB", "SpriteC", "SpriteD", "SpriteE", "SpriteF", "SpriteG", "SpriteH")
	SpriteA:
		FKTR A 0
		Goto Rise
	SpriteB:
		FKTR B 0
		Goto Rise
	SpriteC:
		FKTR C 0
		Goto Rise
	SpriteD:
		FKTR D 0
		Goto Rise
	SpriteE:
		FKTR E 0
		Goto Rise
	SpriteF:
		FKTR F 0
		Goto Rise
	SpriteG:
		FKTR G 0
		Goto Rise
	SpriteH:
		FKTR H 0
	Rise:
		"####" "#" 1 Bright A_JumpIf(Alpha >= 0.7, "Hold")
		"####" "#" 0 A_FadeIn(frandom(0.05, 0.075))
		"####" "#" 0 A_ChangeVelocity(Velx * 0.975, Vely * 0.975, Velz * 1.05, CVF_REPLACE)
		"####" "#" 0 A_SetScale(ScaleX + frandom(0.0015, 0.0025), ScaleX)
		Loop
	Hold:
		"####" "###" 1 Bright A_SetScale(ScaleX + frandom(0.0015, 0.0025), ScaleX)
		"####" "#" 0 A_ChangeVelocity(Velx * 0.975, Vely * 0.975, Velz * 1.05, CVF_REPLACE)
		"####" "#" 0 A_Jump(192, "Out")
		Loop
	Out:
		"####" "#" 1 Bright A_SetScale(ScaleX + frandom(0.0015, 0.0025), ScaleX)
		"####" "#" 0 A_ChangeVelocity(Velx * 0.975, Vely * 0.975, Velz * 1.05, CVF_REPLACE)
		"####" "#" 0 A_FadeOut(frandom(0.05, 0.075))
		Loop
	}
}

ACTOR PB_FlakEmber : PB_FlakFXBasis
{
	States
	{
	Spawn:
		TNT1 A 0 A_Jump(256, "SpriteA", "SpriteB", "SpriteC", "SpriteD", "SpriteE", "SpriteF", "SpriteG", "SpriteH")
	SpriteA:
		FKEM A 0
		Goto Rise
	SpriteB:
		FKEM B 0
		Goto Rise
	SpriteC:
		FKEM C 0
		Goto Rise
	SpriteD:
		FKEM D 0
		Goto Rise
	SpriteE:
		FKEM E 0
		Goto Rise
	SpriteF:
		FKEM F 0
		Goto Rise
	SpriteG:
		FKEM G 0
		Goto Rise
	SpriteH:
		FKEM H 0
	Rise:
		"####" "#" 1 Bright A_JumpIf(Alpha >= 0.95, "Hold")
		"####" "#" 0 A_FadeIn(frandom(0.05, 0.075))
		"####" "#" 0 A_ChangeVelocity(0, 0, frandom(-0.1, -0.15), 0)
		"####" "#" 0 A_SetScale(ScaleX + frandom(0.0015, 0.0025), ScaleX)
		Loop
	Hold:
		"####" "###" 1 Bright
		"####" "#" 0 A_ChangeVelocity(0, 0, frandom(-0.1, -0.15), 0)
		"####" "#" 0 A_Jump(192, "Out")
		Loop
	Out:
		"####" "#" 1 Bright A_SetScale(ScaleX - frandom(0.0015, 0.0025), ScaleX)
		"####" "#" 0 A_ChangeVelocity(0, 0, frandom(-0.1, -0.15), 0)
		"####" "#" 0 A_JumpIf(ScaleX <= 0, "NULL")
		"####" "#" 0 A_FadeOut(frandom(0.1, 0.05))
		Loop
	}
}

ACTOR PB_FlakSoftSmoke : PB_FlakFXBasis
{
	RenderStyle Translucent
	States
	{
	Spawn:
		TNT1 AA 0 A_SetScale(frandom(0.03, 0.045), ScaleX)
		TNT1 A 0 A_Jump(128, "SpriteE", "SpriteG")
	SpriteE:
		FKSM E 0
		Goto Rise
	SpriteG:
		FKSM G 0
	Rise:
		"####" "#" 1 A_JumpIf(Alpha >= 0.35, "Hold")
		"####" "#" 0 A_FadeIn(frandom(0.05, 0.075))
		"####" "#" 0 A_ChangeVelocity(Velx * 0.975, Vely * 0.975, Velz * 1.05, CVF_REPLACE)
		"####" "#" 0 A_SetScale(ScaleX + frandom(0.0015, 0.0025), ScaleX)
		Loop
	Hold:
		"####" "###" 1 A_SetScale(ScaleX + frandom(0.0015, 0.0025), ScaleX)
		"####" "#" 0 A_ChangeVelocity(Velx * 0.975, Vely * 0.975, Velz * 1.05, CVF_REPLACE)
		"####" "#" 0 A_Jump(192, "Out")
		Loop
	Out:
		"####" "#" 1 A_SetScale(ScaleX + frandom(0.002, 0.0025), ScaleX)
		"####" "#" 0 A_ChangeVelocity(Velx * 0.975, Vely * 0.975, Velz * 1.05, CVF_REPLACE)
		"####" "#" 0 A_FadeOut(frandom(0.0175, 0.015))
		Loop
	}
}

ACTOR PB_FlakImpactFlare : PB_FlakFXBasis
{
	States
	{
	Spawn:
		TNT1 AA 0 A_SetScale(frandom(0.03, 0.045))
		TNT1 A 0 A_Jump(256, "SpriteA", "SpriteB", "SpriteC", "SpriteD")
	SpriteA:
		FKFR A 0
		Goto Grow
	SpriteB:
		FKFR B 0
		Goto Grow
	SpriteC:
		FKFR C 0
		Goto Grow
	SpriteD:
		FKFR D 0
	Grow:
		"####" "#" 1 Bright A_JumpIf(Alpha >= 0.95, "Out")
		"####" "#" 0 A_FadeIn(frandom(0.15, 0.2))
		"####" "#" 0 A_SetScale(ScaleX + frandom(0.075, 0.05))
		Loop
	Out:
		"####" "#" 1 Bright A_SetScale(ScaleX - frandom(0.005, 0.01))
		"####" "#" 0 A_JumpIf(ScaleX <= 0, "NULL")
		"####" "#" 0 A_FadeOut(frandom(0.05, 0.075))
		Loop
	}
}

ACTOR PB_FlakChunkTrailer : PB_FlakSpawnerBasis
{
	States
	{
	Spawn:
		TNT1 AA 0 A_SpawnItemEx("PB_FlakTrailFlare", frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(-0.5, 0.5), 0, 0, 0, 0, SXF_CLIENTSIDE, 50)
		TNT1 A 0 A_SpawnItemEx("PB_FlakEmber", frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(0.4, 0.6), frandom(0.4, 0.6), frandom(0.9, 1.4), frandom(0, 360), SXF_CLIENTSIDE, 220)
		TNT1 A 0 A_SpawnItemEx("PB_FlakTrailSmoke", frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(0.1, 0.2), frandom(0.1, 0.2), frandom(0.1, 0.2), frandom(0, 360), SXF_CLIENTSIDE, 170)
		TNT1 A 0 A_SpawnItemEx("PB_FlakSoftSmoke", frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(0.1, 0.15), frandom(0.1, 0.15), frandom(0.1, 0.2), frandom(0, 360), SXF_CLIENTSIDE, 170)
		TNT1 A 0 A_JumpIf(GetCVar("pb_lowgraphicsmode"), "ReducedAccent")
	FullAccent:
		// ~20% of ticks: one accent (RocketSmokeTrail52 or SparkX)
		TNT1 A 0 A_Jump(205, "NULL")
		TNT1 A 0 A_Jump(128, "AccentSpark")
		TNT1 A 0 A_SpawnItemEx("RocketSmokeTrail52", frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(-0.5, 0.5), 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
		Stop
	AccentSpark:
		TNT1 A 0 A_SpawnItemEx("SparkX", frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(0.2, 0.5), frandom(0.2, 0.5), frandom(0.4, 0.8), frandom(0, 360), SXF_CLIENTSIDE, 0)
		Stop
	ReducedAccent:
		// ~7% of ticks: same accent classes, rarer
		TNT1 A 0 A_Jump(237, "NULL")
		TNT1 A 0 A_Jump(128, "AccentSpark")
		TNT1 A 0 A_SpawnItemEx("RocketSmokeTrail52", frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(-0.5, 0.5), 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
		Stop
	}
}

ACTOR PB_FlakImpactBurst : PB_FlakSpawnerBasis
{
	var int user_count;
	States
	{
	Spawn:
		TNT1 AA 0 A_SetUserVar("user_count", 3)
		TNT1 A 0 A_SpawnItemEx("PB_FlakImpactFlare", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
		TNT1 A 0 A_SpawnItemEx("PB_FlakImpactGlow", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
		TNT1 A 0 A_JumpIf(GetCVar("pb_lowgraphicsmode"), "ReducedImpactMix")
	FullImpactMix:
		// ~22% / ~18% / ~6% of chunks — sparse metal + rare Excavator strip
		TNT1 A 0 A_SpawnItemEx("ShrapnelParticle", frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), frandom(1, 3), frandom(1, 3), frandom(1, 3), frandom(0, 360), SXF_CLIENTSIDE, 200)
		TNT1 A 0 A_SpawnItemEx("ExplosionParticleHeavy", frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), frandom(0.5, 1.5), frandom(0.5, 1.5), frandom(0.5, 1.5), frandom(0, 360), SXF_CLIENTSIDE, 210)
		TNT1 A 0 A_SpawnItemEx("ExcavatorExploFX", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE, 240)
		Goto BurstLoop
	ReducedImpactMix:
		// ~10% of chunks — light metal spray only
		TNT1 A 0 A_SpawnItemEx("ShrapnelParticle", frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), frandom(1, 3), frandom(1, 3), frandom(1, 3), frandom(0, 360), SXF_CLIENTSIDE, 230)
	BurstLoop:
		TNT1 AA 0 A_SpawnItemEx("PB_FlakEmber", frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(1.0, 1.6), frandom(1.0, 1.6), frandom(2.0, 2.6), frandom(0, 360), SXF_CLIENTSIDE, 100)
		TNT1 AAA 0 A_SpawnItemEx("PB_FlakTrailSmoke", frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(0.2, 0.4), frandom(0.2, 0.4), frandom(0.2, 0.4), frandom(0, 360), SXF_CLIENTSIDE, 80)
		TNT1 AA 0 A_SpawnItemEx("PB_FlakSoftSmoke", frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(0.15, 0.3), frandom(0.15, 0.3), frandom(0.2, 0.4), frandom(0, 360), SXF_CLIENTSIDE, 80)
		TNT1 A 0 A_SetUserVar("user_count", user_count - 1)
		TNT1 A random(1, 2) A_JumpIf(user_count <= 0, "NULL")
		Loop
	}
}

ACTOR PB_FlakImpactGlow : PB_FlakSpawnerBasis
{
	States
	{
	Spawn:
		TNT1 A 18
		Stop
	}
}

// --- Flak projectiles ---

ACTOR PB_FlakChunkNB1
{
	Projectile
	-NOGRAVITY
	+CANBOUNCEWATER
	+ROCKETTRAIL
	+FORCEXYBILLBOARD
	Gravity 0.13
	Radius 3
	Height 4
	Speed 60
	Damage 5
	RenderStyle Translucent
	Alpha 1.0
	Scale 0.4
	DamageType SSG
	States
	{
	Spawn:
		TNT1 A 0 A_SpawnItemEx("PB_FlakChunkTrailer", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		R030 O 2
		Loop
	Death:
		TNT1 A 0 A_PlaySound("weapons/FlakCannon/Hit", CHAN_AUTO, 0.35)
		TNT1 A 0 A_SpawnItemEx("PB_FlakImpactBurst", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		R030 O 4
		R030 RUX 3
		R030 X 8 A_FadeOut(0.15)
		Stop
	}
}

ACTOR PB_FlakChunkNB2 : PB_FlakChunkNB1
{
	States
	{
	Spawn:
		TNT1 A 0 A_SpawnItemEx("PB_FlakChunkTrailer", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		R030 P 2
		Loop
	Death:
		TNT1 A 0 A_PlaySound("weapons/FlakCannon/Hit", CHAN_AUTO, 0.35)
		TNT1 A 0 A_SpawnItemEx("PB_FlakImpactBurst", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		R030 P 4
		R030 SVY 3
		R030 Y 8 A_FadeOut(0.15)
		Stop
	}
}

