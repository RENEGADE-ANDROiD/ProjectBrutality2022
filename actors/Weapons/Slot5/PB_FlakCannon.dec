ACTOR PB_FlakGrenChunk1 : PB_FlakChunk1
{
	Gravity 0.5
	Speed 35
	Damage 2
}

ACTOR PB_FlakGrenChunk2 : PB_FlakChunk2
{
	Gravity 0.5
	Speed 35
	Damage 2
}

ACTOR PB_FlakGrenChunk3 : PB_FlakChunk3
{
	Gravity 0.5
	Speed 35
	Damage 2
}

ACTOR PB_FlakImpactGrenade
{
	Radius 4
	Height 4
	Speed 45
	Damage 30
	DamageType Explosive
	Projectile
	+FORCEXYBILLBOARD
	+EXTREMEDEATH
	DeathSound "weapons/FlakCannon/Flak_Explosion"
	Obituary "%o was shredded by %k's Flak Cannon."
	States
	{
	Spawn:
		GRNP A 1 Bright
		Loop
	Death:
		TNT1 A 0 A_SpawnItem("BigRicoChet", 0, -30)
		EXPL AAA 0 A_CustomMissile("BigNeoSmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 AAA 0 A_CustomMissile("ExplosionSmoke", 22, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_SpawnItemEx("DetectFloorCrater", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("DetectCeilCrater", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("ExplosionFlareSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("PB_PlayerImpactGrenadeExplosion", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("NewRocketExploFX", 0, 0, 0)
		TNT1 A 0 A_JumpIf(GetCVar("pb_lowgraphicsmode"), "SkipAltExploFX")
		TNT1 A 0 A_SpawnItemEx("ExcavatorExploFX", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
	SkipAltExploFX:
		TNT1 A 1
		TNT1 AAAAAAAAA 0 A_CustomMissile("ExplosionParticleHeavy", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 AAAAAAAAA 0 A_CustomMissile("ExplosionParticleVeryFast", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("ShrapnelParticle", 0, 0, random(0, 360), 2, random(0, 360))
		XXXX A 0 A_CustomMissile("ExplosionQuake", 1, 0, random(0, 360), 2, random(0, 160))
		TNT1 AAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("MediumExplosionFlames", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_PlaySound("weapons/FlakCannon/Flak_Explosion", CHAN_AUTO)
		EXPL AAA 0 A_CustomMissile("ExplosionSmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_CustomMissile("PB_FlakGrenChunk1", 8, 0, random(0, 359))
		TNT1 A 0 A_CustomMissile("PB_FlakGrenChunk2", 8, 0, random(0, 359))
		TNT1 A 0 A_CustomMissile("PB_FlakGrenChunk3", 8, 0, random(0, 359))
		Stop
	}
}

ACTOR PB_FlakBounceGrenade : PB_FragGrenade
{
	Speed 40
	Damage 30
	DeathSound "weapons/FlakCannon/Flak_Explosion"
	States
	{
	Death:
	XDeath:
	Detonate:
		TNT1 A 0 A_SpawnItem("BigRicoChet", 0, -30)
		EXPL AAA 0 A_CustomMissile("BigNeoSmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 AAA 0 A_CustomMissile("ExplosionSmoke", 22, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_SpawnItemEx("DetectFloorCrater", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("DetectCeilCrater", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("ExplosionFlareSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("PB_PlayerImpactGrenadeExplosion", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("NewRocketExploFX", 0, 0, 0)
		TNT1 A 0 A_JumpIf(GetCVar("pb_lowgraphicsmode"), "SkipAltExploFX")
		TNT1 A 0 A_SpawnItemEx("ExcavatorExploFX", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
	SkipAltExploFX:
		TNT1 A 1
		TNT1 AAAAAAAAA 0 A_CustomMissile("ExplosionParticleHeavy", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 AAAAAAAAA 0 A_CustomMissile("ExplosionParticleVeryFast", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("ShrapnelParticle", 0, 0, random(0, 360), 2, random(0, 360))
		XXXX A 0 A_CustomMissile("ExplosionQuake", 1, 0, random(0, 360), 2, random(0, 160))
		TNT1 AAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("MediumExplosionFlames", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_PlaySound("weapons/FlakCannon/Flak_Explosion", CHAN_AUTO)
		EXPL AAA 0 A_CustomMissile("ExplosionSmoke", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_CustomMissile("PB_FlakGrenChunk1", 8, 0, random(0, 359))
		TNT1 A 0 A_CustomMissile("PB_FlakGrenChunk2", 8, 0, random(0, 359))
		TNT1 A 0 A_CustomMissile("PB_FlakGrenChunk3", 8, 0, random(0, 359))
		Stop
	}
}

ACTOR PB_FastFlakImpactGrenade : PB_FlakImpactGrenade
{
	Speed 60
}

ACTOR PB_FastFlakBounceGrenade : PB_FlakBounceGrenade
{
	Speed 60
}
