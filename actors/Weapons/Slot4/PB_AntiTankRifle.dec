// PB_AntiTankRifle support — weapon states in zscript/Weapons/Slot4/AntiTankRifle/PB_AntiTankRifle.zs
// Brutal Doom Plus Machinegun lineage; sprites Tesefy.

ACTOR PB_AntiTankMag : Ammo
{
	+INVENTORY.IGNORESKILL
	Inventory.Amount 0
	Inventory.MaxAmount 5
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 5
	Inventory.Icon "PAPAA0"
}

Actor Select_ATR_Single : Inventory { Inventory.MaxAmount 1 }
Actor Select_ATR_Burst : Inventory { Inventory.MaxAmount 1 }
Actor Select_ATR_VoidGrenade : Inventory { Inventory.MaxAmount 1 }

Actor ATR_BurstMode : Inventory { Inventory.MaxAmount 1 }
Actor ATR_VoidGrenadeMode : Inventory { Inventory.MaxAmount 1 }
Actor RespectAntiTankRifle : Inventory { Inventory.MaxAmount 1 }

ACTOR PB_AntiTankExplosiveProjectile : FastProjectile
{
	+RANDOMIZE
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+NOGRAVITY
	Speed 400
	Damage 50
	Scale 0.35
	Radius 3
	Height 3
	SeeSound "None"
	DamageType ExplosiveImpact
	Decal "Scorch"
	Obituary "%o was punched through by %k's Anti-Tank Rifle"
	States
	{
	Spawn:
		XPAC A 1 BRIGHT
		Loop
	Death:
	XDeath:
		TNT1 A 0 A_Explode(50, 96, XF_HURTSOURCE, 0, 48)
		TNT1 A 0 A_SpawnItemEx("ExplosionFlareSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItem("ShotgunPuff")
		TNT1 A 0 A_CustomMissile("SmallExplosionFlames", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_CustomMissile("ExplosionParticleHeavy", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_PlaySound("weapons/antitank/explode", 1)
		TNT1 A 1
		Stop
	}
}

// Rifle-launched void grenade — same explode payload as ThrownVoidGrenade, faster flight.
ACTOR PB_AntiTankVoidGrenade
{
	Radius 2
	Height 3
	Speed 50
	Damage 0
	Gravity 0.55
	Scale 0.2
	BounceFactor 0.5
	WallBounceFactor 0.25
	Health 5
	Species "Marine"
	Projectile
	+MISSILE
	-NOGRAVITY
	-BLOODSPLATTER
	-EXTREMEDEATH
	+EXPLODEONWATER
	+SKYEXPLODE
	+DOOMBOUNCE
	+FLOORCLIP
	+DONTGIB
	+MTHRUSPECIES
	+THRUSPECIES
	+DontHurtSpecies
	+DontHarmSpecies
	+NoExtremeDeath
	DamageType "BlackHole"
	SeeSound "StunGrenadeBounce"
	DeathSound "StunGrenadeBounce"
	Obituary "%o was swallowed by %k's void grenade."
	States
	{
	Spawn:
		TNT1 A 0 A_PlaySoundEx("grenade/beep/void", "Auto")
		TNT1 A 0 A_SpawnItemEx("PurpleFlareSmall", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		VGR1 ABCDEFA 2
		TNT1 A 0 A_GiveInventory("GrenadeTime", 1)
		TNT1 A 0 A_JumpIfInventory("GrenadeTime", 6, "Explode")
		Loop
	Death:
		TNT1 A 0 A_PlaySoundEx("grenade/beep/void", "Auto")
		TNT1 A 0 A_SpawnItemEx("PurpleFlareSmall", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		VGR1 E 14
		TNT1 A 0 A_GiveInventory("GrenadeTime", 1)
		TNT1 A 0 A_JumpIfInventory("GrenadeTime", 6, "Explode")
		Loop
	Explode:
		TNT1 A 0 A_SpawnItemEx("BlackHoleSingularity", 0, 0, 40, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("PurpleShockWave", 0, 0, 40, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_SpawnItemEx("PurpleShockWave_Flat", 0, 0, 40, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 A_StopSound(CHAN_5)
		TNT1 A 0 A_StartSound("weapons/bh_app", CHAN_5)
		TNT1 A 0 A_PlaySoundEx("weapons/bh_blast", "Auto")
		BH0G ABCDEFGHIJKLM 1 Bright Light("BlackholeBall") {
					A_SetScale(ScaleX-0.02, ScaleY-0.02);
					Radius_Quake (8, 16, 0, 200, 0);
				}
		TNT1 A 0 A_SpawnItemEx("BlackHole", 0, 0, 40, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		Stop
	}
}
