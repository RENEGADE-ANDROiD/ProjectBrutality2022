// Always-dual UAC Portal Blasters - portal bolts that also damage monsters.
// Sprites/sounds: decibel / XV117 (PB_Plasma_Blaster pack).

Actor PB_PortalBlaster : PB_Weapon
{
	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.0
	Weapon.AmmoUse1 0
	Weapon.AmmoGive1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive2 0
	Inventory.Amount 1
	Inventory.MaxAmount 1
	+WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	+WEAPON.WIMPY_WEAPON
	+FLOORCLIP
	+DONTGIB
	Inventory.PickUpSound "weapons/PortalBlaster/Select"
	Inventory.PickupMessage "$PB_PICKUP_PB_PORTALBLASTER"
	Obituary "%o was wasted by UAC Portal Blasters."
	Tag "UAC Portal Blasters"
	Inventory.Icon "D4BPA0"
	Inventory.AltHUDIcon "D4BPA0"
	Scale 0.44
	FloatBobStrength 0.5
	States
	{
	Pickup:
		TNT1 A 0 A_PlaySound("PICKUPONELINER")
		TNT1 A 0
		Stop

	Steady:
		TNT1 A 0 A_ClearOverlays(10, 11)
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 PB_UnsetPlayerExecutionProperties()
		Goto ReadyDualWield

	Ready:
	SelectAnimation:
		TNT1 A 0
		{
			A_WeaponOffset(0, 32);
			A_SetRoll(0);
			A_TakeInventory("PB_LockScreenTilt", 1);
			PB_HandleCrosshair(46);
			A_PlaySoundEx("weapons/PortalBlaster/Select", "Auto");
		}
		D4DS ABCDE 1
		{
			return A_DoPBWeaponAction(WRF_NOFIRE);
		}
		Goto ReadyDualWield

	Ready3:
		TNT1 A 0
		Goto ReadyDualWield

	ReadyDualWield:
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0
		{
			A_SetRoll(0);
			PB_HandleCrosshair(46);
			A_TakeInventory("PB_LockScreenTilt", 1);
			A_SetFiringRightWeapon(False);
			A_SetFiringLeftWeapon(False);
			A_Overlay(10, "IdleLeft_Overlay", False);
			A_Overlay(11, "IdleRight_Overlay", False);
		}
	ReadyToFireDualWield:
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOFIRE)
		Loop

	IdleLeft_Overlay:
		PI2G A 1
		{
			if ((PressingAltfire() || JustPressed(BT_ALTATTACK)) && !A_IsFiringLeftWeapon())
			{
				return state("FireLeft_Overlay");
			}
			return state("");
		}
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		Loop

	IdleRight_Overlay:
		PI3G A 1
		{
			if (PB_TryApplyAutoFatalityOnWeapon())
			{
				return state("");
			}
			if ((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringRightWeapon())
			{
				return state("FireRight_Overlay");
			}
			return state("");
		}
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		Loop

	FireLeft_Overlay:
		PI2F A 1 Bright
		{
			A_FireCustomMissile("BlueFlareSpawn", 0, 0, -6, 0, 0, 0);
			A_FireCustomMissile("ShakeYourAssMinor", 0, 0, -6, 0);
			// Centered invisible portal placer (original portalgun pattern)
			A_FireCustomMissile("PB_PortalBoltB", 0, 0, 0, 0, 0, 0);
			// Visible blue damage blast from left barrel
			A_FireCustomMissile("PB_PortalBlastB", 0, 0, -6, 0, 0, 0);
			A_AlertMonsters;
			A_PlaySound("weapons/PortalBlaster/Fire", 20);
			A_FireCustomMissile("GunFireSmoke", 0, 0, -6, 0, 0, 0);
			A_ZoomFactor(0.985);
			A_SetFiringLeftWeapon(True);
			A_GunFlash;
			PB_WeaponRecoil(-0.9, -0.3);
		}
		PI2F B 1 Bright
		{
			A_ZoomFactor(1.0);
			PB_WeaponRecoil(-0.6, -0.3);
		}
		PI2F C 1 PB_WeaponRecoil(+0.3, -0.3)
		PI2F DEF 1
		PI2G A 1
		TNT1 A 0 A_SetFiringLeftWeapon(False)
		PI2G AA 1
		{
			if (JustPressed(BT_ALTATTACK) && !A_IsFiringLeftWeapon())
			{
				return state("FireLeft_Overlay");
			}
			return state("");
		}
		Goto IdleLeft_Overlay

	FireRight_Overlay:
		PI3F A 1 Bright
		{
			A_PlaySound("weapons/PortalBlaster/Fire", 20);
			A_FireCustomMissile("RedFlareSpawn", 0, 0, 6, 0, 0, 0);
			A_FireCustomMissile("ShakeYourAssMinor", 0, 0, 6, 0);
			// Centered invisible portal placer (original portalgun pattern)
			A_FireCustomMissile("PB_PortalBoltA", 0, 0, 0, 0, 0, 0);
			// Visible red damage blast from right barrel
			A_FireCustomMissile("PB_PortalBlastA", 0, 0, 6, 0, 0, 0);
			A_AlertMonsters;
			A_FireCustomMissile("GunFireSmoke", 0, 0, 6, 0, 0, 0);
			A_ZoomFactor(0.985);
			A_SetFiringRightWeapon(True);
			A_GunFlash;
			PB_WeaponRecoil(-0.9, +0.3);
		}
		PI3F B 1 Bright
		{
			A_ZoomFactor(1.0);
			PB_WeaponRecoil(-0.6, +0.3);
		}
		PI3F C 1 PB_WeaponRecoil(+0.3, +0.3)
		PI3F DEF 1
		PI3G A 1
		TNT1 A 0 A_SetFiringRightWeapon(False)
		PI3G AA 1
		{
			if (JustPressed(BT_ATTACK) && !A_IsFiringRightWeapon())
			{
				return state("FireRight_Overlay");
			}
			return state("");
		}
		Goto IdleRight_Overlay

	Deselect:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0
		{
			A_WeaponOffset(0, 32);
			A_SetRoll(0);
			PB_HandleCrosshair(46);
			A_TakeInventory("PB_LockScreenTilt", 1);
			A_ClearOverlays(10, 11);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_ZoomFactor(1.0);
		}
		D4DS EDCBA 1 A_SetRoll(roll + 0.5, SPF_INTERPOLATE)
		TNT1 A 1 A_Lower
		Wait

	Select:
		TNT1 A 0
		{
			A_WeaponOffset(0, 32);
			A_SetRoll(0);
			PB_HandleCrosshair(46);
			A_TakeInventory("PB_LockScreenTilt", 1);
			A_ClearOverlays(10, 11);
		}
		TNT1 A 0 A_TakeInventory("HasBarrel", 1)
		TNT1 A 0 A_TakeInventory("HasIceBarrel", 1)
		TNT1 A 0 A_TakeInventory("HasFlameBarrel", 1)
		TNT1 A 0 A_TakeInventory("HasBurningBarrel", 1)
		TNT1 A 0 A_TakeInventory("GrabbedBarrel", 1)
		TNT1 A 0 A_TakeInventory("GrabbedIceBarrel", 1)
		TNT1 A 0 A_TakeInventory("GrabbedFlameBarrel", 1)
		TNT1 A 0 A_TakeInventory("GrabbedBurningBarrel", 1)
		Goto SelectFirstPersonLegs
	SelectContinue:
		TNT1 A 0
		TNT1 A 0 A_Raise
		Wait

	Fire:
		TNT1 A 0
		{
			return PB_TryAutoFatalityOnFire();
		}
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "ThrowBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "ThrowFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "ThrowIceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "ThrowFlameBarrel")
		Goto ReadyDualWield

	AltFire:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "PlaceFlameBarrel")
		Goto ReadyDualWield

	Reload:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_ClearOverlays(10, 11)
		Goto ReadyDualWield

	WeaponSpecial:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "IdleFlameBarrel")
		TNT1 A 0
		{
			A_WeaponOffset(0, 32);
			A_SetRoll(0);
			PB_HandleCrosshair(46);
			A_TakeInventory("GoWeaponSpecialAbility", 1);
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_ZoomFactor(1.0);
		}
		Goto ReadyDualWield

	Spawn:
		D4BP A 0 NoDelay
		D4BP A 10 A_PbvpFramework("D4BP")
		"####" "#" 0 A_PbvpInterpolate()
		Loop

	FlashKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelKicking")
		TNT1 A 0 A_ClearOverlays(10, 11)
		PI2K ABCD 1
		PI2K E 6
		PI2K DCBA 1
		Goto ReadyDualWield

	FlashAirKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelAirKicking")
		TNT1 A 0 A_ClearOverlays(10, 11)
		PI2K ABCD 1
		PI2K E 7
		PI2K DCBA 1
		Goto ReadyDualWield

	FlashPunching:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelPunching")
		TNT1 A 0 A_ClearOverlays(10, 11)
		PI2S EDCB 1
		PI2S A 4
		PI2S BCDE 1
		Stop

	FlashSlideKicking:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_ClearOverlays(10, 11)
		PI2K ABCD 1
		PI2K E 13
		PI2K DCBA 1
		Goto ReadyDualWield

	FlashSlideKickingStop:
		TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedFlameBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "FlashBarrelSlideKicking")
		TNT1 A 0 A_ClearOverlays(10, 11)
		PI2K A 1
		Goto ReadyDualWield
	}
}
