// Wall goodang / accept probes — must fail inside solid geometry (no NOCLIP).
Actor PB_PortalTestActor
{
	Radius 1
	Height 2
	+NOBLOCKMAP
	+NOINTERACTION
	-SOLID
}

// Floor / ceil accept probes — may sit under feet / over head.
Actor PB_PortalPlaneTestActor
{
	Radius 1
	Height 2
	+NOBLOCKMAP
	+NOINTERACTION
	+NOCLIP
	-SOLID
}

// Soft GLDEFS PulseLight anchors for floor/ceil particle pads.
Actor PB_PortalPadGlowA
{
	Radius 1
	Height 1
	+NOBLOCKMAP
	+NOGRAVITY
	+NOINTERACTION
	+NOCLIP
	+CLIENTSIDEONLY
	RenderStyle "None"
	States
	{
	Spawn:
		TNT1 A -1
		Stop
	}
}

Actor PB_PortalPadGlowB
{
	Radius 1
	Height 1
	+NOBLOCKMAP
	+NOGRAVITY
	+NOINTERACTION
	+NOCLIP
	+CLIENTSIDEONLY
	RenderStyle "None"
	States
	{
	Spawn:
		TNT1 A -1
		Stop
	}
}

Actor PB_PortalFailSpark
{
	+NOBLOCKMAP
	+NOGRAVITY
	+NOINTERACTION
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 AAAAA 0 A_SpawnItemEx("GunFireSmoke", random(-4,4), random(-4,4), random(0,8), 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 1
		Stop
	}
}

Actor PB_PortalPlaceBurstA
{
	+NOBLOCKMAP
	+NOGRAVITY
	+NOINTERACTION
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 0 A_SpawnItemEx("RedFlareSmall", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("OrangeFlareSmall", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_CustomMissile("PlasmaParticle", 0, 0, random(0,360), 2, random(0,360))
		TNT1 A 1
		Stop
	}
}

Actor PB_PortalPlaceBurstB
{
	+NOBLOCKMAP
	+NOGRAVITY
	+NOINTERACTION
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 0 A_SpawnItemEx("BlueFlareSmall", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 AAAA 0 A_CustomMissile("BluePlasmaParticle", 0, 0, random(0,360), 2, random(0,360))
		TNT1 A 1
		Stop
	}
}
