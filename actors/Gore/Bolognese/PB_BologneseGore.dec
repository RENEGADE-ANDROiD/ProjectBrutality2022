// Additive Brutal Bolognese ketchup / TomatoSauce variety (Sgt. Mark IV).
// Renamed BO* sprites under SPRITES/GORE/Bolognese/ — does not replace Blood / XDeath* / MeatDeath.

ACTOR PB_BoloFlyingMeat
{
	Radius 2
	Height 2
	Speed 10
	Mass 1
	Gravity 0.4
	DeathSound "misc/xdeath2"
	Decal BrutalBloodSuper
	+NOBLOCKMAP
	+MISSILE
	+NOTELEPORT
	+MOVEWITHSECTOR
	+CLIENTSIDEONLY
	+DONTSPLASH
	+THRUGHOST
	+THRUACTORS
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		BOMT A 0 A_JumpIf(waterlevel > 1, "Splash")
		BOMT ABCDEFGH 2
		Loop
	Death:
		TNT1 A 0 A_CheckFloor("SpawnFloor")
		TNT1 A 0 A_SpawnItemEx("Brutal_BloodSpot", 0, 0, 1)
		Stop
	SpawnFloor:
		BOMT M 1
		TNT1 A 0 A_SpawnItemEx("Brutal_BloodSpot", 0, 0, 1)
		BOMT M -1
		Stop
	Splash:
		BOMT M 1
		Stop
	}
}

ACTOR PB_BoloFlyingMeat2 : PB_BoloFlyingMeat
{
	Speed 8
	States
	{
	Spawn:
		BOMU A 0 A_JumpIf(waterlevel > 1, "Splash")
		BOMU ABCDEFGH 2
		Loop
	SpawnFloor:
		BOMU M 1
		TNT1 A 0 A_SpawnItemEx("Brutal_BloodSpot", 0, 0, 1)
		BOMU M -1
		Stop
	Splash:
		BOMU M 1
		Stop
	}
}

