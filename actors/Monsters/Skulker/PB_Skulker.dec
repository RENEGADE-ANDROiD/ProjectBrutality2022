// Project Survival Twitcher (SKULK?R) folded as PB_Skulker.
// Sprites: SPRITES/Monsters/Skulker (VFOD*). Sounds: sounds/monsters/Skulker/.

ACTOR PB_Skulker : PB_Monster
{
    Health 1500 
    GibHealth 20
    Radius 20
    Height 56
    Speed 5
    PainChance 256
	MeleeRange 65
	Mass 10000
    SeeSound ""
    PainSound "skulker/Flinch"
    DeathSound ""
    ActiveSound ""
    Obituary "%o can't."
	Tag "SKULK?R"
	Species "Brute"
	StencilColor "Red"
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	PainChance "Trample", 255
	PainChance "Stun", 255
	PainChance "Avoid", 35
	PainChance "Head", 255
    PainChance "Taunt", 255
    PainChance "Kick", 255
    PainChance "ExtremePunches", 255
	PainChance "Melee", 255
	damagefactor "TeleportRemover", 0.0
	damagefactor "GibRemoving", 0.0
	DamageFactor "CauseObjectsToSplash", 0.0
	damagefactor "killme", 0.0
	damagefactor "Avoid", 1.0
	damagefactor "Trample", 1.5
	damagefactor "SSG", 5.0
	XScale 1
	YScale 1.4
    Monster
    +FLOORCLIP
	+THRUSPECIES
	+SLIDESONWALLS
	+DONTHURTSPECIES
	+DONTHARMSPECIES
	+NOINFIGHTING
	+COUNTKILL
	-SHOOTABLE
  States
  {
  Spawn:
	VFOD AB 7 A_Wander
	TNT1 AA 0 A_Look
	VFOD CD 7 A_Wander
    TNT1 AA 0 A_Look
    Loop
	
  See:
	TNT1 A 0 {
		A_PlaySound("skulker/See",CHAN_7);
		A_SetSpeed(20); 
		A_ChangeFlag("SHOOTABLE",true);
		A_Changeflag("NOPAIN",true);
	}
	VFOD NNNNNNNNNNNNNOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQPQRQSTVUVWUTSVW 1 A_FaceTarget
	TNT1 A 0 {
		A_Changeflag("NOPAIN",false);
	}
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_Wander
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_Wander
  SeeBegin:
	TNT1 A 0 A_ChangeFlag(DONTFALL,1)
	TNT1 A 0 A_ChangeFlag(NOBLOCKMONST,1)
	TNT1 A 0 A_ChangeFlag(NOCLIP,1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Normal)
	TNT1 A 0 A_StopSound(CHAN_6)
	TNT1 A 0 A_SetSpeed(30)
	TNT1 AAAA 3 A_Chase
	TNT1 AAAA 3 A_Chase
	TNT1 A 0 A_Jump(200,"Decisions")
	Loop
	
  Decisions:
    TNT1 A 0 A_CheckSight("SeeBegin")
	TNT1 A 0 A_Jump(100,"BlinkCharge","BurstTele","StalkingEyes","StalkingShadow","NeckBreathe")
	TNT1 A 0 A_Jump(210,"CrazyCharge","BlinkCharge","BurstTele","StalkingEyes","StalkingShadow","NeckBreathe","StalkTrap")
    Goto SeeBegin
	
  Reposition:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_StopSound(CHAN_6)
	TNT1 A 0 A_SetSpeed(20)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Wander
	Goto SeeBegin
	
  MeleedRoam:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_StopSound(CHAN_6)
	TNT1 A 0 A_SetSpeed(50)
	TNT1 AAAAAAAAAAAAAAAAAAAA 2 A_Wander
	Goto Reposition
	
  Melee:
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Normal)
	TNT1 A 0 A_StopSound(CHAN_6)
	TNT1 A 0 A_PlaySound("weapons/fistwhoosh",CHAN_6)
    VFOD FFFF 5
	{
	A_FaceTarget;
	A_Stop;
	}
	TNT1 A 0 A_PlaySound("imp/melee",CHAN_7)
    VFOD G 4 A_CustomMissile("PB_SkulkerMelee",18,0,0,CMF_AIMDIRECTION)
	VFOD GFFF 8 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,30,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,40,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,10,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	Goto MeleedRoam
  StalkingEyes:
	TNT1 A 0 A_SetSpeed(60)
	TNT1 AAAAAAAAAA 2 A_Wander
  StalkingEyesLoop:
	VFOD XYZYX 1 Bright A_FaceTarget
	TNT1 A 0 A_Jump(6,"MeleedRoam")
	TNT1 A 0 A_JumpIfInTargetLOS("StalkOrRoam",5,JLOSF_DEADNOJUMP,2000)
	TNT1 A 0 A_CheckSight("SeeBegin")
	Loop
	
	StalkOrRoam:
	TNT1 A 0 A_Jump(130,"NeckBreathe")
	Goto MeleedRoam
	
  StalkingShadow:
	TNT1 A 0 A_SetSpeed(60)
	TNT1 AAAAAAAAAA 2 A_Wander
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Shadow)
  StalkingShadowLoop:
	VFOD PQRPRPQPQR 1 Bright A_FaceTarget
	TNT1 A 0 A_Jump(6,"MeleedRoam")
	TNT1 A 0 A_JumpIfInTargetLOS("StalkOrRoam",5,JLOSF_DEADNOJUMP,2000)
	TNT1 A 0 A_CheckSight("SeeBegin")
	Loop
	
  StalkTrap:
	TNT1 A 0 A_SetSpeed(60)
	TNT1 AAAAAAAAAA 2 A_Wander
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Fuzzy)
	TNT1 A 0 A_PlaySound("skulker/Whisper",CHAN_6)
  StalkTrapLoop:
	VFOD O 1 A_FaceTarget
	TNT1 A 0 A_Jump(10,"MeleedRoam")
	TNT1 A 0 A_JumpIfInTargetLOS("TrapSprung",5,JLOSF_DEADNOJUMP,2000)
	TNT1 A 0 A_CheckSight("SeeBegin")
	Loop
  TrapSprung:
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Normal)
	TNT1 A 0 A_PlaySound("skulker/Wail",CHAN_6)
	VFOD NNNNNNNNOOOOOOOOOOOOOOOOOOOPQRPRPQPQRQRPQPRPQRPQPQRPRQPPRPPRQPQRPQR 1 
	TNT1 A 0 A_SetSpeed(60)
  TrapAttack:
	VFOD ABCD 1 
	{
	A_Chase("TrapFrenzy",0);
	}
	TNT1 A 0 A_Jump(1,"MeleedRoam")
	Loop
  TrapFrenzy:
	TNT1 A 0 A_FaceTarget
	VFOD E 0  A_PlaySound("imp/melee",CHAN_AUTO,1.0,false,1.2)
	TNT1 A 0 A_Recoil(-20)
	TNT1 A 0 ThrustThingZ(0,16,0,1)
	TNT1 A 0 A_FaceTarget
	VFOD FFFFF 1  A_SpawnItemEx("PB_SkulkerTrailA")
	VFOD E 3 
		{
		A_FaceTarget;
		A_CustomMissile("PB_SkulkerJump",18,0,0,CMF_AIMDIRECTION);
		A_SpawnItemEx("PB_SkulkerTrailA");
		}
	VFOD FF 1 
	VFOD E 0 A_PlaySound("imp/melee",CHAN_AUTO,1.0,false,1.2)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-20)
	TNT1 A 0 ThrustThingZ(0,16,0,1)
	TNT1 A 0 A_FaceTarget
	VFOD FFFFF 1  A_SpawnItemEx("PB_SkulkerTrailA")
	VFOD G 3 
		{
		A_FaceTarget;
		A_CustomMissile("PB_SkulkerJump",18,0,0,CMF_AIMDIRECTION);
		A_SpawnItemEx("PB_SkulkerTrailA");
		}
	VFOD FF 1 
	VFOD E 0 A_PlaySound("imp/melee",CHAN_AUTO,1.0,false,1.2)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-20)
	TNT1 A 0 ThrustThingZ(0,16,0,1)
	TNT1 A 0 A_FaceTarget
	VFOD FFFFF 1  A_SpawnItemEx("PB_SkulkerTrailA")
	VFOD E 3 
		{
		A_FaceTarget;
		A_CustomMissile("PB_SkulkerJump",18,0,0,CMF_AIMDIRECTION);
		A_SpawnItemEx("PB_SkulkerTrailA");
		}
	VFOD FF 1 
	VFOD E 0 A_PlaySound("imp/melee",CHAN_AUTO,1.0,false,1.2)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-20)
	TNT1 A 0 ThrustThingZ(0,16,0,1)
	TNT1 A 0 A_FaceTarget
	VFOD FFFFF 1  A_SpawnItemEx("PB_SkulkerTrailA")
	VFOD G 3 
		{
		A_FaceTarget;
		A_CustomMissile("PB_SkulkerJump",18,0,0,CMF_AIMDIRECTION);
		A_SpawnItemEx("PB_SkulkerTrailA");
		}
	VFOD FF 1 
	VFOD E 0 A_PlaySound("imp/melee",CHAN_AUTO,1.0,false,1.2)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-20)
	TNT1 A 0 ThrustThingZ(0,16,0,1)
	TNT1 A 0 A_FaceTarget
	VFOD FFFFF 1  A_SpawnItemEx("PB_SkulkerTrailA")
	VFOD E 3 
		{
		A_FaceTarget;
		A_CustomMissile("PB_SkulkerJump",18,0,0,CMF_AIMDIRECTION);
		A_SpawnItemEx("PB_SkulkerTrailA");
		}
	VFOD FF 1 
	Goto MeleedRoam
	
  NeckBreathe:
	TNT1 A 0 A_SetSpeed(60)
	TNT1 AAAAAAA 2 A_Chase(0,0)
	TNT1 A 0 A_JumpIfCloser(90,"BreatheCheck")
	Loop
  BreatheCheck:
	TNT1 A 0 A_Jump(3,"MeleedRoam")
	TNT1 A 0 A_JumpIfInTargetLOS("NeckBreathe",70,JLOSF_DEADNOJUMP,2000)
  CommenceBreathing:
	TNT1 A 0 A_PlaySound("skulker/Breath",CHAN_6,1,1)
  Breath:
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Normal)
	VFOD RQPPRP 1 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("BlinkCharge",20,JLOSF_DEADNOJUMP,2000)
	TNT1 A 0 A_CheckSight("MeleedRoam")
	TNT1 A 0 A_JumpIfCloser(350,"Breath")
	Goto MeleedRoam
	
  CrazyCharge:
	TNT1 A 0 A_SetSpeed(60)
	TNT1 A 0 A_PlaySound("skulker/Charge",CHAN_6,1,1)
	TNT1 AAAAA 2 A_Wander
	VFOD BC 2 A_Wander
	TNT1 AAA 3 A_Wander
	VFOD DAB 2 A_Wander
	TNT1 A 0 A_Jump(30,"MeleedRoam")
	TNT1 AAAAAAA 2 A_Wander
	VFOD CDABCD 1 A_Wander
	TNT1 AAA 3 A_Wander
	VFOD BCDABCD 1 A_Wander
  CrazyChargeAttack:
	VFOD ABCD 1 A_Chase
	TNT1 AAA 2 A_Chase
	VFOD CD 1 A_Chase
	TNT1 AAAAA 2 A_Chase
	TNT1 A 0 A_Jump(3,"MeleedRoam")
	Loop
	
  BlinkCharge:
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Shadow)
	TNT1 A 0 A_SetSpeed(25)
	TNT1 A 0 A_PlaySound("skulker/Hunt",CHAN_6,1.0,1)
  BlinkChargeLoop:
	VFOD ABCDABC 2 
	{
	A_Chase;
	A_SpawnItemEx("PB_SkulkerTrailA");
	}
	TNT1 AAA 3 A_Chase
	VFOD DAB 2 
	{
	A_Chase;
	A_SpawnItemEx("PB_SkulkerTrailB");
	}
	TNT1 AAAAAAAAA 3 A_Chase
	TNT1 AAAAAAAAAAAAA 1 A_Wander
	VFOD CDABCDABCDA 2 
	{
	A_Chase;
	A_SpawnItemEx("PB_SkulkerTrailC");
	}
	TNT1 AAA 3 A_Chase
	VFOD BCDABCD 2 
	{
	A_Chase;
	A_SpawnItemEx("PB_SkulkerTrailD");
	}
	TNT1 A 0 A_Jump(6,"MeleedRoam")
	Loop
	
  BurstTele:
	TNT1 A 0 A_SetSpeed(60)
	TNT1 A 0 A_PlaySound("skulker/Phase",CHAN_6,1.0,1)
	VFOD OOOOOOO 5
	{
	A_FaceTarget;
	A_SpawnItemEx ("PB_SkulkerSmoke", -2, random (-8, 8), random (8, 50), 0, random (-1, 1), random (-1, 1), 0, 160);
	}
	TNT1 AAAAAA 1 A_Chase
	TNT1 A 0 A_PlaySound("skulker/Port",CHAN_7)
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	VFOD A 5 A_FaceTarget
	TNT1 AAAAAA 1 A_Chase
	TNT1 A 0 A_PlaySound("skulker/Port",CHAN_7)
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	VFOD A 5 A_FaceTarget
	TNT1 AAAAAA 1 A_Chase
	TNT1 A 0 A_PlaySound("skulker/Port",CHAN_7)
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	VFOD A 5 A_FaceTarget
	TNT1 AAAAAA 1 A_Chase
	TNT1 A 0 A_PlaySound("skulker/Port",CHAN_7)
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	VFOD A 5 A_FaceTarget
	TNT1 AAAAAA 1 A_Chase
	TNT1 A 0 A_PlaySound("skulker/Port",CHAN_7)
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
	TNT1 A 0 A_Jump(10,"MeleedRoam")
	Loop
	
  Pain:
    TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_StopSound(CHAN_6)
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Normal)
	TNT1 A 0 A_SpawnItemEx("PB_SkulkerSmoke",0,0,20,random(-1,1),random(-1,1),random(-1,1),random(1,360))
    VFOD H 6
	TNT1 A 0 A_PlaySound("skulker/Taunt",CHAN_7)
	VFOD NNOOOONN 3
	TNT1 A 0 A_SetSpeed(20)
	TNT1 A 0 A_CustomMissile("PB_SkulkerFlee",1,0,random(-170,170))
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_Wander
    TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	Goto SeeBegin

  Death:
	TNT1 A 0 A_StopSound(CHAN_6)
	TNT1 A 0 A_SetRenderStyle(1,STYLE_Normal)
	TNT1 A 0 A_Scream
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_Fall
	TNT1 A 0 A_PlaySound("skulker/Flinch",CHAN_7)
	TNT1 AAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
	TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
	TNT1 AAA 0 A_CustomMissile("XDeath3", 32, 0, random(0, 360), 2, random(30, 80))
	TNT1 AAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
	TNT1 AAAA 0 A_CustomMissile("PB_BloodMistBig", 40, 0, random(0, 360), 2, random(30, 90))
	TNT1 AAAA 0 A_CustomMissile("NashGoreBloodSpurt", 32, 0, random(170, 190), 2, random(0, 40))
	TNT1 A 0 A_SpawnItem("GrowingBloodPool")
	VFOD EEEEE 4 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("skulker/Flee","Auto")
	VFOD STUVW 3
	VFOD W -1
	Stop

  XDeath:
	Goto Death

	Death.cut:
	Death.Saw:
		Goto XDeath
	Death.Flames:
	Death.fire:
	Death.Burn:
		Goto Death
	Death.ExtremePunches:
		Goto XDeath
	Death.ExeCution:
		TNT1 A 0 A_JumpIfIntargetInventory("PowerStrength", 1, "SpecialFatality")
	Death.ExeCution1:
		TNT1 A 0 A_Pain
		TNT1 A 0 A_GiveToTarget("GoExecution", 1)
		"####" "#" 10 A_Warp(AAPTR_TARGET,-50,0,0,180,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_PlaySound("misc/xdeath3", 3)
		"####" "#" 10 A_Warp(AAPTR_TARGET,-50,0,0,180,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_PlaySound("misc/xdeath3", 3)
		"####" "#" 10 A_Warp(AAPTR_TARGET,-50,0,0,180,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		Goto Death
	SpecialFatality:
		TNT1 A 0 A_JumpIfIntargetInventory("NoFatality", 1, "Death.ExeCution1")
		TNT1 A 0 A_JumpIfIntargetInventory("FistsSelected", 1, "Death.Fatality")
		Goto Death.ExeCution1
	Death.Fatality:
		TNT1 A 0 A_Pain
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_SpawnItemEx("GloryMedPinataSpawn2",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360))
		TNT1 A 0 A_GiveToTarget("GoFatality", 1)
		TNT1 A 0 A_PlaySound("misc/xdeath2", 4)
		Stop

  Raise:
    VFOD L 5
    VFOD KJI 5
    Goto See
  }
}

ACTOR PB_SkulkerFlee
{
  +NOINTERACTION
  //+CLIENTSIDEONLY
  +THRUACTORS
  +FLOORHUGGER
  +MISSILE
  RenderStyle "Stencil"
  StencilColor Black
  Alpha 0.8
  Speed 17
  XScale 1
  YScale 1.4
  States
  {
  Spawn:
	TNT1 A 1
	VFOD ABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCD 2
	Stop
	}
}

ACTOR PB_SkulkerTrailA
{
+CLIENTSIDEONLY
+NOINTERACTION
Alpha 0.50
XScale 1
YScale 1.4
Renderstyle "Shadow"
States
{
Spawn:
    VFOD A 1 A_FadeOut(0.1)
    Loop
    }
}

ACTOR PB_SkulkerTrailB
{
+CLIENTSIDEONLY
+NOINTERACTION
Alpha 0.50
XScale 1
YScale 1.4
Renderstyle "Shadow"
States
{
Spawn:
    VFOD B 1 A_FadeOut(0.1)
    Loop
    }
}

ACTOR PB_SkulkerTrailC
{
+CLIENTSIDEONLY
+NOINTERACTION
Alpha 0.50
XScale 1
YScale 1.4
Renderstyle "Shadow"
States
{
Spawn:
    VFOD C 1 A_FadeOut(0.1)
    Loop
    }
}

ACTOR PB_SkulkerTrailD
{
+CLIENTSIDEONLY
+NOINTERACTION
Alpha 0.50
XScale 1
YScale 1.4
Renderstyle "Shadow"
States
{
Spawn:
    VFOD D 1 A_FadeOut(0.1)
    Loop
    }
}

ACTOR PB_SkulkerJump {
	Height 15
	Radius 15
	Speed 22
	Damage 2
	+RIPPER
	+THRUGHOST
	+NODAMAGETHRUST
	DeathSound ""
	SeeSound ""
	DamageType "Melee"
	PROJECTILE
		States {
			Spawn:
				TNT1 A 2
				Stop	}}
				
ACTOR PB_SkulkerMelee {
	Height 15
	Radius 15
	Speed 22
	Damage 10
	+RIPPER
	+THRUGHOST
	+NODAMAGETHRUST
	DeathSound ""
	SeeSound ""
	DamageType "Melee"
	PROJECTILE
		States {
			Spawn:
				TNT1 A 3
				Stop	}}
			
ACTOR PB_SkulkerSmoke {
