ACTOR XDeathHFQSDArm1
{
  Radius 8
  Height 8
  Scale 0.8
  Speed 8
  Mass 1
  gravity 0.5
  Decal BrutalBloodSplat
  BounceFactor 0.4
  BounceCount 3
  +DOOMBOUNCE
  +MOVEWITHSECTOR
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOTELEPORT
  +MISSILE
  seesound "bloood"
  deathsound "bloood"
  States
    {
    Spawn:
      TNT1 A 0 A_SpawnItem("brutal_BloodSpot",0,0,0,1)
	  TNT1 A 0 A_JumpIf(waterlevel > 1, "Death")
	  QARM ABCDEFGH 5 A_CustomMissile ("brutal_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (0, 360))
	  Loop
	  
	Death:
	  QARM X 1
      TNT1 A 0 A_SpawnItem("brutal_BloodSpot",0,0,0,1)
      QARM X 0 A_SpawnItem("Gib_HFQSD_Arm")
      Stop
      }
 }

actor Gib_HFQSD_Arm: LimbBase
{
  Scale 0.8
  States
    {
    Spawn:
	  TNT1 A 0
	  TNT1 A 0 
	  QARM X 1 A_SpawnItem("brutal_BloodSpot",0,0,0,1)
	  QARM X -1
      Stop
	  
    Death.plasma:
	Death.Burn: 
	Death.Flames:
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedArm", 32, 0, random (0, 360), 2, random (0, 160))
	  Stop
	
    Death:    
      TNT1 AAAA 0 A_CustomMissile ("brutal_FlyingBloodTrail", 0, 0, random (0, 360), 2, random (0, 360))
      TNT1 A 0 A_CustomMissile ("GibHFQSDHand", 0, 0, random (0, 180), 2, random (0, 180))
      TNT1 A 0 A_CustomMissile ("GibHFQSDArmPart", 0, 0, random (0, 180), 2, random (0, 180))
      Stop
	  
	Death.Kick:
	Death.Melee:
	Death.SuperPunch:
	  QARM XX 1 A_FaceTarget
	  TNT1 A 0 A_CustomMissile ("XDeathHFQSDArm1Kicked", 5, 0, random (170, 190), 2, random (20, 40))
	  Stop
	  
	Pain:
	  TNT1 A 0
	  TNT1 A 0 ThrustThingZ(0,20,0,1)
	  QARM ABCDEFGH 3
	  Goto Spawn
	
	Death.ExplosiveImpact:
	  TNT1 A 0
	  TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 0)
	  TNT1 A 0 ThrustThingZ(0,50,0,1)
	  QARM GH 3
	  QARM ABCDEFGHABDCEFGHABCDEFGH 3 A_CheckFloor("Landz")
	  Goto Landz
	  
	Landz:
	  QARM X 0 A_SpawnItem("Gib_HFQSD_Arm")
	  Stop
      }
 }

