// -------------------
// -------------------
//     QSD ACTORS, Thanks to Brutal Doom Guy!
// -------------------
// -------------------

ACTOR DyingHFQSD : SwitchableDecoration
{
  Game Doom
  Radius 16
  Height 28
  Health 50
  PainSound "grunt/pain"
  PainChance 255
  damagefactor "Blood", 0.0 damagefactor "BlueBlood", 0.0 damagefactor "GreenBlood", 0.0
  damagefactor "Avoid", 0.0
  damagefactor "Leg", 0.0
  damagefactor "Kick", 6.0	
  Mass 50
  -SOLID
  +SHOOTABLE
  +FLOORCLIP
  States
	{
	Death.Fatality:
	Death.SuperPunch:
      TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 1
      Goto Xdeath
		
	Death.fire:
	Death.Flames:
	  TNT1 A 0 A_SpawnItem ("CrueltyBonus5Health")
      TNT1 A 0 A_Scream
      TNT1 A 0 A_NoBlocking
      TNT1 A 1 A_SpawnItemEx("BurningZombie",0,0,0,0,0,0,0,sxf_nocheckposition,0,0)
      Stop
		
	Spawn:
      TNT1 A 0
	  TNT1 A 0 A_SpawnItem ("GrowingBloodPool")
	  TNT1 A 0 A_PlaySound("BURNZOM")
	  QD06 A 10
	Suffer:
	  TNT1 A 0 A_SpawnItem ("HeadshotTarget10", 0, 28,0)
      QD06 BBBBB 2 A_CustomMissile ("PB_SquirtingBloodTrail", 15, 1, random(0, 360), 2, random (0, 45))
      TNT1 A 0 A_SpawnItem ("HeadshotTarget10", 0, 28,0)
	  TNT1 A 0 A_CustomMissile ("PB_BloodmistSmall", 18, -5, random (0, 360), 2, random (0, 160))
      TNT1 A 0 A_SpawnItem ("HeadshotTarget10", 0, 28,0)
      QD06 CCCCC 2 A_CustomMissile ("PB_SquirtingBloodTrail", 15, 1, random(0, 360), 2, random (0, 45))
      TNT1 A 0 A_SpawnItem ("HeadshotTarget10", 0, 28,0)
	  TNT1 A 0 A_CustomMissile ("PB_BloodmistSmall", 18, -5, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_Jump(12, "LastStand")  
	  TNT1 A 0 A_GiveInventory("DeathTimer1", 1)
	  TNT1 A 0 A_JumpIfInventory("DeathTimer1", 10, "GotoDeath")
	  Loop
	  
	GotoDeath:
	  TNT1 A 0
	  Goto Death
		
	Death.Cut:
	Death.Cutless:
	Death:
	  TNT1 A 0 A_StopSound(4)
	  QD06 D 8
	  TNT1 A 0 A_PlaySound ("monsters/zombieman/death")
	  TNT1 A 0 A_SpawnItem ("DeadHFQSD_NoArm")
	  Stop

    Death.Head:
    Death.Decaptate:
	  TNT1 A 0
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 0 A_PlaySound("misc/xdeath4")
	  TNT1 AAAA 0 A_CustomMissile ("PB_Brains1", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains2", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains3", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains4", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains5", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_SpawnItem ("CrueltyBonus5Health")
      TNT1 AAAAAAAAAAA 0 A_CustomMissile ("BrainBlood", 37, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_NoBlocking
      QDD4 A 10
      TNT1 A 0 A_SpawnItem ("DeadHFQSD_NoHeadNoArm", 1)
      Stop

    Death.Shotgun:
	  TNT1 A 0
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 0 A_CustomMissile ("MuchBlood2", 35, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_Scream
	  TNT1 A 0 ThrustThingZ(0,30,0,1)
	  TNT1 A 0 A_NoBlocking
      QDXZ KL 15
      TNT1 A 0 A_SpawnItem ("DeadHFQSD_NoArm")
	  Stop
		 
	Death.Plasma: Death.Plasma2:
      TNT1 A 0
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 0 A_XScream
      TNT1 A 0 A_NoBlocking
	  XBRN AA 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
      TNT1 AAAA 0 A_CustomMissile ("brutal_Blood", 30, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedArm", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedLeg", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedSkull", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedMeat", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedMeat2", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedMeat3", 32, 0, random (0, 360), 2, random (0, 160))
      TNT1 A 0 A_SpawnItem ("CrueltyBonus5Armor")
	  XBRN BB 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
      TNT1 A 0 A_CustomMissile ("brutal_Blood", 30, 0, random (0, 360), 2, random (0, 160))
	  XBRN CC 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
      TNT1 AAAAA 0 A_CustomMissile ("PlasmaParticleX", 48, 0, random (0, 360), 2, random (0, 360))
	  TNT1 AAA 0 A_CustomMissile ("BigPlasmaParticleX", 42, 0, random (0, 360), 2, random (0, 360))
      TNT1 A 0
      Stop		 
		 
    Xdeath:
    Death.SuperPunch:
	Death.Blast:
	Death.SSG:
	  TNT1 A 0 A_SpawnItem ("CrueltyBonus10Armor")
	  TNT1 AAAA 0 A_CustomMissile ("PB_XDeath1", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 A 0 A_CustomMissile ("XDeath2", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 A 0 A_CustomMissile ("XDeath3", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 AAAA 0 A_CustomMissile ("NashgoreBlood", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 AAAA 0 A_CustomMissile ("brutal_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 AAAA 0 A_CustomMissile ("brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 AAAA 0 A_CustomMissile ("PB_SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 AAAA 0 A_CustomMissile ("PB_SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
	  TNT1 A 0 A_CustomMissile ("XDeathHFQSDArm1", 32, 0, random (170, 190), 2, random (0, 40))
	  TNT1 A 0 A_CustomMissile ("XDeathHFQSDHead", 32, 0, random (170, 190), 2, random (0, 40))
      TNT1 A 0 A_XScream
	  TNT1 A 0 A_NoBlocking
      ZZD1 EFGH 6
	  TNT1 A 0 A_SpawnItem ("GrowingBloodPool")
	  ZZD1 H -1
      Stop	
		
	LastStand:
	  TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_Pain
	  TNT1 A 0 A_SpawnItem ("HFQSDLastStand2")
	  Stop
	  }
 }

ACTOR DyingHFQSDNoLeg : SwitchableDecoration
{
  Radius 12
  Height 16
  Speed 9
  Health 50
  PainSound "grunt/pain"
  DeathSound "monsters/zombieman/death"
  +SHOOTABLE
  +FLOORCLIP
  +LOOKALLAROUND
  +FRIGHTENED
  +SOLID
  damagefactor "Kick", 6.0
  damagefactor "trample", 2.0
  PainChance "Kick", 255
  damagefactor "Leg", 0.0
  States
    {
	Pain.Kick:
	  TNT1 A 0 A_CustomMissile ("Teeth", 30, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("Blood", 30, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("TeethNoBounce", 30, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_SpawnItem("CrueltyBonus1health")
	  TNT1 A 0 A_Pain
	  TNT1 A 0 A_FaceTarget
	  QDAK ABA 6
	  QDAM A 15
	  Goto See
	
	Death.Kick:
	Death.SuperKick:
	Death.Extremepunches:
	  TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_GiveToTarget("GoFatality", 1)
      TNT1 A 0 A_GiveToTarget("IsCurbstompingHFQSD", 1)
      Stop
		
	Death.Fatality:
	Death.SuperPunch:
      TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 1
      Goto GotoDeath
	
    Spawn:
	  QDAM A 1 A_Look
	  Loop
	  
    See:
	  QDAM ABAB 10 A_Wander
	  TNT1 A 0 A_CustomMissile ("PB_SquirtingBloodTrail", 2, 1, random(0, 360), 2, random (0, 45))
      QDAM A 9 A_Pain
	  TNT1 A 0 A_SpawnItemEx("NashgoreBlood", 0, 0, 10, 0, 0)
	  TNT1 A 0 A_Jump(12, "LastStand")
	  TNT1 A 0 A_GiveInventory("DeathTimer1", 1)
	  TNT1 A 0 A_JumpIfInventory("DeathTimer1", 15, "GotoDeath")
	  Loop
		
	GotoDeath:
	  TNT1 A 0
	  Goto Death
	
	Death:
	  TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_SpawnItem("DeadHFQSD_NoLeg")
	  Stop
	  
    Crush:
      TNT1 A 0 A_PlaySound("misc/xdeath4")
      CRS2 A 5
      CRS2 A -1
      Stop
	
	Death.Plasma: Death.Plasma2:
      TNT1 A 0
      TNT1 A 0 A_XScream
      TNT1 A 0 A_NoBlocking
	  XBRN AA 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
      TNT1 AAAA 0 A_CustomMissile ("brutal_Blood", 30, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedArm", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedLeg", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedSkull", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedMeat", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedMeat2", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedMeat3", 32, 0, random (0, 360), 2, random (0, 160))
      TNT1 A 0 A_SpawnItem ("CrueltyBonus5Armor")
	  XBRN BB 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
      TNT1 A 0 A_CustomMissile ("brutal_Blood", 30, 0, random (0, 360), 2, random (0, 160))
	  XBRN CC 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
	  TNT1 AAAAA 0 A_CustomMissile ("PlasmaParticleX", 48, 0, random (0, 360), 2, random (0, 360))
	  TNT1 AAA 0 A_CustomMissile ("BigPlasmaParticleX", 42, 0, random (0, 360), 2, random (0, 360))
      TNT1 A 0
      Stop		 
	
	Death.Fire:
	Death.Flames:
	Death.Burn:
	  TNT1 A 0 A_SpawnItem ("CrueltyBonus5Armor")
	  TNT1 A 0 A_SpawnItem ("CrueltyBonus5Health")
	  BRZ3 IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII 3 A_CustomMissile("BurnParticles", 5, 0, random (0, 360), 2, random (50, 130))
	  TNT1 A 0 A_SpawnItem("100SmallFireFocusSpawnerz")
	  BRZ3 IIIIIIIIIIIIIIIII 10 A_CustomMissile("PlasmaSmoke", 15, 0, random (0, 360), 2, random (50, 130))
	  BRZ3 I -1
	  Stop
	
	Death.Trample:	
	  TNT1 A 0 A_CustomMissile ("MuchBlood2", 10, 0, random (0, 360), 2, random (0, 160))
	  TNT1 AAAA 0 A_CustomMissile ("PB_Brains1", 10, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains2", 10, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains3", 10, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains4", 10, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains5", 10, 0, random (0, 360), 2, random (0, 160))
	  TNT1 AAAA 0 A_CustomMissile ("PB_SmallBrainPieceFast", random (45, 55), random (5, -5), random (170, 190), 2, random (-10, 10))
	  TNT1 AAAA 0 A_CustomMissile ("PB_SmallBrainPieceFast", 10, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_SpawnItem ("StompedHFQSD") // FIX
	  TNT1 A 0 A_SpawnItem ("CrueltyBonus5Armor")
	  Stop
		
	LastStand:
	  TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_Pain
	  TNT1 A 0 A_SpawnItem ("HFQSDLastStand1")
	  Stop	
	  }
 }

ACTOR DyingHFQSDLegBlewedOff: DyingHFQSDNoLeg
{
  Game Doom
  Radius 16
  Height 28
  Health 50
  PainSound "grunt/pain"
  PainChance 255
  damagefactor "Blood", 0.0 damagefactor "BlueBlood", 0.0 damagefactor "GreenBlood", 0.0
  damagefactor "Avoid", 0.0
  damagefactor "Kick", 6.0	
  Mass 50
  -SOLID
  +SHOOTABLE
  States
	{
	Death.Fatality:
	Death.SuperPunch:
      TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 1
      Goto Xdeath
			
	Spawn:
      TNT1 A 0
	  TNT1 A 0 A_SpawnItem ("GrowingBloodPool")
	  TNT1 A 0 A_PlaySound("BURNZOM")
