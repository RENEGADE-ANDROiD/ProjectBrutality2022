      TNT1 A 0 A_PlaySound("misc/xdeath4")
	  TNT1 AAAA 0 A_CustomMissile ("PB_Brains1", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains2", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains3", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains4", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains5", 32, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_SpawnItem ("CrueltyBonus5Health")
      TNT1 AAAAAAAAAAA 0 A_CustomMissile ("BrainBlood", 37, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_NoBlocking
      QD03 IJ 6
      TNT1 A 0 A_SpawnItem ("DeadHFQSD_NoLeg", 1)
      Stop

    Death.Shotgun:
	  TNT1 A 0
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 0 A_CustomMissile ("MuchBlood2", 35, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_Scream
	  TNT1 A 0 ThrustThingZ(0,30,0,1)
	  TNT1 A 0 A_NoBlocking
      QDXZ KL 15
      TNT1 A 0 A_SpawnItem ("DeadHFQSD_NoArm")
	  Stop
		  
    Death.Plasma: Death.Plasma2:
