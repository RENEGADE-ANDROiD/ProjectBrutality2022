	  TNT1 A 0 A_CustomMissile ("XDeathHFQSDHead", 32, 0, random (170, 190), 2, random (0, 40))
      TNT1 A 0 A_XScream
	  TNT1 A 0 A_NoBlocking
      ZZD1 EFGH 6
	  TNT1 A 0 A_SpawnItem ("GrowingBloodPool")
	  ZZD1 H -1
      Stop		 
	  }
 }

ACTOR BrutalizedHFQSD1 : SwitchableDecoration
{
  Game Doom
  Radius 16
  Height 50
  Health 20
  PainSound "grunt/pain"
  PainChance 255
  Mass 999999
  -SOLID
  +SHOOTABLE
  +FLOORCLIP
  Scale 1.0
  States
	{
	Death.Fatality:
	Death.SuperPunch:
      TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_StopSound(4)
      TNT1 A 1
      Goto Xdeath
		
	Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_Recoil(2)
	  TNT1 A 0 A_CustomMissile ("XDeathHFQSDArm1", 35, 0, random (0, 360), 2, random (0, 160))
      TNT1 AAAA 0 A_CustomMissile ("PB_XDeath1", 40, 0, random (0, 360), 2, random (0, 160))
	Pain:
      QDD1 A 30
	  Goto DieNow
	
    DieNow:
	  TNT1 A 0
	  TNT1 A 0 A_SpawnItem ("BrutalizedHFQSDStop")
	  Stop
	
	Death:
	  TNT1 A 0
	  TNT1 AAAA 0 A_CustomMissile ("PB_Brains1", 50, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains2", 50, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains3", 50, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains4", 50, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("PB_Brains5", 50, 0, random (0, 360), 2, random (0, 160))
	  TNT1 AAAA 0 A_CustomMissile ("PB_SmallBrainPieceFast", random (45, 55), random (5, -5), random (170, 190), 2, random (-10, 10))
	  TNT1 AAAA 0 A_CustomMissile ("PB_SmallBrainPiece", 50, 0, random (0, 360), 2, random (0, 160))
	  TNT1 AA 0 A_CustomMissile ("PB_SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
      TNT1 AAAAAAAAAAA 0 A_CustomMissile ("BrainBlood", 50, 0, random (0, 360), 2, random (0, 160))
	  TNT1 AAA 0 A_CustomMissile ("PB_XDeath1", 40, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_Recoil(2)
	  QDD1 B 16
	  TNT1 A 0
	  TNT1 A 0 A_SpawnItem ("BrutalizedHFQSD2")
	  Stop
		
	XDeath:
	  TNT1 A 0 A_XScream  
	  TNT1 A 0 A_NoBlocking
      TNT1 A 0 A_CustomMissile ("HFQSDXDeath", 0, 0, random (0, 360), 2, random (0, 160))
      Stop
	
	Death.Plasma: Death.Plasma2:
      TNT1 A 0
      TNT1 A 0 A_XScream
      TNT1 A 0 A_NoBlocking
	  XBRN AA 2 BRIGHT A_SpawnItem("BlueFlare",0,43)
      TNT1 AAAA 0 A_CustomMissile ("brutal_Blood", 30, 0, random (0, 360), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile ("XDeathBurnedArm", 32, 0, random (0, 360), 2, random (0, 160))
