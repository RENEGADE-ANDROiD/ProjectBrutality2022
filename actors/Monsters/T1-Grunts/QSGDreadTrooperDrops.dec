// Stubs for QSG Dread Trooper drop references from Monster Pack
ACTOR PB_QSGZombieDrop : CustomInventory
{
	Inventory.PickupMessage "Picked up some shells."
	Inventory.Amount 1
	Inventory.MaxAmount 0
	+INVENTORY.ALWAYSPICKUP
	+COUNTITEM
	States
	{
	Spawn:
		SHEL A -1
		Stop
	Pickup:
		TNT1 A 0 A_GiveInventory("NewShell", 4)
		Stop
	}
}

ACTOR PB_LeechPickup : CustomInventory
{
	Inventory.PickupMessage "Picked up a health bonus."
	Inventory.Amount 1
	Inventory.MaxAmount 0
	+INVENTORY.ALWAYSPICKUP
	+COUNTITEM
	States
	{
	Spawn:
		BON1 A -1
		Stop
	Pickup:
		TNT1 A 0 A_GiveInventory("HealthBonus", 1)
		Stop
	}
}
