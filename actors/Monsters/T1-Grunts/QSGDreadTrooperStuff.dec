{
  Radius 10
  Height 18
  Projectile 
  +RANDOMIZE
  DamageType Normal
  Damage 4
  +FORCEXYBILLBOARD
  +THRUGHOST
  +BLOODSPLATTER 
  RenderStyle Add
  Alpha 0.6
  HitObituary "$OB_IMPHIT"
  Obituary "$OB_IMPHIT"
  +DONTHURTSPECIES
  SeeSound "None"
  DeathSound "none"
  Decal "none"
  DamageType Flames
  States
	{
	Spawn:
		TNT1 A 4 BRIGHT
		Stop
	Death:
        TNT1 A 0 A_PlaySound("AxeHit")
		TNT1 A 0 BRIGHT
		Stop
	}
}
