    Pain.Kick:
    Pain.ExplosiveImpact:
	Pain.ExtremePunches:
	  TNT1 A 0
	  TNT1 A 0 A_JumpIfInventory ("IsDown", 1, "Pain")
	  QDXZ A 0 A_Pain
	  TNT1 A 0 A_GiveInventory("IsDown", 1)
	  TNT1 A 0 A_TakeInventory("SKQSGDreadTrooper", 1)
	  TNT1 A 0 ThrustThingZ(0,30,0,1)
	  TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
	  QDXZ A 1 A_facetarget
	  QDXZ A 6 ThrustThing(angle*256/360+128, 10, 0, 0)
	  QDXZ B 8
	  TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
	  Goto FallingAfterImpact

	FallingAfterImpact:
	  QDXZ B 1 A_GiveInventory ("FallingHeight", 1)
	  QDXZ B 1 A_CheckFloor ("GetUp")
	  NULL A 0 A_JumpIf (momz == 0, "GetUp")
	  Loop	

	GetUp:
	  TNT1 A 0
	  TNT1 A 0 A_JumpIfInventory ("FallingHeight", 5, "FallingDie")
	  TNT1 A 0 A_PlaySound("BODYF",6)
	  TNT1 A 0 A_TakeInventory("FallingHeight", 100)
	  QDXZ CCCCCCC 5 A_JumpIf(momz < 0, "FallingAfterImpact")
      TNT1 A 0 A_TakeInventory("IsDown", 1)
	  QDXZ D 10
	  Goto See

	FallingDie:
	  TNT1 A 0
	  TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
	  TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
	  TNT1 A 0 A_SpawnItem("SplatteredSmall")
	  TNT1 A 0 A_JumpIfInventory ("FallingHeight", 15, "Death.Stomp")
	  TNT1 A 0 A_JumpIfInventory ("FallingHeight", 10, "FallingSuperDeath")
	  TNT1 A 0 A_JumpIfInventory ("FallingHeight", 5, "FallingDeath")

	FallingDeath:
	  TNT1 A 0
	  TNT1 A 0 A_Scream
	  TNT1 AAAA 0 A_CustomMissile ("XDeath1", 32, 0, random (0, 360), 2, random (50, 130))
	  QDXZ AB 2
	  TNT1 A 0 A_NoBlocking
	  TNT1 A 0 A_PlaySound("BODYF",6)
	  TNT1 A 0 A_SpawnItem ("BigBloodSpot")
	  TNT1 A 0 A_SpawnItem ("DeadHFQSD1")
	  Stop
	
	FallingSuperDeath:
	  TNT1 A 0
	  TNT1 A 0 A_XScream
	  TNT1 A 0 A_NoBLocking
	  TNT1 A 0 A_SpawnItem ("BigBloodSpot")
	  Goto Death.ExplosiveImpact+1		
		
	Pain.Siphon:
      //TNT1 A 0 A_SpawnItem("HeadshotTarget30", 0, 45,0)
