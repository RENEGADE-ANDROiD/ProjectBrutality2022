	  QDTM G 1 
	  {
	  A_FaceTarget;
	  A_GiveToTarget("HealthBonus",4);
	  }
	  QDTM G 5 A_FaceTarget 
	  TNT1 A 0 A_Pain
	  Goto See	
		
