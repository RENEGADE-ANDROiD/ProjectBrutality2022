// 2023-08-04 Creation Date 
// 2023-04-05 Tried to tidy up code (Yuck, what a mess!!)
// 2023-04-08 Added Combat Dialogue
/*
Actor PB_QSGDreadTrooper : PB_Sergeant
{
  Tag "Quad Dread Trooper"
  Game Doom
  Monster
  Species "Former_Human"
  Health 220
  WoundHealth 25 
  Radius 16
  Height 46
  Speed 10
  FastSpeed 14	
  Scale 1.1
  MaxStepHeight 24
  MaxDropOffHeight 32
  +MISSILEMORE
  DamageFactor "Blood", 0.0 DamageFactor "BlueBlood", 0.0 DamageFactor "GreenBlood", 0.0
  DamageFactor "TeleportRemover", 0.0
  DamageFactor "Freeze", 2.0
  DamageFactor "Flames", 0.25
  DamageFactor "Fire", 0.25
  DamageFactor "Burn", 0.25		
  SeeSound "grunt/sight"
  PainSound "grunt/pain"
  DeathSound "grunt/death"
  ActiveSound "grunt/active"
  DropItem "PB_Shell"
  DropItem "DropedPB_SSG"
  DropItem "LeechGrenade" 30
  DropItem "Crucible" 6 
  Obituary "%o was fried by a Dread Trooper"
  States
    {	
 	Wound: 
	  "####" "#" 1
	  {
	  if(GetCvar("be_ExecutionsON"))
	  {
	  if(countinv("FinisherToken")==0) //if it isnt healing already
	  {	//will heal and give the token that indicates it's executable
	  A_SpawnItemEx("ZombieHighlight",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION); //to highlight if ON, and to remove the token after the monster heals
	  A_GiveInventory("FinisherToken",1);	//token to allow melee attack to execute
	  A_GiveToTarget("BloodPunchKilled",1); // Check BloodPunch
	  }	
	  if(GetCvar(be_MonsterStagger)==1) //will the monsters stagger at all?
	  {
	  return state("Stagger");	//stays there for a few seconds
	  }
	  else
	  {
	  return state(0);
		   }
	  }
	  return state(0);
	  }
	  Goto See
	 
    Stagger: 
	  QDFX A 0 
	  {
	  if(getcvar(be_ExecutionHighlight)==1)
	  {	return state("PrepareStaggerHighlight");}
	  else
	  {	return state("StagLooper");	}
	  }
	  Goto StagLooper
	
	PrepareStaggerHighlight: 
	  QDFX A 4
	  Goto StagLooper
	
	StagLooper: 
	  QDFX A 4
	  {
	  if(!countinv("FinisherToken"))
	  {
	  return state("See");
	  }
	  if(getcvar(be_NoisyStagger) && countinv("PainSoundToken"))
	  { 
	  A_Pain; 
	  A_TakeInventory("PainSoundToken");
	  }
	  return state(0);
	  }
	  "####" "#" 0 A_SpawnItem("HeadshotTarget4", 0, 42,0)
	  "####" "#" 0
	  Loop  

	Death.Crucible: 
	  TNT1 A 0 A_SpawnItemEx("GlorySawPinataLow",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360))
	  Goto Death.cut	
	
	Death.GloryFire: 
	  TNT1 A 0 A_SpawnItemEx("FlamePinataSpawn",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360))
	  Goto Death.Fire

	Pain.GloryFire: 
	  TNT1 A 0 A_Jump(192, "See")
	  TNT1 A 0 A_SpawnItemEx("FlamePinataSpawn",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360))
	  Goto See
	
	Death.BloodPunch: 
	  TNT1 A 0 A_GiveToTarget("BloodPunchKilled",1)
	  TNT1 A 0 A_GiveToTarget("BloodPunchArmor",1)
	  TNT1 A 0	A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH)
	  TNT1 A 0	A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH)
	  TNT1 A 0	A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH)
	  TNT1 A 0	A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH)
	  TNT1 A 0 A_SpawnItemEx("GlorySawPinataLow",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360))
	  Goto Death.ExtremePunches

	Death.Execution: 
	  TNT1 A 0 
	  {
 	  A_Stopsound;
	  A_FaceTarget;
	  A_NoBlocking;
	  }
	  QDTM A 14 
	  TNT1 A 0 A_Pain
	  QDTM G 15
	  TNT1 A 0 A_Recoil(4)
	  TNT1 A 0 A_GiveToTarget("BPtoken",1)
	  TNT1 A 0 A_SpawnItemEx("GlorySawPinataLow",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360))
      Goto Death.ExtremePunches	 
  
	Spawn:
	  TNT1 A 0
	  TNT1 A 0
	  TNT1 A 0 A_GiveInventory("SKQSGDreadTrooper", 1)
	  TNT1 A 0 A_GiveInventory("TypeSergeant", 1)
	  TNT1 A 0 A_TakeInventory("SergeantAmmo", 6)
	  TNT1 A 0 A_GiveInventory("SergeantAmmo", random(0,5))
	  QDTI B 1
	  Goto Stand
	
	Stand:
	  TNT1 A 0 A_CheckSight("Stand2")
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget20", 5, 44,0)
	  QDTI A 10 A_Look
	  QDTI B 10 A_Look
	  Loop
		
	Stand2:
	  QDTI A 14 A_Look
	  QDTI A 14 A_Look
	  Goto Stand
		
	SearchForPlayer:
	Idle:
	  TNT1 A 0 A_ClearTarget
	  TNT1 A 0 A_TakeInventory("EnemyMemory", 30)
	  TNT1 A 0 A_GiveInventory("SKQSGDreadTrooper", 1)
	  TNT1 A 0 A_Stop
      //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTI A 10 A_Look
      //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTI B 10 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTI A 10 A_Look
      //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTI B 10 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTI A 10 A_Look
		
	  QDTM A 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
	  QDTM B 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
	  QDTM C 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
	  QDTM D 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
		
	  TNT1 A 0 A_Jump(128, "Idle")
	  QDTM A 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
	  QDTM B 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
	  QDTM C 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
	  QDTM D 4 A_Look
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_Wander
	  TNT1 A 0 A_Recoil(-1)
	  Loop
	
	See:
	  TNT1 A 0 A_ChangeFLag("NODROPOFF", 0)
	  TNT1 A 0 A_TakeInventory("SKQSGDreadTrooper", 1)
	  TNT1 A 0 A_TakeInventory("EnemyMemory", 15)
	  TNT1 A 0 A_CheckSight("SeeNeverSeen")
	  Goto SeeContinue
	
	SeeContinue:
	  TNT1 A 0 A_ChangeFLag("NODROPOFF", 0)
	  TNT1 A 0 A_JumpIfTargetInLOS("Fallback",0,JLOSF_DEADNOJUMP,150)
	  TNT1 A 0 A_ChangeFLag("NODROPOFF", 0)
	  TNT1 A 0 A_JumpIfInventory("EnemyMemory", 15, "SearchForPlayer")
	  TNT1 A 0 A_GiveInventory("EnemyMemory", 1)
	  TNT1 A 0 A_TakeInventory("SKQSGDreadTrooper", 1)

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM AA 2 A_Chase

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM AA 2 A_Chase
	  TNT1 A 0 A_Jump(24, "Pain.Avoid")
	  TNT1 A 0 A_PlaySound("humans/step",3)

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM BB 2 A_Chase
	  
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM BB 2 A_Chase

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM CC 2 A_Chase

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM CC 2 A_Chase
	  
	  TNT1 A 0 A_PlaySound("humans/step",3)
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM DD 2 A_Chase

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM DD 2 A_Chase
	  Loop
		
	SeeNeverSeen:
	  TNT1 A 0 A_JumpIfCloser(200, "FallBack")
	Advance:
	  TNT1 A 0 A_ChangeFLag("NODROPOFF", 0)
        
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM AA 2 A_Chase
	  TNT1 A 0 A_Recoil(-1)
	  TNT1 A 0 A_TakeInventory("SKQSGDreadTrooper", 1)

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM BB 2 A_Chase

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM CC 2 A_Chase

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM DD 2 A_Chase
	  Loop
		
	FallBack:
      TNT1 A 0 A_CheckSight("Advance")
      TNT1 A 0 A_ChangeFLag("NODROPOFF", 1)
 
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
      TNT1 A 0 A_SpawnItem ("LegTarget4", 10)
      QDTM D 2 A_FaceTarget
      TNT1 A 0 A_Jump(100, "Missile", "Pain.Avoid")
      TNT1 A 0
      QDTM D 2 A_Recoil(5)
        
      TNT1 A 0 A_Jump(64, "Missile")
      //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
      TNT1 A 0 A_SpawnItem ("LegTarget4", 10)
      TNT1 A 0 A_PlaySound("humans/step",4)
      QDTM C 2 A_FaceTarget
      QDTM C 2 A_Recoil(5)

      //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
      TNT1 A 0 A_SpawnItem ("LegTarget4", 10)
      QDTM B 2 A_FaceTarget
      QDTM B 2 A_Recoil(5)

      //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 5, 40,0)
      TNT1 A 0 A_SpawnItem ("LegTarget4", 10)
      TNT1 A 0 A_PlaySound("humans/step",4)
      QDTM A 2 A_FaceTarget
      QDTM A 2 A_Recoil(4)
      TNT1 A 0 A_ChangeFLag("NODROPOFF", 0)
      Goto Missile		
		
	Melee:
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  TNT1 A 0 A_Jump(224, 2)
	  TNT1 A 0 //A_CombatDialogueHandler
	  QDME A 6 A_FaceTarget
	  TNT1 A 0 A_Recoil(1)

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  TNT1 A 0 A_StartSound("QSGDTM")
	  TNT1 A 0 A_SpawnProjectile("QSGDreadTrooperBashAttack",10,0,0,0)
	  TNT1 A 0 A_CustomMissile ("SmallFlameTrails", 57, 13, 5, 0, 5)
	  QDME B 10 A_FaceTarget

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDME A 6
	  TNT1 A 0 A_TakeInventory("EnemyMemory", 10)
	  TNT1 A 0 A_TakeInventory("EnemyMemory", 10)
	  TNT1 A 0 A_Jump(96, "Melee")
	  TNT1 A 0 A_Jump(8, "Pain.Avoid")
	  TNT1 A 0 A_ClearTarget
	  Goto FallBack
		
	DialogueCheck:
	  TNT1 A 0 A_Jump(240, "MissileContinueDialogue")
	  TNT1 A 0 A_CombatDialogueHandler
	  Goto MissileContinueDialogue		
	
	Missile:
	  TNT1 A 0 A_Stop
	  TNT1 A 0 A_Jump(64, "Pain.Avoid","Teleportaway")
	  TNT1 A 0 A_CheckLOF("MissileSafeToFire") // Checks if it is safe to fire Dragonbreath
	  Goto See  // Not safe to fire

	MissileSafeToFire:
	  TNT1 A 0 A_Jump(96,"MissileContinue") 
	  TNT1 A 0 A_JumpIfCloser (100,"Melee")
	
	MissileContinue:
	  TNT1 AAA 0  
	  TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer",1, "DialogueCheck")
	MissileContinueDialogue:
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  TNT1 A 0 A_Jump(96, "MissileCrouched")
	  QDTM E 0 A_JumpIfInventory("QuadShotgunDreadTrooperCounter", 1, "SingleShot")
	
	QuadShot:
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM EEEE 5 A_FaceTarget
	  QDTM F 0 Bright A_PlaySound("DRBTFIRE", 12)	

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM F 0 Bright A_GiveInventory("QuadShotgunDreadTrooperCounter", 4)

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 35, 30, random (0, 40), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 35, 15, random (0, 40), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 25, 20, random (-40, 0), 2, random (-10, 0))
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 25, -20, random (-40, 0), 2, random (-10, 0))

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM F 4
	  TNT1 AAAAAAAAAA 0 A_CustomMissile("QSGDreadTrooperDragonsBreathTracer", 35,14,frandom(-10,10),1,frandom(-6,6))
		
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM EE 6 A_FaceTarget
		
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  Goto Reload
	
	MissileCrouched:
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 20,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTC EEEE 5 A_FaceTarget

	  QDTC F 0 Bright A_PlaySound("DRBTFIRE", 12)	
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 20,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTC F 0 Bright A_GiveInventory("QuadShotgunDreadTrooperCounter", 4)

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 20,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 27, 30, random (0, 40), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 27, 15, random (0, 40), 2, random (0, 160))
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 17, 20, random (-40, 0), 2, random (-10, 0))
	  TNT1 A 0 A_CustomMissile("OrangeLensFlareAlt", 17, -20, random (-40, 0), 2, random (-10, 0))
	  TNT1 AAAAAAAA 0 A_CustomMissile("OrangeLensFlareAlt", 28, 0, random(-9, 9), 6, random(-9, 9))	

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 20,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTC F 4 A_FaceTarget
	  TNT1 AAAAAAAAAA 0 A_CustomMissile("QSGDreadTrooperDragonsBreathTracer", 32,14,frandom(-10,10),1,frandom(-6,6))

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 20,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTC EE 6 A_FaceTarget

	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 20,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  Goto Reload	
	
	Reload:
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  TNT1 A 0 A_Jump(128, "ReloadContinue")		
	  TNT1 A 0 A_StartSound("monsters/zombie/reload",CHAN_AUTO)	
	ReloadContinue:
	  QDTM A 4 A_FaceTarget
	  QDTX FABCDE 3
	  TNT1 A 0 A_StartSound("insertshell")
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM E 0 A_TakeInventory("QuadShotgunDreadTrooperCounter", 4)
		
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  QDTM A 4 A_FaceTarget
	  QDTX FABCDE 3 
	  TNT1 A 0 A_StartSound("insertshell")
		
	  //TNT1 A 0 A_SpawnItem("HeadshotTarget10", 0, 40,0)
	  TNT1 A 0 A_SpawnItem ("LegTargetBase", 10)
	  TNT1 A 0 A_Jump(128, "Pain.Avoid","Teleportaway")	
	  Goto SeeContinue
	
    Teleportaway:
	  TNT1 A 0 A_JumpIfInventory("GSGDTteleportTimer", 1, "MissileSafeToFire")
	  TNT1 A 0 A_StartSound("QSGDTTO")
	  TNT1 A 0 A_spawnitemex("SmallExplosionFlames")
	  QDTT ABCDE 3 BRIGHT
	  TNT1 A 0 A_stop
	  TNT1 A 0 A_changeflag("thruactors",true)
	  TNT1 A 0 A_changeflag("shootable",false)
	  TNT1 A 0 A_changeflag("solid",false)
	  TNT1 A 0 A_changeflag("nopain",true)
	  TNT1 A 0 A_changeflag("floorhugger",true)
	  TNT1 A 1
	  {
	  A_wander;
	  A_CustomMissile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
	  }
	  TNT1 A 0 A_recoil(random (-10, -2))
	  TNT1 A 1
	  {
	  A_wander;
	  A_CustomMissile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
	  }
	  TNT1 A 0 A_recoil(random (-10, -2))
	  TNT1 A 1 
	  {
	  A_wander;
	  A_CustomMissile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
	  }
	  TNT1 A 0 A_recoil(random (-10, -2))
	  TNT1 A 1 
	  {
	  A_wander;
	  A_CustomMissile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
	  }
	  TNT1 A 0 A_recoil(random (-10, -2))
	Stayteleported:
	  TNT1 A 1 
	  {
	  A_wander;
	  A_CustomMissile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
	  }
	  TNT1 A 0 A_recoil(random (-10, -2))
	  TNT1 A 0 A_jump(25, "Teleportback")
	  Loop

	Teleportback:
	  TNT1 A 0 A_stop
	  TNT1 A 0 A_StartSound("QSGDTTI")			
	  QDTT EDCBA 3 BRIGHT
	  TNT1 A 0 A_spawnitemex("SmallExplosionFlames")
	  TNT1 A 0 A_changeflag("floorhugger",false)
	  TNT1 A 0 A_changeflag("nopain",false)
      TNT1 A 0 A_changeflag("thruactors",false)
	  TNT1 A 0 A_changeflag("shootable",true)
	  TNT1 A 0 A_changeflag("solid",true)
