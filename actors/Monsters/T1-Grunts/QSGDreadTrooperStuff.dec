	Death.MinorLeg:	
	  TNT1 A 0 	
	  QDTM I 5 
	  QDTM J 5 A_NoBlocking
	  QDTM K 5
	  TNT1 A 0 A_PlaySound("BODYF",6)
	  TNT1 A 0 A_SpawnItem ("GrowingBloodPool")
      TNT1 A 0 A_SpawnItem ("DeadHFQSD1", 1)
