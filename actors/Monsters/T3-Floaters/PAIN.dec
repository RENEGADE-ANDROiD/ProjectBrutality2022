//===========================================================================
//
// Pain Elemental
//
//===========================================================================
ACTOR PB_PainElemental Replaces PainElemental
{
	//$Title Pain Elemental
	//$Category Project Brutality - Monsters/Flyers
	//$Sprite PAINA1
	Health 400
	Radius 31
	Height 70
	Mass 400
    Scale 1.4
	Speed 9
	PainChance 128
	Monster
	+FLOAT 
	+NOGRAVITY
	SeeSound "pain/sight"
	damagefactor "Avoid", 0.0
	damagefactor "GibRemoving", 0.0
	PainSound "pain/pain"
	DeathSound "pain/death"
	ActiveSound "pain/active"
    bloodtype "Brutal_Blood"
	DropItem "DemonStrengthRune" 5
	damagefactor "TeleportRemover", 0.0
	DamageFactor "CauseObjectsToSplash", 0.0
	PainChance "Kick", 255
	PainChance "Stun", 255
	PainChance "Siphon", 255
	damagefactor "Avoid", 0.0
	damagefactor "killme", 0.0
	damagefactor "Blood", 0.0 damagefactor "BlueBlood", 0.0 damagefactor "GreenBlood", 0.0
    damagetype Flames
	
	DropItem "Demonpickup" 128
	
	Species "FlyingBalls"
    +DONTHARMSPECIES
	
	States
	{
	
	Death.Blackhole:
        TNT1 A 0 A_NoBlocking
        TNT1 A 0 A_SpawnItem("BlackHoledPainElemental")
		Stop
	
	ReplaceVanilla:
		TNT1 A 0 A_ChangeFlag("THRUACTORS", 1)
		TNT1 A 0 A_ChangeFlag("COUNTKILL", 0)
		TNT1 A 0 A_SpawnItemEx ("Vanilla_PainElemental1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION |SXF_TRANSFERSPECIAL| SXF_TRANSFERAMBUSHFLAG ,0)
		Stop
	
	Spawn:
		TNT1 A 0 ACS_ExecuteAlways(796, 0, 0, 0, 0)
		TNT1 AA 0
		PAIN A 10 A_Look
		Goto Spawn+2


SearchPlayer:
        TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_TakeInventory("EnemyMemory", 30)
		PAIN A 10 A_Look
		TNT1 A 0 A_SetAngle(angle - 30)
		PAIN A 10 A_Look
		TNT1 A 0 A_SetAngle(angle + 30)
		PAIN A 10 A_Look
		TNT1 A 0 A_SetAngle(angle + 30)
		PAIN A 10 A_Look
		TNT1 A 0 A_SetAngle(angle - 30)
		
		PAIN AA 3 A_Wander
		PAIN A 2 A_look
		PAIN BB 3 A_Wander
		PAIN B 2 A_look
		PAIN CC 3 A_Wander
		PAIN C 2 A_look
		PAIN BB 3 A_Wander
		PAIN B 2 A_look
		PAIN AA 3 A_Wander
		PAIN A 2 A_look
		Loop
		
		
	See:
	    TNT1 A 0
		TNT1 A 0 A_CheckSight("See2")
		TNT1 A 0 A_TakeInventory("EnemyMemory", 10)
		PAIN AABBCC 3 A_Chase
		
		Loop
	
	See2:
	    TNT1 A 0 A_JumpIfInventory("EnemyMemory", 18, "SearchPlayer")
		TNT1 A 0 A_GiveInventory("EnemyMemory", 1)
		PAIN AABBCC 3 A_Chase
		Goto See
		
	Missile:
	    TNT1 A 0 A_TakeInventory("EnemyMemory", 30)
		TNT1 A 0 A_Jump(90, "GroundSlamStart")
		TNT1 A 0 A_Jump(80, "MissileTriple")
		TNT1 A 0 A_Jump(100, "MissileSoulSpawn")
	MissileSoulProjectiles:
		PAIN D 5 A_FaceTarget
		TNT1 A 0 A_Recoil(-8)
		PAIN E 4 A_FaceTarget
		PAIN F 4 BRIGHT A_FaceTarget
		TNT1 A 0 A_CustomMissile("PB_PainSoulAttack", 10, 15, 9, 11)
		TNT1 A 0 A_CustomMissile("PB_PainSoulAttack", 10, 15, 0, 11)
		PAIN E 3
		TNT1 A 0 A_Recoil(8)
		PAIN D 3
		Goto See
	MissileSoulSpawn:
		PAIN D 7 A_FaceTarget
		PAIN E 7 A_FaceTarget
		PAIN F 5 BRIGHT A_FaceTarget
		PAIN F 2 BRIGHT A_PainAttack("PB_LostSoul")
		PAIN ED 7
		Goto See
	MissileTriple:
		PAIN D 5 A_FaceTarget
		TNT1 A 0 A_Recoil(-8)
		PAIN E 4 A_FaceTarget
		PAIN F 4 BRIGHT A_FaceTarget
		TNT1 A 0 A_CustomMissile("PB_PainSoulAttack", 10, 15, 9, 11)
		TNT1 A 0 A_PainAttack("PB_LostSoul")
		TNT1 A 0 A_CustomMissile("PB_PainSoulAttack", 10, 15, 0, 11)
		PAIN E 3
		TNT1 A 0 A_Recoil(8)
		PAIN D 3
		Goto See

	GroundSlamStart:
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
		TNT1 A 0 A_ChangeFlag("FLOAT", 0)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY", 0)
		TNT1 A 0 A_TakeInventory("PB_GroundSlamFallTics", 99)
		TNT1 A 0 A_PlaySound("pain/pain", CHAN_VOICE)
		RPEN A 3 A_ChangeVelocity(0, 0, 4, CVF_RELATIVE)
		RPEN B 3 A_ChangeVelocity(0, 0, 4, CVF_RELATIVE)
		RPEN C 3 A_FaceTarget
		RPEN D 4 A_FaceTarget
		Goto GroundSlamFalling
	GroundSlamFalling:
		TNT1 A 0 A_GiveInventory("PB_GroundSlamFallTics", 1)
		TNT1 A 0 A_JumpIfInventory("PB_GroundSlamFallTics", 35, "GroundRollStop")
		RPEN D 2 A_ChangeVelocity(0, 0, -25, CVF_RELATIVE)
		EXPL A 0 A_CustomMissile("ExplosionSmoke", 0, 0, random(0, 360), 2, random(10, 12))
		TNT1 A 0 A_CheckFloor("GroundSlamImpact")
		TNT1 A 0 A_JumpIf(velz == 0, "GroundSlamImpact")
		Loop
	GroundSlamImpact:
		TNT1 A 0 A_TakeInventory("PB_GroundSlamFallTics", 99)
		TNT1 A 0 A_SpawnItemEx("WhiteShockwave", 0, 0, 0)
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 0 A_Quake(3, 20, 0, 256, "")
		EXPL AA 0 A_CustomMissile("ExplosionSmoke", 0, 0, random(0, 360), 2, random(0, 30))
		TNT1 A 0 A_PlaySound("player/cyborg/fist", CHAN_AUTO)
		TNT1 A 0 A_FaceTarget
		Goto GroundRoll1
	GroundRoll1:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRoll2
	GroundRoll2:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRoll3
	GroundRoll3:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRoll4
	GroundRoll4:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRoll5
	GroundRoll5:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRoll6
	GroundRoll6:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRoll7
	GroundRoll7:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRoll8
	GroundRoll8:
		TNT1 A 0 A_FaceTarget(1, 0)
		RPEN E 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN F 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN G 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		RPEN H 2 ThrustThing(angle*256/360, 4)
		TNT1 A 0 A_JumpIf(Momx == 0 && Momy == 0, "GroundSlamHitWall")
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Goto GroundRollStop
	GroundRollStop:
		TNT1 A 0 A_TakeInventory("PB_GroundSlamFallTics", 99)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
		TNT1 A 0 A_ChangeFlag("FLOAT", 1)
		TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
		RPEN A 5 A_ChangeVelocity(0, 0, 1, CVF_RELATIVE)
		RPEN B 5
		RPEN C 5
		RPEN D 5
		TNT1 A 0 A_Jump(85, "MissileTriple")
		Goto See
	GroundSlamHitWall:
		TNT1 A 0 A_TakeInventory("PB_GroundSlamFallTics", 99)
		TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
		TNT1 A 0 A_ChangeFlag("FLOAT", 1)
		TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
		TNT1 A 0 A_PlaySound("pain/pain", CHAN_AUTO)
		TNT1 A 0 A_PlaySound("player/cyborg/fist", CHAN_AUTO)
		TNT1 A 0 A_SpawnItemEx("PB_SlamTrampleDamage", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		EXPL AAAA 0 A_CustomMissile("ExplosionSmoke", 0, 0, random(0, 360), 2, random(10, 40))
		TNT1 A 0 A_SpawnItemEx("WhiteShockwave", 0, 0, 0)
		RPEN A 5 A_ChangeVelocity(0, 0, 1, CVF_RELATIVE)
		RPEN B 5
		RPEN C 5
		RPEN D 5
		TNT1 A 0 A_Jump(85, "MissileTriple")
		Goto See

   Death.ExeCution:
   	TNT1 A 0 A_JumpIfIntargetInventory("PowerStrength", 1, "SpecialFatality")
	Death.ExeCution1:
      TNT1 A 0 A_Pain
      TNT1 A 0 A_GiveToTarget ("GoExecution", 1)
		PAIN G 10 A_Warp(AAPTR_TARGET,-50,0,0,180,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_PlaySound("pain/pain", 6)
		PAIN G 10 A_Warp(AAPTR_TARGET,-50,0,0,180,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_PlaySound("misc/xdeath3", 5)
		PAIN G 10 A_Warp(AAPTR_TARGET,-50,0,0,180,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		Goto Death+3

   SpecialFatality:
 	  TNT1 A 0 A_JumpIfIntargetInventory("NoFatality", 1, "Death.ExeCution1")
		TNT1 A 0 A_JumpIfIntargetInventory("FistsSelected", 1, "Death.Fatality")
		Goto Death.ExeCution1
	
	    Death.Fatality:
		TNT1 A 0 A_Pain
		TNT1 A 0 A_JumpIfIntargetInventory("FistsSelected", 1, 1)
		Goto Death
        TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_GiveToTarget("GoFatality", 1)
        TNT1 A 0 A_GiveToTarget("PEFatality", 1)
        Stop
		
	Pain:
		PAIN G 6
		PAIN G 6 A_Pain
		Goto See
		
	Possession:
    TNT1 A 0 A_SetInvulnerable
    PAIN G 3
    PAIN G 3 A_Pain
    "####" "#" 35 ACS_NamedExecuteAlways("Pos - Flicker effect")
    TNT1 A 0 A_UnSetInvulnerable
    Goto See
	
	Pain.Stun:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx ("StunElectrocute", random (-4, 4), random (-4, 4),  random (16, 32), 0, 0)
		PAIN G 1 A_Pain
		PAIN GGGGGGGGGG 3 A_SpawnItemEx ("StunElectrocute", random (-12, 12), random (-12, 12),  random (16, 52), 0, 0)
		PAIN G 1 A_Pain
		PAIN GGGGGGGGGG 3 A_SpawnItemEx ("StunElectrocute", random (-12, 12), random (-12, 12),  random (16, 52), 0, 0)
		PAIN G 1 A_Pain
		PAIN GGGGGGGGGG 3 A_SpawnItemEx ("StunElectrocute", random (-12, 12), random (-12, 12),  random (16, 52), 0, 0)
		PAIN G 1 A_Pain
		PAIN GGGGGGGGGG 3 A_SpawnItemEx ("StunElectrocute", random (-12, 12), random (-12, 12),  random (16, 52), 0, 0)
		PAIN G 1 A_Pain
		PAIN GGGGGGGGGG 3 A_SpawnItemEx ("StunElectrocute", random (-12, 12), random (-12, 12),  random (16, 52), 0, 0)
		PAIN G 1 A_Pain
		Goto See
	
	Pain.Siphon:
		TNT1 AAA 0 A_SpawnItemEx ("RedLightning_Small", random (-12, 12), random (-12, 12), random (16, 52), 0, 0)
		PAIN G 1 
		{
			A_FaceTarget;
			A_GiveToTarget("HealthBonus",4);
		}
		PAIN G 5 A_FaceTarget 
		TNT1 A 0 A_Pain
		Goto See

	Pain.Kick:
        TNT1 A 0 A_FaceTarget
		PAIN G 12
		PAIN G 12 A_Pain
		Goto See
	Death:
		PAIN H 8 BRIGHT
		PAIN I 8 BRIGHT A_Scream
    TNT1 A 0 A_Explode (220,220)
	TNT1 AAAAAA 0 bright A_CustomMissile ("SuperGoreSpawner", 5, 0, random (0, 360), 2, random (30, 180))
         TNT1 AAAAAAAAA 0 A_CustomMissile ("CeilBloodLauncherLong", 0, 0, random (0, 360), 2, random (50, 130))
		 TNT1 A 0 A_CustomMissile ("XDeathBrain1", 32, 0, random (0, 360), 2, random (0, 160))
		 TNT1 A 0 A_CustomMissile ("XDeathBrain2", 32, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAA 0 A_CustomMissile ("XDeathPainElementalNew1", 32, 0, random (0, 360), 2, random (60, 90))
        TNT1 AAA 0 A_CustomMissile ("XDeathPainElementalNew2", 32, 0, random (0, 360), 2, random (60, 90))
		
		
		 TNT1 AAAAAAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 32, 0, random (0, 360), 2, random (0, 160))
		EXPL A 0 A_SpawnItemEx("ExplosionParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
	EXPL AAAAAAAAAAAAAAAAA 0 A_CustomMissile ("FireBallExplosion", 6, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 BRIGHT A_PainDie("PB_LostSoul")
		
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 4 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 A 0 A_CustomMissile ("ExplosionSmoke", 1, 0, random (0, 360), 2, random (70, 110))
		TNT1 AAA 6 A_CustomMissile ("RealFlameTrailsSmallLong", 1, 0, random (0, 360), 2, random (70, 110))
