// Abyssal Core–style PE Lost Soul projectile (PSOL sprites; death FX reuse PB LS gibs)
ACTOR PB_PainSoulAttack
{
	Radius 6
	Height 10
	Speed 20
	FastSpeed 30
	Damage (random(18,22))
	Projectile
	+THRUGHOST
	+FORCEXYBILLBOARD
	+DONTHURTSPECIES
	RenderStyle Normal
	Alpha 1
	Scale 0.8
	SeeSound "skull/melee"
	DeathSound "LSOD"
	Decal "Scorch"
	Species "FlyingBalls"
	DamageType "Flames"
	States
	{
	Spawn:
		PSOL B 1 BRIGHT
		TNT1 A 0 A_SpawnItem("RedFlareSmall", 0, 12)
		Loop
	Death:
		TNT1 AA 0 A_CustomMissile("SmallLSPart1", 0, 0, random(0, 360), 2, random(0, 360))
		TNT1 AA 0 A_CustomMissile("SmallLSPart3", 0, 0, random(0, 360), 2, random(0, 360))
		EXPL AA 0 A_SpawnItem("ExplosionParticleSpawner")
		TNT1 A 0 A_SpawnItemEx("ExplosionFlareSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		EXPL AAA 0 A_CustomMissile("FireBallExplosionFlamesMedium", 1, 0, random(0, 360), 2, random(0, 360))
		TNT1 AA 0 A_CustomMissile("PlasmaSmoke", 1, 0, random(0, 360), 2, random(0, 360))
		TNT1 A 0 A_SpawnItemEx("TinyBurningPiece", random(-5, 5), random(-5, 5))
		TNT1 AA 0 A_CustomMissile("LSpart1", 12, 0, random(0, 360), 2, random(0, 160))
		TNT1 A 0 A_CustomMissile("LSpart2", 12, 0, random(0, 360), 2, random(0, 160))
		TNT1 A 0 A_CustomMissile("LSpart3", 12, 0, random(0, 360), 2, random(0, 160))
		Stop
	}
}

// Fall timeout counter for GroundSlamFalling (closet / no-floor abort)
ACTOR PB_GroundSlamFallTics : Inventory
{
	Inventory.MaxAmount 99
	Inventory.Amount 0
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
}

// Abyssal Core SlamTrampleDamage — PE ground slam / roll radius hit
ACTOR PB_SlamTrampleDamage
{
	Radius 20
	Height 20
	Speed 0
	+NOBLOCKMAP
	+NOGRAVITY
	+DONTHARMCLASS
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 1 A_Explode(75, 90, 0)
		TNT1 A 0 A_RadiusThrust(5000, 200, RTF_NOIMPACTDAMAGE)
		Stop
	}
}

