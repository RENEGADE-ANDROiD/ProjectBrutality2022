Actor OverLightningTrail
{
  +NOINTERACTION
  RenderStyle Add
  Scale 1.4 
  Alpha 1
  +NoBlockMap
  +NoGravity
  +DontSplash
  Height 0
  Radius 0
  Mass 0
  States
	{
	Spawn:
		DLIT ABC 1 BRIGHT A_SpawnItemEx("OverLightningSparksTrail",0,0,0,0,0,0,0,32)
		Stop
		}
 }

Actor OverLightningTrailExtraSmall : OverLightningTrail
{
  Scale 0.8
  speed 15
  States
	{
	Spawn:
		5H0K ABCDEFGHIJK 1 BRIGHT
		STOP
		}
 }

Actor OverLightningTrailLarge : OverLightningTrail
{
	Scale 1.6
	States
	{
	Spawn:
	DLIT ABC 1 BRIGHT A_SpawnItemEx("OverLightningSparksTrailLarge",0,0,0,0,0,0,0,32)
	Stop
	}
}

Actor OverLightningTrailSmall : OverLightningTrail
{
  Scale 0.8
  States
	{
	Spawn:
		DLIT A 1 BRIGHT A_Jump(96,2)
		TNT1 A 0 A_SpawnItemEx("OverLightningSparksTrailSmall",0,0,0,0,0,0,0,32)
		DLIT B 1 BRIGHT A_Jump(96,2)
		TNT1 A 0 A_SpawnItemEx("OverLightningSparksTrailSmall",0,0,0,0,0,0,0,32)
		DLIT C 1 BRIGHT A_Jump(128,2)
		TNT1 A 0 A_SpawnItemEx("OverLightningSparksTrailSmall",0,0,0,0,0,0,0,32)
		TNT1 A 0
		Stop
		}
 }

Actor OverLightningSparksTrail : OverLightningTrail
{
  Scale 0.7 
  States
	{
	Spawn:
		TNT1 A 0 A_Jump(256,"Spawn1","Spawn2","Spawn3","Spawn4","Spawn5","Spawn6")//randomisation... = LL
	Spawn1:
		5H0K ABCDEFGHIJKABC 1 BRIGHT
	goto Death
		
	Spawn2:
		5H0K CDEFGHIJK 1 BRIGHT
	goto Death

	Spawn3:
		5H0K EFGHIJK 1 BRIGHT
	goto Death
	
	Spawn4:
		5H0K GHIJKA 1 BRIGHT
	goto Death

	Spawn5:
		5H0K IJKA 1 BRIGHT
	goto Death
	
	Spawn6:
		5H0K EFGHIJKAB 1 BRIGHT
	Death:
		TNT1 A 0
		STOP
		}
 }
 
Actor OverLightningSparksTrailLarge: OverLightningSparksTrail
{
  Scale 1 
}

Actor OverLightningSparksTrailSmall: OverLightningSparksTrail
{
  Scale 0.3 
}

ACTOR OverLightningMissile : FastProjectile
{
  Radius 10
  Height 15
  Projectile
  Speed 80
  Damage 10
  DamageType "Incinerate"
  Decal "RedsmallScorch"
  Renderstyle Add
  +EXTREMEDEATH
  +THRUGHOST
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Scale 1.7
  Species "FlyingBalls"
  SeeSound "electrogun/shoot"
  DeathSound "electrogun/hit"
  States
	{
	Spawn:
  		TNT1 A 0 //A_CustomMissile("OverLightningMissile2",0,0,frandom(-15,15),6,(momz+frandom(-15,15)))
 		DLIT A 1 BRIGHT A_SpawnItem("RedFlareSmall",0,0)
		TNT1 A 0 A_Weave(10, 10, random( -7, 7), random( -7, 7))
		TNT1 AAAA 0 A_SpawnItemEx("ObeliskTrailSpark", 0, 0, 0, frandom(15,15), 0, 0, 0, 128)
		DLIT BC 1 BRIGHT A_SpawnItem("RedFlareSmall",0,0)
		TNT1 AAAA 0 A_SpawnItemEx("ObeliskTrailSpark", 0, 0, 0, 20, 0, 0, 0, 128)
		TNT1 AAA 1 A_SpawnItemEx("OverLightningTrail",0,0,0,0,0,0,0,32)
		TNT1 AA 1 A_SpawnItemEx("OverLightningTrail",0,0,0,0,0,0,0,32)	
		Loop
		
	Death:
		3LO2 ABCDEFGH 3 BRIGHT 
		TNT1 AAAAA 0 A_SpawnItemEx("ObeliskTrailSpark", random(19,-19), random(19,-19), random(19,-19), 0, 0, 0, 0, 128, 0)
		TNT2 AAAAA 4 A_CustomMissile ("PlasmaSmoke", 1, 0, random (0, 360), 2, random (0, 160))
		Stop
		}
 }

ACTOR OverLightningMissile1
{
  Radius 2
  Height 4
  Speed 80
  Damage 3
  DamageType "Incinerate"
  PROJECTILE
  +BLOODLESSIMPACT
  -EXTREMEDEATH
  +NODAMAGETHRUST
  +DOOMBOUNCE
  +RIPPER
  -SEEKERMISSILE
  +FORCEPAIN
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  ProjectileKickBack 200
  DeathSound "weapons/lightningend"
  SeeSound "PZAPBOMB"
  Species "FlyingBalls"
  Decal "RedsmallScorch"
  renderstyle ADD
  alpha 0.90
  scale 1.6  
  States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Weave(10, 10, random( -10, 10), random( -10, 10))
		TNT1 A 0 //A_SeekerMissile(40,50, SMF_LOOK|SMF_PRECISE)
		DLIT A 1 BRIGHT //A_SeekerMissile(40,50, SMF_LOOK|SMF_PRECISE)
		TNT1 A 0 //A_CustomMissile("OverLightningMissileTargetSeeker",0,0,frandom(-15,15),6,(momz+frandom(-15,15)))
		DLIT B 1 BRIGHT //A_SeekerMissile(40,50, SMF_LOOK|SMF_PRECISE)
		DLIT C 1 BRIGHT //A_SeekerMissile(40,50, SMF_LOOK|SMF_PRECISE)
		Stop
		
	Crash:
	XDeath:
	Death:
		TNT1 AAAAA 0 A_SpawnItemEx("ObeliskTrailSpark", random(19,-19), random(19,-19), random(19,-19), 0, 0, 0, 0, 128, 0)
		3LO2 ABCDEFGH 2 BRIGHT A_SpawnItem("RedFlareSmall",0,0)
		TNT1 A 0 A_SpawnItemEx("OverLightningTrailLarge",0,0,0,0,0,0,0,32)
		TNT1 A 1 A_Scream
		Stop
		}
 }

