ACTOR OverLightningMissileTargetSeeker 
{  
  +FRIENDLY
  MONSTER
  Damagetype "Incinerate"
  Species "FlyingBalls"
  Decal "RedsmallScorch"
  -COUNTKILL
  +NOGRAVITY
  +NOCLIP
  +THRUACTORS
  +LOOKALLAROUND
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Radius 1
  Height 1
  Speed 0
  States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 Thing_ChangeTid(0,1933)
		TNT1 A 0 Thing_Hate(1933,1932,2)
		TNT1 A 0 A_UnSetShootable
		TNT1 A 0 A_Look
	See:
		TNT1 AAAA 1 A_Chase
	Missile:
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_CustomMissile("OverLightningMissile5",0,0)
		Stop
		}
 }

