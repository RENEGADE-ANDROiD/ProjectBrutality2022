// Eternal Dark Lord — portable Marauder-tier elite from
// Dark_Lord(DoomEternalBossBattle).wad (Davoth-style fan fight).
// Soft HP phases only (no ACS arena teleports). Distinct from MP DarkLord.

ACTOR PB_EternalDarkLord : PB_EternalDarkLordBase
{
	var int user_phasetwo;
	var int user_phasethree;
	Health 1666
	PainChance 255
	PainChance "Stun", 255
	PainChance "Plasma", 255
	Speed 12
	Radius 15
	Height 47
	Mass 1000
	Scale 0.33
	Damage 10
	MeleeRange 70
	DamageFactor "Falling", 0
	Monster
	+FLOORCLIP
	+DONTMORPH
	+DONTBLAST
	+NOICEDEATH
	+NOTARGETSWITCH
	+BRIGHT
	+DONTTHRUST
	+DONTCORPSE
	+COUNTKILL
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	SeeSound "edl/see"
	DeathSound "edl/death"
	ActiveSound ""
	Obituary "%o was unmade by the Eternal Dark Lord."
	Tag "Eternal Dark Lord"
	States
	{
	Spawn:
		DARK K 0 A_SetUserVar("user_shieldup", 1)
		DARK K 5 A_Look
		DARK K 0 A_AttachLightDef("EDL_RedGlow", "EDL_RedGlow")
		Loop
	See:
		DARK A 0 A_RemoveLight("EDL_GreenGlow")
		DARK AABBCCDD 3 A_Chase
		DARK A 0 A_Jump(50, "Missile")
		DARK A 0 A_Jump(50, "Bomb")
		DARK A 0 A_Jump(180, "Summon")
		DARK A 0 A_Jump(200, 3)
		DARK A 0 A_JumpIf(user_phasetwo == 1, "Phase2Summon")
		DARK A 0 A_Jump(200, 2)
		DARK A 0 A_JumpIf(user_phasethree == 1, "Phase3Summon")
		DARK A 0 A_Jump(255, "Melee")
		Loop
	Melee:
		DARK M 0 A_Jump(50, 17)
		DARK M 2 A_FaceTarget
		DARK N 5
		DARK N 3 A_Recoil(-20)
		DARK I 7
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK J 0 A_CustomMeleeAttack(8)
		DARK A 0 A_PlaySound("edl/sword1")
		DARK F 0 A_CheckRange(100, 4)
		DARK F 0 A_CustomMissile("PB_EDL_HealSymbol", 80)
		DARK F 0 HealThing(10)
		DARK A 0 A_PlaySound("edl/swordhit1")
		DARK J 6 A_Jump(50, "See")
		DARK I 0 A_Recoil(5)
		DARK J 2 A_FaceTarget
		DARK J 5
		DARK J 3 A_Recoil(-20)
		DARK O 7
		DARK A 0 A_PlaySound("edl/sword2")
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK P 0 A_CustomMeleeAttack(8)
		DARK F 0 A_CheckRange(100, 4)
		DARK F 0 A_CustomMissile("PB_EDL_HealSymbol", 80)
		DARK F 0 HealThing(10)
		DARK A 0 A_PlaySound("edl/swordhit2")
		DARK L 6 A_Jump(50, "See")
		DARK A 0 A_RemoveLight("EDL_RedGlow")
		DARK A 0 A_AttachLightDef("EDL_GreenGlow", "EDL_GreenGlow")
		DARK G 0 A_FaceTarget
		DARK E 0 A_SetUserVar("user_shieldup", 0)
		DARK H 0 A_CustomMissile("PB_EDL_Green1")
		DARK H 0 A_CustomMissile("PB_EDL_Green2")
		DARK H 0 A_CustomMissile("PB_EDL_Green3")
		DARK G 15 A_Recoil(-13)
		DARK A 0 A_RemoveLight("EDL_GreenGlow")
		DARK A 0 A_AttachLightDef("EDL_RedGlow", "EDL_RedGlow")
		DARK E 0 A_SetUserVar("user_shieldup", 1)
		DARK I 3
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK A 0 A_PlaySound("edl/sword3")
		DARK L 0 A_CustomMeleeAttack(8)
		DARK F 0 A_CheckRange(100, 4)
		DARK A 0 A_PlaySound("edl/swordhit1")
		DARK F 0 A_CustomMissile("PB_EDL_HealSymbol", 80)
		DARK F 7 HealThing(10)
		Goto See
	Missile:
		DARK K 6 A_FaceTarget
		DARK K 0 A_ChangeVelocity(0, Random(30, -30), 0, CVF_RELATIVE|CVF_REPLACE)
		DARK K 0 A_CustomMissile("PB_EDL_SFX", -3)
		DARK K 0 A_CustomMissile("PB_EDL_PurpleBoom", 80, 20)
		DARK K 7 A_CustomMissile("PB_EDL_PurpleShot", 80, 20)
		DARK K 0 A_CustomMissile("PB_EDL_SFX", -3)
		DARK K 0 A_CustomMissile("PB_EDL_PurpleBoom", 80, 20)
		DARK K 7 A_CustomMissile("PB_EDL_PurpleShot", 80, 10)
		DARK K 0 A_CustomMissile("PB_EDL_SFX", -3)
		DARK K 0 A_CustomMissile("PB_EDL_PurpleBoom", 80, 20)
		DARK K 7 A_CustomMissile("PB_EDL_PurpleShot", 80, 20)
		DARK K 0 A_CustomMissile("PB_EDL_SFX", -3)
		DARK K 0 A_CustomMissile("PB_EDL_PurpleBoom", 80, 20)
		DARK K 7 A_CustomMissile("PB_EDL_PurpleShot", 80, 10)
		DARK K 0 A_CustomMissile("PB_EDL_SFX", -3)
		DARK K 0 A_CustomMissile("PB_EDL_PurpleBoom", 80, 20)
		DARK K 7 A_CustomMissile("PB_EDL_PurpleShot", 80, 20)
		DARK F 0 A_CheckRange(500, 2)
		DARK F 0 A_Jump(255, "See")
		DARK A 0 A_Jump(255, "ShieldAttack")
		Goto See
	Bomb:
		DARK K 6 A_FaceTarget
		DARK A 0 A_PlaySound("edl/bomb")
		DARK K 2 A_CustomMissile("PB_EDL_Grenade", 80, -20)
		DARK A 0 A_JumpIf(user_phasetwo == 1, "BombExtra")
		Goto See
	BombExtra:
		DARK K 2 A_CustomMissile("PB_EDL_Grenade", 80, 20)
		Goto See
	Dazzled:
		DARK H 0 A_RemoveLight("EDL_GreenGlow")
		DARK H 0 A_RemoveLight("EDL_RedGlow")
		DARK H 0 A_SetUserVar("user_shieldup", 0)
		DARK A 0 A_PlaySound("edl/dazzled")
		DARK A 0 A_Jump(100, 3)
		DARK A 0 A_PlaySound("edl/hit1")
		DARK A 0 A_Jump(255, 5)
		DARK A 0 A_Jump(100, 3)
		DARK A 0 A_PlaySound("edl/hit2")
		DARK A 0 A_Jump(255, 2)
		DARK A 0 A_PlaySound("edl/hit3")
		DARK H 0 A_ChangeFlag("NOPAIN", 1)
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK H 0 A_CustomMissile("PB_EDL_DazzleFX", 50)
		DARK H 150
		DARK A 0 A_JumpIf(user_phasetwo == 1, 2)
		DARK A 0 A_JumpIfHealthLower(1111, "SoftPhase2")
		DARK A 0 A_JumpIf(user_phasethree == 1, 2)
		DARK A 0 A_JumpIfHealthLower(555, "SoftPhase3")
		DARK H 0 A_ChangeFlag("NOPAIN", 0)
		DARK H 0 A_SetUserVar("user_shieldup", 1)
		DARK H 0 A_AttachLightDef("EDL_RedGlow", "EDL_RedGlow")
		Goto See
	Summon:
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK FFF 7 A_FaceTarget
		DARK A 0 A_PlaySound("edl/summon")
		DARK F 0 A_CustomMissile("PB_EDL_WolfSummon", 0, 80)
		Goto See
	Phase2Summon:
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK FFF 7 A_FaceTarget
		DARK A 0 A_PlaySound("edl/summon")
		DARK F 0 A_CustomMissile("PB_EDL_WolfSummon", 0, 80)
		DARK F 0 A_CustomMissile("PB_EDL_WolfSummon", 0, -80)
		Goto See
	Phase3Summon:
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK FFF 7 A_FaceTarget
		DARK A 0 A_PlaySound("edl/summon")
		DARK F 0 A_CustomMissile("PB_EDL_WolfSummon", 0, 100)
		DARK F 0 A_CustomMissile("PB_EDL_WolfSummon", 0, -100)
		DARK F 0 A_CustomMissile("PB_EDL_WolfSummon", 40, 0)
		Goto See
	ShieldAttack:
		DARK A 0 A_FaceTarget
		DARK A 0 A_Recoil(-30)
		DARK A 0 A_PlaySound("edl/shieldbo")
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 30)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 27)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 24)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 21)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 18)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 15)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 12)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 9)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 6)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 2)
		DARK F 0 A_Jump(255, 3)
		DARK F 2 A_CustomMissile("PB_EDL_SFXShield", -3)
		DARK F 0 A_CheckRange(100, 3)
		DARK F 0 A_CustomMeleeAttack(16)
		DARK A 0 A_PlaySound("edl/shieldhi")
		DARK K 15 A_CustomMissile("PB_EDL_PurpleBoom", 0, 100)
		Goto See
	SoftPhase2:
		DARK A 0 A_PlaySound("edl/phasehit")
		DARK E 12 A_Recoil(8)
		DARK KGLMF 3 A_FaceTarget
		DARK A 0 A_PlaySound("edl/bathe")
		DARK A 0 A_SetUserVar("user_phasetwo", 1)
		DARK H 0 A_ChangeFlag("NOPAIN", 0)
		DARK H 0 A_SetUserVar("user_shieldup", 1)
		DARK H 0 A_AttachLightDef("EDL_RedGlow", "EDL_RedGlow")
		Goto See
	SoftPhase3:
		DARK A 0 A_PlaySound("edl/phasehit")
		DARK E 10 A_Recoil(8)
		DARK KGLMF 3 A_FaceTarget
		DARK A 0 A_PlaySound("edl/soul")
		DARK A 0 A_SetUserVar("user_phasethree", 1)
		DARK H 0 A_ChangeFlag("NOPAIN", 0)
		DARK H 0 A_SetUserVar("user_shieldup", 1)
		DARK H 0 A_AttachLightDef("EDL_RedGlow", "EDL_RedGlow")
		Goto See
	Pain.Stun:
	Pain.Plasma:
	Pain.SuperPlasma:
		DARK A 0 A_Jump(255, "Dazzled")
	Pain:
		DARK H 0 A_ChangeVelocity(0, 0, 0, CVF_RELATIVE|CVF_REPLACE)
		DARK A 0 A_JumpIf(user_shieldup == 0, "Dazzled")
		DARK A 0 A_PlaySound("edl/heal")
		DARK FFF 12 A_FaceTarget
		Goto See
	Death:
		DARK H 0 A_RemoveLight("EDL_GreenGlow")
		DARK H 0 A_RemoveLight("EDL_RedGlow")
		DARK A 0 A_Scream
		DARK A 0 A_NoBlocking
		DARK A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("XDeath3", 32, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("PB_BloodMistBig", 40, 0, random(0, 360), 2, random(30, 90))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		DARK Q 6
		DARK R 6
		DARK ST 8
		DARK U 8
		DARK V -1
		Stop
	XDeath:
		DARK H 0 A_RemoveLight("EDL_GreenGlow")
		DARK H 0 A_RemoveLight("EDL_RedGlow")
		DARK A 0 A_XScream
		DARK A 0 A_NoBlocking
		DARK A 0 A_Fall
		TNT1 AAAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("PB_BloodMistBig", 40, 0, random(0, 360), 2, random(30, 90))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		Stop
	Death.Execution:
		TNT1 A 0 A_NoBlocking
		TNT1 A 0
		Stop
	Death.GloryKill:
		TNT1 A 0 A_GiveToTarget("BPtoken", 4)
		Goto Death.Fatality
	Death.Fatality:
	Death.Fatality1:
		TNT1 A 0 A_Pain
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_SpawnItemEx("GloryHightPinataSpawn2",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360))
		TNT1 A 0 A_GiveToTarget("GoFatality", 1)
		TNT1 A 0 A_PlaySound("misc/xdeath2", 4)
		Stop
	}
}

ACTOR PB_EDL_HealSymbol
{
	+NOBLOCKMAP
	+NOGRAVITY
	+NOSPRITESHADOW
	+BRIGHT
	RenderStyle Add
	Alpha 0.6
	Scale 0.75
	States
	{
	Spawn:
		EDHL A 2 A_ChangeVelocity(0, 0, 5, CVF_RELATIVE|CVF_REPLACE)
		EDHL A 2 A_ChangeVelocity(0, 0, 5, CVF_RELATIVE|CVF_REPLACE)
		EDHL A 2 A_ChangeVelocity(0, 0, 5, CVF_RELATIVE|CVF_REPLACE)
		EDHL A 2 A_ChangeVelocity(0, 0, 5, CVF_RELATIVE|CVF_REPLACE)
		EDHL A 2 A_SetTranslucent(0.4)
		EDHL A 2 A_ChangeVelocity(0, 0, 5, CVF_RELATIVE|CVF_REPLACE)
		Stop
	}
}

ACTOR PB_EDL_WolfSummon
{
	Health 50
	Speed 14
	PainChance 180
	Radius 20
	Height 40
	Mass 100
	Scale 1.6
	MeleeRange 48
	Monster
	RenderStyle Add
	+FLOORCLIP
	+NOTARGETSWITCH
	+NOSPRITESHADOW
	+BRIGHT
	+COUNTKILL
	SeeSound "edl/wolf"
	DeathSound "skull/death"
	Obituary "%o was mauled by a phantom wolf."
	Tag "Eternal Dark Lord Wolf"
	States
	{
	Spawn:
		SUMM IHGFE 5 A_Look
		Loop
	See:
		SUMM AABBCCDD 2 A_Chase
		Loop
	Melee:
		SUMM JK 3 A_FaceTarget
		SUMM L 2 A_CustomMeleeAttack(10)
		Goto See
	Pain:
		SUMM A 2
		SUMM A 2 A_Pain
		Goto See
	Death:
		SUMM E 8
		SUMM F 8 A_Scream
		SUMM G 4 A_NoBlocking
		SUMM HI 4
		Stop
	}
}

ACTOR PB_EDL_Grenade
{
	Radius 8
	Height 8
	Speed 12
	Damage 10
	Scale 0.7
	Projectile
	-NOGRAVITY
	+RANDOMIZE
	+DEHEXPLOSION
	BounceType "Doom"
	Gravity 1.0
	SeeSound "edl/bomb"
	DeathSound "edl/bombboom"
	DamageType Grenade
	States
	{
	Spawn:
		DLGR A 1 Bright
		Loop
	Death:
		DLGR A 0 A_Scream
		DLGR A 0 A_SetScale(2.0, 2.0)
		MISL B 8 Bright A_Explode(25, 120)
		MISL C 6
		MISL D 4
		Stop
	}
}

