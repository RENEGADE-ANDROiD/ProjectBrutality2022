// Hellduke Gauss FX from Monster Pack staging HelldukeStuff.dec
ACTOR HDukeGaussAimDot
{
  RenderStyle "Add"
  //Scale 0.0125
  //Scale 0.75
  Scale 0.5
  Alpha 0.8
  +NOINTERACTION
  +NOGRAVITY
  //+CLIENTSIDEONLY
  States
	{
	Spawn:
		TTRR A 3 Bright
	Stop
	}
}

ACTOR HDukeGaussCannonTrail
{
  +NOINTERACTION
  +NOGRAVITY
  -SOLID
  +THRUACTORS
  +DONTSPLASH
  RenderStyle Add
  Alpha 0.9
  Scale 0.08
	//+CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	PUF2 A 1 bright A_SpawnItemEx("HDukeGaussCannonSpark", random(4,-4), random(4,-4), random(4,-4), 0, 0, 0, 0, 128, 0)
  Trolololo:
	PUF2 A 0 A_JumpIf(ScaleY <= 0, "NULL")
	PUF2 A 0 A_SetScale(ScaleX -0.01, ScaleY -0.01)
	PUF2 A 1 bright A_FadeOut(0.025)
	Loop
  }
}

ACTOR HDukeGaussCannonSpark
{ 
	RenderStyle Add
	Scale 0.010
	Alpha 0.95
	//Translation "0:255=%[0,0,0]:[0,0,1]"
	+NOINTERACTION
	+NOGRAVITY
	//+CLIENTSIDEONLY
	States
	{
	Spawn:
	PUF2 A 0 NoDelay A_JumpIf(ScaleX <= 0, "NULL")
	PUF2 A 0 A_SetScale(ScaleX-0.0008)
	PUF2 A 1 bright A_ChangeVelocity (frandom(-0.2, 0.2), frandom(-0.2, 0.2), frandom(-0.2, 0.2), 0)
	PUF2 A 2 bright A_FadeOut(0.05)
	Loop
	}
}

Actor HDukeGaussCannonPuffNormal //main puff, shockwave fast
{
  Radius 0
  Height 0
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  -SOLID
  +NOTELEPORT
  +FORCEXYBILLBOARD
  Translation "0:255=%[0,0,0]:[2.0,0.2,0.2]"
  Scale 0.44
  RenderStyle Add
	States
	{
	Spawn:
		TNT1 A 0
		//TNT1 A 0 NODELAY A_Warp(AAPTR_DEFAULT,5,0,0,WARPF_NOCHECKPOSITION) //moves it 5MU towards the player, to get it unstuck from walls
		TNT1 AA 0 A_SpawnItemEx("HDukeGaussCannonParticle",3,0,0,frandom(0.3,3.5),frandom(-3.5,3.5),frandom(0.6,5),0,SXF_NOCHECKPOSITION)
		TNT1 AA 0 A_SpawnItemEx("HDukeGaussCannonPuffGas",0,0,0,frandom(0,1),frandom(1,-1),frandom(1,-1),0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SetScale(scalex*1.2)
		TNT1 AA 0 A_SpawnItemEx("HDukeGaussParticlesFew",0,0,0,0,0,0,0,32)
		X060 A 1 Bright 
		X060 A 0 A_SpawnItemEx("HdukeGaussCannonShockwave2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		X060 A 1 Bright A_SetScale(scalex*1.2)	//grows a bit before fading out
	Looper:
		X060 AAAAAAAAAA 1 Bright  {A_SetScale(scalex*1.2); A_FadeOut(0.1);}
	Stop
	}
}


Actor HDukeGaussCannonParticle
{
	Projectile
	Speed 10
	-NOGRAVITY
	+THRUACTORS
	+PAINLESS
	+DOOMBOUNCE
	+FORCEXYBILLBOARD
	//+CLIENTSIDEONLY
	Alpha 0.5
	Radius 2
	Height 5
	Gravity 0.2
	BounceFactor 0.2
	WallBounceFactor 1.0
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[2.0,0.2,0.2]"
	Scale 0.05
	states
	{
	Spawn:
		FX01 A 20 Bright
		FX01 A 1 Bright A_FadeOut(0.14)
		Wait
	}
}

