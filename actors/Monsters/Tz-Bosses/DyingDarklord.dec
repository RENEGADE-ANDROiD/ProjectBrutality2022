ACTOR XDeathDarkLordHead: XDeathBullArm1
{
-CLIENTSIDEONLY
+SKYEXPLODE
    Scale 1.0
    States
    {
	Spawn:
		  TNT1 A 0 A_SpawnItem("Brutal_BloodSpot",0,0,0,1)
		  TNT1 A 0 A_JumpIf(waterlevel > 1, "Death")
		TNT1 A 0 A_JumpIf(momz == 0, "Death")
		D9A8 ABCDEFGH 5
		Loop
   	Death:
		  TNT1 A 0 A_SpawnItem("Brutal_BloodSpot",0,0,0,1)
		  D9A8 A 1
		  D9A8 A 1 A_SpawnItem("DarkLordHead",0,0,0,1)
		  Stop
}
}

actor DarkLordHead: LimbBase
{
damagefactor "Kick", 9.0
damagefactor "Melee", 9.0
damagefactor "SuperPunch", 9.0
-CLIENTSIDEONLY
	Radius 20
	Mass 100
	Health 60
	Scale 1.0
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 
		D9A8 A 1 A_SpawnItem("Brutal_BloodSpot",0,0,0,1)
		D9A8 A -1
		Stop

	Death:
	Death.Trample:
		TNT1 A 0 A_GiveToTarget("BootsSmearedWithRedBlood", 6)
	Crush:
		TNT1 A 0 A_PlaySound("misc/xdeath4")
		TNT1 AAAAAAAAA 0 A_CustomMissile ("BloodMistBig", 0, 0, random (0, 360), 2, random (30, 90))
		TNT1 AAAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 0, 0, random (0, 360), 2, random (30, 90))
		TNT1 AAA 0 A_CustomMissile ("Brains6Big", 10, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAA 0 A_CustomMissile ("Brains7Big", 10, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAA 0 A_CustomMissile ("XDeath1", 10, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAAAA 0 A_CustomMissile ("XDeath3b", 10, 0, random (0, 360), 2, random (50, 90))
		TNT1 AAAAA 0 A_CustomMissile ("XDeath2b", 10, 0, random (0, 360), 2, random (50, 90))
	Stop
	Death.plasma:
		TNT1 A 0
		TNT1 A 0 A_CustomMissile ("XDeathBurnedSkull", 32, 0, random (0, 360), 2, random (0, 160))
		EXPL A 0 A_CustomMissile ("ExplosionSmoke", 32, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0
		Stop
	Death.Melee:
	Death.SuperPunch:
	Death.Kick:
		D9A8 B 1 A_Pain
		D9A8 B 1 A_FaceTarget
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_CustomMissile ("XDeathDarkLordHeadKicked", 5, 0, random (170, 190), 2, random (20, 40))
		Stop
	
	Pain:
	TNT1 A 0
	TNT1 A 0 ThrustThingZ(0,5,0,1)
	D9A8 B 3
	Goto Spawn
	
	Death.ExplosiveImpact:
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 ThrustThingZ(0,50,0,1)
	D9A8 BCDE 6
	D9A8 F 0 A_SpawnItem("XDeathDarkLordHead")
	Stop

}}

ACTOR XDeathDarkLordHeadKicked: XDeathDarkLordHead
{
-BOUNCEONACTORS
Damage 4
Speed 5
Scale 1.0
BounceFactor 0.4
}

