		HIBR E 3 A_Wander
		HIBR E 3 A_Wander
		TNT1 A 0
			{
				A_CustomMissile("BurnParticlesNoDamage", random(63,71), 0, random (0, 360), 2, random (50, 130));
				A_CustomMissile("FireballExplosionFlamesBig", random(63,71), 0, random (0, 360), 2, random (50, 130));
				A_CustomMissile("ExplosionParticleVerySlow", random(63,71), 0, random (0, 360), 2, random (50, 130));
			}
		TNT1 A 0 A_JumpIfInventory("PoorGuyBurningLife", 5, "Death")
		TNT1 A 0 A_GiveInventory("PoorGuyBurningLife", 1)
	Loop

    Death:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx("PlasmaDyingD16Cyberdemon")
	Stop
	}
}

