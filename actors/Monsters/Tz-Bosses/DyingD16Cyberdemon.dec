Actor Gib_D16CyberdemonArm: LimbBase
{
  damagefactor "Kick", 9.0
  damagefactor "Melee", 9.0
  damagefactor "SuperPunch", 9.0
  -CLIENTSIDEONLY
  Radius 10
  Height 10
  Mass 10
  Health 60
  Scale 1.0
  //Translation "0:2=%[0,0,0]:[0.3,0.3,0.3]", "9:37=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "112:175=%[0,0,0]:[0.3,0.3,0.3]", "192:255=%[0,0,0]:[0.3,0.3,0.3]"
  States
	{
	Spawn:
		TNT1 A 0
		HIBE B -1
	Loop

	Pain:
		TNT1 A 0 A_Changeflag ("ROLLSPRITE", 1)
		TNT1 A 0 ThrustThingZ(0,20,0,1)
		HIBE A 6 {A_SetRoll(random(0,360));}
		TNT1 A 0 A_Changeflag ("ROLLSPRITE", 0)
	Goto Spawn

	XDeath:
	Death:
	Death.fire:
	Death.burn:
	Death.flames:
	Death.Plasma:
	Death.Incinerate:
	Death.SuperPlasma:
	Death.Desintegrate:
