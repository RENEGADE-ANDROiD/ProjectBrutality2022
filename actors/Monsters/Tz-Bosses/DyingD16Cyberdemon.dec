Actor Gib_D16CyberdemonTorso
{
  damagefactor "Kick", 9.0
  damagefactor "Melee", 9.0
  damagefactor "SuperPunch", 9.0
  -CLIENTSIDEONLY
  +FLOORCLIP
  +MOVEWITHSECTOR
  //+CLIENTSIDEONLY
  +NOBLOCKMONST
  +THRUACTORS
  +SHOOTABLE
  +NOBLOOD
  +NOBLOODDECALS
  -PUSHABLE
  Bloodtype "Brutal_Blood"
  BloodColor "Red"
  Decal "BrutalBloodSplat"
  Radius 20
  Height 20
  Mass 1000
  Health 60
  Scale 1.0
  //Translation "0:2=%[0,0,0]:[0.3,0.3,0.3]", "9:37=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "112:175=%[0,0,0]:[0.3,0.3,0.3]", "192:255=%[0,0,0]:[0.3,0.3,0.3]"
  States
	{
	Spawn:
		TNT1 A 0
		HIBE F -1
	Loop

	Death:
	XDeath:
	Death.Disintegrate:
	Death.Stomp:
	Death.CrushedBodies:
	Death.Crush:
	Crush:
		TNT1 AA 0 A_SpawnItemEX("NashgoreGibs", 0, 0, 0, random (4, 12), 0, random (4, 12), random(0, 360))
		TNT1 AA 0 A_CustomMissile ("PB_SmallGib", 32, 0, random(0,360), 2, random (0, 40))
		TNT1 AA 0 A_CustomMissile ("MeatDeath", 0, 0, random (0, 360), 2, random (0, 160))
		TNT1 AA 0 A_CustomMissile ("MeatDeathsmall", 0, 0, random (0, 360), 2, random (0, 160))
		TNT1 AA 0 A_CustomMissile ("Instestin", 32, 0, random(0,360), 2, random (0, 40))
		TNT1 AA 0 A_CustomMissile ("XDeath1", 42, 0, random(0,360), 2, random (0, 40))
		TNT1 AA 0 A_CustomMissile ("Xdeath3", 26, 0, random(0,360), 2, random (0, 40))
		TNT1 AA 0 A_CustomMissile ("NashGoreBloodSpurt", 32, 0, random(0,360), 2, random (0, 40))
	Stop

	Death.Plasma: Death.Plasma2:
	Death.Flames:
	Death.Burn:
		TNT1 AAA 0 A_SpawnItemEx("TinyBurningPiece2", random (-15, 15), random (-15, 15))
		TNT1 AAA 0 A_SpawnItemEx("TinyBurningPiece3", random (-15, 15), random (-15, 15))
		TNT1 AAA 0 A_CustomMissile ("Brutal_FlyingBlood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 AA 0 A_SpawnProjectile ("XDeathBurnedMeat", 32, 0, random (0, 360), 2, random (0, 160))
		TNT1 AA 0 A_SpawnProjectile ("XDeathBurnedMeat2", 32, 0, random (0, 360), 2, random (0, 160))
		TNT1 AA 0 A_SpawnProjectile ("XDeathBurnedMeat3", 32, 0, random (0, 360), 2, random (0, 160))
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 6 A_CustomMissile ("PlasmaSmoke", 16, 0, random (0, 180), 2, random (0, 180))
	Stop

	Death.TeleportRemover:
	Death.GibRemoving:
		TNT1 A 0
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_ChangeFlag("NOCLIP", 1)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
	Stop		
	}
}


