	Loop
	Death:
		TNT1 A 0 A_SpawnItem("Brutal_BloodSpot",0,0,0,1)
		TNT1 A 0 A_SetRoll(0)
		TNT1 A 0 A_Playsound("VENTBUST")
		TNT1 A 0 A_SpawnItem("Gib_D16CyberdemonGun",0,0,0,1)
	Stop
	}
}



