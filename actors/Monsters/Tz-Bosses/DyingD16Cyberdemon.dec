		TNT1 A 0 A_SetRoll(0)
		TNT1 AAAAAAAA 0 A_CustomMissile ("Brutal_FlyingBloodTrail5", 0, 0, random (0, 360), 2, random (60, 140))
		TNT1 A 0 A_PlaySound("misc/xdeath4")
		CRS1 A 5
		CRS1 A 9009
	Stop

	Death.Melee:
	Death.SuperPunch:
	Death.Kick:
		HIBE A 1 A_FaceTarget
		TNT1 A 0 A_PlaySound("player/cyborg/fist", 3)
	Death.ExplosiveImpact:
		TNT1 A 0 A_Changeflag ("ROLLSPRITE", 1)
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 0)
		TNT1 A 0 ThrustThingZ(0,50,0,1)
		HIBE A 6 {A_SetRoll(random(0,360));}
		HIBE A 3 A_CheckFloor("Landz")
	Goto Landz

	Landz:
		TNT1 A 0 A_Changeflag ("ROLLSPRITE", 0)
		TNT1 A 0 A_SpawnItem("Gib_D16CyberdemonArm")
	Stop

	Death.Trample:
	Death.Stomp:
		TNT1 A 0 A_GiveToTarget("BootsSmearedWithRedBlood", 6)
	Goto Death

	Death.plasma:
	Death.Burn:
	Death.Flames:
	Death.Fire:
		TNT1 A 0 A_SpawnItemEx("TinyBurningPiece2", random (-15, 15), random (-15, 15))
		TNT1 A 0 A_SpawnItemEx("TinyBurningPiece3", random (-15, 15), random (-15, 15))	
	Stop
	}
}


ACTOR XDeathD16CyberdemonGun
{
  -CLIENTSIDEONLY
  +ROLLSPRITE
  +THRUACTORS
  +BOUNCEONWALLS
  //+DOOMBOUNCE
  +SKYEXPLODE
  +MOVEWITHSECTOR
  //+CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOTELEPORT
  +MISSILE
  -DONTSPLASH
  Scale 1.0
  //Translation "0:2=%[0,0,0]:[0.3,0.3,0.3]", "9:37=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "112:175=%[0,0,0]:[0.3,0.3,0.3]", "192:255=%[0,0,0]:[0.3,0.3,0.3]"
  Speed 10
  Gravity 0.5
  Mass 1
  BounceFactor 0.4
  BounceCount 3
  Radius 16
  Height 16
  BounceSound "VENTBUST"
  Decal BrutalBloodSplat

	States
	{
	Spawn:
		TNT1 A 0 A_SpawnItem("Brutal_BloodSpot",0,0,0,1)
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Death")
		TNT1 A 0 A_JumpIf(momz == 0, "Death")
