 }


ACTOR HellStormCloudEffect
{
	Projectile
	+MISSILE
	+NoGravity
	-SHOOTABLE
	+NOBLOOD
	//+RIPPER
	+THRUGHOST
	+FloorClip
	+CeilingHugger
	+SpawnCeiling
	+BLOODLESSIMPACT
	+NODAMAGETHRUST
	+THRUACTORS
	Damage 0
	RenderStyle add
	DamageType "Disintegrate"
	Species "Cyberdemon"
	Speed 0
	Scale 0.25
	Alpha 0.7
	Translation "0:255=%[0,0,0] : [1,0.25,0.25]"
	//Seesound "redburn"
	States
	{
	Spawn:
		GTXL KLMNOPQRST 1 BRIGHT A_SetScale(ScaleX+0.05, ScaleY+0.05)
		GTXL TSRQPONMLK 1 BRIGHT A_SetScale(ScaleX+0.05, ScaleY+0.05)
		GTXL KLMNOPQRST 1 BRIGHT A_SetScale(ScaleX+0.05, ScaleY+0.05)
		GTXL TSRQPONMLK 1 BRIGHT A_SetScale(ScaleX+0.05, ScaleY+0.05)
		GTXL KLMNOPQRST 1  A_FadeOut( 0.05)
	Stop
	}
}
/*
Script launch parameters.
Argument 1: Sprite width multiplier.
-1 - sprite width does not change;
0 - the width changes in proportion to the height of the object;
More than 0 - the width of the object will be less than the height by this percentage.

Argument 2. Height limit. The object will not be able to grow higher than this value.

Argument 3. If >0, the radius will change proportionally to the width of the object.
*/

ACTOR DarkCardinalHellStormStrike1
{
  Damage 1
  PROJECTILE
  +MISSILE
  +RIPPER
  RipperLevel 2
  +FLOORCLIP
  +FLOORHUGGER
  +CEILINGHUGGER
  +NOGRAVITY
  +NOINTERACTION
  +BLOODLESSIMPACT
  Radius 16
  Height 14
  DeathHeight 1
  RenderStyle Add
  DamageType "Incinerate"
  Species "Cyberdemon"
  Speed 0
  Scale 1.0
  Alpha 0.85
  var int user_Tick;
  States
	{
	Spawn:
		DV09 B 0
		TNT1 A 0 ACS_NamedExecuteAlways("SectorHeightAdapt",0, -1, 0, 0)
		TNT1 A 0 A_ChangeFlag("MISSILE", 1)
		TNT1 A 0 A_ScaleVelocity(0)
		TNT1 A 0 A_ChangeFlag("SPRITEFLIP", random(0,1))
		TNT1 A 0 A_Jump (256, "Spawn1", "Spawn2")
	Stop
	Spawn1:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("weapons/devzap",2,1.0,0,0.6)
		DV09 ABCABCABC 2 Bright
			{
			if (user_tick > 2)
				{
				bNOINTERACTION = False;
				A_SetUserVar("user_tick", 0);
				}
			else
				{
				bNOINTERACTION = True;
				A_SetUserVar("user_tick", user_tick + 1);
				}
			}
		DV09 ABC 2 Bright
			{
			A_FadeOut(0.06);
			if (user_tick > 2)
				{
				bNOINTERACTION = False;
				A_SetUserVar("user_tick", 0);
				}
			else
				{
				bNOINTERACTION = True;
				A_SetUserVar("user_tick", user_tick + 1);
				}
			}
	Stop
	Spawn2:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("weapons/devzap",2,1.0,0,0.6)
		DV09 ABCBA 2 Bright
			{
			if (user_tick > 2)
				{
				bNOINTERACTION = False;
				A_SetUserVar("user_tick", 0);
				}
			else
				{
				bNOINTERACTION = True;
				A_SetUserVar("user_tick", user_tick + 1);
				}
			}
		DV09 CBA 2 Bright
			{
			A_FadeOut(0.06);
			if (user_tick > 2)
				{
				bNOINTERACTION = False;
				A_SetUserVar("user_tick", 0);
				}
			else
				{
				bNOINTERACTION = True;
				A_SetUserVar("user_tick", user_tick + 1);
				}
			}
	Stop
	}
}




