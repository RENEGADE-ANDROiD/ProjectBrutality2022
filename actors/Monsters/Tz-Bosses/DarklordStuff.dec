		HLF6 A 1 A_FadeOut(0.01,1)
	Loop
	SpawnB:
		TNT1 A 0 A_JumpIf(Alpha<0.18,2)
		TNT1 A 0 A_Explode(5,60,1)
		TNT1 A 0 A_SetScale(ScaleX+0.01,ScaleY+0.01)
		HLF6 B 1 A_FadeOut(0.01,1)
	Loop
	SpawnC:
		TNT1 A 0 A_JumpIf(Alpha<0.18,2)
		TNT1 A 0 A_Explode(5,60,1)
		TNT1 A 0 A_SetScale(ScaleX+0.01,ScaleY+0.01)
		HLF6 C 1 A_FadeOut(0.01,1)
	Loop
	SpawnD:
		TNT1 A 0 A_JumpIf(Alpha<0.18,2)
		TNT1 A 0 A_Explode(5,60,1)
		TNT1 A 0 A_SetScale(ScaleX+0.01,ScaleY+0.01)
		HLF6 D 1 A_FadeOut(0.01,1)
	Loop
		}
 }

