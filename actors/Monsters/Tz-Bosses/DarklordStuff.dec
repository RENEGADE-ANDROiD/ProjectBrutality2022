ACTOR DarkCyberGhostA
{
  Scale 1.2
  RENDERSTYLE Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
	{
	Spawn:
		CBEP A 2 A_FadeOut(0.18)
	Loop
		}
 }

