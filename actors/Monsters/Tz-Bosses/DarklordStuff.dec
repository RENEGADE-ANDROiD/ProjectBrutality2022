		TNT1 A 0 A_Jump (256, "Meteor")

	RLength2:	
		TNT1 AAAAAAAAAA 4 A_SpawnProjectile("HellStormCloudEffect", random(-65, 65), random(-65, 65))
		TNT1 A 0 A_Jump (256, "Meteor")

	RLength3:	
