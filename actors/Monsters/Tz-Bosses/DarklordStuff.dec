ACTOR DarklordRail : FastProjectile
{
  +NOINTERACTION
  +NOGRAVITY
  -SOLID
  +THRUACTORS
  +DONTSPLASH
  RenderStyle Normal
  Alpha 0.9
  Scale 0.08
	//+CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	YAE4 B 1 bright A_SpawnItemEx("DarklordRailSpark", random(4,-4), random(4,-4), random(4,-4), 0, 0, 0, 0, 128, 0)
  Trolololo:
	YAE4 B 0 A_JumpIf(ScaleY <= 0, "NULL")
	YAE4 B 0 A_SetScale(ScaleX -0.01, ScaleY -0.01)
	YAE4 B 1 bright A_FadeOut(0.025)
	Loop
  }
}

ACTOR DarklordRailSpark
{ 
	RenderStyle Normal
	Scale 0.010
	Alpha 0.95
	//Translation "0:255=%[0,0,0]:[0,0,1]"
	+NOINTERACTION
	+NOGRAVITY
	//+CLIENTSIDEONLY
	States
	{
	Spawn:
	YAE4 B 0 NoDelay A_JumpIf(ScaleX <= 0, "NULL")
	YAE4 B 0 A_SetScale(ScaleX-0.0008)
	YAE4 B 1 bright A_ChangeVelocity (frandom(-0.2, 0.2), frandom(-0.2, 0.2), frandom(-0.2, 0.2), 0)
	YAE4 B 2 bright A_FadeOut(0.05)
	Loop
	}
}

ACTOR DarklordRailWave
{
  RenderStyle Add
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +DONTSPLASH
  +NOCLIP
  +NOINTERACTION
  +THRUACTORS
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +THRUSPECIES
  +MTHRUSPECIES
  Species "CyberDemon"
  Scale 1
  States
	{
	Spawn:
		TNT1 A 0
		RGPG ABCDEFGHIJKLMNOP 2 A_FadeOut(0.04)
	Stop
		}
 }

Actor DarklordRailPuff //main puff, shockwave fast
{
  Radius 0
  Height 0
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  -SOLID
  +NOTELEPORT
  +FORCEXYBILLBOARD
  Translation "0:255=%[0,0,0]:[2.0,0.2,0.2]"
  Scale 0.44
  RenderStyle Add
	States
	{
	Spawn:
		TNT1 A 0 A_StopSound(1)
		TNT1 A 0 BRIGHT A_SetRoll(0)
		TNT1 A 0 A_StartSound("cyberrail/impact", CHAN_AUTO, CHANF_OVERLAP)
		TNT1 AA 0 A_CustomMissile ("PBExplosionparticles", 0, 0, random (0, 360), 2, random (40, 90))
		EXPL AA 0 A_CustomMissile ("ExplosionSmokeFast22", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAA 0 A_CustomMissile ("FireworkSFXType2", 2, 0, random (0, 360), 2, random (10, 80))
		TNT1 A 0 A_explode(35, 80, 0)
		TNT1 A 0 A_SpawnItemEx("ObeliskTrailSpark", random(-8, 8), random(-8, 8), random(-2,2), 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0)
		TNT1 A 0 BRIGHT A_SpawnItemEx("RedLightningTrial",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION, 0)
		HRX2 A 0
			{
			A_Setscale(frandom(.7,.9));
			A_Setroll(frandom(-30,30));
			A_Changeflag("SPRITEFLIP",random(1,0));
			}
		HRX2 ABCDEFGH 3 Bright
			{
			A_Setscale(scalex*1.05,scaley*1.05);
			A_Setroll(roll*1.05);
			}
	Stop
	}
}

