ACTOR RainCometAttack
{
  Radius 5
  Height 5
  Speed 56
  Damage 0
  Projectile
  Species "Cyberdemon"
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +SEEKERMISSILE
  +FLOORHUGGER
  +BLOODLESSIMPACT
  BounceType "Hexen"
  BounceFactor 1
  WallBounceFactor 1
  BounceCount 20
  var int user_NumShots;
  States
	{

	Spawn:
		TNT1 A 1 A_SeekerMissile(90, 90)
	Loop
	Death:
		TNT1 A 0
		TNT1 A 0 A_SetUserVar("user_NumShots", random(10,15))
	DistantHellStormContinue:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx("FloorStandingStormSpawner",Random(250,-250),Random(250,-250),0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_SETMASTER | SXF_ORIGINATOR)
		TNT1 A 0 A_SetUserVar("user_NumShots", user_NumShots - 1)
		TNT1 A 0 A_JumpIf(user_NumShots > 0, "DistantHellStormContinue")
	Waiting:
		TNT1 A 0
		TNT1 A 0 A_SetUserVar("user_NumShots", random(35,50))
	WaitingContinue:
		TNT1 A 2 Bright
		TNT1 A 0 A_SetUserVar("user_NumShots", user_NumShots - 1)
		TNT1 A 0 A_JumpIf(user_NumShots > 0, "WaitingContinue")
		TNT1 A 0 A_RemoveChildren(1,RMVF_EVERYTHING)
		TNT1 A 0 A_Remove(1,RMVF_EVERYTHING)
		TNT1 A 0 A_TakeInventory("SummonedHellStorm",1,0,AAPTR_MASTER)
	Stop
		}
 }

