 }

Actor RocketZoomer
{
  Radius 2
  Height 2
  +NOINTERACTION
  +BRIGHT
  +FORCEXYBILLBOARD
  +FLOORHUGGER
  RenderStyle Add
  Translation "0:255=%[0,0,0]:[2.0,0.0,0.2]"
  Scale 2.51
  Alpha 0.01
  States
	{
	Spawn:
