ACTOR PB_BVCH_Machina : PB_Monster
{
	Health 850
	Radius 20
	Height 56
	Mass 500
	Speed 14
	PainChance 40
	Monster
	+FLOORCLIP
	+COUNTKILL
	+MISSILEMORE
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Obituary "%o was disabled by a Machina."
	SeeSound "bvch/machina/sight"
	ActiveSound "bvch/machina/active"
	PainSound "bvch/machina/pain"
	DeathSound "bvch/machina/death"
	Tag "Machina"
	States
	{
	Spawn:
		MIAL A 10 A_Look
		Loop
	See:
		MIAL AABBCCDDEEFF 2 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_Jump(100, "Plasma")
		TNT1 A 0 A_PlaySound("bvch/machina/attack", 2)
		MIAL G 8 Bright A_FaceTarget
		MIAL H 6 Bright A_VileTarget
		MIAL IJKLMN 5 Bright A_FaceTarget
		MIAL O 8 Bright A_VileAttack("bvch/machina/vile", 12, 60, 65, 1.0, "Plasma")
		MIAL P 12 Bright
		Goto See
	Plasma:
		TNT1 A 0 A_PlaySound("bvch/machina/attack", 2)
		MIAL GHIJKLM 3 Bright A_FaceTarget
		MIAL O 6 Bright A_CustomMissile("Plasma_Ball", 40, 0, 0)
		MIAL P 8 Bright A_CustomMissile("Plasma_Ball", 40, 0, random(-4, 4))
		Goto See
	Pain:
		MIAL Q 5
		MIAL Q 5 A_Pain
		Goto See
	Death:
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 32, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("XDeath2", 28, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("PB_BloodMistBig", 30, 0, random(0, 360), 2, random(30, 90))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		MIAL Q 6
		MIAL R 6
		MIAL S 6
		MIAL TUVWX 5
		MIAL Y 5
		MIAL Z -1
		Stop
	XDeath:
		Goto Death
	}
}

