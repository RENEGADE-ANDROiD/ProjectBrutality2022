// The Hotel: Lost Contact guest monsters + gore props (Hevn_Cross-90eks).
// Sprites: SPRITES/Monsters/Hotel/ (HTB2/HTBS/HTBD renamed from BOS2/BRUS/BRUD).
// Gore props: SPRITES/Decoration/HotelGore/ (HLGR/HLGU).
// Sounds: sounds/monsters/Hotel/ (see SNDINFO hotel/* / mory/* / skulker is separate).

// ---------------------------------------------------------------------------
// Combat guests
// ---------------------------------------------------------------------------

ACTOR PB_HotelMory : PB_Monster
{
	Health 500
	Radius 22
	Height 54
	Mass 400
	Speed 11
	FastSpeed 13
	Scale 0.15
	MeleeRange 70
	PainChance 190
	GibHealth -55
	Monster
	+FLOORCLIP
	+LOOKALLAROUND
	+NOINFIGHTING
	+COUNTKILL
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Obituary "%o was torn apart by Mory."
	HitObituary "%o was torn apart by Mory."
	SeeSound "mory/Sight"
	PainSound "hotel/morypain"
	DeathSound "morydie"
	AttackSound "moryatk"
	Tag "Mory"
	States
	{
	Spawn:
		MORY A 10 A_Look
		Loop
	See:
		MORY ABCDEFGH 1 A_Chase
		Loop
	Melee:
		MORY I 1 A_FaceTarget
		MORY J 2
		MORY KL 2 A_CustomMeleeAttack(15, "moryatk", "weapons/gswing")
		MORY L 1
		MORY M 1 A_SkullAttack
		MORY NOP 1
		Goto See
	Pain:
		MORY A 2 A_Pain
		MORY P 2
		Goto See
	Death:
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 24, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("XDeath2", 20, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 28, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("PB_BloodMistBig", 24, 0, random(0, 360), 2, random(30, 90))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		Stop
	XDeath:
		Goto Death
	}
}

ACTOR PB_HotelBloodCrawler : PB_Monster
{
	Health 350
	Radius 20
	Height 30
	Mass 500
	Speed 13
	MeleeRange 40
	MeleeDamage 8
	Scale 0.36
	PainChance 80
	Monster
	+FLOORHUGGER
	+LOOKALLAROUND
	+FLOORCLIP
	+COUNTKILL
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Obituary "%o was killed by a blood crawler."
	SeeSound ""
	ActiveSound "hotel/act"
	DeathSound "hotel/death"
	PainSound "hotel/pain"
	Tag "Blood Crawler"
	States
	{
	Spawn:
		A4IM A 1 A_Look
		Loop
	See:
		A4IW A 1 A_Chase
		TNT1 A 0 A_PlaySound("hotel/crawl", 5, 0.5, true)
		A4IW BC 1 A_Chase
		A4IW DEF 1 A_Chase
		A4IW GH 1 A_Chase
		A4IW IJ 1 A_Chase
		Loop
	Melee:
		TNT1 A 0 A_Jump(128, "Me1")
		Goto Me2
	Me1:
		A4IM ACEG 1 A_FaceTarget
		TNT1 A 0 A_MeleeAttack
		TNT1 A 0 A_PlaySound("hotel/hit")
		A4IM IKM 1
		Goto See
	Me2:
		A4IF ACEGIK 1 A_FaceTarget
		TNT1 A 0 A_MeleeAttack
		TNT1 A 0 A_MeleeAttack
		TNT1 A 0 A_PlaySound("hotel/hit")
		A4IF MPR 1
		Goto See
	Pain:
		A4IM A 3 A_Pain
		Goto See
	Death:
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAA 0 A_CustomMissile("XDeath1", 16, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 20, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("PB_BloodMistBig", 18, 0, random(0, 360), 2, random(20, 70))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		HMDY A 1
		HMDY BCDEF 3
		HMDY G 1
		HMDY HIJ 2
		HMDY K -1
		Stop
	XDeath:
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 16, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 14, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 20, 0, random(0, 360), 2, random(30, 80))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		Stop
	}
}

ACTOR PB_HotelVoidCrawler : PB_Monster
{
	Health 330
	Radius 22
	Height 34
	Mass 500
	Speed 13
	MeleeRange 40
	MeleeDamage 8
	Scale 0.40
	PainChance 80
	Monster
	+FLOORHUGGER
	+LOOKALLAROUND
	+FLOORCLIP
	+COUNTKILL
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Obituary "%o was killed by a void crawler."
	SeeSound ""
	ActiveSound "hotel/act"
	DeathSound "hotel/death"
	PainSound "hotel/pain"
	Tag "Void Crawler"
	States
	{
	Spawn:
		B4IM A 1 A_Look
		Loop
	See:
		B4IW A 1 A_Chase
		TNT1 A 0 A_PlaySound("hotel/crawl", 5, 0.5, true)
		B4IW BC 1 A_Chase
		B4IW DEF 1 A_Chase
		B4IW GH 1 A_Chase
		B4IW IJ 1 A_Chase
		Loop
	Melee:
		TNT1 A 0 A_Jump(128, "Me1")
		Goto Me2
	Me1:
		B4IM ACEG 1 A_FaceTarget
		TNT1 A 0 A_MeleeAttack
		TNT1 A 0 A_PlaySound("hotel/hit")
		B4IM IKM 1
		Goto See
	Me2:
		B4IF ACEGIK 1 A_FaceTarget
		TNT1 A 0 A_MeleeAttack
		TNT1 A 0 A_MeleeAttack
		TNT1 A 0 A_PlaySound("hotel/hit")
		B4IF MPR 1
		Goto See
	Pain:
		B4IM A 3 A_Pain
		Goto See
	Death:
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAA 0 A_CustomMissile("XDeath1", 16, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 20, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("PB_BloodMistBig", 18, 0, random(0, 360), 2, random(20, 70))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		BMDY A 1
		BMDY BCDEF 3
		BMDY G 1
		BMDY HIJ 2
		BMDY K -1
		Stop
	XDeath:
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 16, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 14, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 20, 0, random(0, 360), 2, random(30, 80))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		Stop
	}
}

ACTOR PB_HotelBloodCrawlerBig : PB_Monster
{
	Health 1500
	Radius 35
	Height 70
	Mass 2000
	Speed 5
	MeleeRange 60
	MeleeDamage 30
	Scale 0.75
	PainChance 40
	Monster
	+FLOORHUGGER
	+LOOKALLAROUND
	+DONTHURTSPECIES
	+COUNTKILL
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Obituary "%o was crushed by a blood crawler."
	SeeSound "hotel/crwlsee"
	ActiveSound "hotel/act"
	DeathSound "hotel/death"
	PainSound "hotel/pain"
	Tag "Blood Crawler (Large)"
	States
	{
	Spawn:
		HTB2 G 1 A_Look
		Loop
	See:
		TNT1 A 0 A_PlaySound("hotel/crwlwl", 6, 0.7, false)
		HTB2 GGGAAABBBCCC 2 A_Chase
		TNT1 A 0 A_PlaySound("hotel/crwlwl", 6, 0.7, false)
		HTB2 DDDEEEFFF 2 A_Chase
		Loop
	Melee:
		HTB2 HHH 2 A_FaceTarget
		HTB2 IJ 1 A_MeleeAttack
		TNT1 A 0 A_PlaySound("hotel/hit")
		HTB2 K 6
		Goto See
	Missile:
		HTB2 HHH 2 A_FaceTarget
		HTB2 IIJJ 1 A_CustomBulletAttack(4.0, 4.0, 1, 8, "BulletPuff")
		TNT1 A 0 A_PlaySound("hotel/hit")
		HTB2 K 6
		Goto See
	Pain:
		HTB2 G 3 A_Pain
		Goto See
	Death:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("XDeath3", 32, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("PB_BloodMistBig", 40, 0, random(0, 360), 2, random(30, 90))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		HTB2 N 4
		HTB2 OPQRST 4
		HTB2 T -1
		Stop
	XDeath:
		Goto Death
	}
}

ACTOR PB_HotelOgre : PB_Monster
{
	Health 600
	Radius 30
	Height 65
	Mass 800
	Speed 5
	Scale 0.7
	MeleeRange 80
	MeleeDamage 12
	PainChance 120
	Monster
	+FLOORCLIP
	+SOLID
	+COUNTKILL
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Obituary "%o was slashed into pieces."
	SeeSound "hotel/ogresee"
	PainSound "hotel/ogrepain"
	DeathSound "hotel/ogrefall"
	ActiveSound "hotel/ogreact"
	Tag "Hotel Ogre"
	States
	{
	Spawn:
		TNT1 A 0 A_PlaySound("hotel/csawready", 6, 0.6, true)
		OGRA BBBCCCDDDEEEFFFGGGHHHIII 2 A_Look
		Loop
	See:
		TNT1 A 0 A_PlaySound("hotel/chnswf1", 7, 0.7, false)
		OGRH ABCDEFGH 2 A_Chase
		TNT1 A 0 A_PlaySound("hotel/chnswf", 6, 0.55, true)
		OGRA JJKKLLMMNNOOPPQQ 2 A_Chase
		Loop
	Melee:
		TNT1 A 0 A_Jump(128, "Melee1")
		Goto Melee2
	Melee1:
		TNT1 A 0 A_PlaySound("hotel/ogresee")
		OGRB AB 2 A_FaceTarget
		OGRB CDEFG 2 A_CustomMeleeAttack(random(10, 18), "weapons/chainsaw/start", "weapons/gswing")
		OGRB HIJK 3 A_FaceTarget
		OGRB LMN 2 A_CustomMeleeAttack(random(8, 14), "weapons/chainsaw/start", "weapons/gswing")
		Goto See
	Melee2:
		TNT1 A 0 A_PlaySound("hotel/ogresee")
		OGRC ABCDE 2 A_FaceTarget
		OGRC FGHIJ 2 A_CustomMeleeAttack(random(12, 20), "weapons/chainsaw/start", "weapons/gswing")
		OGRC KLMN 3
		Goto See
	Pain:
		OGRA A 3 A_Pain
		Goto See
	Death:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("XDeath3", 32, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("PB_BloodMistBig", 40, 0, random(0, 360), 2, random(30, 90))
		TNT1 AAAA 0 A_CustomMissile("NashGoreBloodSpurt", 32, 0, random(170, 190), 2, random(0, 40))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		OGRE ABCDEFG 4
		OGRE G -1
		Stop
	XDeath:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath3", 32, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		Stop
	}
}

ACTOR PB_HotelBruiser : PB_Monster
{
	Health 600
	Radius 30
	Height 65
	Mass 1500
	Speed 4
	PainChance 62
	Monster
	+FLOORCLIP
	+COUNTKILL
	DropItem "Shell", 128
	DropItem "Clip", 128
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Obituary "%o was gunned down by a Hotel Bruiser."
	SeeSound "hotel/bruisersee"
	PainSound "hotel/bruiserpain"
	DeathSound "hotel/bruiserdeath"
	ActiveSound "hotel/bruisersee"
	Tag "Hotel Bruiser"
	States
	{
	Spawn:
		HTBS A 5 A_Look
		Loop
	See:
		TNT1 A 0 A_Jump(128, "SeeFast")
		HTBS AAABBBCCCDDD 2 A_Chase
		Goto See
	SeeFast:
		HTBS AAABBBCCCDDD 2 A_FastChase
		Goto See
	Missile:
		TNT1 A 0 A_Jump(128, "M1")
		Goto M2
	M1:
		HTBS EEEEEE 2 A_FaceTarget
		TNT1 A 0 A_PlaySound("hotel/shotgun")
		HTBS F 3 Bright A_CustomBulletAttack(13.0, 13.0, 10, 2, "BulletPuff")
		HTBS E 5
		TNT1 A 0 A_PlaySound("hotel/shotguncock")
		HTBS B 4
		HTBS A 3
		Goto See
	M2:
		HTBS EEEE 2 A_FaceTarget
	M2Hold:
		HTBS F 1 Bright A_CustomBulletAttack(6.0, 6.0, 1, 3, "BulletPuff")
		TNT1 A 0 A_PlaySound("hotel/smg")
		HTBS E 2
		HTBS F 1 Bright A_CustomBulletAttack(6.0, 6.0, 1, 3, "BulletPuff")
		TNT1 A 0 A_PlaySound("hotel/smg")
		HTBS E 2
		HTBS F 1 Bright A_CustomBulletAttack(6.0, 6.0, 1, 3, "BulletPuff")
		TNT1 A 0 A_PlaySound("hotel/smg")
		HTBS E 2
		TNT1 A 0 A_CPosRefire
		Goto M2Hold
	Pain:
		HTBS A 3 A_Pain
		Goto See
	Death:
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("XDeath3", 32, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("PB_BloodMistBig", 40, 0, random(0, 360), 2, random(30, 90))
		TNT1 AAAA 0 A_CustomMissile("NashGoreBloodSpurt", 32, 0, random(170, 190), 2, random(0, 40))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		HTBD ABCDE 6
		HTBD E -1
		Stop
	XDeath:
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAAA 0 A_CustomMissile("XDeath1", 40, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 36, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath3", 32, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAAA 0 A_CustomMissile("MuchBlood", 48, 0, random(0, 360), 2, random(40, 90))
		TNT1 A 0 A_SpawnItem("GrowingBloodPool")
		Stop
	}
}

