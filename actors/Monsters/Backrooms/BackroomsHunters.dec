// Backrooms Redux guest hunters (Kazim_Master) — killable rare mini-bosses.
// Sprites under SPRITES/Monsters/Backrooms/ (SFVI/SFVW/SFVA, SMLR).
// Audio: Level ! RUN chase bed + EXPL death from BackroomsRedux.wad (see SNDINFO).

ACTOR PB_BackroomsSanguineFestivus : PB_Monster
{
	Health 900
	Radius 20
	Height 56
	Mass 700
	Speed 16
	FastSpeed 18
	MeleeRange 64
	PainChance 40
	Scale 0.6
	Monster
	+FLOORCLIP
	+LOOKALLAROUND
	Species BaronOfHell
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	DamageFactor "Blood", 0.0
	Obituary "%o was smashed down by a Sanguine Festivus Instance."
	HitObituary "%o was smashed down by a Sanguine Festivus Instance."
	SeeSound "knight/sight"
	PainSound "knight/pain"
	DeathSound "backrooms/expl"
	States
	{
	Spawn:
		SFVI AB 10 A_Look
		Loop
	See:
		TNT1 A 0 A_PlaySound("backrooms/run", 6, 0.65, true)
	SeeChase:
		SFVW AABBCCBB 2 A_Chase
		Loop
	Melee:
		SFVA A 5 A_FaceTarget
		SFVA B 5 A_CustomMeleeAttack(random(20, 35), "baron/melee", "weapons/gswing")
		SFVA C 5 A_FaceTarget
		Goto SeeChase
	Pain:
		SFVI B 3
		SFVI B 3 A_Pain
		Goto SeeChase
	Death:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 32, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 32, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("XDeath3", 28, 0, random(0, 360), 2, random(30, 80))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 40, 0, random(0, 360), 2, random(40, 90))
		SFVA C 6
		SFVA C 6 A_SetTranslucent(0.8, 0)
		SFVA C 6 A_SetTranslucent(0.5, 0)
		SFVA C 6 A_SetTranslucent(0.2, 0)
		Stop
	XDeath:
		Goto Death
	Death.cut:
		Goto Death
	Death.ExtremePunches:
		Goto Death
	Death.Flames:
		Goto Death
	Raise:
		SFVI A 5 A_SetTranslucent(1.0, 0)
		SFVI B 5
		Goto See
	}
}

ACTOR PB_BackroomsSmiler : PB_Monster
{
	Health 650
	Radius 20
	Height 56
	Mass 400
	Speed 20
	FastSpeed 22
	MeleeRange 64
	PainChance 0
	Scale 1.2
	Monster
	+FLOORCLIP
	+LOOKALLAROUND
	+BRIGHT
	Species BaronOfHell
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	DamageFactor "Blood", 0.0
	Obituary "%o was shredded by a Smiler."
	HitObituary "%o was shredded by a Smiler."
	SeeSound "demon/sight"
	PainSound "demon/pain"
	DeathSound "backrooms/expl"
	States
	{
	Spawn:
		SMLR A 1 Bright A_Look
		Loop
	See:
		TNT1 A 0 A_PlaySound("backrooms/run", 6, 0.65, true)
	SeeChase:
		SMLR A 2 Bright A_Chase
		Loop
	Melee:
		SMLR A 4 Bright A_FaceTarget
		SMLR A 5 Bright A_CustomMeleeAttack(random(15, 30), "demon/melee", "weapons/gswing")
		Goto SeeChase
	Pain:
		SMLR A 1 Bright
		Goto SeeChase
	Death:
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_Scream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_Fall
		TNT1 AAAA 0 A_CustomMissile("XDeath1", 32, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAAA 0 A_CustomMissile("XDeath2", 32, 0, random(0, 360), 2, random(40, 90))
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 40, 0, random(0, 360), 2, random(40, 90))
		SMLR A 4 Bright
		SMLR A 4 Bright A_SetTranslucent(0.8, 0)
		SMLR A 4 Bright A_SetTranslucent(0.5, 0)
		SMLR A 4 Bright A_SetTranslucent(0.2, 0)
		Stop
	XDeath:
		Goto Death
	Death.cut:
		Goto Death
	Death.ExtremePunches:
		Goto Death
	Death.Flames:
		Goto Death
	Raise:
		SMLR A 5 Bright A_SetTranslucent(1.0, 0)
		Goto See
	}
}
