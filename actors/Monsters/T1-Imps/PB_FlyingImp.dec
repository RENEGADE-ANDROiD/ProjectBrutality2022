//===========================================================================
// Flying Imp — Brutal Doom Plus fold (AEIM float chase + FireBall_ double volley)
//===========================================================================

ACTOR PB_FlyingImp : PB_Monster
{
	//$Title Flying Imp
	//$Category Project Brutality - Monsters/Imps
	//$Sprite AEIMA1
	Game Doom
	Health 80
	Radius 20
	Height 56
	Mass 100
	GibHealth 35
	Speed 12
	PainChance 200
	PainChance "Head", 255
	PainChance "Melee", 255
	PainChance "Fatality", 255
	PainChance "Kick", 255
	PainChance "ExtremePunches", 255
	PainChance "Taunt", 255
	PainChance "Stun", 255
	damagefactor "Blood", 0.0
	damagefactor "BlueBlood", 0.0
	damagefactor "GreenBlood", 0.0
	damagefactor "Avoid", 1.0
	damagefactor "Trample", 1.5
	damagefactor "Crush", 10.0
	damagefactor "Kick", 0.5
	damagefactor "SSG", 5.0
	damagefactor "Shrapnel", 0.3
	damagefactor "CauseObjectsToSplash", 0.0
	damagefactor "killme", 0.0
	damagefactor "TeleportRemover", 0.0
	damagefactor "GibRemoving", 0.0
	BloodType "Brutal_Blood", "BloodSPlatterReplacer", "SawBlood"
	Monster
	+FLOAT
	+NOGRAVITY
	+DONTHURTSPECIES
	+SLIDESONWALLS
	Species Imp
	SeeSound "imp/sight"
	PainSound "imp/pain"
	DeathSound "imp/death"
	ActiveSound "imp/active"
	Obituary "$OB_FLYINGIMP"
	HitObituary "$OB_FLYINGIMPHIT"
	DropItem "Demonpickup" 40
	MaxStepHeight 24
	MaxDropOffHeight 32

	States
	{
	Spawn:
		AEIM ABCD 10 A_Look
		Loop
	See:
		AEIM AABBCCDD 3 A_Chase
		Loop
	Missile:
		AEIM EF 6 A_FaceTarget
		AEIM O 6 A_CustomMissile("FireBall_", 32)
		AEIM F 4 A_FaceTarget
		AEIM O 6
		AEIM F 4 A_FaceTarget
		AEIM O 6 A_CustomMissile("FireBall_", 32)
		Goto See
	Melee:
		AEIM F 4 A_FaceTarget
		AEIM O 6 A_CustomMissile("FireBall_", 32)
		AEIM F 10 A_FaceTarget
		Goto See
	Pain:
		AEIM G 2
		AEIM G 2 A_Pain
		Goto See
	Death:
		AEIM H 8
		AEIM I 8 A_Scream
		AEIM J 6
		AEIM K 6 A_NoBlocking
		AEIM L 6
		AEIM M 6
		AEIM N -1
		Stop
	XDeath:
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_FaceTarget
		TNT1 AAA 0 A_CustomMissile("XDeath1", 42, 0, random(0, 190), 2, random(10, 60))
		TNT1 AAA 0 A_CustomMissile("XDeath3", 42, 0, random(0, 190), 2, random(10, 60))
		TNT1 A 0 A_CustomMissile("XDeath2", 42, 0, random(0, 190), 2, random(10, 60))
		TNT1 A 0 A_CustomMissile("XDeath4", 42, 0, random(0, 190), 2, random(10, 60))
		TNT1 A 1 A_CustomMissile("ImpXDeath", 0, 0, random(0, 360), 2, random(0, 160))
		Stop
	Death.cut:
	Death.Saw:
		Goto XDeath
	Death.Flames:
	Death.fire:
	Death.Burn:
		Goto Death
	Death.ExtremePunches:
		Goto XDeath
	Death.Fatality:
		TNT1 A 0 A_Pain
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 A_GiveToTarget("GoFatality", 1)
		TNT1 A 0 A_Jump(256, "Death.Fatality1", "Death.Fatality2", "Death.Fatality3")
		Goto Death.Fatality1
	Death.Fatality1:
		TNT1 A 0 A_GiveToTarget("ImpFatality8", 1)
		Stop
	Death.Fatality2:
		TNT1 A 0 A_GiveToTarget("ImpFatality9", 1)
		Stop
	Death.Fatality3:
		TNT1 A 0 A_GiveToTarget("ImpFatality10", 1)
		Stop
	Raise:
		AEIM NMLKJIH 8
		Goto See
	}
}
