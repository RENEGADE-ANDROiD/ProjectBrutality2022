// Vanilla map light props → looping NewFlares aura + MapDecorations.inc lights.
// Friendly marines keep inheriting base RedTorch; these replaces only affect map spawns.

ACTOR PB_Candle : Candle Replaces Candle
{
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIfInventory("PB_DecoAuraSpawned", 1, "SpawnLit")
		TNT1 A 0 A_SpawnItemEx("PB_DecoAura_Candle", 0, 0, 0, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveInventory("PB_DecoAuraSpawned", 1)
	SpawnLit:
		CBR1 A -1 Bright
		Stop
	}
}

