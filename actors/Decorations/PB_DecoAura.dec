ACTOR PB_DecoAura_BarrelGreen : PB_DecoAuraBase
{
	Alpha 0.28
	XScale 0.25
	YScale 0.15
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(!master, "Null")
	AuraLoop:
		TNT1 A 0 A_JumpIf(!master, "Null")
		TNT1 A 0 A_JumpIfInventory("BarrelIsFlaming", 1, "Null", AAPTR_MASTER)
		TNT1 A 0 A_JumpIfInventory("BarrelIsFrozen", 1, "Null", AAPTR_MASTER)
		TNT1 A 0 A_JumpIfInventory("DrainedBarrel", 1, "Null", AAPTR_MASTER)
		TNT1 A 0 A_JumpIfInventory("DrainedBarrelCut", 1, "Null", AAPTR_MASTER)
		BAR1 X 4 Bright A_Warp(AAPTR_MASTER, 0, 0, 32, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		Loop
	}
}

ACTOR PB_DecoAura_BarrelFlame : PB_DecoAuraBase
{
	Alpha 0.4
	Scale 0.40
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(!master, "Null")
	AuraLoop:
		TNT1 A 0 A_JumpIf(!master, "Null")
		TNT1 A 0 A_JumpIfInventory("BarrelIsFlaming", 1, 1, AAPTR_MASTER)
		Goto Null
		TNT1 A 0 A_JumpIfInventory("DrainedBarrel", 1, "Null", AAPTR_MASTER)
		BBAR X 2 Bright A_Warp(AAPTR_MASTER, 0, 0, 34, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_JumpIf(!master, "Null")
		TNT1 A 0 A_SetScale(0.34)
		BBAR X 1 Bright A_Warp(AAPTR_MASTER, 0, 0, 34, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_SetScale(0.40)
		Loop
	}
}

