// Looping NewFlares auras for map light decorations (pairs with MapDecorations.inc).
// Spawn once: A_SpawnItemEx(..., SXF_SETMASTER|SXF_NOCHECKPOSITION) + give latch inventory.

ACTOR PB_DecoAuraSpawned : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR PB_DecoAuraNukageSpawned : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR PB_DecoAuraFlameSpawned : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR PB_DecoAuraIceSpawned : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR PB_DecoAuraBase : Flare_General
{
	+FORCEXYBILLBOARD
	+NOINTERACTION
	+NOGRAVITY
	+CLIENTSIDEONLY
	RenderStyle Translucent
	Alpha 0.4
	Scale 0.35
}

ACTOR PB_DecoAura_Candle : PB_DecoAuraBase
{
	Alpha 0.35
	Scale 0.12
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(!master, "Null")
	AuraLoop:
		TNT1 A 0 A_JumpIf(!master, "Null")
		TYEL X 2 Bright A_Warp(AAPTR_MASTER, 0, 0, 14, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_JumpIf(!master, "Null")
		TNT1 A 0 A_SetScale(0.10)
		TYEL X 1 Bright A_Warp(AAPTR_MASTER, 0, 0, 14, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 A 0 A_SetScale(0.12)
		Loop
	}
}

