// Player footsteps (Staging Footsteps.zs adapted for 4.5.0 + cvar volume/delay).

class PB_Footsteps : Actor
{
	Default
	{
		+NOINTERACTION
	}

	PlayerPawn toFollow;
	int updateTics;

	void Init(PlayerPawn attached_player)
	{
		toFollow = attached_player;
	}

	override void Tick()
	{
		if (!toFollow)
		{
			Destroy();
			return;
		}

		let cvOn = CVar.FindCVar("cl_footsteps");
		if (cvOn && !cvOn.GetBool())
		{
			updateTics = 5;
			return;
		}

		if (gamestate == GS_TITLELEVEL || gametic < 35)
			return;
		if (toFollow.CountInv("CameraRunner") > 0)
			return;

		updateTics--;
		if (updateTics > 1)
			return;

		SetOrigin(toFollow.pos, false);
		floorz = toFollow.floorz;

		double playerVel2D = toFollow.Vel.Length();
		double isCrouched = toFollow.GetCrouchFactor();

		if ((playerVel2D > 0.1) && (toFollow.pos.z - toFollow.floorz <= 0))
		{
			sound stepsound;
			if (toFollow.floorpic == skyflatnum)
				stepsound = "none";
			else
				stepsound = GetFlatSound(TexMan.GetName(toFollow.floorpic));

			string speed;
			if (isCrouched < 0.99)
				speed = "creep";
			else if (playerVel2D >= 10)
				speed = "run";
			else
				speed = "walk";

			double volMul = 1.0;
			let cvVol = CVar.FindCVar("cl_step_volmul");
			if (cvVol)
				volMul = clamp(cvVol.GetFloat() / 7.0, 0.05, 3.0);

			if (updateTics == 1)
			{
				double soundVolume = clamp(playerVel2D * 0.05 * volMul, 0.0, 1.0);
				toFollow.A_StartSound(speed .. "/foley/pre", CHAN_AUTO, CHANF_LOCAL | CHANF_UI, volume: soundVolume);
			}
			else
			{
				double soundVolume = clamp(isCrouched * playerVel2D * 0.05 * volMul, 0.0, 1.0);
				if (stepsound != "none")
					toFollow.A_StartSound(stepsound, CHAN_AUTO, CHANF_LOCAL | CHANF_UI, volume: soundVolume);
				toFollow.A_StartSound(speed .. "/foley/post", CHAN_AUTO, CHANF_LOCAL | CHANF_UI, volume: soundVolume);

				double delayMul = 1.0;
				let cvDelay = CVar.FindCVar("cl_step_delaymul");
				if (cvDelay)
					delayMul = clamp(cvDelay.GetFloat(), 0.1, 2.0);
				double dmul = (2.1 - delayMul);
				updateTics = int((gameinfo.normforwardmove[0] - playerVel2D) * dmul);
				if (updateTics < 2)
					updateTics = 2;
			}
		}
		else
		{
			updateTics = 1;
		}
	}

	sound GetFlatSound(string texname)
	{
		Name tmpname = PB_Materialsys.GetMaterialFromTexName(texname);
		if (tmpname == 'err_nomaterialfound' || tmpname == 'err_escapedloop')
			tmpname = 'default';
		return "step/" .. tmpname;
	}
}
