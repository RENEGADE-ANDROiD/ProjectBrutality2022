// Shared deploy debounce for Platinum / MKIII railgun holograms.

class PB_HoloDeployCooldown : Inventory
{
	int life;

	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
		-INVENTORY.INVBAR
	}

	override void DoEffect()
	{
		Super.DoEffect();
		if (++life >= PB_HoloDeploy.COOLDOWN_TICS)
			Destroy();
	}
}

class PB_HoloDeploy
{
	const COOLDOWN_TICS = 280; // ~8 seconds

	// Returns true and starts the cooldown when a deploy is allowed.
	play static bool TryBegin(Actor user)
	{
		if (!user)
			return false;
		if (user.CountInv("PB_HoloDeployCooldown") > 0)
		{
			user.A_Print("\cgHologram recharging");
			return false;
		}
		user.GiveInventory("PB_HoloDeployCooldown", 1);
		return true;
	}
}
