class HelmetDropHandler : EventHandler
{
	override void WorldThingDied(WorldEvent e)
	{
		if (!e || !e.thing) return;
		Actor dead = e.thing;

		bool isSpecial = dead is "PyroSergeant"
			|| dead is "PB_QSGZombie"
			|| dead is "PB_PistolZombieman2";
		bool hasHelmet = isSpecial
			|| dead is "PB_HelmetZombieman"
			|| dead is "PB_PistolZombieman2"
			|| dead is "PB_HelmetCommando"
			|| dead is "PB_ShotgunGuyHelmet"
			|| dead is "PB_HelmetSergeant";

		if (!hasHelmet)
			return;

		Class<Actor> helmCls = "PB_DroppedHelmet";
		if (!helmCls) return;
		double xvel = frandom(-8, 8);
		double yvel = frandom(-8, 8);
		double zvel = frandom(5, 10);
		vector3 p = (dead.pos.x, dead.pos.y, dead.pos.z + dead.Default.Height * 0.9);
		Actor helm = Actor.Spawn(helmCls, p);
		if (!helm) return;
		helm.angle = frandom(0, 359);
		helm.vel = (xvel, yvel, zvel);
		if (dead is "PB_HelmetCommando")
			helm.A_SetTranslation("CommandoHelm");
	}
}
