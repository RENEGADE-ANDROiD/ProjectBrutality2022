// Footstep / impact material lookup — Staging FastMaterialCheck without Map<> (ZScript 4.5.0).

class PB_MaterialDataStorage
{
	string bulletImpact;
	color tintColor;
	string footstepSound;
	string materialName;

	static PB_MaterialDataStorage CreateDefault()
	{
		PB_MaterialDataStorage m = new("PB_MaterialDataStorage");
		if (m)
		{
			m.bulletImpact = "PB_BulletImpact";
			m.tintColor = "FFFFFF";
			m.footstepSound = "step/default";
			m.materialName = "default";
		}
		return m;
	}
}

class PB_Materialsys : StaticEventHandler
{
	Array<string> textureNames;
	Array<int> rangeFrom;
	Array<int> rangeTo;
	Array<Name> rangeMaterial;

	void SetupMaterial(Array<string> refArray, Name materialId)
	{
		int from = textureNames.Size();
		for (int i = 0; i < refArray.Size(); i++)
			textureNames.Push(refArray[i].MakeLower());
		int to = textureNames.Size() - 1;
		if (to < from)
			return;
		rangeFrom.Push(from);
		rangeTo.Push(to);
		rangeMaterial.Push(materialId);
	}

	clearscope static PB_MaterialDataStorage GetMaterialDefFromTexName(string texName)
	{
		PB_MaterialDataStorage m = PB_MaterialDataStorage.CreateDefault();
		Name mat = GetMaterialFromTexName(texName);
		if (m && mat != 'err_nomaterialfound' && mat != 'err_escapedloop')
		{
			m.materialName = mat;
			m.footstepSound = "step/" .. mat;
		}
		return m;
	}

	clearscope static Name GetMaterialFromTexName(string texName)
	{
		PB_Materialsys seh = PB_Materialsys(StaticEventHandler.Find("PB_Materialsys"));
		if (!seh || seh.textureNames.Size() < 1)
			return 'default';

		texName = texName.MakeLower();
		int matIndex = -1;
		for (int i = 0; i < seh.textureNames.Size(); i++)
		{
			if (texName.IndexOf(seh.textureNames[i]) == 0)
			{
				matIndex = i;
				break;
			}
		}
		if (matIndex < 0)
			return 'default';

		for (int r = 0; r < seh.rangeFrom.Size(); r++)
		{
			if (matIndex >= seh.rangeFrom[r] && matIndex <= seh.rangeTo[r])
				return seh.rangeMaterial[r];
		}
		return 'default';
	}

	override void OnRegister()
	{
		Array<string> texnamesBuf;
		int i;

		for (i = 0; i < FLATS_WATER.Size(); i++) texnamesBuf.Push(FLATS_WATER[i]);
		SetupMaterial(texnamesBuf, 'water');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_SLIME.Size(); i++) texnamesBuf.Push(FLATS_SLIME[i]);
		SetupMaterial(texnamesBuf, 'slime');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_FLESH.Size(); i++) texnamesBuf.Push(FLATS_FLESH[i]);
		SetupMaterial(texnamesBuf, 'flesh');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_LAVA.Size(); i++) texnamesBuf.Push(FLATS_LAVA[i]);
		SetupMaterial(texnamesBuf, 'lava');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_ROCK.Size(); i++) texnamesBuf.Push(FLATS_ROCK[i]);
		SetupMaterial(texnamesBuf, 'rock');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_WOOD.Size(); i++) texnamesBuf.Push(FLATS_WOOD[i]);
		SetupMaterial(texnamesBuf, 'wood');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_TILEA.Size(); i++) texnamesBuf.Push(FLATS_TILEA[i]);
		SetupMaterial(texnamesBuf, 'tile/a');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_TILEB.Size(); i++) texnamesBuf.Push(FLATS_TILEB[i]);
		SetupMaterial(texnamesBuf, 'tile/b');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_HARD.Size(); i++) texnamesBuf.Push(FLATS_HARD[i]);
		SetupMaterial(texnamesBuf, 'hard');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_CARPET.Size(); i++) texnamesBuf.Push(FLATS_CARPET[i]);
		SetupMaterial(texnamesBuf, 'carpet');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_METALA.Size(); i++) texnamesBuf.Push(FLATS_METALA[i]);
		SetupMaterial(texnamesBuf, 'metal/a');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_METALB.Size(); i++) texnamesBuf.Push(FLATS_METALB[i]);
		SetupMaterial(texnamesBuf, 'metal/b');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_DIRT.Size(); i++) texnamesBuf.Push(FLATS_DIRT[i]);
		SetupMaterial(texnamesBuf, 'dirt');
		texnamesBuf.Clear();

		for (i = 0; i < FLATS_GRAVEL.Size(); i++) texnamesBuf.Push(FLATS_GRAVEL[i]);
		SetupMaterial(texnamesBuf, 'gravel');
		texnamesBuf.Clear();
	}

	static const string FLATS_SLIME[] = { "SFALL", "BFALL", "BDT_WFL", "BDT_BFL", "BDT_AFL", "BDT_SFL1", "BDT_SFL2", "NUKAGE1", "NUKAGE2", "NUKAGE3", "SLIME01", "SLIME02", "SLIME03", "SLIME04", "SLIME05", "SLIME06", "SLIME07", "SLIME08" };
	static const string FLATS_WATER[] = { "FWATER1", "FWATER2", "FWATER3", "FWATER4", "BLOOD1", "BLOOD2", "BLOOD3", "WATER", "BLOOD", "WFALL", "BDT_W", "BDT_B", "BDT_S" };
	static const string FLATS_FLESH[] = { "SFLR6_1","SFLR6_4","SFLR7_1","SFLR7_4" };
	static const string FLATS_LAVA[] = { "LAVA1","LAVA2","LAVA3","LAVA4","BDT_LFL" };
	static const string FLATS_ROCK[] = { "SLIME09","SLIME10","SLIME11","SLIME12","RROCK01","RROCK02","RROCK05","RROCK06","RROCK07","RROCK08","FLAT1","FLAT1_1","FLAT1_2","FLAT5_6","FLAT5_7","FLAT5_8","FLOOR5_4","GRNROCK","MFLR8_2","MFLR8_3","RROCK03","RROCK04","RROCK09","RROCK10","RROCK11","RROCK12","RROCK13","RROCK14","RROCK15","SLIME13", "STONE6", "STONE7", "SW1STON6", "TANROCK", "ZIMMER3", "ZIMMER4" };
	static const string FLATS_WOOD[] = { "FLOOR0_2","CEIL1_1","CRATOP1","CRATOP2","FLAT5_1","FLAT5_2", "WOOD", "PAN", "CRAT", "PANEL", "STUCCO", "FLOOR0_1", "FLOOR0_3", "FLOOR7_1", "FLAT5_5", "TANROCK2", "TANROCK3", "TANROCK8", "ZZWOLF5", "ZZWOLF6", "ZZWOLF7", "BIGDOOR5", "BIGDOOR6", "BIGDOOR7" };
	static const string FLATS_TILEA[] = { "CEIL1_3","CEIL3_3","CEIL3_4","COMP01","FLAT2","FLAT3","FLAT8","FLAT9","FLAT17","FLAT18","FLAT19","FLOOR0_6","FLOOR0_7","FLOOR3_3","FLOOR4_1","FLOOR4_5","FLOOR4_6","FLOOR4_8","FLOOR5_1","FLOOR5_2","FLOOR5_3","TLITE6_1","TLITE6_4","TLITE6_5","TLITE6_6" };
	static const string FLATS_TILEB[] = { "DEM1_1","DEM1_2","DEM1_3","DEM1_4","DEM1_5","DEM1_6","FLOOR7_2" };
	static const string FLATS_HARD[] = { "CEIL3_1","CEIL3_2","CEIL3_5","CEIL3_6","CEIL5_1","CEIL5_2","FLAT5","FLOOR0_1","FLOOR0_3","FLOOR1_6","FLOOR1_7","FLOOR7_1","GRNLITE1","MFLR8_1" };
	static const string FLATS_CARPET[] = { "CEIL4_1","CEIL4_2","CEIL4_3","FLAT5_3","FLAT5_4","FLAT5_5","FLAT14","FLOOR1_1" };
	static const string FLATS_METALA[] = { "FLOOR0_5","CEIL1_2","FLAT1_3","FLAT20","GATE1","GATE2","GATE3","SLIME14","SLIME15","SLIME16","STEP1","STEP2", "SHAWN", "SILVER", "BRONZ", "SUPPORT", "STEP", "FLAT22", "FLAT23", "CONS", "LITE", "COMM", "DOOR", "PLAT" };
	static const string FLATS_METALB[] = { "CONS1_1","CONS1_5","CONS1_7","FLAT4","FLAT22","FLAT23","GATE4", "PIPE", "COMP", "TEK", "METAL", "SPACE", "STAR" };
	static const string FLATS_DIRT[] = { "FLAT10","GRASS1","GRASS2","MFLR8_4","RROCK16","RROCK17","RROCK18","RROCK19","RROCK20", "ASHWALL3", "ASHWALL4", "ZIMMER5" };
	static const string FLATS_GRAVEL[] = { "FLOOR6_1","FLOOR6_2" };
}
