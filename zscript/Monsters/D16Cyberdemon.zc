Class D16Cyberdemon: PB_Monster
{
	int seeonce; //to check whether the player was seen once
	int hc; //for max health
	int mh; //to check max health once
	int AttackChance; //Attack if Anger > AttackChance
	int Anger; //The less health the boss has, the more often he attacks.
	int BossState;
	const LaserDist = 2300; //Distance for using laser.

	int NumShots;
	int NumShots1;
	const ArenaRadius = 600; //The radius of the arena made of rocks.
	const Stage2Health = 10000; //The level of health after which the second stage of the battle begins.
	Array <Actor> StoneBarrierArray;
	Vector3 spawnpos;
	Vector2 ofs;
	Mixin MP_VolumetricLaserBeam;

	int w; //1 if the cyberdemon is injured; The death animation plays differently.
	Default
	{
  DamageFactor "BFG", 0.5;
  DamageFactor "Plasma", 0.75;
  DamageFactor "Disintegrate", 0.5;
  DamageFactor "GreenFire", 0.5;
  DamageFactor "SSG", 0.75;
  damagefactor "Fire", 0.75;
  damagefactor "Flames", 0.75;
  damagefactor "Burn", 0.75;
