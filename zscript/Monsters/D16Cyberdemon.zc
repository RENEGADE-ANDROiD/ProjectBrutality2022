		HIBR O 3 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnProjectile("D16CyberdemonWave",42,0,0,CMF_OFFSETPITCH,random(-1,1));
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonWaveArmSpark", 6, 29, 42);
		HIBR P 3 Bright A_FaceTarget();
		TNT1 A 0 {NumShots--;}
		TNT1 A 0 A_CheckSight("BarrierEnd");
		HIBR P 10 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonWaveArmSpark", 33, 4, 42);
		HIBR O 3 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnProjectile("D16CyberdemonWave",42,0,0,CMF_OFFSETPITCH,random(-1,1));
		TNT1 A 0 {NumShots--;}
		TNT1 A 0 A_CheckSight("BarrierEnd");
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonWaveArmSpark", 45, 46, 63);
		HIBR N 3 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonWaveArmSpark", 9, 75, 96);
		HIBR M 3 Bright A_FaceTarget();
		TNT1 A 0 A_JumpIf(NumShots>0, "BarrierMissiles2Continue");
		TNT1 A 0 A_Jump(256, "BarrierEnd");

	BarrierEnd:
		HIBR L 6 Bright A_FaceTarget();
		TNT1 A 0 {if (BossState==0) {bNOPAIN=0;}}
		TNT1 A 0 {bNOTARGETSWITCH = 0;}
		TNT1 A 0
			{		
					for (int i = 0; i < StoneBarrierArray.Size(); i++)
						{
						let Stone = StoneBarrierArray[i];
						if (Stone)
						{Stone.DamageMobj(self, self, Stone.health, "inv", DMG_FOILINVUL);}
						}
			}

	Goto See2;

	Bombardment:
		TNT1 A 0;
		TNT1 A 0 A_StopSound();
		TNT1 A 0 A_FaceTarget();
		HIBR L 6 Bright A_FaceTarget();
	BombardmentContinue0:
		TNT1 A 0;
		TNT1 A 0 A_JumpIf(BossState == 1, "Bombardment2Continue0");
		TNT1 A 0 {NumShots = random(15,20);}
		TNT1 A 0 {NumShots1 = 0;}
	BombardmentContinue:
		HIBR J 3 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonocketRainUpwards", 0,0,83, frandom(5.0,-5.0),frandom(5.0,-5.0),20, 0,SXF_SETMASTER|SXF_NOCHECKPOSITION);
		TNT1 A 0 {NumShots--; NumShots1++;}
		TNT1 A 0 A_JumpIf(NumShots>0, "BombardmentContinue");
		HIBR K 3 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonocketRainUpwards", 0,0,83, frandom(5.0,-5.0),frandom(5.0,-5.0),20, 0,SXF_SETMASTER|SXF_NOCHECKPOSITION);
		TNT1 A 0 {NumShots--; NumShots1++;}
		TNT1 A 0 A_JumpIf(NumShots>0, "BombardmentContinue");
	BombardmentEnd:
		HIBR L 6 Bright A_FaceTarget();
	BombardmentEndContinue:
		TNT1 A 0 A_VileTarget("D16CyberdemonGroundTargetSpawner");
		TNT1 A 0 {NumShots1--;}
		TNT1 A 0 A_JumpIf(NumShots1>0, "BombardmentEndContinue");
	Goto See2;


	Bombardment2Continue0:
		TNT1 A 0 {NumShots = random(17,20);}
		TNT1 A 0 {NumShots1 = 0;}
	Bombardment2Continue:
		HIBR J 3 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonocketRainUpwards", 0,0,83, frandom(5.0,-5.0),frandom(5.0,-5.0),20, 0,SXF_SETMASTER|SXF_NOCHECKPOSITION);
		TNT1 A 0 {NumShots--; NumShots1++;}
		TNT1 A 0 A_JumpIf(NumShots>0, "Bombardment2Continue");
		HIBR K 3 Bright A_FaceTarget();
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonocketRainUpwards", 0,0,83, frandom(5.0,-5.0),frandom(5.0,-5.0),20, 0,SXF_SETMASTER|SXF_NOCHECKPOSITION);
		TNT1 A 0 {NumShots--; NumShots1++;}
		TNT1 A 0 A_JumpIf(NumShots>0, "Bombardment2Continue");
	Bombardment2End:
		HIBR L 6 Bright A_FaceTarget();
	BombardmentEnd2Continue:
		TNT1 A 0 A_VileTarget("D16CyberdemonGroundTargetSpawner2");
		TNT1 A 0 {NumShots1--;}
		TNT1 A 0 A_JumpIf(NumShots1>0, "BombardmentEnd2Continue");
	Goto See2;


	Melee:
		TNT1 A 0;
		TNT1 A 0 {if (BossState==0) {bNOPAIN=0;}}
		HIBR L 5 Bright A_FaceTarget();
		TNT1 A 0 A_Recoil(-15);
		HIBR MN 4 Bright A_FaceTarget();
		HIBR N 0 A_FaceTarget();
		TNT1 A 0 A_Recoil(-15);
		TNT1 A 0 A_StartSound ("D16Cyberdemon/melee");
		TNT1 A 0 A_CustomMeleeAttack(random(4,6)*10, "D16Cyberdemon/melee")	;
		TNT1 A 0 A_Explode (150,200);
		HIBR O 7 Bright;
		HIBR PQ 4 Bright;
	Goto See2;

	Ram:
		TNT1 A 0;
		TNT1 A 0 A_Jumpif (CybDist(self, target) > 600, "MissileNoRam");
		TNT1 A 0 {bNOPAIN=1;}
		HIBR RS 6 Bright A_FaceTarget();
		HIBR T 0 ThrustThingZ(0,0,0,1);
		HIBR T 0 A_FaceTarget();
		TNT1 A 0 {NumShots = 5;}
		TNT1 A 0 A_StartSound ("D16Cyberdemon/charge");
	RamLoop:
		HIBR T 3 Bright A_Recoil (-20);
		TNT1 A 0 A_SpawnItemEx("D16CyberdemonPuff",0,0,0,0,0,2);
		HIBR T 0 A_CustomMeleeAttack(80, "D16Cyberdemon/impact");
		TNT1 A 0 {NumShots --;}
		TNT1 A 0 A_JumpIfTargetInsideMeleeRange("Melee");
		TNT1 A 0 A_JumpIf(NumShots>0, "RamLoop");
		TNT1 A 0 {if (BossState==0) {bNOPAIN=0;}}
		HIBR T 10 Bright A_JumpIfTargetInsideMeleeRange("Melee");
	Goto See2;

	Death:
		TNT1 A 0;
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 A_JumpIfInTargetInventory("HasIncendiaryWeapon",1,"Death.Incinerate");
		TNT1 A 0 A_JumpIfIntargetInventory("SSGSelected", 1, "Death.SSG");
		TNT1 A 0 A_JumpIfIntargetInventory("MinigunSelected", 1, "Death.Railgun");
		TNT1 A 0 A_JumpIfIntargetInventory("NewChaingunSelected", 1, "Death.Railgun");
		TNT1 A 0 A_JumpIfIntargetInventory("MG42Selected", 1, "Death.Railgun");
		TNT1 A 0 A_JumpIfIntargetInventory("QSGSelected", 1, "Death.SSG");
		HIBD QRST 8;
		TNT1 A 0 Radius_Quake (3, 25, 0, 22, 0);
		TNT1 A 0 A_StartSound("baron/step", 6);
		HIBD U 4;
		TNT1 A 0 A_SpawnItem ("GrowingBloodPool");
		TNT1 A 0 A_SpawnItem ("DeadD16Cyberdemon");
	Stop;

	Death.Head:
		TNT1 A 0;
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 A_JumpIfInTargetInventory("HasIncendiaryWeapon",1,"Death.Incinerate");
		TNT1 A 0 A_JumpIfInTargetInventory("HasPlasmaWeapon", 1, "Death.Plasma");
		TNT1 A 0 A_JumpIfInTargetInventory("HasCutingWeapon", 1, "Death.decaptate");
		TNT1 A 0 A_StartSound("misc/xdeath4");
		TNT1 A 0 A_SpawnProjectile ("D16CyberdemonHeadExplode", 96, 0, random (0, 360), 2, random (0, 67));
		HIBF ABCD 8;
		TNT1 A 0 Radius_Quake (3, 25, 0, 22, 0);
		TNT1 A 0 A_StartSound("baron/step", 6);
		HIBF E 4;
		TNT1 A 0 A_SpawnItem ("GrowingBloodPool");
		TNT1 A 0 A_SpawnItem ("DeadD16CyberdemonNoHead");
	Stop;

	Death.decaptate:
		TNT1 A 0;
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 A_StartSound("misc/xdeath4");
		TNT1 A 0 A_SpawnProjectile ("XDeathHeadD16Cyberdemon", 96, 0, random (0, 360), 2, random (0, 67));
		HIBF ABCD 8;
		TNT1 A 0 Radius_Quake (3, 25, 0, 22, 0);
		TNT1 A 0 A_StartSound("baron/step", 6, CHANF_OVERLAP);
		HIBF E 4;
		TNT1 A 0 A_SpawnItem ("GrowingBloodPool");
		TNT1 A 0 A_SpawnItem ("DeadD16CyberdemonNoHead");
	Stop;


	XDeath:
	Death.Explosiveimpact:
	Death.Explosives: 
	Death.Landmine:
		TNT1 A 0;
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 Radius_Quake (6, 100, 0, 22, 0);
		TNT1 AAAA 0 A_SpawnProjectile ("ExplosionSpawner", 75, 0, random (0, 360), 2, random (0, 75));
		TNT1 AAAAAA 0 A_SpawnProjectile ("ExplosionSpawner", 75, 0, random (0, 360), 2, random (0, 75));
		TNT1 AAAAA 0 A_SpawnProjectile("UltraGoreSPawner", 71, 0, random (0, 360), CMF_BADPITCH | CMF_ABSOLUTEPITCH | CMF_AIMDIRECTION, random (0, 75));
		TNT1 AAAAA 0 A_SpawnProjectile("UltraGoreSpawner", 71, 0, random (0, 360), CMF_BADPITCH | CMF_ABSOLUTEPITCH | CMF_AIMDIRECTION, random (0, 75));
		TNT1 AAAAA 0 A_SpawnProjectile("MuchMeatDeath", 71, 0, random (0, 360), CMF_BADPITCH | CMF_ABSOLUTEPITCH | CMF_AIMDIRECTION, random (0, 75));
		TNT1 A 0 A_SpawnProjectile ("RidiculousExplosionSpawner", 63, 0, random (0, 360), 2, 38);
		TNT1 A 0 A_SpawnProjectile ("XDeathHeadD16Cyberdemon", 92, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonGun", 75, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonArm", 75, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonTorso", 67, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonLeg1", 13, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonLeg2", 13, 0, random (0, 360), 2, random (0, 67));		
		Stop;

	Death.Railgun:
	Death.Blast:
	Death.SSG:
	Death.Minigun:
	Death.Cutless:
		HIBD AB 6;
		TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx("Blood",0,0,48);
		HIBD CDED 8;
		TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx("Blood",0,0,48);
		HIBD CDED 8;
		TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx("Blood",0,0,48);
		HIBD CDED 8;
		TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx("Blood",0,0,48);
		HIBD CDEFG 8;
		HIBD H 14;
		HIBD I 6;
		TNT1 A 0 Radius_Quake (6, 100, 0, 22, 0);
		TNT1 AAAA 0 A_SpawnProjectile ("ExplosionSpawner", 75, 0, random (0, 360), 2, random (0, 75));
		TNT1 AAAAAA 0 A_SpawnProjectile ("ExplosionSpawner", 75, 0, random (0, 360), 2, random (0, 75));
		HIBD J 5 A_Scream();
		TNT1 A 0 A_SpawnProjectile ("RidiculousExplosionSpawner", 63, 0, random (0, 360), 2, 38);
		TNT1 AAAA 0 A_SpawnProjectile ("ExplosionSpawner", 75, 0, random (0, 360), 2, random (0, 75));
		TNT1 AAAAAA 0 A_SpawnProjectile ("ExplosionSpawner", 75, 0, random (0, 360), 2, random (0, 75));
		TNT1 AAAAA 0 A_SpawnProjectile("UltraGoreSPawner", 71, 0, random (0, 360), CMF_BADPITCH | CMF_ABSOLUTEPITCH | CMF_AIMDIRECTION, random (0, 75));
		TNT1 AAAAA 0 A_SpawnProjectile("UltraGoreSpawner", 71, 0, random (0, 360), CMF_BADPITCH | CMF_ABSOLUTEPITCH | CMF_AIMDIRECTION, random (0, 75));
		TNT1 AAAAA 0 A_SpawnProjectile("MuchMeatDeath", 71, 0, random (0, 360), CMF_BADPITCH | CMF_ABSOLUTEPITCH | CMF_AIMDIRECTION, random (0, 75));
		TNT1 A 0 A_SpawnProjectile ("RidiculousExplosionSpawner", 63, 0, random (0, 360), 2, 38);
		TNT1 A 0 A_SpawnProjectile ("XDeathHeadD16Cyberdemon", 92, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonGun", 75, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonArm", 75, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonTorso", 67, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonLeg1", 13, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("XDeathD16CyberdemonLeg2", 13, 0, random (0, 360), 2, random (0, 67));		
		TNT1 O 0 A_NoBlocking();
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
	Stop;

	Death.Cut:
	Death.Saw:
		TNT1 A 0 A_Jump(64, "Death.Cutless");
		TNT1 A 0 A_ScaleVelocity(0);
		TNT1 A 0 {bNOINTERACTION = true;}
		TNT1 A 0 A_NoBlocking();
		TNT1 AAA 0 A_SpawnProjectile ("Instestin", 71, 0, random (63, 88), 2, random (0, 17));
		TNT1 AAAA 0 A_SpawnProjectile ("brutal_FlyingBlood", 71, 0, random (71, 79), 2, random (0, 17));
		TNT1 A 0 A_SpawnProjectile ("XDeath1", 71, 0, random (0, 360), 2, random (0, 67));
		TNT1 A 0 A_SpawnProjectile ("RipHalfD16CyberdemonUpper", 21, 0, random (0, 360), 2, random (0, 67));
		HIBE MMMM 4;
		HIBE NNNN 4;
		HIBE OOOO 4 A_SpawnItem ("Big_Blood", 71, 13); // 170->71, 30->13
		TNT1 A 0 A_SpawnItem ("GrowingBloodPool");
		TNT1 A 1 A_SpawnItem ("RipHalfD16CyberdemonLowerGib");
	Stop;

	Death.Ice:
	Death.IceExplosion:
	Death.Freeze:
	Death.Frost:
		TNT1 A 0;
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 A_SpawnItemEx("FrozenD16Cyberdemon", 0, 0, 0, 0, 0, 0, random(1,360), SXF_NOCHECKPOSITION);
	Stop;


	Death.Blackhole:
		TNT1 A 0;
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 A_SpawnItem("BlackHoledD16Cyberdemon");
	Stop;


	Death.Shrink:
		TNT1 A 0;
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_BossDeath();
		TNT1 A 1 A_StartSound("Shrink", 3);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX08", 0, 0, 5, 0, 0);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX07", 0, 0, 5, 0, 0);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX06", 0, 0, 5, 0, 0);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX05", 0, 0, 5, 0, 0);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX04", 0, 0, 5, 0, 0);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX03", 0, 0, 5, 0, 0);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX02", 0, 0, 5, 0, 0);
		TNT1 A 0 A_SpawnItemEx ("D16CyberdemonShrinkFX01", 0, 0, 5, 0, 0);
		TNT1 A 1 A_SpawnItemEx ("LilD16Cyberdemon", 1);
	Stop;

	Death.Fire:
	Death.Burn:
		TNT1 A 0;
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_SpawnItem("BurningD16Cyberdemon");
	Stop;

	Death.Incinerate:
		TNT1 A 0;
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_SpawnItem("IncinerateDyingD16Cyberdemon");
	Stop;

	Death.Disintegrate:
		TNT1 A 0;
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_SpawnItem("DisintegrateDyingD16Cyberdemon");
	Stop;


	Death.Plasma:
	Death.Plasma2:
		TNT1 A 0;
		TNT1 A 0 A_BossDeath();
		TNT1 A 0 {bSHOOTABLE = false; bSOLID = false;}
		TNT1 A 0 A_SpawnItem("PlasmaDyingD16Cyberdemon");
	Stop;

	Death.Execution:
		TNT1 A 0 {
		A_BossDeath();
		A_StopSound();
		A_FaceTarget();
		A_NoBlocking();
		}
		TNT1 A 0 A_GiveToTarget("BPtoken",5);
	Stop;
	}
}

Class D16CyberdemonHolder: Actor
{
int CeilingHeight;
Default
{
  +CLIENTSIDEONLY;
  -SOLID;
  +DONTRIP;
  -COUNTKILL;
  -ALLOWTHRUFLAGS;
  +STOPRAILS;
  +FLOORCLIP;
  +FLOORHUGGER;
  +THRUACTORS;
  +NOTELEPORT;
  -PUSHABLE;
  +NODAMAGETHRUST;
  +NOTARGET;
  +INVULNERABLE;
  +NOBLOOD;
  +NOBLOODDECALS;
  +SHOOTABLE;
  +NOICEDEATH;
  +DONTTHRUST;
  +BOSS;
  -BOSSDEATH;
  Scale 0.05;
  Speed 0;
  Height 5;
  Radius 25;
  Health 1;
  Renderstyle "Add";
  Gravity 5;
  Mass 1000;
}
  States
	{
	Spawn:
		TNT1 A 0 A_ScaleVelocity(0);
	SpawnLoop:
		TNT1 A 1 A_CheckFloor("Rescaling");
		TNT1 A 0
		{
		if(waterlevel >= 1) {SetState(FindState("Rescaling"));}
		}
	Loop;

	Rescaling:
		TNT1 A 0;
		TNT1 A 0
		{
			Vector2 ofs = RotateVector((0, 0), 0); 
			Vector3 ppos = Vec3Offset(ofs.x, ofs.y, 0);
			let mo = Spawn("D16CyberdemonHolderStone", ppos);
			if (mo)
				{mo.master = self;}
		}
		TNT1 A 0
		{
		//radius = 20;
		bTHRUACTORS = false;
		bSOLID = true;
		}
		TNT1 A 0;
		TNT1 A 0 {Height = ceilingz - floorz;}
		//TNT1 A 0 {Console.Printf("New Real Height: %f", self.Height);}

	Idle:
		TNT1 A 5 {if (!master || master.health <= 0) {SetState(FindState("death"));}}
	Loop;

	Death:
	Death.Inv:
		TNT1 A 0;
		TNT1 A 0 A_KillChildren ("Inv", KILS_FOILINVUL, "D16CyberdemonHolderStone");
	Stop;
	}
}


Class D16CyberdemonHolderStone: Actor
{
const sm = 0.25;
double sx;
double sy;
int t;
Default
{
  Radius 1;
  Height 1;
  Scale 0.25;
  +CLIENTSIDEONLY;
  -SOLID;
  +NOCLIP;
  +THRUACTORS;
  +NOGRAVITY;
  +DONTFALL;
  +NOTELEPORT;
  -PUSHABLE;
  +NODAMAGETHRUST;
  +NOTARGET;
  +INVULNERABLE;
  +NOBLOOD;
  +NOBLOODDECALS;
  +SHOOTABLE;
  +NOICEDEATH;
  +DONTTHRUST;
  Renderstyle "Normal";
}
  States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_ScaleVelocity(0);

		TNT1 A 0 A_Jump(256, "Spawn1", "Spawn2", "Spawn3");
	
	Spawn1:
		HIBX A 1 Bright A_Jump(256, "Rescaling");
	Spawn2:
		HIBX B 1 Bright A_Jump(256, "Rescaling");
	Spawn3:
		HIBX C 1 Bright A_Jump(256, "Rescaling");


	Rescaling:
	"####" "#" 0 {
	sx = frandom(0.7,1.2);
	sy = frandom(0.7,1.2)/3;
	bSPRITEFLIP=random(0,1);}
	//"####" "#" 0 {Console.Printf("sx: %f", sx);}
	//"####" "#" 0 {Console.Printf("sy: %f", sy);}

		"####" "###" 1 Bright
		{
		A_SetScale(sx, Scale.Y+sy);
		A_FadeIn(0.2);
		}
		
	Idle:
		"####" "#" 5 Bright;
	Loop;

	Death:
	Death.Inv:
		"####" "#" 0;
		"####" "###" 1 Bright
		{
		A_SetScale(sx, Scale.Y-sy);
		A_FadeOut(0.2);
		}
	Stop;
	}
}

