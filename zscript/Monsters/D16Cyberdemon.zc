Class D16CyberdemonLightningStrike: Actor
{
const sy = 256;
int Tick;
float StartY;
Default

{
  Scale 1.0;
  RenderStyle "Add";
  Alpha 0.85;
  Radius 16;
  Height 14;
  Speed 0;
  Damage 1;
  PROJECTILE;
  +MISSILE;
  +RIPPER;
  RipperLevel 2;
  +FLOORCLIP;
  +FLOORHUGGER;
  +CEILINGHUGGER
  +NOGRAVITY;
  +NOINTERACTION;
}
  States
	{
	Spawn:
		TNT1 AAAAAA 0 A_SpawnProjectile("D16CyberdemonHellStormCloudEffect", random(-65, 65), random(-65, 65));
		TNT1 A 2;
		TNT1 A 0 {StartY = Scale.Y;}
		TNT1 A 0 {bSPRITEFLIP = random(0,1);}
		TNT1 A 0 {
				Height = ceilingz - floorz;
				Scale.Y = Scale.Y*(height/sy);
				}
		TNT1 A 0 {
				if (Scale.Y > StartY)
					{
					Scale.X = Scale.X + ((Scale.Y - StartY)/2);
					}
				}
		HIBX DEF 1 Bright;
		TNT1 A 0 A_SpawnItemEx("ObeliskExplode",1,1,15,0,0,0,0);

		TNT1 A 0;
		TNT1 A 0 A_StartSound("weapons/devzap",2,1.0,1,0.6);
		HIBX GHIGHI 1 Bright
			{
			if (tick > 2)
				{
				bNOINTERACTION = False;
				tick = 0;
				}
			else
				{
				bNOINTERACTION = True;
				tick++;
				}
			}
		TNT1 A 0 A_StartSound("weapons/devzap",2,1.0,0,0.6);
		HIBX JKL 1 Bright
			{
			if (tick > 1)
				{
				bNOINTERACTION = False;
				tick = 0;
				}
			else
				{
				bNOINTERACTION = True;
				tick++;
				}
			}
		TNT2 AAAAA 4 A_SpawnProjectile ("PlasmaSmoke", 1, 0, random (0, 360), 2, random (0, 160));
	Stop;
	 }
}



