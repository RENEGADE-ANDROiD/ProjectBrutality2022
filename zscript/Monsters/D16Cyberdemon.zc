	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0 A_StartSound("Weapons/StachanovFly",6,1.0,1);
	Fly:
		TNT1 A 6;
	Loop;
	Death:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StartSound("Weapons/YamatoExp",3);
		TNT1 A 0 A_Explode(random(10,13),8,0,0);
		TNT1 AAAA 0 A_SpawnItemEx("D16CyberdemonWaveSpark", random(19,-19), random(19,-19), random(19,-19), 0, 0, 0, 0, 128, 0);
		TNT1 A 0 {A_SetScale (0.25); A_SetRoll(random(0,360));}
		YA36 CCCCC 1 Bright
		{
		A_SetScale((Scale.X+0.1)*1.2, Scale.Y+0.1);
		A_SetRoll(roll+15);
		A_FadeOut(0.2);
		}		
	Stop;
	}
}

