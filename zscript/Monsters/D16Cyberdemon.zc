Class D16CyberdemonWave : FastProjectile
{
Default
{
  DamageType "Fire";
  Radius 32;
  Height 4;
  Speed 50;
  Damage 35;
  PROJECTILE;
  +THRUGHOST;
  +ROLLSPRITE;
  RenderStyle "Add";
  Alpha 1;
  DeathSound "weapons/StachanovHit";
  Decal "BigScorch";
  Scale 2;
  MissileType "D16CyberdemonWavetrail";
}
