  DamageFactor "Frost", 0.25;
  DamageFactor "PB_Shell", 0.05;
  DamageFactor "HexaAmmo", 0.05;
  DamageFactor "Blast", 0.75;
  DamageFactor "Cut", 0.75;
  DamageFactor "Explosive", 1.1;
  DamageFactor "HKFT", 0.05;
  DamageFactor "Decaptate", 5.0;
  DamageFactor "Avoid", 0.0;
  DamageFactor "killme", 0.0;
  DamageFactor "GibRemoving", 0.0;
  DamageFactor "TeleportRemover", 0.0;
  DamageFactor "CauseObjectsToSplash", 0.0;
  DamageFactor "Blackhole", 0.75;
  Tag "Tyrant";
  SeeSound "TYRSEE";
  PainSound "TYRPAI";
  DeathSound "DSDKDIE";
  ActiveSound "TYRACT";
  Obituary "%o was destroyed by a Tyrant.";
  +DONTRIP;
  +SOLID;
  +DONTHARMSPECIES;
  +THRUSPECIES;
  +BOSS;
  +BOSSDEATH;
  +FLOORCLIP;
  +NORADIUSDMG;
  +DONTMORPH;
  +NODAMAGETHRUST;
  +BUDDHA;
  Health 20000;
  //Health 160;
  DamageFactor "Crush", 20.0;
  MaxStepHeight 24;
  MaxDropOffHeight 32;
  Scale 1.0;
  Radius 25;
  Height 92;

  Speed 12;
  FastSpeed 32;
  Painchance 16;
  Mass 20833;
  MeleeRange 43;
  //Translation "0:2=%[0,0,0]:[0.3,0.3,0.3]", "9:37=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "48:79=%[0,0,0]:[0.3,0.3,0.3]", "112:175=%[0,0,0]:[0.3,0.3,0.3]", "192:255=%[0,0,0]:[0.3,0.3,0.3]";
  DropItem "SlayerPower", 40;
  DropItem "Demonpickup2", 255;
  DropItem "Demonpickup2", 255;
  DropItem "Crucible", 60;
  PainChance "BloodPunch", 255;
  WoundHealth 500;
  Damagefactor "Crucible", 2.0;
	}

	override void Tick()
	{
		Super.Tick();
		if(BossState == 0 && Self.Health < Stage2Health && !InStateSequence(self.curstate, self.ResolveState("FalseDeath1")))
			{SetState(FindState("FalseDeath1"));}
		else return;
	}

void AngryAttack()
{
	if(Self.Health > 0 && target && target.Health > 0 && CheckSight(target) && hc == 1)
		{
		Anger = 128-((mh-(mh-self.health))*0.128);
		if (Anger > 128) {anger = 128;}
		AttackChance = random(0,256);
		if ( Anger >= AttackChance && CybDist(self, target) > self.MeleeRange )
			{SetState(FindState("Missile"));}
		else if ( Anger >= AttackChance && CybDist(self, target) < self.MeleeRange )
			{SetState(FindState("Melee"));}
		else return;
		}
}

Void RockCircle()
{
	ofs = self.RotateVector((10, 0), self.angle);
	spawnpos = self.Vec3Offset(ofs.x, ofs.y, 45);
	spawnpos = self.Vec3Offset(ofs.x, ofs.y, 5);
	if (target)
		{
				//ArenaRadius = 800;
				SpawnRockBarrier("D16CyberdemonHolder", ArenaRadius);
		}
}


Void SpawnRockBarrier(string StoneName, int dist)
{
	float cr = 2*3.14159*dist; //circumference
	int RCount = int(cr/50); //Total number of barriers. The diameter of the barrier is 50
	if (RCount < 1) return;
	double angStep = 360.0 / RCount;
	for (int n = 0; n < RCount; n++)
	{
		Vector2 StoneOfs = RotateVector((dist, 0), self.angle + n * angStep);
		Vector3 StoneSpawnpos = Vec3Offset(StoneOfs.x, StoneOfs.y, 5);
		Actor Stone = Spawn(StoneName, StoneSpawnpos);
		if (Stone)
		{
			StoneBarrierArray.Push(Stone);
			Stone.master = self;
		}
	}
}

double CybDist(actor a, actor b)
{
	double d = 0;
		if (a && b)
		{
			d = a.Distance3D(b);
		}
	else 
		{
			d = 0;
		}
	return d;
}

	States
	{
	Wound:
		TNT1 A 0 A_Pain();
		HIBY ABCD 8 Bright;
		"####" "#" 1
		{
			if(GetCvar("be_ExecutionsON"))
			{
				if(countinv("FinisherToken")==0) //if it isnt healing already
				{								//will heal and give the token that indicates it's executable
					A_SpawnItemEx("BaronHighlight",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION); //to highlight if ON, and to remove the token after the monster heals
					A_GiveInventory("FinisherToken",1);	//token to allow melee attack to execute
					A_ScaleVelocity(0);
				}
				
				if(GetCvar("be_MonsterStagger")==1) //will the monsters stagger at all?
				{
					Height = 80;
					return ResolveState("Stagger");	//stays there for a few seconds
				}
				else
				{
					return ResolveState(null);
				}
			}
			return ResolveState(null);
		}
		Goto See;

	Stagger:
		HIBY R 0
		{
			if(getcvar("be_ExecutionHighlight")==1)
			{	return ResolveState("PrepareStaggerHighlight");}
			else
			{	return ResolveState("StagLooper");	}
		}
		Goto StagLooper;

	PrepareStaggerHighlight:
		HIBY R 4 Bright;
	Goto StagLooper;

	StagLooper:
		HIBY R 0 { w = 1;}
		"####" "#" 4
		{
			if(!countinv("FinisherToken"))
			{
				Height = 92;
				return Resolvestate("See");
				}
				if(getcvar("be_NoisyStagger") && countinv("PainSoundToken"))
				{ 
				A_Pain(); 
				A_TakeInventory("PainSoundToken");
			}
			return ResolveState(null);
		}
		"####" "#" 0;
	Loop;

