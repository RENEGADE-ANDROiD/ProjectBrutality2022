		TNT1 A 0
		{
			A_StopSound(CHAN_BODY);
			//A_StartSound("FAREXPL", CHAN_AUTO,CHANF_OVERLAP,0.5,0,1.1);
			Radius_Quake (2, 4, 0, 7, 0);
