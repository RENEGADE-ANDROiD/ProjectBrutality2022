		TNT1 A 0;
		TNT1 A 0 A_StartSound("weapons/rocketloop",CHAN_BODY,CHANF_LOOP);
	SpawnLoop:
		MIC8 C 1 Bright
			{
			//A_SpawnItemEx("RocketTrailFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION);
			//A_SpawnItemEx("RocketTrailSmoke",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION);
