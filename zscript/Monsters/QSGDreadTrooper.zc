Class PB_QSGDreadTrooper: PB_Monster
{
  int CantTeleport;
  int AmmoType;
  int NumShots;
  int NumBullets;
  int crouched;
  int Dist;
Default
  {
  Tag "Quad Dread Trooper";
  Monster;
  Species "Former_Human";
  Health 220;
  Radius 16;
  Height 56;
  Speed 10;
  FastSpeed 14;
  Scale 1.0;
  MaxStepHeight 24;
  MaxDropOffHeight 32;
  DamageFactor "Blood", 0.0;
  DamageFactor "BlueBlood", 0.0;
  DamageFactor "GreenBlood", 0.0;
  DamageFactor "TeleportRemover", 0.0;
  DamageFactor "Freeze", 2.0;
  DamageFactor "Flames", 0.25;
  DamageFactor "Fire", 0.25;
  DamageFactor "Burn", 0.25;
  SeeSound "grunt/sight";
  PainSound "grunt/pain";
  DeathSound "grunt/death";
  ActiveSound "grunt/active";
  DropItem "PB_Shell";
  DropItem "PB_QSGZombieDrop", 64;
  DropItem "PB_LeechPickup", 30;
  Obituary "%o was fried by a Dread Trooper";
  DropItem "Crucible", 4;
  WoundHealth 25;
  }

	override void Tick()
	{
		Super.Tick();
		
		// Update recognition if crouching
		if (InStateSequence(curstate, ResolveState("MissileCrouched")))
			Height = 44;
		else if (InStateSequence(curstate, ResolveState("AvoidLeft")))
			Height = 32;
		else if (InStateSequence(curstate, ResolveState("AvoidLeftShort")))
			Height = 32;
		else if (InStateSequence(curstate, ResolveState("AvoidRightShort")))
			Height = 32;
		else if (InStateSequence(curstate, ResolveState("AvoidRight")))
			Height = 32;
		else
			Height = 56;

		//Handle Hitbox system
		//HitboxerHandler();

	}
	void A_CombatDialogueHandler()
	{
		if (!target) return;
		if (target.health < 50)
			A_StartSound("monsters/zombie/player_low", CHAN_AUTO);
		else
			A_StartSound("monsters/zombie/combat", CHAN_AUTO);
	}


	override void PostBeginPlay() {
		Super.PostBeginPlay(); // call the super function for virtual functions so we don't break shit if GZdoom update.
		HitBoxSpawned = False;
	}

	Void TrooperShot (Double BulletHeight = 36, Double FlareHeight = 34)
	{

		if (Crouched == 1)
		{
			//console.printf ("DEBUG: crouched fire",I);
			BulletHeight = 24;
			FlareHeight = 22;
		}


		if (AmmoType == 0)
		{
			For (Int I = 7; I > 0; I--)
			{
				//console.printf ("DEBUG: Shotgunner fired %d bullets",I);
				A_SpawnProjectile("PB_ShotPellet12", BulletHeight, 14, random(-6, 6), 1, random(-4, 4));
				A_SpawnProjectile("ShotgunParticles", BulletHeight, 14, random(-9, 9), 6, random(-9, 9));
			}

			switch(NumBullets) //If the x variable is...
				{
				case 4:
					A_StartSound("QSGFIRE1", 1, CHAN_WEAPON);
					A_StartSound ("SuperShotgunDistantGunshot", 3, CHAN_7);
					return;
				case 3:
					A_StartSound("Weapons/SG", 1, CHAN_WEAPON);
					A_StartSound ("SuperShotgunDistantGunshot", 3, CHAN_7);
					return;
				case 2:
					A_StartSound("Weapons/SG", 1, CHAN_WEAPON);
					A_StartSound ("SuperShotgunDistantGunshot", 3, CHAN_7);
				return;
				case 1:
					A_StartSound ("weapons/shh2", CHAN_WEAPON);
				return;
				}
		}


		else
		{
			//console.printf ("DEBUG: Shotgunner fired %d bullets",I);
			A_SpawnProjectile("DreadTrooperDemonicBreathOneBlast", BulletHeight, 14, random(-6, 6), 1, random(-4, 4));
			A_SpawnProjectile("ShotgunParticles", BulletHeight, 14, random(-9, 9), 6, random(-9, 9));
			A_StartSound ("QSGCHRG", CHAN_WEAPON);
		}

		A_SpawnProjectile("OrangeLensFlareAlt", FlareHeight, 10, 15, 0);
		A_SpawnProjectile("OrangeLensFlareAlt", FlareHeight, 10, 15, 0);

	}



  States
    {	
	Wound:
		"####" "#" 1
		{
			if(GetCvar("be_ExecutionsON"))
			{
				if(countinv("FinisherToken")==0) //if it isnt healing already
				{								//will heal and give the token that indicates it's executable
					A_SpawnItemEx("ZombieHighlight",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION); //to highlight if ON, and to remove the token after the monster heals
					A_GiveInventory("FinisherToken",1);	//token to allow melee attack to execute
				}
				
				if(GetCvar("be_MonsterStagger")==1) //will the monsters stagger at all?
				{
					return ResolveState("Stagger");	//stays there for a few seconds
				}
				else
				{
					return ResolveState(null);
				}
			}
			return ResolveState(null);
		}
	Goto See;
	Stagger:
		QDFX A 0
		{
			if(getcvar("be_ExecutionHighlight")==1)
			{	return ResolveState("PrepareStaggerHighlight");}
			else
			{	return ResolveState("StagLooper");	}
		}
	Goto StagLooper;
	PrepareStaggerHighlight:
		QDFX A 0;
	Goto StagLooper;
	
	StagLooper:
		"####" "#" 4
		{
			if(!countinv("FinisherToken"))
			{
				return ResolveState("See");
			}
			if(getcvar("be_NoisyStagger") && countinv("PainSoundToken"))
			{ 
				A_Pain(); 
				A_TakeInventory("PainSoundToken");
			}
			return ResolveState(null);
		}
		//"####" "#" 0 { A_SpawnItem ("HeadshotTarget4", 0, 40,0); ;//A_SpawnItem ("LegTarget4", 10); }
		"####" "#" 0;
	Loop;

	Death.Crucible:
		TNT1 A 0 A_SpawnItemEx("GlorySawPinataLow",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360));
	Goto Death.cut;

	Death.GloryFire:
		TNT1 A 0 A_SpawnItemEx("FlamePinataSpawn",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360));
	Goto Death.Fire;

	Pain.GloryFire:
		TNT1 A 0 A_Jump(192, "See");
		TNT1 A 0 A_SpawnItemEx("FlamePinataSpawn",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360));
	Goto See;

	Death.BloodPunch:
		TNT1 A 0 A_GiveToTarget("BloodPunchKilled",1);
		TNT1 A 0 A_GiveToTarget("BloodPunchArmor",1);
		TNT1 A 0 A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH);
		TNT1 A 0 A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH);
		TNT1 A 0 A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH);
		TNT1 A 0 A_SpawnItemEx("BloodpunchWave", 0, 0, Height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_TRANSFERPITCH);
		TNT1 A 0 A_SpawnItemEx("GlorySawPinataLow",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360));
	Goto Death.ExtremePunches;

	Death.Execution:
		TNT1 A 0
		{
 		A_StopSound();
		A_FaceTarget();
		A_NoBlocking();
		}
		QDTM A 14;
		TNT1 A 0 A_Pain();
		QDTM G 15;
		TNT1 A 0 A_Recoil(4);
		TNT1 A 0 A_GiveToTarget("BPtoken",1);
		TNT1 A 0 A_SpawnItemEx("GlorySawPinataLow",0,0,Height / 2,random(0,8),0,random(0,8),random(0,360));
	Goto Death.ExtremePunches;

	Spawn:
		TNT1 A 0;
		TNT1 A 0;
		TNT1 A 0 A_GiveInventory("SKQSGDreadTrooper", 1);
		TNT1 A 0 A_GiveInventory("TypeSergeant", 1);
		TNT1 A 0 {NumShots = 4;}
		TNT1 A 0 {AmmoType = random(0,1);}
		QDTI B 1;
	Goto Stand;

	Stand:
		QDTI A 14 A_Look();
	Loop;

	LookAround:
		TNT1 A 0 A_ClearTarget();
		TNT1 A 0 A_TakeInventory("Wandering", 71);
		TNT1 A 0 A_Jump(200, "SeeContinue");
		TNT1 A 0 A_Jump(200, 2);
		TNT1 A 0 A_StartSound("monsters/zombie/searching", CHAN_AUTO);
		QDTI AAAAAAAA 12 A_Look();
	Goto See;

	See:
		TNT1 A 0 {Crouched = 0;}
		TNT1 A 0 {bNODROPOFF = false;}
		TNT1 A 0 A_TakeInventory("SKQSGDreadTrooper", 1);
		TNT1 A 0
		{
			EnemyLastSighted = Level.MapTime;
			bNoPain = false;
		}
	SeeContinue:
		TNT1 A 0 {Crouched = 0;}
		TNT1 A 0 {bNODROPOFF = false;}
		//TNT1 A 0 A_JumpIfTargetInLOS("Fallback",0,JLOSF_DEADNOJUMP,150);
		TNT1 A 0 {bNODROPOFF = false;}
		QDTM A 1 A_SmartChase();
		QDTM AA 1 A_Chase(null, null, CHF_DONTTURN);
		QDTM A 1 A_SmartChase();
		QDTM AA 1 A_Chase(null, null, CHF_DONTTURN);
		QDTM B 1 A_SmartChase();
		QDTM BB 1 A_Chase(null, null, CHF_DONTTURN);
		QDTM B 1 A_SmartChase();
		QDTM BB 1 A_Chase(null, null, CHF_DONTTURN);
		TNT1 A 0 A_StartSound("humans/step");
		QDTM C 1 A_SmartChase();
		QDTM CC 1 A_Chase(null, null, CHF_DONTTURN);
		QDTM C 1 A_SmartChase();
		QDTM CC 1 A_Chase(null, null, CHF_DONTTURN);
		QDTM D 1 A_SmartChase();
		QDTM DD 1 A_Chase(null, null, CHF_DONTTURN);
		QDTM D 1 A_SmartChase();
		QDTM DD 1 A_Chase(null, null, CHF_DONTTURN);
		TNT1 A 0 A_StartSound("humans/step");
		TNT1 A 0 A_JumpIf(CantTeleport == 1, 2);
		TNT1 A 0 A_Jump(64, "Teleportaway");
		TNT1 A 0;
		TNT1 A 0 A_JumpIf(CountInv("Wandering") == 71,"LookAround");
	Loop;

	FallBack:
		TNT1 A 0 {bNODROPOFF = true;}


		TNT1 A 0 ;//A_SpawnItem ("LegTarget4", 10);
		QDTM D 2 A_FaceTarget();
		TNT1 A 0 A_Jump(100, "Missile", "Pain.Avoid");
		TNT1 A 0;
		QDTM D 2 A_Recoil(5);

		TNT1 A 0 A_Jump(64, "Missile");

		TNT1 A 0 ;//A_SpawnItem ("LegTarget4", 10);
		TNT1 A 0 A_StartSound("humans/step",4);
		QDTM C 2 A_FaceTarget();
		QDTM C 2 A_Recoil(5);


		TNT1 A 0 ;//A_SpawnItem ("LegTarget4", 10);
		QDTM B 2 A_FaceTarget();
		QDTM B 2 A_Recoil(5);


		TNT1 A 0 ;//A_SpawnItem ("LegTarget4", 10);
		TNT1 A 0 A_StartSound("humans/step",4);
		QDTM A 2 A_FaceTarget();
		QDTM A 2 A_Recoil(4);
		TNT1 A 0 {bNODROPOFF = false;}
	Goto Missile;

	Melee:
		TNT1 A 0;
		TNT1 A 0 {CantTeleport = 0;}
		TNT1 A 0 A_Jump(224, 2);
		TNT1 A 0; //A_CombatDialogueHandler
		QDME A 6 A_FaceTarget();
		TNT1 A 0 A_Recoil(1);



		TNT1 A 0 A_StartSound("QSGDTM");
		TNT1 A 0 A_CustomMeleeAttack(10, "monsters/nazi/bash", "", "Normal");
		TNT1 A 0 A_SpawnProjectile ("SmallFlameTrails", 57, 13, 5, 0, 5);
		QDME B 10 A_FaceTarget();

		//TNT1 A 0 A_SpawnItem("HeadshotTarget4", 0, 40,0);

		QDME A 6;
		//TNT1 A 0 A_Jump(96, "Melee");
		TNT1 A 0 A_Jump(8, "Pain.Avoid");
		TNT1 A 0 A_ClearTarget;
	Goto FallBack;


	Missile:
		TNT1 A 0;
		TNT1 A 0 {CantTeleport = 0;}
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer",1, "DialogueCheck");
		TNT1 A 0 A_Jump(256, "MissileContinue");
	
	DialogueCheck:
		TNT1 A 0;
		TNT1 A 0 A_Jump(240, "MissileContinue");
		TNT1 A 0 A_CombatDialogueHandler();
	
	MissileContinue:
		TNT1 A 0; //A_Stop();
		TNT1 A 0 A_Jump(64,"Teleportaway");
		TNT1 A 0 A_CheckLOF("MissileSafeToFire"); // Checks if it is safe to fire Dragonbreath
	Goto See;  // Not safe to fire

	MissileSafeToFire:
		TNT1 A 0 A_Jump(96,"StartShooting");
		TNT1 A 0 A_JumpIfCloser (100,"Melee");

	StartShooting:
		TNT1 A 0;
		TNT1 A 0 A_Jump(96, "MissileCrouched");
	QuadShot:
		TNT1 A 0;
		TNT1 A 0
			{
				if (target)
				{
					Dist = Distance3D(self.target);
					if(Dist > 1000)
						{
						Return FindState ("SeeContinue");
						}
					else
						{
						Return FindState ("QuadShotContinue");
						}
				}
				else
				{
					Return FindState ("See");
				}
			}
	QuadShotContinue:
		TNT1 A 0;

		TNT1 A 0 A_CheckSight("SeeContinue");
		QDTM EEEE 2 A_FaceTarget();
		QDTM F 4;
		//QDTM F 0 Bright A_StartSound("DRBTFIRE", 12);
		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 35, 30, random (0, 40), 2, random (0, 160));
		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 35, 15, random (0, 40), 2, random (0, 160));
		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 25, 20, random (-40, 0), 2, random (-10, 0));
		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 25, -20, random (-40, 0), 2, random (-10, 0));


		//TNT1 AAAAAAAAAA 0 A_SpawnProjectile("QSGDreadTrooperDragonsBreathTracer", 35,14,frandom(-10,10),1,frandom(-6,6));
		TNT1 A 0 {NumBullets = random(1,4);}
		TNT1 A 0
			{
			if (NumBullets > NumShots)
				{
				NumBullets = NumShots;
				}
			}
		TNT1 A 0 {
			For (Int S = NumBullets; S > 0; S--)
			{
			TrooperShot();
			}
		}
		TNT1 A 0 {NumShots = NumShots - NumBullets;}


		QDTM EE 6 A_FaceTarget();

		TNT1 A 0 A_JumpIf(NumShots == 0, "Reload");
		TNT1 A 0 A_Jump(128, "QuadShot");
	Goto See;

	MissileCrouched:
		TNT1 A 0;
		TNT1 A 0
			{
				if (target)
				{
					Dist = Distance3D(self.target);
					if(Dist > 800)
						{
						Return FindState ("SeeContinue");
						}
					else
						{
						Return FindState ("MissileCrouchedContinue");
						}
				}
				else
				{
					Return FindState ("See");
				}
			}
	MissileCrouchedContinue:

		TNT1 A 0 A_CheckSight("SeeContinue");
		TNT1 A 0 {Crouched = 1;}
		QDTC EEEE 2 A_FaceTarget();
		QDTC F 4 A_FaceTarget();
		//QDTC F 0 Bright A_StartSound("DRBTFIRE", 12);

		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 27, 30, random (0, 40), 2, random (0, 160));
		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 27, 15, random (0, 40), 2, random (0, 160));
		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 17, 20, random (-40, 0), 2, random (-10, 0));
		TNT1 A 0 A_SpawnProjectile("OrangeLensFlareAlt", 17, -20, random (-40, 0), 2, random (-10, 0));
		TNT1 AAAAAAAA 0 A_SpawnProjectile("OrangeLensFlareAlt", 28, 0, random(-9, 9), 6, random(-9, 9));


		//TNT1 AAAAAAAAAA 0 A_SpawnProjectile("QSGDreadTrooperDragonsBreathTracer", 32,14,frandom(-10,10),1,frandom(-6,6));

		TNT1 A 0 {NumBullets = random(1,4);}
		TNT1 A 0
			{
			if (NumBullets > NumShots)
				{
				NumBullets = NumShots;
				}
			}
		
		TNT1 A 0 {
			For (Int S = NumBullets; S > 0; S--)
			{
			TrooperShot();
			}
		}
		TNT1 A 0 {NumShots = NumShots - NumBullets;}


		QDTC EE 6 A_FaceTarget();
		TNT1 A 0 A_JumpIf(NumShots == 0, "Reload");
		TNT1 A 0 A_Jump(128, "MissileCrouched");
		TNT1 A 0 {Crouched = 0;}
	Goto Reload;

	Reload:
		TNT1 A 0;
		TNT1 A 0 {Crouched = 0;}
		TNT1 A 0 A_StartSound("monsters/zombie/reload",CHAN_AUTO);
		QDTM A 4 A_FaceTarget();
		QDTX EDC 2;
		TNT1 A 0 A_SpawnProjectile("ShotgunCasing",32,-3,random(70,90),random(45,60),random(35,65));
		TNT1 A 0 A_SpawnProjectile("ShotgunCasing",31,-4,random(70,90),random(45,60),random(35,65));		
		TNT1 A 0 A_SpawnProjectile("ShotgunCasing",32,-5,random(70,90),random(45,60),random(35,65));
		TNT1 A 0 A_SpawnProjectile("ShotgunCasing",31,-6,random(70,90),random(45,60),random(35,65));	
		QDTX FABCDE 3;
		TNT1 A 0 A_StartSound("insertshell");
		TNT1 A 0 {NumShots = 4;}
		QDTM A 4 A_FaceTarget();
		QDTX FABCDE 3;
		TNT1 A 0 A_StartSound("insertshell");
		TNT1 A 0 {AmmoType = random(0,1);}

		TNT1 A 0 A_Jump(128, "Pain.Avoid","Teleportaway");
	Goto See;

    Teleportaway:
		TNT1 A 0;
		//TNT1 A 0 A_JumpIf(CantTeleport == 1, "See");
		TNT1 A 0 {CantTeleport = 0;}
		TNT1 A 0 A_JumpIfInventory("GSGDTteleportTimer", 1, "MissileSafeToFire");
		TNT1 A 0 A_StartSound("QSGDTTO");
		TNT1 A 0 A_spawnitemex("SmallExplosionFlames");
		QDTT ABCDE 3 BRIGHT;
		TNT1 A 0 A_Stop();
		TNT1 A 0 {bTHRUACTORS = true;}
		TNT1 A 0 {bSHOOTABLE = false;}
		TNT1 A 0 {bSOLID = false;}
		TNT1 A 0 {bNOPAIN = true;}
		TNT1 A 0 {bFLOORHUGGER = true;}
		TNT1 A 1
		{
		A_Wander();
		A_SpawnProjectile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
		}
		TNT1 A 0 A_recoil(random (-10, -2));
		TNT1 A 1
		{
		A_Wander();
		A_SpawnProjectile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
		}
		TNT1 A 0 A_recoil(random (-10, -2));
		TNT1 A 1
		{
		A_Wander();
		A_SpawnProjectile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
		}
		TNT1 A 0 A_recoil(random (-10, -2));
		TNT1 A 1
		{
		A_Wander();
		A_SpawnProjectile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
		}
		TNT1 A 0 A_recoil(random (-10, -2));
	Stayteleported:
		TNT1 A 1
		{
		A_Wander();
		A_SpawnProjectile ("PlasmaSmoke", 8, 0, random (0, 360), 2, random (90, 110));
		}
		TNT1 A 0 A_recoil(random (-10, -2));
		TNT1 A 0 A_jump(25, "Teleportback");
	Loop;

	Teleportback:
		TNT1 A 0 A_Stop();
		TNT1 A 0 A_StartSound("QSGDTTI");
		QDTT EDCBA 3 BRIGHT;
		TNT1 A 0 A_spawnitemex("SmallExplosionFlames");
		TNT1 A 0 {bFLOORHUGGER = false;}
		TNT1 A 0 {bNOPAIN = false;}
		TNT1 A 0 {bTHRUACTORS = false;}
		TNT1 A 0 {bSHOOTABLE = true;}
		TNT1 A 0 {bSOLID = true;}
		TNT1 A 0 A_giveinventory("GSGDTteleportTimer",1);
	Goto See;
			
	Pain.Melee:
	Pain:
		//TNT1 AA 0 A_SpawnProjectile ("Brutal_Blood", 25, 0, random (140, 230), 2, random (30, 60));
		//TNT1 AA 0 A_SpawnProjectile ("BloodmistBig", 30, 0, random (0, 360), 2, random (30, 150));
		//TNT1 AA 0 A_SpawnProjectile ("Brutal_FlyingBlood", 50, 0, random (160, 200), 2, random (0, 50));


		QDTM G 3;


		QDTM G 3 A_Pain();
		TNT1 A 0 A_Jump(96, "Pain.Avoid");
	Goto See;
		
    Pain.Kick:
    Pain.ExplosiveImpact:
	Pain.ExtremePunches:
		TNT1 A 0;
		TNT1 A 0 A_JumpIfInventory ("IsDown", 1, "Pain");
		QDXZ A 0 A_Pain();
		TNT1 A 0 A_GiveInventory("IsDown", 1);
		TNT1 A 0 A_TakeInventory("SKQSGDreadTrooper", 1);
		TNT1 A 0 ThrustThingZ(0,30,0,1);
		TNT1 A 0 {bNOPAIN = true;}
		QDXZ A 1 A_facetarget;
		QDXZ A 6 ThrustThing(angle*256/360+128, 10, 0, 0);
		QDXZ B 8;
		TNT1 A 0 {bNOPAIN = false;}
	Goto FallingAfterImpact;

	FallingAfterImpact:
		QDXZ B 1 A_GiveInventory ("FallingHeight", 1);
		QDXZ B 1 A_CheckFloor ("GetUp");
		NULL A 0 A_JumpIf (Vel.Z == 0, "GetUp");
	Loop;

	GetUp:
		TNT1 A 0;
		TNT1 A 0 A_JumpIfInventory ("FallingHeight", 5, "FallingDie");
		TNT1 A 0 A_StartSound("BODYF",6);
		TNT1 A 0 A_TakeInventory("FallingHeight", 100);
		QDXZ CCCCCCC 5 A_JumpIf(Vel.Z < 0, "FallingAfterImpact");
		TNT1 A 0 A_TakeInventory("IsDown", 1);
		QDXZ D 10;
	Goto See;

	FallingDie:
