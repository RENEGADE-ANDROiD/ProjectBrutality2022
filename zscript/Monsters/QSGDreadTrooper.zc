		QDO5 A 1 A_CheckFloor("missile");
		TNT1 A 0 A_CheckCeiling("missile"); //For corruption cards
	Goto RightJumpLoop;
			
	AvoidRight:
		QDTM A 1 A_FaceTarget();
		TNT1 A 0 ThrustThing(angle*256/360+64, 15, 0, 0);
