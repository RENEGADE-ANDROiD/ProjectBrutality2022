	PlayerActionDialogue:
		TNT1 A 0
		{
			if (A_JumpIfInTargetInventory("PlayerIsThrowingAGrenade",1, 1))
			{
				A_StartSound("monsters/zombie/player_grenade", CHAN_AUTO);
			}
		}
		Goto Pain.AvoidDialogue;

	Pain.Avoid:
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer",1, "PlayerActionDialogue");
	Pain.AvoidDialogue:
		TNT1 A 0;
		TNT1 A 0 A_Jump(256, "AvoidLeft","AvoidJumpLeft", "AvoidRight","AvoidJumpRight","HopNRollLeft", "HopNRollRight", "Teleportaway");
	Goto AvoidLeft;

	HopNRollLeft:
		QDTM A 3 A_FaceTarget();
		QDTC E 3 A_FaceTarget();
		TNT1 A 0 ThrustThingZ(0, 20, 0, 0);
		QDTM A 0 ThrustThing(angle*256/360+192, 8, 0, 0);
		QDO5 AH 6;
	RightHopNRollloop:
		QDO5 H 1 A_CheckFloor("AvoidLeftShort");
		TNT1 A 0 A_CheckCeiling("AvoidLeftShort"); //For corruption cards
	Goto RightHopNRollloop;

	AvoidLeftShort:
		TNT1 A 0 ThrustThing(angle*256/360+192, 12, 0, 0);
		QDO5 GFEDCBA 2 A_FaceTarget();
		TNT1 A 0 A_CheckSight("SeeContinue");
		TNT1 A 0 A_StartSound("humans/step",4);
		TNT1 A 0 A_Stop();
		TNT1 A 0 A_Jump(32, "SeeContinue");
		TNT1 A 0 A_Jump(128, "Missile");
	Goto MissileCrouched;

	AvoidJumpLeft:
		QDTM A 3 A_FaceTarget();
		QDTC E 3 A_FaceTarget();
		TNT1 A 0 ThrustThingZ(0, 20, 0, 0);
		QDTM A 0 ThrustThing(angle*256/360+192, 8, 0, 0);
	LeftJumpLoop:
		QDO5 A 1 A_FaceTarget();
		QDO5 A 1 A_CheckFloor("missile");
		TNT1 A 0 A_CheckCeiling("missile"); //For corruption cards
	Goto LeftJumpLoop;

	AvoidLeft:
		QDTM A 1 A_FaceTarget();
		TNT1 A 0 ThrustThing(angle*256/360+192, 15, 0, 0);
		QDO5 HGFEDCBA 2 A_FaceTarget();
		TNT1 A 0 A_StartSound("humans/step",4);
		TNT1 A 0 A_Stop();
		TNT1 A 0 A_CheckSight("SeeContinue");
		TNT1 A 0 A_Jump(128, "Missile");
	Goto MissileCrouched;

	HopNRollRight:
		QDTM A 3 A_FaceTarget();
		QDTC E 3 A_FaceTarget();
		TNT1 A 0 ThrustThingZ(0, 20, 0, 0);
		TNT1 A 0 ThrustThing(angle*256/360+64, 8, 0, 0);
		QDO5 AB 6;
    LeftHopNRollLoop:
		QDO5 B 1 A_CheckFloor("AvoidRightShort");
		TNT1 A 0 A_CheckCeiling("AvoidRightShort"); //For corruption cards
	Goto LeftHopNRollLoop;

	AvoidRightShort:
		TNT1 A 0 ThrustThing(angle*256/360+64, 12, 0, 0);
		QDO5 CDEFGHA 2 A_FaceTarget();
