// Opt-in monster weapon/ammo drops (pb_weapon_drops). Mode 0 = off (DECORATE DropItem only).

const PB_UPG_DROP_CHANCE = 32;

class PB_MonsterDropBase : Inventory
{
	string weaponDrop;
	string upgradeDrop;
	string ammoDrop;
	string weaponCvar;
	string UpgradeCvar;

	property weaponDrop: weaponDrop;
	property upgradeDrop: upgradeDrop;
	property ammoDrop: ammoDrop;
	property weaponCvar: weaponCvar;
	property UpgradeCvar: UpgradeCvar;

	Default
	{
		PB_MonsterDropBase.weaponDrop "";
		PB_MonsterDropBase.upgradeDrop "";
		PB_MonsterDropBase.ammoDrop "";
		PB_MonsterDropBase.weaponCvar "";
		PB_MonsterDropBase.UpgradeCvar "";
		+NOINTERACTION;
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();

		let cv = CVar.FindCVar("pb_weapon_drops");
		int mode = cv ? cv.GetInt() : 0;
		if (mode <= 0)
		{
			Destroy();
			return;
		}

		let cvNg = CVar.FindCVar("pb_disablenewguns");
		if (cvNg && cvNg.GetBool())
		{
			SpawnDrop(ammoDrop);
			Destroy();
			return;
		}

		if (mode == 1)
		{
			SpawnDrop(ammoDrop);
		}
		else
		{
			int chance = random[upgchan](0, 255);
			bool upg = chance <= PB_UPG_DROP_CHANCE;
			if (upgradeDrop != "" && upg && IsUpgradeEnabled())
				SpawnDrop(upgradeDrop);
			else if (weaponDrop != "" && IsWeaponEnabled())
				SpawnDrop(weaponDrop);
			else
				SpawnDrop(ammoDrop);
		}
		Destroy();
	}

	bool IsUpgradeEnabled()
	{
		if (UpgradeCvar == "")
			return true;
		let cv = CVar.FindCVar(UpgradeCvar);
		if (cv && cv.GetInt())
			return false;
		return true;
	}

	bool IsWeaponEnabled()
	{
		if (weaponCvar == "")
			return true;
		let cv = CVar.FindCVar(weaponCvar);
		if (cv && cv.GetInt())
			return false;
		return true;
	}

	void SpawnDrop(string drop)
	{
		if (drop == "")
			return;
		Name nm = drop;
		class<Actor> cls = (class<Actor>)(nm);
		if (!cls)
			return;

		let dp = Spawn(cls, pos);
		if (!dp)
			return;
		dp.vel = vel;
		double dropfactor = G_SkillPropertyFloat(SKILLP_DropAmmoFactor);
		if (dropfactor < 0)
			dropfactor = 0.5;
		let wpdp = Weapon(dp);
		if (wpdp && wpdp.AmmoGive1 > 0)
		{
			wpdp.AmmoGive1 = max(1, int(dropfactor * wpdp.AmmoGive1));
			return;
		}
		let amdp = Ammo(dp);
		if (amdp)
			amdp.Amount = max(1, int(dropfactor * amdp.Amount));
	}

	States
	{
	Spawn:
		TNT1 A 1;
		Stop;
	}
}

class PB_CarbineZombieDrop : PB_MonsterDropBase
{
	Default
	{
		PB_MonsterDropBase.weaponDrop "PB_Carbine";
		PB_MonsterDropBase.ammoDrop "PB_HighCalMag";
		PB_MonsterDropBase.weaponCvar "pb_NoCarbineWeapon";
	}
}

