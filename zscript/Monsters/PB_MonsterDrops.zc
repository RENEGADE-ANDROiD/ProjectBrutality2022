class PB_MonsterDropsHandler : EventHandler
{
	override void CheckReplacement(ReplaceEvent e)
	{
		if (!e || !e.Replacee)
			return;
		let cv = CVar.FindCVar("pb_weapon_drops");
		if (!cv || cv.GetInt() <= 0)
			return;

		Name cn = e.Replacee.GetClassName();
		switch (cn)
		{
			case 'DropedRifle':
				e.Replacement = 'PB_ZombieManDrop1';
				break;
			case 'DropedPistol':
				e.Replacement = 'PB_PistolGuyDrop';
				break;
			case 'DropedShotgun':
				e.Replacement = 'PB_ShotgunGuyDrop1';
				break;
			case 'DropedMinigun':
				e.Replacement = 'PB_ChaingunGuyDrop1';
				break;
		}
	}
}
