Class PB_Monster : Actor abstract
{
	int	HitBoxTimerNew;
	int HitBoxTimerOld;
	int EnemyLastSighted;

	double posHeadHB;
	double posTorsoHB;
	double posDickHB;
	double posLegHB;
	double dmgHeadMult;
	double dmgTorsoMult;
	double dmgArmMult;
	double dmgLowTorsoMult;
	double dmgDickMult;
	double dmgLegMult;
	bool ignoreArmDamage;
	bool ignoreHeadDamage;
	bool ignoreDickDamage;
	bool ignoreLegDamage;

	bool HitBoxSpawned;
	bool Wandering;
	bool willBeLooking;
	int heardOpponent;

	// Staging-style suppress / last-seen aim (hardened for 4.5.0)
	const PB_TARGET_HISTORY_SIZE = 20;
	const PB_SUPPRESS_HORIZ_EPS = 0.001;
	const PB_EMPTYTARGET_MAX_AGE = 35 * 8;

	bool suppress;
	int suppressCount;
	int suppressLimit;
	int suppressCount2;
	int suppressLimit2;
	int suppressJumpTic;
	bool inSuppressiveFire;
	bool historyPrimed;
	double lastSeenPosX;
	double lastSeenPosY;
	double lastSeenPosZ;
	double lastTargetPosX;
	double lastTargetPosY;
	Actor lastSeenCorpse;
	vector3 targetHistory[20];
	int historyIndex;
	class<Actor> suppressiveMissile;
	double suppressiveOffZ;
	double suppressiveOffXY;

	void ExecutionHandler() {
		if(CheckInventory("ExecutionToken",1)) {
			SetState(FindState("Execution"));
		}
	}
	
	
	void HitboxerHandler() {
		
		if (HitBoxSpawned == True){
			HitBoxTimerNew = Level.MapTime;
			if(abs(HitBoxTimerNew - HitBoxTimerOld) > 350) {
				A_TakeInventory("HeadshotToken",1);
				HitBoxSpawned = False;
				Wandering = False;
			}
		}
		
		if (CheckInventory("HeadshotToken",1) && HitBoxSpawned == False) {
			A_SpawnItem("PB_HeadshotHitbox");
			if (!CheckInventory("IsProning", 1)){
				A_SpawnItem("PB_LegHitbox");
			}
			HitBoxSpawned = True;
			HitBoxTimerOld = Level.MapTime;
		}
		
	}
	
	
	
	void A_SmartChase() {
	
			if (willBeLooking)
			{
				// Terminate function immediately if called inside A_LookEx.
				return;
			}
			// Target must be cleared out if it is a friend of the monster, else we get infinite function recursions.
			if (target && (target is "PossessionWarperA" || isFriend(target)))
			{
				A_ClearTarget();
				target = NULL;
			}
			if (target == NULL) {
				A_GiveInventory("Wandering",1);
				willBeLooking = true;
				A_LookEx();
				willBeLooking = false;
				A_Wander();
				return;
			}
			if (CheckIfCloser(target, 150) && !CheckIfCloser(target, 50) && CheckInventory("IsPlayer", 1, AAPTR_TARGET)) {
				SetStateLabel("Fallback");
			}
			if (CheckSight(target) == true || CheckIfCloser(target, 500)) {
				EnemyLastSighted = Level.MapTime;
				A_TakeInventory("Wandering",36);			
				A_Chase();
			}
			else if (CheckSight(target) == false && abs(Level.MapTime - EnemyLastSighted) < 360) {
				A_Chase();
			}
			else {
				A_GiveInventory("Wandering",1);
				A_Wander(CHF_NORANDOMTURN);
			}
	}

	void PB_ClearLastSeenDummy()
	{
		if (lastSeenCorpse)
		{
			lastSeenCorpse.Destroy();
			lastSeenCorpse = null;
		}
	}

	bool PB_MonsterAIBlocked()
	{
		if (health <= 0)
			return true;
		if (CheckInventory("ExecutionToken", 1))
			return true;
		return false;
	}

	bool PB_CanEnterSuppressLabel(statelabel lab)
	{
		if (PB_MonsterAIBlocked())
			return false;
		if (inSuppressiveFire)
			return false;
		if (!suppressiveMissile)
			return false;
		let st = FindState(lab);
		if (!st)
			return false;
		if (InStateSequence(CurState, st))
			return false;
		if (suppressJumpTic == Level.MapTime)
			return false;
		return true;
	}

	void PB_EnsureLastSeenDummy(vector3 at)
	{
		if (lastSeenCorpse)
			return;
		lastSeenCorpse = Spawn("PB_EmptyTarget", (at.x, at.y, at.z + 8), ALLOW_REPLACE);
	}

	vector3 PB_HistoryAimPos()
	{
		if (!historyPrimed)
			return pos;
		return targetHistory[(historyIndex + 1) % PB_TARGET_HISTORY_SIZE];
	}

	void PB_RecordTargetHistory()
	{
		if (!target || !CheckSight(target))
			return;
		if (target is "PB_EmptyTarget" || target is "PossessionWarperA" || isFriend(target))
			return;
		targetHistory[historyIndex] = target.pos;
		lastSeenPosX = target.pos.x;
		lastSeenPosY = target.pos.y;
		lastSeenPosZ = target.pos.z;
		historyIndex = (historyIndex + 1) % PB_TARGET_HISTORY_SIZE;
		historyPrimed = true;
	}

	bool ShouldDoSuppressiveFire()
	{
		if (!lastSeenCorpse)
			return false;
		if (!suppressiveMissile)
			return false;

		double offZ = suppressiveOffZ;
		double offXY = suppressiveOffXY;
		double spawnX = pos.x;
		double spawnY = pos.y;
		double spawnZ = pos.z + offZ;
		double vecX = lastSeenCorpse.pos.x - spawnX;
		double vecY = lastSeenCorpse.pos.y - spawnY;
		double vecZ = lastSeenCorpse.pos.z - spawnZ;
		double horiz = sqrt(vecX * vecX + vecY * vecY);
		if (horiz < PB_SUPPRESS_HORIZ_EPS)
			return false;

		double yawDegrees = VectorAngle(vecX, vecY);
		double computedPitch = -atan(vecZ / horiz);
		double dist = sqrt(vecX * vecX + vecY * vecY + vecZ * vecZ);
		if (dist < 1.0)
			dist = 1.0;

		FLineTraceData traceData;
		bool hit = LineTrace(yawDegrees, dist, computedPitch, TRF_THRUACTORS, offZ, offXY, 0, data: traceData);
		if (!hit)
			return true;

		vector3 hitPos = traceData.HitLocation;
		double dx = hitPos.x - lastSeenCorpse.pos.x;
		double dy = hitPos.y - lastSeenCorpse.pos.y;
		double dz = hitPos.z - lastSeenCorpse.pos.z;
		return sqrt(dx * dx + dy * dy + dz * dz) <= 64.0;
	}

	void A_CustomChase(bool useSmartChase = false)
	{
		if (PB_MonsterAIBlocked())
		{
			if (useSmartChase) A_SmartChase(); else A_Chase();
			return;
		}

		if (target && (target is "PossessionWarperA" || target is "PB_EmptyTarget" || isFriend(target)))
		{
			A_ClearTarget();
			target = null;
		}

		if (!target)
		{
			if (useSmartChase) A_SmartChase(); else A_Chase();
			return;
		}

		if (CheckSight(target))
		{
			suppress = true;
			suppressCount = 0;
			suppressCount2 = 0;
			PB_ClearLastSeenDummy();
			if (useSmartChase) A_SmartChase(); else A_Chase();
			return;
		}

		vector3 delayedPosition = PB_HistoryAimPos();
		PB_EnsureLastSeenDummy(delayedPosition);

		double corpseDistance = 999999.0;
		if (lastSeenCorpse)
			corpseDistance = Distance3D(lastSeenCorpse);

		if (corpseDistance < 300.0)
		{
			suppress = false;
			if (useSmartChase) A_SmartChase(); else A_Chase();
			return;
		}

		if (suppress)
		{
			if (suppressCount < suppressLimit)
			{
				if (PB_CanEnterSuppressLabel('SuppressiveFire') && ShouldDoSuppressiveFire())
				{
					suppressJumpTic = Level.MapTime;
					SetStateLabel("SuppressiveFire");
					return;
				}
			}
			else if (suppressCount2 < suppressLimit2)
			{
				if (PB_CanEnterSuppressLabel('SuppressiveFire2') && ShouldDoSuppressiveFire())
				{
					suppressJumpTic = Level.MapTime;
					SetStateLabel("SuppressiveFire2");
					return;
				}
			}
			else
			{
				suppress = false;
			}
		}

		if (useSmartChase) A_SmartChase(); else A_Chase();
	}

	void A_PB_SuppressBurstEnd()
	{
		inSuppressiveFire = false;
		suppressCount++;
	}

	void A_PB_SuppressBurstEnd2()
	{
		inSuppressiveFire = false;
		suppressCount2++;
	}

	void A_SuppressiveFire(bool shootDownward = false)
	{
		if (PB_MonsterAIBlocked())
			return;
		if (!suppressiveMissile)
			return;

		double aimX = lastSeenPosX;
		double aimY = lastSeenPosY;
		double aimZ = lastSeenPosZ;
		if (lastSeenCorpse)
		{
			aimX = lastSeenCorpse.pos.x;
			aimY = lastSeenCorpse.pos.y;
			aimZ = lastSeenCorpse.pos.z;
		}

		double offZ = suppressiveOffZ;
		double offXY = suppressiveOffXY;
		double spawnX = pos.x;
		double spawnY = pos.y;
		double spawnZ = pos.z + offZ;
		double dx = aimX - spawnX;
		double dy = aimY - spawnY;
		double dz = aimZ - spawnZ;
		double horiz = sqrt(dx * dx + dy * dy);
		if (horiz < PB_SUPPRESS_HORIZ_EPS)
			return;

		double yawDegrees = VectorAngle(dx, dy);
		double computedPitch = -atan(dz / horiz);

		// Aim without swapping target onto the dummy (avoids friend/chase latch).
		angle = yawDegrees;
		if (shootDownward)
		{
			A_SpawnProjectile(suppressiveMissile, offZ, offXY, 0,
				flags: CMF_AIMDIRECTION | CMF_OFFSETPITCH, pitch: computedPitch);
		}
		else
		{
			A_SpawnProjectile(suppressiveMissile, offZ, offXY, 0,
				flags: CMF_AIMDIRECTION);
		}
		pitch = 0;
	}

	void A_DropAdjust2(class<Actor> missiletype, class<Actor> missiletype2, double offX, double offY, double offZ,
		double speedmult = 1.0, int minRange = 0, int maxRange = 1000, bool shootDownward = false, bool forceMinAngle = false)
	{
		if (PB_MonsterAIBlocked())
			return;
		if (!missiletype || !missiletype2)
			return;
		if (!target)
			return;

		double ceilH = CeilingZ - pos.z;
		double tarDist = max(distance2d(target), 1.0);
		double PredAngleACS = ACS_NamedExecuteWithResult("PredictAim", 1, GetDefaultByType(missiletype).speed, int(offZ));
		double rawDiff = deltaangle(angle, PredAngleACS);

		if (lastTargetPosX == 0 && lastTargetPosY == 0)
		{
			lastTargetPosX = target.pos.x;
			lastTargetPosY = target.pos.y;
		}
		double displacementX = target.pos.x - lastTargetPosX;
		double displacementY = target.pos.y - lastTargetPosY;
		lastTargetPosX = target.pos.x;
		lastTargetPosY = target.pos.y;

		double dx = target.pos.x - pos.x;
		double dy = target.pos.y - pos.y;
		double distc = max(sqrt(dx * dx + dy * dy), 0.01);
		double dirX = dx / distc;
		double dirY = dy / distc;
		double lateralDisplacement = abs(displacementX * dirY - displacementY * dirX);
		double lateralSpeed = abs(target.vel.x * dirY - target.vel.y * dirX);
		double scaleFactor = clamp(1.0 - (tarDist / 1500.0), 0.5, 1.0);
		double minAngle = 2200;
		double maxAngle = 10500;
		double maxAngleChange;
		if (lateralDisplacement < 70.0)
			maxAngleChange = minAngle;
		else
			maxAngleChange = minAngle + clamp((abs(lateralSpeed) - 1.0) * 500, 0, maxAngle - minAngle);
		if (forceMinAngle)
			maxAngleChange = minAngle;

		double finalDiff = clamp(rawDiff * scaleFactor, -maxAngleChange, maxAngleChange);
		double FinalPredAngle = angle + finalDiff;

		if (ceilH < 80 || tarDist > maxRange || tarDist < minRange)
		{
			A_SpawnProjectile(missiletype2, offZ, offX, FinalPredAngle * 360.0 / 65536.0);
			return;
		}

		if (shootDownward)
		{
			double minDist = 250.0;
			double optimalDist = 450.0;
			double farDist = 800.0;
			double maxExtraPitch = 70.0;
			double extraPitch = 0;
			if (tarDist <= minDist)
				extraPitch = 70;
			else if (tarDist <= optimalDist)
				extraPitch = (tarDist - minDist) / (optimalDist - minDist) * maxExtraPitch;
			else if (tarDist <= farDist)
				extraPitch = (farDist - tarDist) / (farDist - optimalDist) * maxExtraPitch;
			pitch += extraPitch;
		}

		A_SpawnProjectile(missiletype, offZ, offX, FinalPredAngle * 360.0 / 65536.0,
			flags: CMF_OFFSETPITCH, pitch: sin(pitch / 2) * abs(offY));
		pitch = 0;
	}

	bool PB_MonsterHandlersDueThisTic()
	{
		if (HitBoxSpawned)
			return true;
		if (CheckInventory("HeadshotToken", 1))
			return true;
		if (CheckInventory("ExecutionToken", 1))
			return true;
		return (Level.MapTime & 7) == 0;
	}

	override void Tick()
	{
		Super.Tick();

		if (health > 0)
			PB_RecordTargetHistory();

		if (PB_MonsterHandlersDueThisTic())
		{
			HitboxerHandler();
			ExecutionHandler();
		}
	}

	override void PostBeginPlay() {
		Super.PostBeginPlay();
		heardOpponent = 0;
		HitBoxSpawned = False;
		historyPrimed = false;
		historyIndex = 0;
		suppressJumpTic = -1;
		inSuppressiveFire = false;
		if (suppressLimit <= 0)
			suppressLimit = 4;
		if (suppressLimit2 <= 0)
			suppressLimit2 = 2;
		for (int i = 0; i < PB_TARGET_HISTORY_SIZE; i++)
			targetHistory[i] = pos;

		if (posTorsoHB == 0)
		{
			posHeadHB = 0.80;
			posTorsoHB = 0.65;
			posDickHB = 0.38;
			posLegHB = 0.40;
			dmgHeadMult = 2.0;
			dmgTorsoMult = 1.5;
			dmgArmMult = 0.70;
			dmgLowTorsoMult = 1.0;
			dmgDickMult = 0.95;
			dmgLegMult = 0.80;
		}
	}

	override void Die(Actor source, Actor inflictor, int dmgflags, Name MeansOfDeath)
	{
		inSuppressiveFire = false;
		suppress = false;
		PB_ClearLastSeenDummy();
		Super.Die(source, inflictor, dmgflags, MeansOfDeath);
	}

	override void OnDestroy()
	{
		PB_ClearLastSeenDummy();
		Super.OnDestroy();
	}
	
	double A_PrepairDrop()
	{
		vector2 aimbak =(self.angle,self.pitch);
		self.A_FaceTarget(0,0);
		self.angle=aimbak.x;
		self.pitch=aimbak.y;
		
		double targdist=(self.target?distance3d(self.target):4096);
		vector2 leadoffset;
		if(targdist>2000) leadoffset=(frandom(-2.,2),frandom(-1.,1.));
		else leadoffset=(
			deltaangle(aimbak.x,aimbak.x),
			deltaangle(aimbak.y,aimbak.y)
		)*targdist*frandom(0.055,0.067);

		self.angle += leadoffset.x;
		self.pitch += leadoffset.y;
		return targdist;
	}

	void A_DropAdjust(class<actor> missiletype, class<actor> missiletype2,double offX, double offY, double offZ,double PredAngle=0,
						double dist=0,double speedmult=1.,double gravity=0,actor target=null,double spawnOffsetY=0,bool flipped=0,int minRange=0,int maxRange=1000)
	{
		if (!missiletype || !missiletype2)
			return;
		if (getdefaultbytype(missiletype).gravity != 0) { PredAngle = ACS_NamedExecuteWithResult("PredictAim", 1, 20, 32); }
		else {PredAngle = ACS_NamedExecuteWithResult("PredictAim", 1, getdefaultbytype(missiletype).speed, offZ);}
			
		if(!target)target=self.target;
		if(!target)return;
		double ceil = self.CeilingZ - self.pos.z;
		
		double tarDist = self.A_PrepairDrop();
		if(ceil < 80 || (tarDist > maxRange || tarDist < minRange))
		{
			self.A_SpawnProjectile(missiletype2,offZ);
			return;
		}
		if(dist<1) dist=max(1,(target?self.distance2d(target):1));
		if(!gravity)gravity=getdefaultbytype(missiletype).gravity;
		double spd=getdefaultbytype(missiletype).speed*speedmult;
		if(getdefaultbytype(missiletype).gravity&&dist>spd)
		{
			
			int ticstotake=dist/spd;
            int dropamt=0;
            for(int i=1;i<=ticstotake;i++)
			{
                dropamt+=i;
            }
            self.pitch -= min(atan(dropamt*gravity/dist),30);
        }

        //because we don't shoot from height 32 but 42
        if(dist>0 && gravity != 0) {self.pitch += atan(10/dist);}
		else { self.pitch = 0;}
		
		double finalAngle =  PredAngle+1024;
		
		if(flipped) {
			finalAngle = PredAngle-1024;
		}
		else {
			finalAngle = PredAngle+1024;
		}
		
		self.A_DropProjectile(missiletype,offX,offY,offZ,tarDist,finalAngle, spawnOffsetY);
    }
	
	void A_DropProjectile(class<actor> missiletype, double offX, double offY, double offZ, double targdist, double PredictAngle, double spawnOffsetY=0.0)
	{
			
			if(!getdefaultbytype(missiletype).gravity) {
				self.A_SpawnProjectile(missiletype,offZ, offX, PredictAngle*360/65536);
			}
			else {
				self.A_SpawnItemEx(
					missiletype,offX,offY,offZ,
					cos(pitch)*abs(offY),0,-sin(pitch)*abs(offY),
					PredictAngle*360/65536,
					flags:SXF_NOCHECKPOSITION|SXF_SETTARGET|SXF_TRANSFERPITCH
				);
			}
	}

}

extend class PB_Monster
{
	action void A_PB_BurnFX_TinyBurningPieces()
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnTinyPiece())
			return;
		A_SpawnItemEx("TinyBurningPiece", random(-15, 15), random(-15, 15));
		A_SpawnItemEx("TinyBurningPiece2", random(-35, 35), random(-35, 35));
		A_SpawnItemEx("TinyBurningPiece3", random(-45, 45), random(-45, 35));
	}

	action void A_PB_BurnFX_RealisticFireSparks1(int zofs)
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnBurnParticles())
			return;
		A_SpawnItemEx("RealisticFireSparks1", random(-2, 2), random(-2, 2), zofs, 0, 0, 0, 0, SXF_NOCHECKPOSITION, 0);
	}

	action void A_PB_BurnFX_ExplosionHeavy(int height)
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnExplosionVerySlow())
			return;
		A_CustomMissile("ExplosionParticleHeavy", height, 0, random(0, 360), 2, random(0, 360));
	}

	action void A_PB_BurnFX_ExplosionHeavyBurst(int height, int count = 4)
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnExplosionVerySlow())
			return;
		int n = max(1, count);
		for (int i = 0; i < n; i++)
			A_CustomMissile("ExplosionParticleHeavy", height, 0, random(0, 360), 2, random(0, 360));
	}

	action void A_PB_BurnFX_ExplosionVeryFast(int height)
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnExplosionVerySlow())
			return;
		A_CustomMissile("ExplosionParticleVeryFast", height, 0, random(0, 360), 2, random(0, 360));
	}

	action void A_PB_BurnFX_ExplosionVeryFastBurst(int height, int count = 4)
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnExplosionVerySlow())
			return;
		int n = max(1, count);
		for (int i = 0; i < n; i++)
			A_CustomMissile("ExplosionParticleVeryFast", height, 0, random(0, 360), 2, random(0, 360));
	}

	action void A_PB_BurnFX_BurningEmberBigger(int height)
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnBurnParticles())
			return;
		A_CustomMissile("BurningEmberParticlesFloating_Bigger", height, 0, random(0, 360), 2, random(0, 160));
	}

	action void A_PB_BurnFX_PlasmaSmoke(int height)
	{
		PB_BurnFXThrottleHandler.NotifyIncinerating(self);
		if (!PB_BurnFXThrottleHandler.ShouldSpawnBurnParticles())
			return;
		A_CustomMissile("PlasmaSmoke", height, 0, random(0, 360), 2, random(0, 160));
	}
}

// Dummy last-seen marker for A_CustomChase / A_SuppressiveFire (hardened: never targetable, short life).
class PB_EmptyTarget : Actor
{
	int pbEmptyAge;

	Default
	{
		Radius 10;
		Height 6;
		Mass 5000;
		Health 1;
		+NOINTERACTION
		+NOTELEPORT
		+MOVEWITHSECTOR
		+FLOORCLIP
		+NOBLOCKMAP
		+NOBLOCKMONST
		+FORCEXYBILLBOARD
		+CORPSE
		+NEVERTARGET
		+NONSHOOTABLE
		-SOLID
		-SHOOTABLE
	}

	override void Tick()
	{
		Super.Tick();
		pbEmptyAge++;
		if (pbEmptyAge >= (35 * 8))
			Destroy();
	}

	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}
}