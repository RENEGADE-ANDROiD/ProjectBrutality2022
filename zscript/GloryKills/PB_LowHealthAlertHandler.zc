// Low health / low armor alert beeps (replaces SRC/lowhealth.acs ENTER scripts).

class PB_LowHealthAlertHandler : EventHandler
{
	private bool lowHp[MAXPLAYERS];
	private bool lowArmorLatched[MAXPLAYERS];
	private bool wasArmorAbove[MAXPLAYERS];
	private int cvarRefreshTic;
	private bool cachedHpAlertOn;
	private bool cachedArmorAlertOn;
	private int cachedHpThreshold;
	private int cachedArmorThreshold;

	override void PlayerEntered(PlayerEvent e)
	{
		if (!e)
			return;
		int pn = e.PlayerNumber;
		if (pn < 0 || pn >= MAXPLAYERS)
			return;
		lowHp[pn] = false;
		lowArmorLatched[pn] = false;
		wasArmorAbove[pn] = false;
	}

	private void RefreshAlertCvars()
	{
		cachedHpAlertOn = false;
		cachedArmorAlertOn = false;
		cachedHpThreshold = 30;
		cachedArmorThreshold = 30;

		for (int pn = 0; pn < MAXPLAYERS; pn++)
		{
			if (!playeringame[pn])
				continue;
			let plr = players[pn];
			let cvHp = CVar.GetCVar("be_LowHealthAlert", plr);
			if (cvHp && cvHp.GetBool())
				cachedHpAlertOn = true;
			let cvAr = CVar.GetCVar("be_LowArmorAlert", plr);
			if (cvAr && cvAr.GetBool())
				cachedArmorAlertOn = true;
			let cvHpVal = CVar.GetCVar("sv_LowHealthValue", plr);
			if (cvHpVal)
				cachedHpThreshold = clamp(cvHpVal.GetInt(), 0, 200);
			let cvArVal = CVar.GetCVar("sv_LowArmorValue", plr);
			if (cvArVal)
				cachedArmorThreshold = clamp(cvArVal.GetInt(), 0, 100);
			break;
		}
	}

	override void WorldTick()
	{
		if (cvarRefreshTic == 0 || level.time - cvarRefreshTic >= 16)
		{
			RefreshAlertCvars();
			cvarRefreshTic = level.time;
		}

		if (!cachedHpAlertOn && !cachedArmorAlertOn)
			return;

		for (int pn = 0; pn < MAXPLAYERS; pn++)
		{
			if (!playeringame[pn])
				continue;
			let plr = players[pn];
			let mo = plr.mo;
			if (!mo)
				continue;

			if (cachedHpAlertOn)
				TickLowHealth(pn, mo);
			else
				lowHp[pn] = false;

			if (cachedArmorAlertOn)
				TickLowArmor(pn, mo);
			else
				lowArmorLatched[pn] = false;
		}
	}

	private void TickLowHealth(int pn, Actor mo)
	{
		int threshold = cachedHpThreshold;
		if (mo.health <= threshold)
		{
			if (!lowHp[pn])
			{
				mo.A_StartSound("LOWHEALTH", CHAN_AUTO, CHANF_OVERLAP | CHANF_LOCAL | CHANF_UI);
				lowHp[pn] = true;
			}
		}
		else
		{
			lowHp[pn] = false;
		}
	}

	private void TickLowArmor(int pn, Actor mo)
	{
		int threshold = cachedArmorThreshold;
		int armor = mo.CountInv("Armor");
		if (armor > threshold)
			wasArmorAbove[pn] = true;

		if (armor <= threshold)
		{
			if (!lowArmorLatched[pn] && wasArmorAbove[pn])
			{
				mo.A_StartSound("LOWARMOR", CHAN_AUTO, CHANF_OVERLAP | CHANF_LOCAL | CHANF_UI);
				lowArmorLatched[pn] = true;
				wasArmorAbove[pn] = false;
			}
		}
		else
		{
			lowArmorLatched[pn] = false;
		}
	}
}
