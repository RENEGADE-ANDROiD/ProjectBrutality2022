// Glory Kill fuel HUD — Eternal (NewHUD) strip only.

extend class PB_EventHandler
{
	ui void EnsureGloryKillFuelTextures()
	{
		if (gkFuelTexCached)
			return;
		gkFuelTexCached = true;
		gkTexCrucry00 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/CRUCRY00.png", TexMan.Type_Any);
		gkTexCrucry01 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/CRUCRY01.png", TexMan.Type_Any);
		gkTexCrucam01 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/CRUCAM01.png", TexMan.Type_Any);
		gkTexCrucam02 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/CRUCAM02.png", TexMan.Type_Any);
		gkTexCrucam03 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/CRUCAM03.png", TexMan.Type_Any);
		gkTexBpammo10 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/BPAMMO10.png", TexMan.Type_Any);
		gkTexBpammo11 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/BPAMMO11.png", TexMan.Type_Any);
		gkTexBpammo12 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/BPAMMO12.png", TexMan.Type_Any);
		gkTexBpammo13 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/BPAMMO13.png", TexMan.Type_Any);
		gkTexBpammo14 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/BPAMMO14.png", TexMan.Type_Any);
		gkTexScflm00 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/SCFLM00.png", TexMan.Type_Any);
		gkTexScflm01 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/SCFLM01.png", TexMan.Type_Any);
		gkTexScicb00 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/SCICB00.png", TexMan.Type_Any);
		gkTexScicb01 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/SCICB01.png", TexMan.Type_Any);
		gkTexGksha00 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/GKSHA00.png", TexMan.Type_Any);
		gkTexGksha01 = TexMan.CheckForTexture("graphics/hud/glorykills/newhud/GKSHA01.png", TexMan.Type_Any);
	}

	ui void DrawGloryKillFuelHud()
	{
		if (!playeringame[consoleplayer])
			return;
		let plr = players[consoleplayer];
		if (!plr || !plr.mo)
			return;
		if (plr.mo.CountInv("CameraRunner") > 0)
			return;

		let cvBe = CVar.GetCVar("be_fuelhud", plr);
		if (!cvBe || !cvBe.GetBool())
			return;

		DrawGloryKillEternalFuelHud(plr);
	}

	ui void DrawGkEternalIcon(TextureID tex, double x, double y, double scale)
	{
		if (!tex.IsValid())
			return;
		Screen.DrawTexture(tex, false, x, y,
			DTA_Alpha, 0.85,
			DTA_CenterOffset, true,
			DTA_ScaleX, scale, DTA_ScaleY, scale);
	}

	ui void DrawGloryKillEternalFuelHud(PlayerInfo plr)
	{
		EnsureGloryKillFuelTextures();

		let cvSX = CVar.GetCVar("sv_fuelhud_x", plr);
		let cvSY = CVar.GetCVar("sv_fuelhud_y", plr);
		let cvScale = CVar.GetCVar("sv_fuelhud_scale", plr);
		int ox = cvSX ? cvSX.GetInt() : 0;
		int oy = cvSY ? cvSY.GetInt() : 0;
		double hudScale = cvScale ? cvScale.GetFloat() : 1.0;
		if (hudScale <= 0.0)
			hudScale = 1.0;

		double vsc = Screen.GetHeight() / 480.0;
		double cx = Screen.GetWidth() * 0.5 + double(ox) * vsc;
		double cy = Screen.GetHeight() * 0.5 + double(oy) * vsc;
		// Authored for overlapping parallelogram tiles (~21 virtual px center-to-center at 480p).
		double step = 21.0 * vsc * hudScale;
		double x = cx;

		int cruc = plr.mo.CountInv("CrucibleEnergy");
		TextureID tCore = cruc > 0 ? gkTexCrucry01 : gkTexCrucry00;
		if (!tCore.IsValid())
			return;

		DrawGkEternalIcon(tCore, x, cy, hudScale);
		x += step;

		if (cruc > 0)
		{
			TextureID tCam;
			if (cruc == 1)
				tCam = gkTexCrucam01;
			else if (cruc == 2)
				tCam = gkTexCrucam02;
			else
				tCam = gkTexCrucam03;
			if (tCam.IsValid())
			{
				DrawGkEternalIcon(tCam, x, cy, hudScale);
				x += step;
			}
		}

		int bpt = plr.mo.CountInv("BPtoken");
		TextureID tBP;
		if (bpt <= 0)
			tBP = gkTexBpammo10;
		else if (bpt == 1)
			tBP = gkTexBpammo11;
		else if (bpt == 2)
			tBP = gkTexBpammo12;
		else if (bpt == 3)
			tBP = gkTexBpammo13;
		else
			tBP = gkTexBpammo14;
		if (tBP.IsValid())
		{
			DrawGkEternalIcon(tBP, x, cy, hudScale);
			x += step;
		}

		int fb = plr.mo.CountInv("FlameBelchReady");
		TextureID tFB = fb == 1 ? gkTexScflm01 : gkTexScflm00;
		if (tFB.IsValid())
		{
			DrawGkEternalIcon(tFB, x, cy, hudScale);
			x += step;
		}

		int ic = plr.mo.CountInv("IceBombReady");
		TextureID tIC = ic == 1 ? gkTexScicb01 : gkTexScicb00;
		if (tIC.IsValid())
		{
			DrawGkEternalIcon(tIC, x, cy, hudScale);
			x += step;
		}

		int ssReady = plr.mo.CountInv("ShieldSawReady");
		TextureID tSS = ssReady == 1 ? gkTexGksha01 : gkTexGksha00;
		if (tSS.IsValid())
			DrawGkEternalIcon(tSS, x, cy, hudScale);
	}
}
