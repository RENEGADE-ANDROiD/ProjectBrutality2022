class PB_LeanLeft : Inventory {}
class PB_LeanRight : Inventory {}
class PB_LeanToggle : Inventory {}

class PB_WeaponTilterInventory : Inventory
{
	double currentRoll;
	double motionEnableBlend;
	// Smoothed tactical lean angle (degrees). Tilt++ reads this and adds its offset; do not A_SetRoll here.
	double leanRoll;
	int tickCounter;

	double outputRoll;
	double smoothedWeaponRoll;
	double prevStrafeDot;
	double lastAppliedRoll;
	double lastAppliedBillboardX;

	double baselineWeaponY;
	double lastAppliedDip;
	double smoothedPendulumDip;
	bool hasBaselineWeaponY;

	bool poseActive;
	bool restoreDipThisTick;
	bool rollOnlyWeapon;
	Name lastWeaponClass;

	double cvRollResistance;
	double cvRollVelocity;
	double cvRollCap;
	double cvLoweringScale;
	double cvLeanAngle;
	double cvLeanSmoothing;
	double cvTiltSmoothing;
	bool cvEnabled;
	bool cvEnableLean;
	bool cvEnableReadyOnly;
	bool cvEnableMoveOnly;
	bool cvCapRoll;

	static const Name NO_TACTICAL_WEAPONS[] =
	{
		'PB_Minigun',
		'PB_MG42',
		'PB_BFG9000',
		'PB_BFGMKIV',
		'PB_BFGBeam',
		'PB_BLACKHOLE',
		'PB_Unmaker',
		'MastermindChaingun'
	};

	static const Name SCOPED_TACTICAL_WEAPONS[] =
	{
		'PB_Railgun',
		'PB_BDPRailgun',
		'PB_MetalSniper',
		'PB_XM21',
		'BDPBattleRifle',
		'PB_LeverAction',
		'PB_CSSG'
	};

	static const Name ROLL_ONLY_TACTICAL_WEAPONS[] =
	{
		'Stormcast',
		'ThunderCrossbow'
	};

	private void ApplyWeaponTiltToAttachedOverlays(PlayerInfo pi, double roll)
	{
		if (!pi) { return; }
		let o10 = pi.FindPSprite(10); if (o10) { o10.Rotation = roll; }
		let o11 = pi.FindPSprite(11); if (o11) { o11.Rotation = roll; }
		let o60 = pi.FindPSprite(60); if (o60) { o60.Rotation = roll; }
		let o61 = pi.FindPSprite(61); if (o61) { o61.Rotation = roll; }
		let o63 = pi.FindPSprite(63); if (o63) { o63.Rotation = roll; }
		let o64 = pi.FindPSprite(64); if (o64) { o64.Rotation = roll; }
	}

	Default
	{
		Inventory.MaxAmount 1;
	}

	override void BeginPlay()
	{
		Super.BeginPlay();
		motionEnableBlend = 1.;
		smoothedWeaponRoll = 0.;
		prevStrafeDot = 0.;
	}

	private bool IsExcludedWeapon(Weapon weap)
	{
		if (!weap) { return true; }
		Name cls = weap.GetClassName();
		for (int i = 0; i < NO_TACTICAL_WEAPONS.Size(); i++)
		{
			if (cls == NO_TACTICAL_WEAPONS[i]) { return true; }
		}
		return false;
	}

	private bool InWeaponStateSequence(Weapon weap, PSprite psp, statelabel label)
	{
		if (!weap || !psp || !psp.CurState)
			return false;
		State st = weap.FindState(label);
		return st && weap.InStateSequence(psp.CurState, st);
	}

	private bool IsPbWpCaWeaponBase(Weapon weap)
	{
		class<Object> pbBase = Object.FindClass('PBWP_CA_WeaponBase');
		return weap && pbBase && weap is pbBase;
	}

	private bool UsesRollOnlyMotion(Weapon weap)
	{
		if (!weap)
			return false;
		if (IsPbWpCaWeaponBase(weap))
			return true;
		Name cls = weap.GetClassName();
		for (int i = 0; i < ROLL_ONLY_TACTICAL_WEAPONS.Size(); i++)
		{
			if (cls == ROLL_ONLY_TACTICAL_WEAPONS[i])
				return true;
		}
		return false;
	}

	private bool WeaponUsesBillboardSprite(Weapon weap)
	{
		return weap && weap.bFORCEXYBILLBOARD;
	}

	private bool IsCoreIdleState(Weapon weap, PSprite psp)
	{
		static const statelabel coreIdle[] =
		{
			'Ready', 'Hold', 'ReadyLoop', 'Readyloop', 'Idle', 'GunReady', 'WaitReady'
		};
		for (int i = 0; i < coreIdle.Size(); ++i)
		{
			if (InWeaponStateSequence(weap, psp, coreIdle[i]))
				return true;
		}
		return false;
	}

	private bool IsExtendedIdleState(Weapon weap, PSprite psp)
	{
		static const statelabel extendedIdle[] =
		{
			'Ready2', 'Ready3', 'Ready4', 'Ready5', 'RealReady', 'ReallyReady', 'ReallyReady2',
			'ReadyToFire', 'ReadyToFire2', 'ReadyToFireAgain', 'ReadyToFireDualWield',
			'ReadyNormal', 'ReadyLoaded', 'ReadyFull', 'ReadyNoAmmo', 'IdleNoAmmo', 'NoBuzzing',
			'SelectReady', 'GoingToReady', 'GoingToReady2', 'OnLoop',
			'ReadyAim', 'Ready_ADS', 'BDReady3', 'BDReadyADS', 'ReadyRaised',
			'ReallyReady2Loop', 'ReallyReady3', 'ActuallyReady3',
			'ReadySettle', 'ReadyToFire_Red', 'ReadyToFireDrum',
			'ReadyMissile', 'JavelinReady3', 'ReadyDualWield', 'RealReady_Reload'
		};
		for (int i = 0; i < extendedIdle.Size(); ++i)
		{
			if (InWeaponStateSequence(weap, psp, extendedIdle[i]))
				return true;
		}
		return false;
	}

	private bool IsGenericReadyFallback(Weapon weap, PSprite psp)
	{
		if (!weap || weap.FindState('RealReady'))
			return false;
		return InWeaponStateSequence(weap, psp, 'Ready');
	}

	private bool IsSwitchState(Weapon weap, PSprite psp)
	{
		if (!weap || !psp || !psp.CurState)
			return false;

		return InWeaponStateSequence(weap, psp, 'Select')
			|| InWeaponStateSequence(weap, psp, 'Deselect');
	}

	private bool IsCombatWeaponState(Weapon weap, PSprite psp)
	{
		if (!weap || !psp || !psp.CurState)
			return false;

		static const statelabel combatLabels[] =
		{
			'Fire', 'Fire2', 'Fire3', 'HoldFire', 'AltFire', 'AltFire1', 'AltFire2',
			'Melee', 'Melee2', 'Punch', 'Kick', 'Stomp',
			'Reload', 'Reloading', 'ReloadLoop', 'ReloadLoop2', 'Reload2', 'Reload3',
			'Pump', 'Pump1', 'Slide', 'Burst', 'Charge', 'ChargeLoop', 'Attack', 'Windup',
			'BDReload', 'BDReloadADS'
		};

		for (int i = 0; i < combatLabels.Size(); ++i)
		{
			if (InWeaponStateSequence(weap, psp, combatLabels[i]))
				return true;
		}
		return false;
	}

	private bool IsReadyState(Weapon weap, PSprite psp, PlayerInfo pi)
	{
		if (!weap || !psp || !psp.CurState)
			return false;

		if (IsCoreIdleState(weap, psp))
			return true;
		if (IsExtendedIdleState(weap, psp))
			return true;
		if (IsGenericReadyFallback(weap, psp))
			return true;

		if (pi && !IsCombatWeaponState(weap, psp) && !IsSwitchState(weap, psp))
		{
			if ((pi.weaponstate & wf_weaponready) != 0)
				return true;
		}
		return false;
	}

	private bool IsScopedWeapon(Weapon weap)
	{
		if (!weap) { return false; }
		Name cls = weap.GetClassName();
		for (int i = 0; i < SCOPED_TACTICAL_WEAPONS.Size(); i++)
		{
			if (cls == SCOPED_TACTICAL_WEAPONS[i]) { return true; }
		}
		return false;
	}

	private bool IsScopedNow(Actor plr, Weapon weap, PSprite psp)
	{
		if (!plr || !weap || !psp || !psp.CurState || !IsScopedWeapon(weap)) { return false; }

		if (plr.CountInv("Zoomed") > 0 || plr.CountInv("ADSMode") > 0) { return true; }

		static const statelabel scopedNow[] =
		{
			'ZoomIn', 'ZoomOut', 'Ready_ADS', 'BDReadyADS', 'ZoomFire',
			'ScopedFire', 'Fire_ADS', 'ZoomLoop', 'FireZoom', 'FireZoomed'
		};
		for (int i = 0; i < scopedNow.Size(); ++i)
		{
			if (InWeaponStateSequence(weap, psp, scopedNow[i]))
				return true;
		}

		return weap.FOVScale < 0.99;
	}

	private bool ShouldBlockForSafety(Actor plr, Weapon weap, PSprite psp)
	{
		if (!plr || !weap || !psp || !plr.player) { return true; }
		if (IsScopedNow(plr, weap, psp)) { return true; }
		if (IsSwitchState(weap, psp)) { return true; }
		let ov10 = plr.player.GetPSprite(10);
		let ov11 = plr.player.GetPSprite(11);
		bool hasOverlayActions = (ov10 && ov10.CurState) || (ov11 && ov11.CurState);
		if (hasOverlayActions && !IsReadyState(weap, psp, plr.player)) { return true; }
		if (plr.CountInv("Zoomed") > 0 || plr.CountInv("ADSMode") > 0) { return true; }
		if (plr.CountInv("GoFatality") > 0 || plr.CountInv("ExecutionToken") > 0) { return true; }
		if (plr.CountInv("Kicking") > 0 || plr.CountInv("UseEquipment") > 0 || plr.CountInv("ToggleEquipment") > 0) { return true; }
		if (plr.CountInv("PlayerIsThrowingAGrenade") > 0 || plr.CountInv("PlayerIsThrowingAMolotovCocktail") > 0) { return true; }
		if (plr.CountInv("DoShoulderCannon") > 0 || plr.CountInv("DoGloryMelee") > 0 || plr.CountInv("PB_LockScreenTilt") > 0) { return true; }
		return false;
	}

	private bool IsFiringState(Weapon weap, PSprite psp)
	{
		if (!weap || !psp || !psp.CurState) { return false; }

		static const statelabel fireLabels[] =
		{
			'Fire', 'Fire_ADS', 'FireRight_Overlay', 'FireLeft_Overlay', 'FireGrenade', 'Scope_Fire'
		};
		for (int i = 0; i < fireLabels.Size(); ++i)
		{
			if (InWeaponStateSequence(weap, psp, fireLabels[i]))
				return true;
		}
		return false;
	}

	private bool UsesAuthoredFireOffset(Name weaponClass, Weapon weap, PSprite psp)
	{
		if (weaponClass != 'PB_NeoHMG' || !weap || !psp || !psp.CurState)
			return false;
		if (IsFiringState(weap, psp))
			return true;
		State st = weap.FindState("DoFireHMG");
		return st && weap.InStateSequence(psp.CurState, st);
	}

	private void ResetRollState()
	{
		currentRoll = 0;
		smoothedWeaponRoll = 0;
		prevStrafeDot = 0;
		outputRoll = 0;
		lastAppliedRoll = 0;
		lastAppliedBillboardX = 0;
	}

	private void DiscardPendulumDipState()
	{
		lastAppliedDip = 0;
		smoothedPendulumDip = 0;
		hasBaselineWeaponY = false;
	}

	private void RestorePendulumDip(PSprite psp)
	{
		// Only undo our dip delta — never snap to baselineWeaponY while the weapon
		// state machine is running A_Lower/A_Raise or authored A_WeaponOffset.
		if (psp && lastAppliedDip > 0.05)
			psp.Y -= lastAppliedDip;
		DiscardPendulumDipState();
	}

	private void ApplyPendulumDip(PSprite psp, double dip)
	{
		if (!psp)
			return;

		if (hasBaselineWeaponY && lastAppliedDip > 0.05)
		{
			double expectedY = baselineWeaponY + lastAppliedDip;
			if (abs(psp.Y - expectedY) > 2.0)
			{
				baselineWeaponY = psp.Y;
				lastAppliedDip = 0;
			}
		}
		else if (!hasBaselineWeaponY)
		{
			baselineWeaponY = psp.Y - lastAppliedDip;
			hasBaselineWeaponY = true;
		}

		if (dip > 0.05)
		{
			psp.Y = baselineWeaponY + dip;
			lastAppliedDip = dip;
		}
		else if (lastAppliedDip > 0.05)
		{
			psp.Y -= lastAppliedDip;
			lastAppliedDip = 0;
		}
	}

	private double ComputePendulumDipTarget(double displayRoll, double strafeDot, PlayerInfo pi, bool allowLowering, Name weaponClass)
	{
		if (!allowLowering || cvLoweringScale <= 0.01)
			return 0;

		double absRoll = abs(displayRoll);
		if (absRoll < 0.1)
			return 0;

		bool strafeInput = abs(pi.cmd.sidemove) > 0 || abs(strafeDot) > 0.15;
		if (!strafeInput)
			return 0;

		double scale = max(0.5, cvLoweringScale);
		if (weaponClass == 'PB_RocketLauncher')
			scale *= 1.14;

		double dip = (4.0 + absRoll * 6.0) * scale;
		if (displayRoll < 0)
			dip += absRoll * 6.0 * scale;
		else
			dip += absRoll * 1.2 * scale;

		double dipCap = weaponClass == 'PB_RocketLauncher' ? 22.0 : 18.0;
		return min(dip, dipCap);
	}

	private void ClearAppliedRollAndBillboard(PSprite psp)
	{
		if (!psp)
			return;

		if (lastAppliedBillboardX != 0)
		{
			psp.X -= lastAppliedBillboardX;
			lastAppliedBillboardX = 0;
		}

		if (lastAppliedRoll != 0)
		{
			psp.Rotation -= lastAppliedRoll;
			lastAppliedRoll = 0;
		}
	}

	void ApplyPose(PlayerInfo pi)
	{
		if (!pi)
			return;

		let psp = pi.FindPSprite(PSP_WEAPON);
		if (!psp)
			return;

		let wpn = Weapon(pi.ReadyWeapon);
		if (wpn && pi.PendingWeapon != WP_NOCHANGE && pi.PendingWeapon != null
			&& pi.PendingWeapon.GetClassName() != wpn.GetClassName())
		{
			ClearAppliedRollAndBillboard(psp);
			RestorePendulumDip(psp);
			ApplyWeaponTiltToAttachedOverlays(pi, 0.);
			return;
		}

		ClearAppliedRollAndBillboard(psp);

		if (restoreDipThisTick || !poseActive || !cvEnabled)
		{
			RestorePendulumDip(psp);
			ApplyWeaponTiltToAttachedOverlays(pi, 0.);
			restoreDipThisTick = false;
			return;
		}

		if (!wpn)
		{
			RestorePendulumDip(psp);
			ApplyWeaponTiltToAttachedOverlays(pi, 0.);
			return;
		}
		bool authoredFireOffset = UsesAuthoredFireOffset(wpn.GetClassName(), wpn, psp);
		double applyRoll = outputRoll;
		double applyX = 0;

		if (WeaponUsesBillboardSprite(wpn))
		{
			applyX = outputRoll * 4.8;
			applyRoll = 0;
		}

		psp.Rotation += applyRoll;
		lastAppliedRoll = applyRoll;

		if (applyX != 0)
		{
			psp.X += applyX;
			lastAppliedBillboardX = applyX;
		}

		if (rollOnlyWeapon || authoredFireOffset)
			RestorePendulumDip(psp);
		else
			ApplyPendulumDip(psp, smoothedPendulumDip);

		double overlayRoll = applyRoll != 0 ? applyRoll : outputRoll;
		ApplyWeaponTiltToAttachedOverlays(pi, overlayRoll);
	}

	private void RefreshCvars(PlayerInfo pi)
	{
		cvEnabled = CVar.GetCVar("pb_tac_enable", pi).GetBool();
		cvRollResistance = clamp(CVar.GetCVar("pb_tac_roll_resistance", pi).GetFloat(), 0.08, 0.62);
		cvRollVelocity = CVar.GetCVar("pb_tac_roll_velocity", pi).GetFloat();
		cvRollCap = CVar.GetCVar("pb_tac_roll_cap_value", pi).GetFloat();
		cvLoweringScale = CVar.GetCVar("pb_tac_lowering_scale", pi).GetFloat();
		cvEnableLean = CVar.GetCVar("pb_tac_lean_enable", pi).GetBool();
		cvLeanAngle = CVar.GetCVar("pb_tac_lean_angle", pi).GetFloat();
		cvLeanSmoothing = CVar.GetCVar("pb_tac_lean_smoothing", pi).GetFloat();
		cvTiltSmoothing = clamp(CVar.GetCVar("pb_tac_tilt_smoothing", pi).GetFloat(), 0.5, 0.95);
		cvEnableReadyOnly = CVar.GetCVar("pb_tac_ready_only", pi).GetBool();
		cvEnableMoveOnly = CVar.GetCVar("pb_tac_move_only", pi).GetBool();
		cvCapRoll = CVar.GetCVar("pb_tac_roll_cap", pi).GetBool();
	}

	override void DoEffect()
	{
		Super.DoEffect();
		tickCounter++;

		outputRoll = 0;
		poseActive = false;
		restoreDipThisTick = false;
		rollOnlyWeapon = false;

		if (!owner || !owner.player || owner.player.health <= 0) { return; }

		PlayerInfo pi = owner.player;
		UserCmd cmd = pi.cmd;
		Weapon weap = pi.ReadyWeapon;
		let psp = pi.FindPSprite(PSP_WEAPON);
		if (!weap || !psp) { return; }

		if (tickCounter <= 8 || tickCounter % 4 == 0)
			RefreshCvars(pi);

		Name weaponClass = weap.GetClassName();
		if (weaponClass != lastWeaponClass)
		{
			ResetRollState();
			DiscardPendulumDipState();
			motionEnableBlend = 1.;
			lastWeaponClass = weaponClass;
		}

		if (pi.PendingWeapon != WP_NOCHANGE && pi.PendingWeapon != null
			&& pi.PendingWeapon.GetClassName() != weaponClass)
		{
			ResetRollState();
			restoreDipThisTick = true;
			smoothedPendulumDip = 0;
			return;
		}

		if (!cvEnabled)
		{
			ResetRollState();
			restoreDipThisTick = true;
			smoothedPendulumDip = 0;
			leanRoll = 0;
			return;
		}

		bool blocked = ShouldBlockForSafety(owner, weap, psp);
		bool inCombatPose = IsCombatWeaponState(weap, psp);
		bool idle = IsReadyState(weap, psp, pi);
		bool engineBob = (pi.weaponstate & wf_weaponbobbing) != 0;
		bool moving = owner.Vel.XY.Length() > 0.75;

		bool excluded = IsExcludedWeapon(weap);
		rollOnlyWeapon = UsesRollOnlyMotion(weap);
		bool authoredFireOffset = UsesAuthoredFireOffset(weaponClass, weap, psp);
		bool fireSuppressed = IsFiringState(weap, psp) && weaponClass == 'PB_Nailgun';

		bool allowMotion = !blocked && !excluded && !inCombatPose;
		if (cvEnableReadyOnly)
			allowMotion = allowMotion && idle;
		else
			allowMotion = allowMotion && (idle || engineBob);
		if (cvEnableMoveOnly)
			allowMotion = allowMotion && moving;
		if (fireSuppressed)
			allowMotion = false;

		bool allowLowering = allowMotion && !authoredFireOffset && !rollOnlyWeapon && cvLoweringScale > 0.01;

		Vector2 strafeDir = (sin(-owner.angle), cos(-owner.angle));
		double strafeDot = (owner.Vel.X * strafeDir.X) + (owner.Vel.Y * strafeDir.Y);

		if (blocked || inCombatPose)
		{
			currentRoll *= 0.75;
			smoothedWeaponRoll *= 0.75;
			motionEnableBlend += (0.0 - motionEnableBlend) * 0.15;
			restoreDipThisTick = true;
			smoothedPendulumDip *= 0.82;
			if (smoothedPendulumDip < 0.05)
				smoothedPendulumDip = 0;
		}
		else
		{
			if (allowMotion)
				motionEnableBlend += (1.0 - motionEnableBlend) * 0.15;
			else
				motionEnableBlend += (0.0 - motionEnableBlend) * 0.15;

			if (allowMotion)
			{
				if (prevStrafeDot * strafeDot < 0. && abs(strafeDot) > 0.02 && abs(prevStrafeDot) > 0.02)
					currentRoll *= 0.55;
				currentRoll += strafeDot * cvRollVelocity * motionEnableBlend;
				currentRoll *= cvRollResistance;
				if (cvCapRoll)
					currentRoll = clamp(currentRoll, -cvRollCap, cvRollCap);
			}
			else
			{
				currentRoll *= 0.75;
			}
		}

		prevStrafeDot = strafeDot;

		double tiltS = cvTiltSmoothing;
		smoothedWeaponRoll = smoothedWeaponRoll * tiltS + currentRoll * (1.0 - tiltS);
		outputRoll = smoothedWeaponRoll;

		if (!blocked && !inCombatPose)
		{
			double dipTarget = ComputePendulumDipTarget(outputRoll, strafeDot, pi, allowLowering, weaponClass);
			double dipRate = dipTarget > smoothedPendulumDip ? 0.22 : 0.16;
			smoothedPendulumDip += (dipTarget - smoothedPendulumDip) * dipRate;
			if (smoothedPendulumDip <= 0.05)
				smoothedPendulumDip = 0;
		}

		poseActive = abs(outputRoll) > 0.05 || smoothedPendulumDip > 0.05;

		double targetLean = 0;
		if (cvEnableLean && !blocked && !inCombatPose && idle && !excluded && !authoredFireOffset)
		{
			bool toggleLean = owner.CountInv("PB_LeanToggle") > 0;
			bool moveLeft = (cmd.buttons & BT_MOVELEFT) != 0;
			bool moveRight = (cmd.buttons & BT_MOVERIGHT) != 0;
			if (toggleLean)
			{
				if (moveLeft && !moveRight) { targetLean = -cvLeanAngle; }
				else if (moveRight && !moveLeft) { targetLean = cvLeanAngle; }
				else if (cmd.sidemove < 0) { targetLean = -cvLeanAngle; }
				else if (cmd.sidemove > 0) { targetLean = cvLeanAngle; }
			}
			else
			{
				bool left = owner.CountInv("PB_LeanLeft") > 0;
				bool right = owner.CountInv("PB_LeanRight") > 0;
				if (left && !right) { targetLean = -cvLeanAngle; }
				else if (right && !left) { targetLean = cvLeanAngle; }
			}
		}
		leanRoll += (targetLean - leanRoll) * cvLeanSmoothing;
	}
}

class PB_TacticalFeelHandler : EventHandler
{
	private void GiveTilter(PlayerPawn mo)
	{
		if (mo && mo.player && !mo.FindInventory("PB_WeaponTilterInventory"))
			mo.GiveInventory("PB_WeaponTilterInventory", 1);
	}

	override void PlayerEntered(PlayerEvent e)
	{
		if (!e) return;
		if (e.PlayerNumber < 0 || e.PlayerNumber >= MAXPLAYERS) return;
		if (!playeringame[e.PlayerNumber]) return;
		GiveTilter(players[e.PlayerNumber].mo);
	}

	override void PlayerRespawned(PlayerEvent e)
	{
		if (!e) return;
		if (e.PlayerNumber < 0 || e.PlayerNumber >= MAXPLAYERS) return;
		if (!playeringame[e.PlayerNumber]) return;
		GiveTilter(players[e.PlayerNumber].mo);
	}

	override void WorldLoaded(WorldEvent e)
	{
		for (int i = 0; i < MAXPLAYERS; i++)
		{
			if (!playeringame[i] || !players[i].mo)
				continue;
			GiveTilter(players[i].mo);
		}
	}

	override void WorldTick()
	{
		for (int i = 0; i < MAXPLAYERS; i++)
		{
			if (!playeringame[i] || !players[i].mo || !players[i].mo.player)
				continue;

			GiveTilter(players[i].mo);

			let inv = PB_WeaponTilterInventory(players[i].mo.FindInventory("PB_WeaponTilterInventory"));
			if (inv)
				inv.ApplyPose(players[i]);
		}
	}

	override void NetworkProcess(ConsoleEvent e)
	{
		if (!e) return;
		if (e.Player < 0 || e.Player >= MAXPLAYERS || !playeringame[e.Player] || !players[e.Player].mo) { return; }
		let mo = players[e.Player].mo;
		if (e.Name ~== "pb_lean_toggle")
		{
			if (mo.CountInv("PB_LeanToggle") > 0) { mo.TakeInventory("PB_LeanToggle", 1); }
			else { mo.GiveInventory("PB_LeanToggle", 1); }
		}
		else
		if (e.Name ~== "pb_lean_left") { mo.GiveInventory("PB_LeanLeft", 1); }
		else if (e.Name ~== "pb_unlean_left") { mo.TakeInventory("PB_LeanLeft", 1); }
		else if (e.Name ~== "pb_lean_right") { mo.GiveInventory("PB_LeanRight", 1); }
		else if (e.Name ~== "pb_unlean_right") { mo.TakeInventory("PB_LeanRight", 1); }
		else if (e.Name ~== "pb_glorycryo")
		{
			while (mo.CountInv("FlameBelchSelected") > 0)
				mo.TakeInventory("FlameBelchSelected", 1);
			mo.GiveInventory("IceBombSelected", 1);
			mo.GiveInventory("DoShoulderCannon", 1);
		}
		else if (e.Name ~== "pb_glorysaw_on")
		{
			mo.GiveInventory("DoGloryMelee", 1);
		}
		else if (e.Name ~== "pb_glorysaw_off")
		{
			mo.TakeInventory("DoGloryMelee", 1);
		}
		else if (e.Name ~== "pb_shouldercannon")
		{
			while (mo.CountInv("IceBombSelected") > 0)
				mo.TakeInventory("IceBombSelected", 1);
			mo.GiveInventory("FlameBelchSelected", 1);
			mo.GiveInventory("DoShoulderCannon", 1);
		}
	}
}
