class PB_LeanLeft : Inventory {}
class PB_LeanRight : Inventory {}
class PB_LeanToggle : Inventory {}

// Tactical weapon roll + pendulum lowering — STALKER / Universal golden path:
// WorldTick ComputePose + ApplyPose, absolute PSP Rotation, input-first strafe,
// exclusive combat blocklist (no ready allowlist). Lean still feeds Tilt++ via leanRoll.
class PB_WeaponTilterInventory : Inventory
{
	const WT_FULL = 0;
	const WT_ROLL_ONLY = 1;
	const WT_DISABLED = 2;

	double currentRoll;
	double motionEnableBlend;
	double leanRoll;
	double prevStrafeInput;
	int tickCounter;
	int lastComputeGametic;
	Name lastWeaponClass;
	double smoothedWeaponRoll;
	double smoothedPendulumDip;
	double lastAppliedDip;
	double baselineWeaponY;
	bool hasBaselineWeaponY;

	double outputRoll;
	double lastAppliedRoll;
	bool poseActive;
	bool restoreDipThisTick;
	bool rollOnlyWeapon;
	double profileRollMul;
	double profileDipMul;

	double cvRollResistance;
	double cvRollVelocity;
	double cvRollCap;
	double cvLoweringScale;
	double cvLeanAngle;
	double cvLeanSmoothing;
	double cvTiltSmoothing;
	bool cvEnabled;
	bool cvEnableLean;
	bool cvEnableReadyOnly;
	bool cvEnableMoveOnly;
	bool cvCapRoll;
	bool cvLowering;
	int lastCvarRefreshTic;

	// Idle-head cache for exclusive combat walks (per weapon class).
	Name idleCacheWeapon;
	Array<State> idleCacheStates;

	// Per-class set of states reachable from combat labels (rebuild on class change).
	Name combatBlockedWeapon;
	Array<State> combatBlockedStates;

	// Combat-sequence block cache: (weapon, psp.CurState) → blocked.
	Name combatCacheWeapon;
	State combatCacheState;
	bool combatCacheBlocked;

	static const Name SCOPED_TACTICAL_WEAPONS[] =
	{
		'PB_Railgun',
		'PB_BDPRailgun',
		'PB_MetalSniper',
		'BDPBattleRifle',
		'PB_LeverAction',
		'PB_CSSG',
		'Rifle',
		'PB_Carbine',
		'PB_M41A',
		'PB_Deagle'
	};

	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE
	}

	override void BeginPlay()
	{
		Super.BeginPlay();
		smoothedWeaponRoll = 0.;
		prevStrafeInput = 0.;
		motionEnableBlend = 1.;
		outputRoll = 0.;
		lastAppliedRoll = 0.;
		profileRollMul = 1.;
		profileDipMul = 1.;
		leanRoll = 0.;
	}

	private int GetWeaponTiltMode(Weapon weap)
	{
		if (!weap)
			return WT_DISABLED;

		Name cls = weap.GetClassName();

		if (cls == 'PB_Minigun'
			|| cls == 'MastermindChaingun'
			|| cls == 'PB_BFG9000'
			|| cls == 'FrostburnDevice'
			|| cls == 'DragonSlayer')
			return WT_DISABLED;

		if (cls == 'ThunderCrossbow')
			return WT_ROLL_ONLY;

		return WT_FULL;
	}

	private double GetWeaponRollMul(Weapon weap)
	{
		if (!weap)
			return 1.0;

		Name cls = weap.GetClassName();

		// Sidearms — stronger roll read (STALKER pistol profile).
		if (cls == 'PB_Pistol'
			|| cls == 'PB_Deagle'
			|| cls == 'HellPistoler'
			|| cls == 'Revolver'
			|| cls == 'PB_SideFusil'
			|| cls == 'PB_Revolver')
			return 1.35;

		// Melee — readable roll without over-rotating large sprites.
		if (cls == 'BattleAxe' || cls == 'Stormcast')
			return 1.20;

		// Long guns / launchers — slightly softer roll.
		if (cls == 'PB_MetalSniper'
			|| cls == 'PB_Railgun'
			|| cls == 'PB_BDPRailgun'
			|| cls == 'BDPBattleRifle'
			|| cls == 'PB_LeverAction'
			|| cls == 'PB_Excavator'
			|| cls == 'PB_RocketLauncher'
			|| cls == 'Paingiver'
			|| cls == 'ProSurv_Ballista'
			|| cls == 'PB_Unmaker'
			|| cls == 'PB_BFGMKIV'
			|| cls == 'PB_BFGBeam'
			|| cls == 'PB_BLACKHOLE'
			|| cls == 'BHGen'
			|| cls == 'PB_CSSG')
			return 0.90;

		if (cls == 'Rifle'
			|| cls == 'PB_Carbine'
			|| cls == 'PB_M41A'
			|| cls == 'PB_MP40'
			|| cls == 'PB_Fusil'
			|| cls == 'PB_M1Plasma'
			|| cls == 'PB_M2Plasma'
			|| cls == 'PB_SMG'
			|| cls == 'PB_Nailgun'
			|| cls == 'Tactical_Nail_Gun'
			|| cls == 'INNailGun')
			return 1.0;

		return 1.0;
	}

	private double GetWeaponDipMul(Weapon weap)
	{
		if (!weap)
			return 1.0;

		Name cls = weap.GetClassName();

		if (cls == 'BattleAxe')
			return 1.55;

		if (cls == 'Stormcast')
			return 1.40;

		if (cls == 'Tactical_Nail_Gun'
			|| cls == 'INNailGun'
			|| cls == 'PB_Nailgun')
			return 1.40;

		if (cls == 'PB_MetalSniper'
			|| cls == 'PB_Railgun'
			|| cls == 'PB_BDPRailgun'
			|| cls == 'BDPBattleRifle'
			|| cls == 'PB_Excavator'
			|| cls == 'PB_RocketLauncher'
			|| cls == 'Paingiver'
			|| cls == 'ProSurv_Ballista'
			|| cls == 'PB_Unmaker'
			|| cls == 'PB_BFGMKIV'
			|| cls == 'PB_BFGBeam'
			|| cls == 'PB_BLACKHOLE'
			|| cls == 'BHGen'
			|| cls == 'PB_LeverAction'
			|| cls == 'PB_CSSG')
			return 1.25;

		if (cls == 'PB_Pistol'
			|| cls == 'PB_Deagle'
			|| cls == 'HellPistoler'
			|| cls == 'Revolver'
			|| cls == 'PB_SideFusil'
			|| cls == 'PB_Revolver')
			return 1.0;

		return 1.0;
	}

	private bool HasInvToken(Actor plr, Name token)
	{
		return plr && plr.CountInv(token) > 0;
	}

	// Idle heads that combat strips Goto into — stop exclusive walk here.
	// Resolve FindState once per weapon class (inner walk used to re-Find every step).
	private void EnsureIdleStateCache(Weapon weap)
	{
		if (!weap) return;
		Name cls = weap.GetClassName();
		if (cls == idleCacheWeapon && idleCacheStates.Size() > 0)
			return;

		idleCacheWeapon = cls;
		idleCacheStates.Clear();
		static const statelabel idles[] =
		{
			'RealReady', 'RealReady_Reload', 'RealReady_Upgraded',
			'Ready', 'Ready2', 'Ready3', 'Ready4', 'Ready5',
			'ReadyLoop', 'Readyloop', 'ReadyAim', 'Ready_ADS',
			'BDReady3', 'BDReadyADS', 'ReadyRaised',
			'ReallyReady', 'ReallyReady2', 'ReallyReady2Loop', 'ReallyReady3', 'ActuallyReady3',
			'ReadySettle', 'ReadyNormal', 'ReadyLoaded', 'ReadyFull', 'ReadyNoAmmo',
			'ReadyToFire', 'ReadyToFire2', 'ReadyToFireAgain', 'ReadyToFire_Red', 'ReadyToFireDrum',
			'ReadyToFireDualWield', 'ReadyMissile', 'JavelinReady3',
			'ReadyDualWield', 'IdleNoAmmo', 'NoBuzzing', 'GoingToReady', 'GoingToReady2', 'OnLoop',
			'GunReady', 'WaitReady', 'Idle', 'PreReady',
			'CryoShotgunReadyToFire', 'MarauderShotgunReadyToFire',
			'M45Halo3ShotgunReadyToFire', 'HeatBlastReadyToFire',
			'ScopeReadyToFire', 'JavelinReadyToFire',
			'JavelinReadyEmpty', 'JavelinReadyUnloaded',
			'UnloadedReady', 'UnloadedReadyDualWield',
			'ContinueReady', 'NormalReady', 'Drum_Ready', 'HipReadyLoop',
			'ReadyNoDtech', 'ReadyHasDtech', 'Ready.Lightning',
			'ReadyToFireDemonic', 'ReadyEmpty', 'ReadyZoom',
			'KatanaReadyToCut', 'PB_HexaOverkillReadyToFire', 'MastermindChaingunReadyToFire',
			'NailGunReady', 'NailgunActuallyReady', 'EmptyReady', 'RS_AxeReady',
			'RS_PistolReady3', 'RS_PistolReadyShield',
			'BackToReadyDual', 'BackToReadyDualFromLeft', 'BackToReadyDualFromRight',
			'ScopedReady', 'SelectContinue', 'SelectAnimation', 'SelectAnimationDualWield', 'SelectReady',
			'ChargeReady', 'AxeThrowReady', 'ChargingAxeReady'
		};
		for (int i = 0; i < idles.Size(); ++i)
		{
			State st = weap.FindState(idles[i]);
			if (st)
				idleCacheStates.Push(st);
		}
	}

	private bool IsIdleGotoTarget(Weapon weap, State s)
	{
		if (!weap || !s) return false;
		EnsureIdleStateCache(weap);
		for (int i = 0; i < idleCacheStates.Size(); ++i)
		{
			if (s == idleCacheStates[i])
				return true;
		}
		return false;
	}

	// Like InStateSequence, but STOP before following Goto into Ready/idle heads.
	private bool InExclusiveCombatSequence(Weapon weap, PSprite psp, statelabel label)
	{
		if (!weap || !psp || !psp.CurState) return false;
		State base = weap.FindState(label);
		if (!base) return false;

		State cur = psp.CurState;
		State s = base;
		int guard = 0;
		while (s && guard++ < 400)
		{
			if (s == cur)
				return true;

			State next = s.NextState;
			if (!next)
				return false;
			if (next == base)
				return false;
			if (IsIdleGotoTarget(weap, next))
				return false;

			s = next;
		}
		return false;
	}

	private void PushCombatBlockedState(State s)
	{
		if (!s) return;
		for (int i = 0; i < combatBlockedStates.Size(); ++i)
		{
			if (combatBlockedStates[i] == s)
				return;
		}
		combatBlockedStates.Push(s);
	}

	// Walk each combat label once per weapon class; membership replaces per-tic graph walks.
	private void EnsureCombatBlockedCache(Weapon weap)
	{
		if (!weap) return;
		Name cls = weap.GetClassName();
		if (cls == combatBlockedWeapon)
			return;

		combatBlockedWeapon = cls;
		combatBlockedStates.Clear();
		EnsureIdleStateCache(weap);

		static const statelabel sequenceLabels[] =
		{
			'ZoomIn', 'ZoomOut', 'Ready_ADS', 'BDReadyADS', 'ZoomFire',
			'ScopedFire', 'Fire_ADS', 'ZoomLoop', 'FireZoom', 'FireZoomed',
			'Select', 'Deselect',
			'SelectContinue', 'SelectAnimation', 'SelectAnimationDualWield', 'SelectReady',
			'DeselectAkimbo', 'DeselectDualWield', 'DeselectEmpty', 'DeselectDown',
			'FinishDeselect',
			'Fire', 'Fire2', 'Fire3', 'Fire4', 'Fire5', 'Fire6', 'Fire7', 'Fire8', 'Fire9', 'Fire10',
			'Fire1', 'HoldFire', 'Hold', 'AltHold', 'AltFire', 'AltFire1', 'AltFire2',
			'FireDualWield',
			'FireGrenades', 'FireGrenade', 'DryFire', 'ChargedFire', 'ChargeFire', 'EXPFire', 'EXPFire2',
			'Melee', 'Punch', 'Kick', 'FlashKicking', 'FlashPunching', 'DoKick', 'SlideKick', 'AirKick',
			'Reload', 'Reloading', 'ReloadLoop', 'Unload', 'Unloading', 'Doreload', 'BeginMagReload',
			'Pump', 'Burst', 'Charge', 'ChargeLoop',
			'WeaponRespect', 'Respect', 'WeaponSpecial',
			'ThrowGrenade', 'UseEquipment', 'ToggleEquipment', 'SwitchEquipment',
			'EquipSelectShowFrag', 'EquipSelectShowStun', 'EquipSelectShowShield',
			'EquipSelectShowVoid', 'EquipSelectShowMine', 'EquipSelectShowGeneric',
			'QuickMelee', 'QuickMeleePunchSetup', 'GoMeleeInstead',
			'RandomMelee_ArgentMelee', 'RandomMelee_BeamMelee',
			'RandomMelee_VorpalMelee', 'RandomMelee_Backhand',
			'RandomMelee_Uppercut', 'RandomMelee_Saw',
			'QuickFire', 'JumpSlash', 'FastSlash', 'FastSlash2',
			'SpecialAttack', 'SpecialPunch', 'NormPunch', 'SpecialBashConnect',
			'AxeThrow', 'GotoAxeThrow',
			'HoldLightning', 'HoldLightning2', 'GotoHold', 'Fly', 'QuickLightning',
			'AltHold2', 'AltHold3', 'FinishElectricArc',
			'CastPulseBall', 'CastStunBall', 'CastBallLightning',
			'StartWarp', 'StartWarp2', 'StartWarp3'
		};

		for (int i = 0; i < sequenceLabels.Size(); ++i)
		{
			State base = weap.FindState(sequenceLabels[i]);
			if (!base) continue;

			State s = base;
			int guard = 0;
			while (s && guard++ < 400)
			{
				PushCombatBlockedState(s);

				State next = s.NextState;
				if (!next)
					break;
				if (next == base)
					break;
				if (IsIdleGotoTarget(weap, next))
					break;

				s = next;
			}
		}
	}

	private bool IsScopedWeapon(Weapon weap)
	{
		if (!weap) { return false; }
		Name cls = weap.GetClassName();
		for (int i = 0; i < SCOPED_TACTICAL_WEAPONS.Size(); i++)
		{
			if (cls == SCOPED_TACTICAL_WEAPONS[i]) { return true; }
		}
		return false;
	}

	private bool IsScopedFovOrToken(Actor plr, Weapon weap)
	{
		if (!plr || !weap)
			return false;

		bool fovZoomed = weap.FOVScale > 0.01 && weap.FOVScale < 0.99;
		bool adsToken = HasInvToken(plr, 'Zoomed') || HasInvToken(plr, 'ADSMode');

		// Zoomed/ADSMode are player-global and can linger after leaving an ADS gun.
		if (adsToken && (IsScopedWeapon(weap) || fovZoomed))
			return true;

		if (IsScopedWeapon(weap) && fovZoomed)
			return true;

		return false;
	}

	// Membership in per-class combat-state set; memoize (weapon class, psp.CurState).
	private bool CombatSequenceBlocks(Weapon weap, PSprite psp)
	{
		if (!weap || !psp || !psp.CurState)
			return false;

		Name cls = weap.GetClassName();
		if (cls == combatCacheWeapon && psp.CurState == combatCacheState)
			return combatCacheBlocked;

		EnsureCombatBlockedCache(weap);

		combatCacheWeapon = cls;
		combatCacheState = psp.CurState;
		combatCacheBlocked = false;
		State cur = psp.CurState;
		for (int i = 0; i < combatBlockedStates.Size(); ++i)
		{
			if (combatBlockedStates[i] == cur)
			{
				combatCacheBlocked = true;
				break;
			}
		}
		return combatCacheBlocked;
	}

	private bool ShouldBlock(Actor plr, Weapon weap, PSprite psp)
	{
		if (!plr || !weap || !psp || !plr.player)
			return true;

		if (GetWeaponTiltMode(weap) == WT_DISABLED)
			return true;

		if (IsScopedFovOrToken(plr, weap))
			return true;

		if (CombatSequenceBlocks(weap, psp))
			return true;

		PlayerInfo pi = plr.player;
		let ov10 = pi.FindPSprite(10);
		let ov11 = pi.FindPSprite(11);
		bool hasOverlayActions = (ov10 && ov10.CurState) || (ov11 && ov11.CurState);
		if (hasOverlayActions)
		{
			// Overlays during non-idle combat already blocked above; still block if kicking overlays.
			if (HasInvToken(plr, 'Kicking'))
				return true;
		}

		if (HasInvToken(plr, 'GoFatality') || HasInvToken(plr, 'ExecutionToken'))
			return true;
		if (HasInvToken(plr, 'Kicking') || HasInvToken(plr, 'UseEquipment') || HasInvToken(plr, 'ToggleEquipment'))
			return true;
		if (HasInvToken(plr, 'PlayerIsThrowingAGrenade') || HasInvToken(plr, 'PlayerIsThrowingAMolotovCocktail'))
			return true;
		if (HasInvToken(plr, 'DoShoulderCannon') || HasInvToken(plr, 'DoGloryMelee'))
			return true;

		// PB_LockScreenTilt often sticks after Respect / AltFire. Only honor while not ready.
		if (HasInvToken(plr, 'PB_LockScreenTilt')
			&& (pi.WeaponState & WF_WEAPONREADY) == 0)
			return true;

		return false;
	}

	private bool UsesAuthoredFireOffset(Name weaponClass, Weapon weap, PSprite psp)
	{
		if (weaponClass != 'PB_NeoHMG' || !weap || !psp || !psp.CurState)
			return false;
		if (InExclusiveCombatSequence(weap, psp, 'Fire')
			|| InExclusiveCombatSequence(weap, psp, 'Fire_ADS')
			|| InExclusiveCombatSequence(weap, psp, 'DoFireHMG'))
			return true;
		return false;
	}

	private void DiscardPendulumDipState()
	{
		lastAppliedDip = 0;
		smoothedPendulumDip = 0;
		hasBaselineWeaponY = false;
	}

	private void RestorePendulumDip(PSprite psp)
	{
		if (psp)
		{
			if (hasBaselineWeaponY)
				psp.Y = baselineWeaponY;
			else if (lastAppliedDip > 0)
				psp.Y -= lastAppliedDip;
		}
		DiscardPendulumDipState();
	}

	private void ApplyPendulumDip(PSprite psp, double dip)
	{
		if (!psp)
			return;

		if (hasBaselineWeaponY && lastAppliedDip > 0.05)
		{
			double expectedY = baselineWeaponY + lastAppliedDip;
			if (abs(psp.Y - expectedY) > 2.0)
			{
				baselineWeaponY = psp.Y;
				lastAppliedDip = 0;
			}
		}
		else if (!hasBaselineWeaponY)
		{
			baselineWeaponY = psp.Y - lastAppliedDip;
			hasBaselineWeaponY = true;
		}

		if (dip > 0.05)
		{
			psp.Y = baselineWeaponY + dip;
			lastAppliedDip = dip;
		}
		else
		{
			psp.Y = baselineWeaponY;
			lastAppliedDip = 0;
		}
	}

	private double ComputePendulumDipTarget(double displayRoll, double strafeInput, bool allowLowering)
	{
		if (!allowLowering || !cvLowering || cvLoweringScale <= 0.01)
			return 0;

		double absRoll = abs(displayRoll);
		// Wait until roll has committed so dip doesn't lead with a wrong-side slam.
		if (absRoll < 0.55)
			return 0;
		if (abs(strafeInput) < 0.05)
			return 0;

		double scale = max(0.5, cvLoweringScale) * profileDipMul;
		double dip = (5.5 + absRoll * 7.5) * scale;
		if (displayRoll < 0)
			dip += absRoll * 3.2 * scale;
		else
			dip += absRoll * 2.4 * scale;
		return min(dip, 26.0);
	}

	private void ResetRollState()
	{
		currentRoll = 0;
		smoothedWeaponRoll = 0;
		prevStrafeInput = 0;
		outputRoll = 0;
		lastAppliedRoll = 0;
		// Keep leanRoll — lean is independent of weapon swap.
	}

	private void ClearOverlayRoll(PlayerInfo pi)
	{
		if (!pi) { return; }
		let o10 = pi.FindPSprite(10); if (o10) { o10.Rotation = 0; }
		let o11 = pi.FindPSprite(11); if (o11) { o11.Rotation = 0; }
		let o60 = pi.FindPSprite(60); if (o60) { o60.Rotation = 0; }
		let o61 = pi.FindPSprite(61); if (o61) { o61.Rotation = 0; }
		let o63 = pi.FindPSprite(63); if (o63) { o63.Rotation = 0; }
		let o64 = pi.FindPSprite(64); if (o64) { o64.Rotation = 0; }
	}

	private void ApplyOverlayRoll(PlayerInfo pi, double roll)
	{
		if (!pi) { return; }
		let o10 = pi.FindPSprite(10); if (o10) { o10.Rotation = roll; }
		let o11 = pi.FindPSprite(11); if (o11) { o11.Rotation = roll; }
		let o60 = pi.FindPSprite(60); if (o60) { o60.Rotation = roll; }
		let o61 = pi.FindPSprite(61); if (o61) { o61.Rotation = roll; }
		let o63 = pi.FindPSprite(63); if (o63) { o63.Rotation = roll; }
		let o64 = pi.FindPSprite(64); if (o64) { o64.Rotation = roll; }
	}

	private void RefreshCvars(PlayerInfo pi)
	{
		// Null-safe defaults (STALKER playtest baseline) if CVAR lookup fails.
		cvEnabled = true;
		cvRollResistance = 0.6;
		cvRollVelocity = 4.0;
		cvRollCap = 12.0;
		cvLoweringScale = 0.5;
		cvTiltSmoothing = 0.38;
		cvCapRoll = true;
		cvLowering = true;
		cvEnableLean = true;
		cvLeanAngle = 12.0;
		cvLeanSmoothing = 0.20;
		cvEnableReadyOnly = false;
		cvEnableMoveOnly = false;

		if (!pi) return;

		let cEnable = CVar.GetCVar("pb_tac_enable", pi);
		let cRes = CVar.GetCVar("pb_tac_roll_resistance", pi);
		let cVel = CVar.GetCVar("pb_tac_roll_velocity", pi);
		let cCapAmt = CVar.GetCVar("pb_tac_roll_cap_value", pi);
		let cLow = CVar.GetCVar("pb_tac_lowering_scale", pi);
		let cSmooth = CVar.GetCVar("pb_tac_tilt_smoothing", pi);
		let cCap = CVar.GetCVar("pb_tac_roll_cap", pi);
		let cLeanEn = CVar.GetCVar("pb_tac_lean_enable", pi);
		let cLeanAng = CVar.GetCVar("pb_tac_lean_angle", pi);
		let cLeanSm = CVar.GetCVar("pb_tac_lean_smoothing", pi);
		let cReady = CVar.GetCVar("pb_tac_ready_only", pi);
		let cMove = CVar.GetCVar("pb_tac_move_only", pi);

		if (cEnable) cvEnabled = cEnable.GetBool();
		if (cRes) cvRollResistance = cRes.GetFloat();
		if (cVel) cvRollVelocity = cVel.GetFloat();
		if (cCapAmt) cvRollCap = cCapAmt.GetFloat();
		if (cLow) cvLoweringScale = cLow.GetFloat();
		if (cSmooth) cvTiltSmoothing = cSmooth.GetFloat();
		if (cCap) cvCapRoll = cCap.GetBool();
		if (cLeanEn) cvEnableLean = cLeanEn.GetBool();
		if (cLeanAng) cvLeanAngle = cLeanAng.GetFloat();
		if (cLeanSm) cvLeanSmoothing = cLeanSm.GetFloat();
		if (cReady) cvEnableReadyOnly = cReady.GetBool();
		if (cMove) cvEnableMoveOnly = cMove.GetBool();

		cvRollResistance = clamp(cvRollResistance, 0.08, 0.70);
		cvLoweringScale = clamp(cvLoweringScale, 0.0, 2.5);
		cvTiltSmoothing = clamp(cvTiltSmoothing, 0.20, 0.95);
		cvLeanSmoothing = clamp(cvLeanSmoothing, 0.05, 0.50);
		if (cvRollCap < 3.0) cvRollCap = 3.0;
		cvLowering = cvLoweringScale > 0.01;
	}

	override void DoEffect()
	{
		Super.DoEffect();
		tickCounter++;
	}

	// WorldTick entry — after weapon states settle for this tic.
	void ComputePose(PlayerInfo pi)
	{
		if (lastComputeGametic == level.time)
			return;
		lastComputeGametic = level.time;

		outputRoll = 0;
		poseActive = false;
		restoreDipThisTick = false;
		rollOnlyWeapon = false;
		profileRollMul = 1.0;
		profileDipMul = 1.0;

		if (!owner || !pi || pi.health <= 0)
			return;

		UserCmd cmd = pi.cmd;
		Weapon weap = pi.ReadyWeapon;
		let psp = pi.FindPSprite(PSP_WEAPON);
		if (!weap || !psp)
			return;

		Name weaponClass = weap.GetClassName();

		if (weaponClass != lastWeaponClass)
		{
			ResetRollState();
			DiscardPendulumDipState();
			motionEnableBlend = 1.;
			lastWeaponClass = weaponClass;
			combatCacheWeapon = 'None';
			combatBlockedWeapon = 'None';
			combatBlockedStates.Clear();
			State cleared;
			combatCacheState = cleared;
		}

		if (pi.PendingWeapon != WP_NOCHANGE && pi.PendingWeapon != null
			&& pi.PendingWeapon.GetClassName() != weaponClass)
		{
			ResetRollState();
			restoreDipThisTick = true;
			smoothedPendulumDip = 0;
			return;
		}

		// Menu CVars rarely change mid-fight; refresh every 8 tics.
		if (lastCvarRefreshTic == 0 || level.time - lastCvarRefreshTic >= 8)
		{
			RefreshCvars(pi);
			lastCvarRefreshTic = level.time;
		}

		if (!cvEnabled)
		{
			ResetRollState();
			leanRoll *= 0.85;
			restoreDipThisTick = true;
			smoothedPendulumDip = 0;
			return;
		}

		int tiltMode = GetWeaponTiltMode(weap);
		profileRollMul = GetWeaponRollMul(weap);
		profileDipMul = GetWeaponDipMul(weap);
		rollOnlyWeapon = (tiltMode == WT_ROLL_ONLY);

		bool blocked = ShouldBlock(owner, weap, psp);
		bool authoredFireOffset = UsesAuthoredFireOffset(weaponClass, weap, psp);

		// Optional stricter modes (off by default — golden path tilts whenever not blocked).
		if (!blocked && cvEnableReadyOnly && (pi.WeaponState & WF_WEAPONREADY) == 0)
			blocked = true;
		if (!blocked && cvEnableMoveOnly && owner.Vel.XY.Length() <= 0.75)
			blocked = true;

		// Positive cmd.sidemove = strafe right (Doom convention).
		double strafeInput = cmd.sidemove / 10240.0;
		Vector2 rightDir = (sin(owner.angle), -cos(owner.angle));
		double strafeDot = owner.Vel.X * rightDir.X + owner.Vel.Y * rightDir.Y;

		// Input wins while strafing; velocity only fills ice / knockback / conveyors.
		double strafe = strafeInput;
		if (abs(strafeInput) < 0.08 && abs(strafeDot) > 1.0)
			strafe = clamp(strafeDot * 0.10, -1.5, 1.5);

		if (blocked)
		{
			currentRoll *= 0.7;
			smoothedWeaponRoll *= 0.7;
			motionEnableBlend += (0.0 - motionEnableBlend) * 0.45;
			restoreDipThisTick = true;
			smoothedPendulumDip *= 0.8;
			if (smoothedPendulumDip < 0.05)
				smoothedPendulumDip = 0;
		}
		else
		{
			motionEnableBlend += (1.0 - motionEnableBlend) * 0.45;

			if (prevStrafeInput * strafe < 0. && abs(strafe) > 0.02 && abs(prevStrafeInput) > 0.02)
				currentRoll *= 0.88;

			double rollVel = cvRollVelocity * profileRollMul;
			double rollCap = cvRollCap * profileRollMul;

			currentRoll += strafe * rollVel * motionEnableBlend;
			currentRoll *= cvRollResistance;
			if (cvCapRoll)
				currentRoll = clamp(currentRoll, -rollCap, rollCap);
		}
		prevStrafeInput = strafe;

		// Lean (feeds Tilt++ leanRoll; also adds to weapon output).
		double targetLean = 0;
		if (cvEnableLean && !authoredFireOffset)
		{
			bool toggleLean = owner.CountInv('PB_LeanToggle') > 0;
			bool moveLeft = (cmd.buttons & BT_MOVELEFT) != 0;
			bool moveRight = (cmd.buttons & BT_MOVERIGHT) != 0;
			if (toggleLean)
			{
				if (moveLeft && !moveRight) { targetLean = -cvLeanAngle; }
				else if (moveRight && !moveLeft) { targetLean = cvLeanAngle; }
				else if (cmd.sidemove < 0) { targetLean = -cvLeanAngle; }
				else if (cmd.sidemove > 0) { targetLean = cvLeanAngle; }
			}
			else
			{
				bool left = owner.CountInv('PB_LeanLeft') > 0;
				bool right = owner.CountInv('PB_LeanRight') > 0;
				if (left && !right) { targetLean = -cvLeanAngle; }
				else if (right && !left) { targetLean = cvLeanAngle; }
			}
		}
		leanRoll += (targetLean - leanRoll) * cvLeanSmoothing;

		double tiltS = cvTiltSmoothing;
		smoothedWeaponRoll = smoothedWeaponRoll * tiltS + currentRoll * (1.0 - tiltS);
		outputRoll = smoothedWeaponRoll + leanRoll;

		bool allowLowering = !blocked
			&& !authoredFireOffset
			&& !rollOnlyWeapon
			&& cvLowering;

		if (!allowLowering)
		{
			if (smoothedPendulumDip > 0.05 || lastAppliedDip > 0)
				restoreDipThisTick = true;
			smoothedPendulumDip = 0;
		}
		else
		{
			double dipTarget = ComputePendulumDipTarget(smoothedWeaponRoll, strafe, true);
			double dipRate = dipTarget > smoothedPendulumDip ? 0.36 : 0.30;
			smoothedPendulumDip += (dipTarget - smoothedPendulumDip) * dipRate;
			if (smoothedPendulumDip <= 0.05)
				smoothedPendulumDip = 0;
		}

		poseActive = abs(outputRoll) > 0.04 || smoothedPendulumDip > 0.05;
	}

	void ApplyPose(PlayerInfo pi)
	{
		if (!pi)
			return;

		let psp = pi.FindPSprite(PSP_WEAPON);
		if (!psp)
			return;

		if (lastComputeGametic != level.time)
			ComputePose(pi);

		if (!cvEnabled)
		{
			psp.Rotation = 0;
			lastAppliedRoll = 0;
			ClearOverlayRoll(pi);
			RestorePendulumDip(psp);
			restoreDipThisTick = false;
			return;
		}

		if (restoreDipThisTick || !poseActive)
		{
			psp.Rotation = 0;
			lastAppliedRoll = 0;
			ClearOverlayRoll(pi);
			RestorePendulumDip(psp);
			restoreDipThisTick = false;
			// Still show lean-only roll if leaning while blocked.
			if (abs(leanRoll) > 0.05)
			{
				psp.bPivotPercent = true;
				psp.Pivot = (0.5, 0.75);
				psp.Rotation = leanRoll;
				lastAppliedRoll = leanRoll;
				ApplyOverlayRoll(pi, leanRoll);
			}
			return;
		}

		// Absolute Rotation — delta apply fought bob/offsets each tic.
		psp.bPivotPercent = true;
		psp.Pivot = (0.5, 0.75);
		psp.Rotation = outputRoll;
		lastAppliedRoll = outputRoll;
		ApplyOverlayRoll(pi, outputRoll);
		ApplyPendulumDip(psp, smoothedPendulumDip);
	}
}

class PB_TacticalFeelHandler : EventHandler
{
	private void GiveTilter(PlayerPawn mo)
	{
		if (mo && mo.player && !mo.FindInventory("PB_WeaponTilterInventory"))
			mo.GiveInventory("PB_WeaponTilterInventory", 1);
	}

	static void EnsureAndApply(PlayerPawn mo)
	{
		if (!mo || !mo.player) return;
		if (!mo.FindInventory("PB_WeaponTilterInventory"))
			mo.GiveInventory("PB_WeaponTilterInventory", 1);

		let inv = PB_WeaponTilterInventory(mo.FindInventory("PB_WeaponTilterInventory"));
		if (!inv) return;
		inv.ComputePose(mo.player);
		inv.ApplyPose(mo.player);
	}

	override void WorldTick()
	{
		for (int i = 0; i < MAXPLAYERS; i++)
		{
			if (!playeringame[i] || !players[i].mo)
				continue;
			EnsureAndApply(players[i].mo);
		}
	}

	override void PlayerEntered(PlayerEvent e)
	{
		if (!e) return;
		if (e.PlayerNumber < 0 || e.PlayerNumber >= MAXPLAYERS) return;
		if (!playeringame[e.PlayerNumber]) return;
		GiveTilter(players[e.PlayerNumber].mo);
	}

	override void PlayerRespawned(PlayerEvent e)
	{
		if (!e) return;
		if (e.PlayerNumber < 0 || e.PlayerNumber >= MAXPLAYERS) return;
		if (!playeringame[e.PlayerNumber]) return;
		GiveTilter(players[e.PlayerNumber].mo);
	}

	override void WorldLoaded(WorldEvent e)
	{
		for (int i = 0; i < MAXPLAYERS; i++)
		{
			if (!playeringame[i] || !players[i].mo)
				continue;
			GiveTilter(players[i].mo);
		}
	}

	override void NetworkProcess(ConsoleEvent e)
	{
		if (!e) return;
		if (e.Player < 0 || e.Player >= MAXPLAYERS || !playeringame[e.Player] || !players[e.Player].mo) { return; }
		let mo = players[e.Player].mo;
		if (e.Name ~== "pb_lean_toggle")
		{
			if (mo.CountInv("PB_LeanToggle") > 0) { mo.TakeInventory("PB_LeanToggle", 1); }
			else { mo.GiveInventory("PB_LeanToggle", 1); }
		}
		else
		if (e.Name ~== "pb_lean_left") { mo.GiveInventory("PB_LeanLeft", 1); }
		else if (e.Name ~== "pb_unlean_left") { mo.TakeInventory("PB_LeanLeft", 1); }
		else if (e.Name ~== "pb_lean_right") { mo.GiveInventory("PB_LeanRight", 1); }
		else if (e.Name ~== "pb_unlean_right") { mo.TakeInventory("PB_LeanRight", 1); }
		else if (e.Name ~== "pb_glorycryo")
		{
			while (mo.CountInv("FlameBelchSelected") > 0)
				mo.TakeInventory("FlameBelchSelected", 1);
			mo.GiveInventory("IceBombSelected", 1);
			mo.GiveInventory("DoShoulderCannon", 1);
		}
		else if (e.Name ~== "pb_glorysaw_on")
		{
			mo.GiveInventory("DoGloryMelee", 1);
		}
		else if (e.Name ~== "pb_glorysaw_off")
		{
			mo.TakeInventory("DoGloryMelee", 1);
		}
		else if (e.Name ~== "pb_shouldercannon")
		{
			while (mo.CountInv("IceBombSelected") > 0)
				mo.TakeInventory("IceBombSelected", 1);
			mo.GiveInventory("FlameBelchSelected", 1);
			mo.GiveInventory("DoShoulderCannon", 1);
		}
	}
}
