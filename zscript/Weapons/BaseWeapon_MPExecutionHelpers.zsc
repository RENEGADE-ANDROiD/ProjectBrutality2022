extend class PB_WeaponBase
{
	bool executionBlueBlood;
	bool executionGreenBlood;

	// Side-effect-free: true when PB_ExecutionHandlerString has a dedicated kit strip.
	clearscope static bool PB_HasExperimentalExecutionKit(Actor monster)
	{
		if (monster == null)
			return false;
		if (monster is "PB_Imp" || monster is "PB_Imp1" || monster is "PB_ImpGK" || monster is "PB_Imp1GK")
			return true;
		if (monster is "PB_ShotgunGuy" || monster is "PB_Sergeant" || monster is "PB_ShotgunGuyGK")
			return true;
		if (monster is "PB_Zombieman" || monster is "PB_ZombieMan")
			return true;
		if (monster is "PB_Cacodemon" || monster is "PB_CacodemonGK")
			return true;
		switch (monster.GetClassName())
		{
		case 'Hellduke':
		case 'Director':
		case 'DarkLord':
		case 'ESoul':
		case 'ObsidianRavager':
		case 'IceDemon':
		case 'PB_Marauder':
		case 'PB_EternalDarkLord':
		case 'PB_FleshWizard':
		case 'D3Seeker':
		case 'CyberSatyr':
		case 'Satyr':
		case 'FreshHorrorspawn':
		case 'PB_FreshHorrorspawn':
		case 'Horrorspawn1':
		case 'PB_Horrorspawn1':
		case 'HorrorspawnDecap':
		case 'PB_HorrorspawnDecap':
		case 'Unwilling':
		case 'WeakWilledOne':
		case 'HorrorspawnScreamer':
		case 'PB_HorrorspawnScreamer':
		case 'SleepingHorrorspawn':
		case 'Hunger':
		case 'Hungry':
		case 'CyberFodder':
		case 'MeleeZombie':
		case 'MeleeSergeant':
		case 'Helemental':
		case 'DarkDisciple':
		case 'Pyrodemon':
		case 'Terminator':
		case 'FriendlyTerminator':
		case 'CrackoDemon':
		case 'Crackodemon':
		case 'PB_Realm667_Behemoth':
		case 'PB_Realm667_BehemothGK':
		case 'Behemoth':
		case 'PB_Realm667_BloodGhost':
		case 'PB_Realm667_BloodGhostGK':
		case 'PB_Realm667_BloodSkull':
		case 'PB_Realm667_BloodSkullGK':
		case 'D3HellGuardian':
		case 'D3Maledict':
		case 'Rahovart':
		case 'PB_Overlord':
		case 'PB_OverlordGK':
		case 'OverLord':
			return true;
		default:
			return false;
		}
	}

	// Staging-style roster gate: any living COUNTKILL (kits preferred in the handler).
	clearscope static bool PB_IsExperimentalExecutionTarget(Actor monster)
	{
		if (monster == null || monster.health <= 0 || monster.bDORMANT)
			return false;
		return monster.bCountKill;
	}

	// Staging actorCanBeExecuted health thresholds (PowerStrength = berserk).
	clearscope static bool PB_ActorCanBeExecuted(Actor monster, Actor viewer = null)
	{
		if (monster == null || monster.health < 1 || monster.bDORMANT)
			return false;
		if (!monster.bCountKill)
			return false;

		int targetMaxHealth = monster.spawnHealth();
		int targetCurrentHealth = monster.health;

		if (viewer && viewer.CountInv("PowerStrength") >= 1
			&& (targetCurrentHealth <= targetMaxHealth * 0.25 || targetCurrentHealth <= 150))
			return true;

		if (targetCurrentHealth < targetMaxHealth * 0.20 || targetCurrentHealth <= 54)
			return true;

		return false;
	}
	action bool PB_GetExecutionBlueBlood(){
		return invoker.executionBlueBlood;
	}
	
	action void PB_SetExecutionBlueBlood(bool type){
		invoker.executionBlueBlood = type;
	}
	
	action bool PB_GetExecutionGreenBlood(){
		return invoker.executionGreenBlood;
	}
	action void PB_SetExecutionGreenBlood(bool type){
		invoker.executionGreenBlood = type;
	}
	action StateLabel PB_ExecuteGeneric() {
		// Shared P1NK/KIC* POV; blended only from humanoid fodder execution pools where it fits visually.
		return "Execution_Generic";
	}

	// Keep kit-less / Generic-fallback targets in front of the camera during the POV strip.
	action void PB_PinExecutionTarget()
	{
		Actor m = invoker.activeExecutionTarget;
		Actor proxy = invoker.activeExecutionProxy;
		if (!m || m.health <= 0 || !proxy)
			return;
		m.A_Stop();
		m.vel = (0, 0, 0);
		double spd = clamp(radius + 36.0, 48.0, 64.0);
		vector3 neworigin = Vec3Offset(cos(angle) * spd, sin(angle) * spd, 0);
		neworigin.z = invoker.activeExecutionAnchor.z;
		proxy.SetOrigin(neworigin, false);
		proxy.A_SetAngle(angle + 180, SPF_INTERPOLATE);
	}

	// Kit-less generic: kill on first impact beat (after pin hold), not during intro.
	action void PB_ExecuteKillHeldTarget()
	{
		Actor m = invoker.activeExecutionTarget;
		if (m && m.health > 0)
			m.A_Die();
		invoker.PB_ClearActiveGenericExecution();
	}
action StateLabel PB_ExecutionHellDuke() {
		StateLabel result;
		int selector = (random(1,2));
		FLineTraceData RemoteRay;
		bool wallcheck = LineTrace(
		   angle,
		   120,
		   pitch,
		   TRF_THRUACTORS,
		   offsetz: height-12,
		   data: RemoteRay
		);
		
		if((Pos.Z-floorz) > 8) {
			A_Warp(AAPTR_PLAYER_GETTARGET, 0, 0, 54, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION);
			result = "Execution_HellDuke";			return result;
		}
		
		switch(selector){
			case 1:
				result = "Execution_HellDuke";
				break;
			case 2:
				result = "Execution_HellDuke";
				break;
		}
		return result;
	}

