	action StateLabel PB_ExecutionEternalDarkLord() {
		StateLabel result;
		int selector = (random(1, 3));
		if ((Pos.Z - floorz) > 8) {
			A_Warp(AAPTR_PLAYER_GETTARGET, 0, 0, 54, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION);
			return "Execution_EternalDarkLord1";
		}
		switch (selector) {
		case 1: result = "Execution_EternalDarkLord1"; break;
		case 2: result = "Execution_EternalDarkLord2"; break;
		case 3: result = "Execution_EternalDarkLord3"; break;
		default: result = "Execution_EternalDarkLord1"; break;
		}
		return result;
	}

