		   data: RemoteRay
		);
		
		if((Pos.Z-floorz) > 8) {
			A_Warp(AAPTR_PLAYER_GETTARGET, 0, 0, 54, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION);
			result = "Execution_Darkdisciple1";
			return result;
		}
		
		
		switch(selector){
			case 1:
				result = "Execution_Darkdisciple1";
				break;
			case 2:
				result = "Execution_Darkdisciple2";
				break;
		}
		return result;
	}
	
