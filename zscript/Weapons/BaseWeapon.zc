	// Used for interrupting the hand animation when kicking with melee attacks
	action bool PB_MeleeKickInterruptCheck() {
		if(!invoker.owner || !invoker.owner.player)
			return false;
		if( InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftJab")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftHook")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftUpperCut")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftBackHand")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightJab"))||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightHook")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightUpperCut")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightBackHand"))
		) {
			return true;
		}
		return false;
	}
	
	action bool PB_MeleeAttackKickCheck() 
	{
		if(!invoker.owner || !invoker.owner.player)
			return true;
		if( InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftJab")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftHook")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftUpperCut")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("LeftBackHand")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightJab"))||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightHook")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightUpperCut")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("RightBackHand")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("SideKickRight")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("SideKickLeft")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("HookKickLeft")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("ThrustKick")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("AirKickCombo")) ||
			InStateSequence(invoker.owner.player.GetPSprite(PSP_WEAPON).Curstate,invoker.ResolveState("HookKickRight"))
			
			
		) {
			return false;
		}
		return true;
		
	}
	
	action bool PB_WeaponIsInReadyState()
	{
		if(!invoker.owner || !invoker.owner.player)
			return false;
		PSprite weaponPSP = invoker.owner.player.GetPSprite(PSP_WEAPON);
		if (!weaponPSP || !weaponPSP.CurState)
			return false;
		static const statelabel readyStates[] =
		{
			'RealReady', 'RealReady_Reload', 'RealReady_Upgraded',
			'Ready', 'Ready2', 'Ready3', 'Ready4', 'Ready5',
			'ReadyLoop', 'Readyloop', 'ReadyAim', 'Ready_ADS',
			'BDReady3', 'BDReadyADS', 'ReadyRaised',
			'ReallyReady', 'ReallyReady2', 'ReallyReady2Loop', 'ReallyReady3', 'ActuallyReady3',
			'ReadySettle', 'ReadyNormal', 'ReadyLoaded', 'ReadyFull', 'ReadyNoAmmo',
			'ReadyToFire', 'ReadyToFire2', 'ReadyToFireAgain', 'ReadyToFire_Red', 'ReadyToFireDrum',
			'ReadyToFireDualWield', 'ReadyDualUnloaded', 'ReadyMissile', 'JavelinReady3',
			'ReadyDualWield', 'IdleNoAmmo', 'NoBuzzing', 'OnLoop',
			'GunReady', 'WaitReady', 'Idle', 'PreReady',
			'ReadyFists', 'ReadyFistsLoop',
			'CryoShotgunReadyToFire', 'MarauderShotgunReadyToFire',
			'M45Halo3ShotgunReadyToFire', 'HeatBlastReadyToFire',
			'ScopeReadyToFire', 'JavelinReadyToFire',
			'JavelinReadyEmpty', 'JavelinReadyUnloaded',
			'UnloadedReady', 'UnloadedReadyDualWield',
			'ContinueReady', 'NormalReady', 'Drum_Ready', 'HipReadyLoop',
			'ReadyNoDtech', 'ReadyHasDtech', 'Ready.Lightning',
			'ReadyToFireDemonic', 'ReadyEmpty', 'ReadyZoom',
			'KatanaReadyToCut', 'PB_HexaOverkillReadyToFire', 'MastermindChaingunReadyToFire',
			'NailGunReady', 'NailgunActuallyReady', 'EmptyReady', 'RS_AxeReady',
			'RS_PistolReady3', 'RS_PistolReadyShield',
			'BackToReadyDual', 'BackToReadyDualFromLeft', 'BackToReadyDualFromRight',
			'ScopedReady', 'ChargeReady', 'AxeThrowReady', 'ChargingAxeReady'
		};
		for (int i = 0; i < readyStates.Size(); ++i)
		{
			State base = invoker.FindState(readyStates[i]);
			if (base && InStateSequence(weaponPSP.CurState, base))
				return true;
		}
		PSprite left = invoker.owner.player.GetPSprite(10);
		PSprite right = invoker.owner.player.GetPSprite(11);
		State leftIdle = invoker.FindState('IdleLeft_Overlay');
		State rightIdle = invoker.FindState('IdleRight_Overlay');
		State dualIdle = invoker.FindState('ReadyToFireDualWield');
		return left && right && leftIdle && rightIdle && dualIdle
			&& InStateSequence(left.CurState, leftIdle)
			&& InStateSequence(right.CurState, rightIdle)
			&& InStateSequence(weaponPSP.CurState, dualIdle);
	}
	
	
	action state A_DoPBWeaponAction(int weapflags = WRF_ALLOWRELOAD, int pbFlags = 0, string unloadtoken = "HasUnloaded", bool noReload = false)
	{
		static const string PBWeapEmptyToken[] = 
		{
			"PB_PistolWasEmpty","RifleWasEmpty","UACSMGWasEmpty"
		};
		static const string PBWeapUnloadedToken[] =
		{
			"HasUnloaded", "HasUnloadedRG"
		};
		static const string PBWeapUnloadableClasses [] =
		{
			"PB_Weapon"
		};
		static const statelabel PBWeapStatelabels[] =
		{
			"Steady", "QuickPunch",
			"DoKick", "Taunt", "Salute", "Salute",
			"UseEquipment", "SwitchEquipment", "DualWieldBaby",
			"NoDualWield", "WeaponSpecial", "GrabbedBarrel", "GrabbedBurningBarrel", "GloryMelee", "FireShoulderCannon"
		};
		PB_EnsureWeaponMiniOverlays();
		if (!(pbFlags & PBWEAP_UNLOADED)) pbFlags |= CheckUnloaded(invoker.UnloaderToken);
		// 3rd-person Glory Kill wait: Steady until GoFatality clears.
		if (CountInv("GoFatality") >= 1)
			return ResolveState("PB_FinisherCleanup");
		// Live FPS execute owns PSP — do not Steady-yank (orphans Token/FLY via GoingToReady).
		if (PB_executingEnemy() || CountInv("ExecutionToken") >= 1)
		{
			A_WeaponReady(WRF_NOFIRE | WRF_NOSWITCH);
			return null;
		}

		if (CountInv("DoGloryMelee") >= 1)
			return ResolveState("GloryMelee");

		if (CountInv("DoShoulderCannon") >= 1)
		{
			State stShoulder = invoker.ResolveState("FireShoulderCannon");
			if (stShoulder)
				return stShoulder;
			A_TakeInventory("DoShoulderCannon", 1);
		}

		// Stale throw tokens after an aborted catch strip: heal once PSP left the authored strip.
		PB_HealOrphanedShieldSawThrowAnim();

		if (invoker.usingMelee || CountInv("ShieldSawThrowAnim") >= 1 || CountInv("CantFire") >= 1)
		{
			A_WeaponReady(WRF_NOFIRE | WRF_NOSECONDARY | WRF_NOSWITCH);
			return null;
		}
		
		if(((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringLeftWeapon()) || ((PressingAltfire() || JustPressed(BT_ALTATTACK)) && !A_IsFiringRightWeapon())){
			if(CountInv("DualFireReload") >= 2){
				A_TakeInventory("DualFireReload",2);
				return ResolveState("Reload");
			}
		}
		
		if (CountInv("GoWeaponSpecialAbility")>=1)
		{
			if (ResolveState("DualWieldBaby")) return ResolveState("DualWieldBaby");
			else if (ResolveState("NoDualWield")) return ResolveState("NoDualWield");
			else return ResolveState("WeaponSpecial");
		}
		if (CountInv("HasBarrel") >= 1)
			return ResolveState("ReadyBarrel");
		if (CountInv("HasBurningBarrel") >= 1)
			return ResolveState("ReadyFlameBarrel");
		if (CountInv("HasIceBarrel") >= 1)
			return ResolveState("ReadyIceBarrel");
		// Staging GoingToReady/DoEffect contract: re-assert hold if Grabbed*.
		if (CountInv("GrabbedBarrel") >= 1)
			return ResolveState("IdleBarrel");
		if (CountInv("GrabbedBurningBarrel") >= 1)
			return ResolveState("IdleFlameBarrel");
		if (CountInv("GrabbedIceBarrel") >= 1)
			return ResolveState("IdleIceBarrel");
		if (CountInv("Unloading")>=1 && ResolveState("Unload") && !(pbFlags & PBWEAP_NOUNLOAD) && !(pbFlags & PBWEAP_UNLOADED) && CountInv(invoker.UnloaderToken) != 1)
		{
			return ResolveState("Unload");
		}
		else A_TakeInventory("Unloading", CountInv("Unloading"));
		{
			State stGunEmpty = invoker.ResolveState("GunEmpty");
			PlayerInfo pl = invoker.owner ? invoker.owner.player : null;
			if (stGunEmpty != null && invoker.UnloaderToken != "" && CountInv(invoker.UnloaderToken) >= 1 && !(pbFlags & PBWEAP_UNLOADED) && pl)
			{
				let psp = pl.GetPSprite(PSP_WEAPON);
				if (psp && !InStateSequence(psp.Curstate, stGunEmpty))
					return ResolveState("GunEmpty");
			}
		}
		if (ResolveState("LoadChamber"))
		{
			for (int i = 0; i < PBWeapEmptyToken.Size(); ++i)
			{
				if (CountInv(PBWeapEmptyToken[i]) >= 1)
				{
					return ResolveState("LoadChamber");
				}
			}
		}
		
		if (!(weapflags & (WRF_NOFIRE | WRF_NOPRIMARY)) && JustPressed(BT_ATTACK) && !A_IsFiringLeftWeapon())
		{
			State fatalitySt = PB_DispatchAutoFireFinisher();
			if (fatalitySt)
				return fatalitySt;
		}

		if (noReload) {
			A_WeaponReady();
		}
		else {
			A_WeaponReady(weapflags);
		}
		return null;
	}
	
	action void PB_HandleCrosshair(int num)
	{
        CVar crosshair_settings = CVar.FindCVar('pb_weapon_crosshairs');
		
		if(crosshair_settings.GetBool()){
			A_SetCrosshair(num);
		}
		else {
			A_SetCrosshair(0);
		}
	}
	
	override void DoEffect()
	{
		super.DoEffect();
		if (pendingExecutionTic > 0 && gametic > pendingExecutionTic)
			PB_ClearPendingExecution();
		if (activeExecutionDeadline > 0 && gametic >= activeExecutionDeadline)
		{
			PB_ClearActiveGenericExecution();
			let timedOutPlayer = PlayerPawn(owner);
			if (timedOutPlayer)
				ClearOrphanedExecutionLock(timedOutPlayer);
		}
		if (!owner || !owner.player)
			return;
		let player = owner.player;
		// Interrupted mid-execute weapon switch: clear orphaned freeze/token when no longer ready.
		if (player.ReadyWeapon != self && executingEnemy)
		{
			let pp = PlayerPawn(owner);
			if (pp)
				ClearOrphanedExecutionLock(pp);
		}
		if (player && player.readyweapon)
		{
			player.WeaponState |= WF_WEAPONBOBBING;
			if (!owner.FindInventory("PB_WeaponTilterInventory"))
			{
				owner.GiveInventory("PB_WeaponTilterInventory", 1);
			}
		}
	}
	
