	action void A_PB_AirMeleeLunge(double xyBoost)
	{
		if (!player || !player.mo)
			return;
		let pl = PlayerPawn(player.mo);
		if (!pl || abs(pl.Vel.Z) < 1.)
			return;
		Vector2 f = AngleToVector(pl.angle);
		pl.Vel.X += f.X * xyBoost;
		pl.Vel.Y += f.Y * xyBoost;
	}

	// STALKER Theme Weapons NR-40 / User1 knife feel — camera + FOV + shove (A_ZoomFactor for PB ADS parity).
	action void PB_MeleeFeelWind()
	{
		A_SetAngle(angle - 0.5, SPF_INTERPOLATE);
		A_SetPitch(pitch + 0.5, SPF_INTERPOLATE);
		A_SetRoll(roll - 2);
		A_ZoomFactor(0.98);
		A_WeaponOffset(-10, 6, WOF_ADD | WOF_INTERPOLATE);
	}

	action void PB_MeleeFeelStep(double zoomMul)
	{
		A_SetAngle(angle - 0.5, SPF_INTERPOLATE);
		A_SetPitch(pitch + 0.5, SPF_INTERPOLATE);
		A_SetRoll(roll - 2);
		A_ZoomFactor(zoomMul);
	}

	action void PB_MeleeFeelCommit()
	{
		A_SetPitch(pitch + 1.25, SPF_INTERPOLATE);
		A_ZoomFactor(0.95);
		A_Recoil(-1);
		A_WeaponOffset(-6, 4, WOF_ADD | WOF_INTERPOLATE);
	}

	action void PB_MeleeFeelReturn(double zoomMul)
	{
		A_SetAngle(angle + 0.75, SPF_INTERPOLATE);
		A_SetPitch(pitch - 0.5, SPF_INTERPOLATE);
		A_SetRoll(roll + 2);
		A_ZoomFactor(zoomMul);
		A_WeaponOffset(6, -3, WOF_ADD | WOF_INTERPOLATE);
	}

	action void PB_MeleeFeelEnd()
	{
		A_SetAngle(angle + 0.5, SPF_INTERPOLATE);
		A_SetPitch(pitch - 1.25, SPF_INTERPOLATE);
		A_SetRoll(roll + 2);
		A_ZoomFactor(1.0);
		A_WeaponOffset(0, 32, WOF_INTERPOLATE);
	}

