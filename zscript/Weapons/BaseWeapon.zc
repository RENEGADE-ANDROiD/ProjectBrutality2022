		invoker.usingMelee = type;
	}

	// Hold attack input off during quick-melee / shield-saw throw (stops Fire loops still shooting).
	action void PB_BlockWeaponFireInput()
	{
		A_WeaponReady(WRF_NOFIRE | WRF_NOSECONDARY | WRF_NOSWITCH);
	}

	action void PB_StartShieldSawThrowAnim()
	{
		A_GiveInventory("CantFire", 1);
		A_GiveInventory("ShieldSawThrowAnim", 1);
		PB_SetUsingMelee(true);
		PB_BlockWeaponFireInput();
	}

	action void PB_EndShieldSawThrowAnim()
	{
		A_TakeInventory("CantFire", 1);
		A_TakeInventory("ShieldSawThrowAnim", 1);
		PB_SetUsingMelee(false);
		if (invoker)
			invoker.PB_ConsumeMeleeReturnState(false);
	}

	action bool PB_ShieldSawThrowAnimBusy()
	{
		return CountInv("ShieldSawThrowAnim") >= 1 || CountInv("CantFire") >= 1;
	}

	// Heal only when ThrowAnim outlives the authored catch strip.
	// Keys off ShieldSawThrowAnim alone so unrelated CantFire never false-triggers.
	action void PB_HealOrphanedShieldSawThrowAnim()
	{
		if (CountInv("ShieldSawThrowAnim") < 1)
			return;
		if (!invoker || !invoker.owner || !invoker.owner.player)
			return;
		let psp = invoker.owner.player.GetPSprite(PSP_WEAPON);
		if (psp && psp.CurState && invoker.PB_ShieldSawAnimOwnsCurrentPSP(psp.CurState))
			return;
		PB_EndShieldSawThrowAnim();
	}

	bool PB_ShieldSawAnimChainContains(State cur, StateLabel label)
	{
		if (cur == null)
			return false;
		State s = FindState(label);
		if (s == null)
			return false;
		State stopReturn = FindState('ReturnFromShieldSawAnim');
		State stopReady = FindState('Ready');
		State stopReady3 = FindState('Ready3');
		State stopDeselect = FindState('Deselect');
		for (int i = 0; i < 128 && s != null; i++)
		{
			if (s == cur)
				return true;
			State nx = s.NextState;
			if (nx == null)
				break;
			if (stopReturn && nx == stopReturn) break;
			if (stopReady && nx == stopReady) break;
			if (stopReady3 && nx == stopReady3) break;
			if (stopDeselect && nx == stopDeselect) break;
			s = nx;
		}
		return false;
	}

	bool PB_ShieldSawAnimOwnsCurrentPSP(State cur)
	{
		if (cur == null)
			return false;
		return PB_ShieldSawAnimChainContains(cur, 'ShieldSawCatchAnim');
	}

	// Instant throw payload (no FPS SHIE strip).
	action void PB_CommitShieldSawThrow()
	{
		A_ClearOverlays(1006, 1006, false);
		A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
		A_ClearOverlays(3, 65);
		if (CountInv("GrabbedBarrel") == 1 || CountInv("GrabbedIceBarrel") == 1 || CountInv("GrabbedBurningBarrel") == 1)
			A_Overlay(PSP_WEAPON, "FlashBarrelKicking");
		A_TakeInventory("Zoomed", 1);
		A_ZoomFactor(1.0);
		A_TakeInventory("ADSmode", 1);
		A_StopSoundEx("Soundslot5");
		A_PlaySoundEx("ShieldSawSwing", "Soundslot6");
		A_AlertMonsters();
		A_StartSound("ShieldSawThrow", CHAN_WEAPON, CHANF_DEFAULT, 0.8);
		PB_Achievements.OnShieldSawThrow();
		PB_FireShieldSawThrown();
		A_TakeInventory("ShieldSaw_token", 1);
		A_TakeInventory("ShieldSawReady", 1);
		A_GiveInventory("CoolShieldSaw", 1);
		A_GiveInventory("ShieldSawThrown", 1);
		PB_WeaponRecoil(-1.20, 0.20);
		PB_UnsetPlayerExecutionProperties();
		SetPlayerProperty(0, 0, 0);
		SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
		A_TakeInventory("CantFire", 1);
		A_TakeInventory("ShieldSawThrowAnim", 1);
		PB_SetUsingMelee(false);
		if (invoker)
			invoker.PB_ConsumeMeleeReturnState(false);
		PB_RestoreWeaponMiniOverlays();
	}

	action void PB_ShieldSawThrowFlashOverlayOfs()
	{
		// Absolute HUD position — do not add PSP_WEAPON offset (default ADDWEAPON reads as floating mid-screen).
		A_OverlayFlags(1006, PSPF_ADDWEAPON, false);
		A_OverlayFlags(1006, PSPF_ADDBOB, false);
		A_OverlayOffset(1006, -8, 200);
	}

	action void PB_ShieldSawCatchFlashOverlayOfs()
	{
		A_OverlayFlags(1006, PSPF_ADDWEAPON, false);
		A_OverlayFlags(1006, PSPF_ADDBOB, false);
		A_OverlayOffset(1006, -44, 200);
	}

	// Re-arm mini overlays after shield-saw throw/catch (A_ClearOverlays(-999,-999) nuked these).
	action void PB_RestoreWeaponMiniOverlays()
	{
		// Stale rock-on / equip tip (FlashPunching on 799) can survive Select races and lock flash actions.
		A_ClearOverlays(799, 799);
		A_Overlay(-777, "Melee_Equipment_Handler_Overlay");
		A_Overlay(-778, "KickHandler_Overlay");
		A_Overlay(-779, "Equipment_Toggle_Handler_Overlay");
		A_Overlay(-10, "FirstPersonLegsStand");
	}

	action void PB_EnsureWeaponMiniOverlays()
	{
		if (!invoker.owner || !invoker.owner.player || invoker.owner.player.ReadyWeapon != invoker)
			return;

		State meleeHandler = invoker.ResolveState("Melee_Equipment_Handler_Overlay");
		State kickHandler = invoker.ResolveState("KickHandler_Overlay");
		State equipHandler = invoker.ResolveState("Equipment_Toggle_Handler_Overlay");
		PSprite meleePSP = invoker.owner.player.GetPSprite(-777);
		PSprite kickPSP = invoker.owner.player.GetPSprite(-778);
		PSprite equipPSP = invoker.owner.player.GetPSprite(-779);

		if (meleeHandler && (!meleePSP || !meleePSP.CurState || !InStateSequence(meleePSP.CurState, meleeHandler)))
			A_Overlay(-777, "Melee_Equipment_Handler_Overlay");
		if (kickHandler && (!kickPSP || !kickPSP.CurState || !InStateSequence(kickPSP.CurState, kickHandler)))
			A_Overlay(-778, "KickHandler_Overlay");
		if (equipHandler && (!equipPSP || !equipPSP.CurState || !InStateSequence(equipPSP.CurState, equipHandler)))
			A_Overlay(-779, "Equipment_Toggle_Handler_Overlay");
	}

	action void PB_ResetInterruptedFlashActions(bool clearZoom = false, bool clearFlash = false)
	{
		invoker.usingMelee = false;
		invoker.usingKick = false;
		invoker.usingEquipment = false;
		invoker.meleeReturnState = null;
		invoker.kickReturnState = null;
		invoker.meleeReturnWeapon = 'None';
		invoker.kickReturnWeapon = 'None';
		invoker.meatHookChordArm = 0;
		A_SetInventory("CantFire", 0);
		A_SetInventory("ShieldSawThrowAnim", 0);
		A_SetInventory("Kicking", 0);
		A_SetInventory("PB_LockScreenTilt", 0);
		if (clearZoom)
			A_SetInventory("Zoomed", 0);
		A_ClearOverlays(-999, -999);
		A_ClearOverlays(799, 799);
		if (clearFlash)
			A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
		PB_EnsureWeaponMiniOverlays();
	}

	// Resume held weapon after shield-saw throw/catch without SelectAnimation / equip SFX.
	action state PB_ReturnFromShieldSawToReady()
	{
		let mo = invoker.owner;
		if (!mo)
			return null;
		State r3 = invoker.ResolveState("Ready3");
		readonly<Actor> baseDef = GetDefaultByType((class<PB_WeaponBase>)('PB_WeaponBase'));
		State baseR3 = baseDef.FindState("Ready3");
		if (r3 && baseR3 && r3 == baseR3)
		{
			mo.GiveInventory("PB_SkipWeaponSelectAnim", 1);
			return invoker.ResolveState("Ready");
		}
		mo.TakeInventory("PB_SkipWeaponSelectAnim", 1);
		return r3;
	}
	
	
	action bool PB_usingKick(){
		return invoker.usingKick;
	}
	
	action void PB_SetUsingKick(bool type){
		invoker.usingKick = type;
	}

	// Crosshair aim target (same pointer PB_Execute uses) within flash-punch range.
	action bool PB_QuickMeleeAimWithinPunchRange()
	{
		if (PB_ResolveFinisherMonster(99.) != null)
			return true;
		Actor aim = GetPointer(AAPTR_PLAYER_GETTARGET);
		if (aim && Distance3D(aim) < 99.)
			return true;
		let mo = invoker.owner;
		if (mo && mo.target && mo.Distance3D(mo.target) < 99.)
			return true;
		return false;
	}

	// Hitbox / body with FinisherToken (stagger glow lives on the monster, not HeadshotTarget).
	action Actor PB_FinisherFromAimActor(Actor aim)
	{
		if (!aim || aim.health <= 0)
			return null;
		if (aim.CountInv("FinisherToken") >= 1)
			return aim;
		if (aim.master && aim.master.health > 0 && aim.master.CountInv("FinisherToken") >= 1)
			return aim.master;
		return null;
	}

	// Find staggered monster within GloryKillPuff range (150), despite hitbox aim steal.
	action Actor PB_ResolveFinisherMonster(double maxDist = 150.)
	{
		let mo = invoker.owner;
		if (!mo)
			return null;

		Actor cand = PB_FinisherFromAimActor(GetPointer(AAPTR_PLAYER_GETTARGET));
		if (cand && mo.Distance3D(cand) < maxDist)
			return cand;

		cand = PB_FinisherFromAimActor(mo.target);
		if (cand && mo.Distance3D(cand) < maxDist)
			return cand;

		BlockThingsIterator it = BlockThingsIterator.Create(mo, maxDist);
		Actor best = null;
		double bestD = maxDist;
		while (it.Next())
		{
			Actor a = it.thing;
			if (!a || a == mo || a.health <= 0)
				continue;
			if (a.CountInv("FinisherToken") < 1)
				continue;
			double d = mo.Distance3D(a);
			if (d >= bestD)
				continue;
			if (!mo.CheckSight(a))
				continue;
			best = a;
			bestD = d;
		}
		return best;
	}

	// Possession mounts (Caco / Mastermind / Cyber / Manc / Arachno / Rev) — block finishers mid-ride.
	clearscope static bool PB_PlayerOnPossessionRide(Actor a)
	{
		if (!a)
			return false;
		return a.CountInv("CacoPlayer") > 0 || a.CountInv("CacoTimer") > 0
			|| a.CountInv("MastermindPlayer") > 0 || a.CountInv("MastermindTimer") > 0
			|| a.CountInv("CyberdemonPlayer") > 0 || a.CountInv("CyberdemonTimer") > 0
			|| a.CountInv("MancubusPlayer") > 0 || a.CountInv("ArachnotronTurret") > 0
			|| a.CountInv("RevenantRider") > 0;
	}

	// DECORATE cannot pass `self` into static helpers; use these from BaseWeapon.dec.
	action state PB_PossessionRideGotoReady()
	{
		if (PB_PlayerOnPossessionRide(self))
			return ResolveState("Ready");
		return ResolveState(null);
	}

	action state PB_AbortHayultiOnPossessionRide()
	{
		if (!PB_PlayerOnPossessionRide(self))
			return ResolveState(null);
		A_ChangeFlag("INVULNERABLE", 0);
		SetPlayerProperty(0, 0, 0);
		SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
		A_TakeInventory("Hayulti", 1);
		return ResolveState("Ready");
	}

	action state PB_AbortHayberserkOnPossessionRide()
	{
		if (!PB_PlayerOnPossessionRide(self))
			return ResolveState(null);
		A_ChangeFlag("INVULNERABLE", 0);
		SetPlayerProperty(0, 0, 0);
		SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
		A_TakeInventory("Hayberserk", 1);
		A_TakeInventory("PB_HayberserkInvuln", 1);
		return ResolveState("Ready");
	}

	// Staggered Glory Kill: nearby FinisherToken monster (not only GETTARGET inventory).
	action bool PB_GloryKillOpportunityReady()
	{
		if (PB_PlayerOnPossessionRide(self))
			return false;
		Actor mon = PB_ResolveFinisherMonster(150.);
		if (!mon)
			return false;
		if (Distance3D(mon) < 150.)
			return true;
		return A_CheckLOF("Null", CLOFF_SETTARGET | CLOFF_NOAIM_VERT | CLOFF_IGNOREGHOST | CLOFF_MUSTBESOLID, 180);
	}

	// Experimental execution eligibility without starting an Execution_* state.
	action bool PB_ExecutionOpportunityReady()
	{
		if (PB_PlayerOnPossessionRide(self))
			return false;
		CVar experimental_settings = CVar.FindCVar("pb_experimental");
		if (!experimental_settings || !experimental_settings.GetBool())
			return false;

		Actor monster = GetPointer(AAPTR_PLAYER_GETTARGET);
		if (!monster || monster.health <= 0)
			return false;
		if (!PB_IsExperimentalExecutionTarget(monster))
			return false;
		if (!PB_ActorCanBeExecuted(monster, self))
			return false;

		LookExParams look;
		look.FOV = 110;
		if (!monster.IsVisible(self, false, look) || GetDistance(True, AAPTR_PLAYER_GETTARGET) >= 250)
			return false;

		// Never call PB_ExecutionHandlerString here (side effects).
		return true;
	}

	// Kick / Quick Melee shared gate: Glory Kill, charged Blood Punch, or experimental execute.
	action bool PB_FinisherOpportunityReady()
	{
		if (PB_GloryKillOpportunityReady())
			return true;
		if (CountInv("BPToken") == 5 && ResolveState("BloodPunch"))
			return true;
		return PB_ExecutionOpportunityReady();
	}

	// Mid-punch re-press: USER2 or USER4 → Glory Kill then PB_Execute.
	action state PB_TryMidPunchFinisher()
	{
		if (!(JustPressed(BT_USER2) || JustPressed(BT_USER4)))
			return null;
		if (PB_GloryKillOpportunityReady())
			return ResolveState("PermormGloryKill");
		return PB_Execute();
	}

	// GK_ShieldSaw parity: throw only when beyond flash-punch range — never steal stagger GK.
	action state PB_ResolveQuickMeleeShieldThrow()
	{
		let mo = invoker.owner;
		if (!mo)
			return null;
		if (mo.CountInv("ShieldSawThrown") >= 1)
			return null;
		if (mo.CountInv("ShieldSaw_token") < 1)
			return null;
		if (mo.CountInv("ShieldSawReady") < 1)
			return null;
		// Hard-block saw while a staggered FinisherToken monster is in Glory Kill range.
		if (PB_ResolveFinisherMonster(150.) != null)
			return null;
		if (PB_QuickMeleeAimWithinPunchRange())
			return null;
		State st = invoker.ResolveState("ThrowShieldSaw");
		if (st)
			return st;
		return null;
	}

	clearscope static vector3 PB_KickEjectaViewDir(double angle, double pitch)
	{
		double cosp = cos(pitch);
		return (cos(angle) * cosp, sin(angle) * cosp, -sin(pitch));
	}

	clearscope static bool PB_IsKickableBulletStatEjecta(Actor mo)
	{
		if (!mo)
			return false;
		return mo is "EmptyMagMP40"
			|| mo is "EmptyBrass"
			|| mo is "EmptyBrass2"
			|| mo is "EmptyBrassMP40"
			|| mo is "ShotgunCasing"
			|| mo is "MG42Casing"
			|| mo is "LMGCasingStandard"
			|| mo is "LMGCasingRocket"
			|| mo is "EmptyGrenadeBrass"
			|| mo is "EmptyClip"
			|| mo is "EmptyClipMP40"
			|| mo is "EmptyLMGMag"
			|| mo is "EmptyASGDrum"
			|| mo is "EmptyHMGDrum"
			|| mo is "EmptyRocketChamber"
			|| mo is "EmptyCell"
			|| mo is "MinigunBeltPiece"
			|| mo is "ShotgunWad"
			|| mo is "MP40DogTag";
	}

	static bool PB_TryKickOneClientsideEjecta(PlayerPawn pl, Actor mo, Vector3 dir, Vector2 fwdHoriz, double radius, double power)
	{
		if (!pl || !mo || mo == pl)
			return false;
		double dist = pl.Distance2D(mo);
		if (dist > radius || dist < 1.)
			return false;
		double dz = mo.pos.z - pl.pos.z;
		if (dz < -48 || dz > 42)
			return false;
		Vector2 toMo = mo.pos.xy - pl.pos.xy;
		double tlen = toMo.Length();
		if (tlen < 0.001)
			return false;
		toMo /= tlen;
		if (fwdHoriz.X * toMo.X + fwdHoriz.Y * toMo.Y < 0.42)
			return false;
		double falloff = clamp(1.0 - dist / radius, 0.22, 1.0);
		double massMul = clamp(9.0 / max(double(mo.Mass), 1.0), 0.28, 2.85);
		Vector3 impulse = dir * (power * falloff * massMul);
		impulse.Z += 2.75 * falloff * massMul;
		mo.Vel += impulse;
		mo.A_SetRoll(mo.roll + frandom(-28., 28.), SPF_INTERPOLATE);
		return true;
	}

	action void A_PB_KickClientsideEjecta(double radius = 88., double power = 7.)
	{
		PlayerPawn pl = PlayerPawn(self);
		if (!pl || !pl.player)
			return;

		Vector3 dir = PB_KickEjectaViewDir(pl.angle, pl.pitch);
		Vector2 fwdHoriz = AngleToVector(pl.angle);
		int budget = 52;
		bool any = false;

		ThinkerIterator it = ThinkerIterator.Create("Actor", STAT_PB_BULLETS);
		Actor mo;
		while (mo = Actor(it.Next()))
		{
			if (budget <= 0)
				break;
			if (!PB_IsKickableBulletStatEjecta(mo))
				continue;
			if (!PB_TryKickOneClientsideEjecta(pl, mo, dir, fwdHoriz, radius, power))
				continue;
			budget--;
			any = true;
		}

		it = ThinkerIterator.Create("PB_UnloadPropBase");
		while (mo = Actor(it.Next()))
		{
			if (budget <= 0)
				break;
			if (!PB_TryKickOneClientsideEjecta(pl, mo, dir, fwdHoriz, radius, power))
				continue;
			budget--;
			any = true;
		}

		if (any)
			A_StartSound("weapons/casing", CHAN_AUTO, CHANF_DEFAULT, 0.48, ATTN_IDLE);
	}

	action bool PB_executingEnemy(){
		return invoker.executingEnemy;
	}
	
	action void PB_SetExecutingEnemy(bool type){
		invoker.executingEnemy = type;
	}
	
	action void PB_SetPlayerExecutionProperties() {
		A_GiveInventory("ExecutionToken", 1);
		A_ClearOverlays(10,11);
		A_StopSound(CHAN_7);
		A_StopSound(CHAN_WEAPON);
		SetPlayerProperty(0, 1, PROP_INVULNERABILITY);
		SetPlayerProperty(0, 1, PROP_TOTALLYFROZEN );
		SetPlayerProperty(0, 1, PROP_FLY);
		invoker.executeLockStartTic = gametic;
		PB_SetUsingMelee(true);
		PB_SetExecutingEnemy(true);
	}
	
	
	action void PB_UnsetPlayerExecutionProperties() {
		// Also clear PROP_FROZEN (property 0) — Glory Kill wait uses it; experimental uses TOTALLYFROZEN.
		SetPlayerProperty(0, 0, 0);
		SetPlayerProperty(0, 0, PROP_INVULNERABILITY);
		SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN );
		SetPlayerProperty(0, 0, PROP_FLY);
		PB_SetExecutingEnemy(false);
		PB_SetUsingMelee(false);
		PB_SetExecutionBlueBlood(false);
		PB_SetExecutionGreenBlood(false);
		invoker.executeLockStartTic = 0;
		A_TakeInventory("KnifeHasHit",1);
		A_TakeInventory("HasCutingWeapon", 1);
		A_TakeInventory("ExecutionToken", 1);
		invoker.PB_ClearActiveGenericExecution();
	}

	void PB_ClearPendingExecution()
	{
		pendingExecutionTarget = null;
		pendingExecutionState = null;
		pendingExecutionGeneric = false;
		pendingExecutionDedicated = false;
		pendingExecutionTic = 0;
	}

	void PB_ClearActiveGenericExecution()
	{
		if (activeExecutionProxy)
			activeExecutionProxy.Destroy();
		activeExecutionTarget = null;
		activeExecutionProxy = null;
		activeExecutionAnchor = (0, 0, 0);
		activeExecutionDeadline = 0;
	}

	action State PB_ValidateGenericExecution()
	{
		if (!invoker.activeExecutionTarget
			|| invoker.activeExecutionTarget.health <= 0
			|| !invoker.activeExecutionProxy
			|| (invoker.activeExecutionDeadline > 0 && gametic >= invoker.activeExecutionDeadline))
		{
			invoker.PB_ClearActiveGenericExecution();
			return ResolveState("PB_FinisherCleanup");
		}
		return null;
	}

	action State PB_CommitPendingExecution()
	{
		Actor monster = invoker.pendingExecutionTarget;
		State next = invoker.pendingExecutionState;
		bool forceGeneric = invoker.pendingExecutionGeneric;
		bool dedicated = invoker.pendingExecutionDedicated;
		invoker.PB_ClearPendingExecution();

		if (!monster || monster.health <= 0 || !next)
		{
			PB_UnsetPlayerExecutionProperties();
			return null;
		}

		vector3 delta = (monster.pos.x - pos.x, monster.pos.y - pos.y, monster.pos.z - pos.z);
		double angleToMonster = AngleTo(monster);
		double pitchToMonster = VectorAngle(sqrt(delta.y * delta.y + delta.x * delta.x), delta.z);
		A_SetAngle(angleToMonster);
		A_SetPitch(-pitchToMonster);

		if (forceGeneric || !dedicated)
		{
			invoker.PB_ClearActiveGenericExecution();
			Actor proxy = Spawn("PB_GenericExecutionProxy", monster.pos, ALLOW_REPLACE);
			if (!proxy)
				return null;

			double visualHeight = max(1.0, monster.height * monster.scale.y);
			double sizeMul = clamp(48.0 / visualHeight, 0.65, 3.0);
			proxy.sprite = monster.sprite;
			proxy.frame = monster.frame;
			proxy.scale = (monster.scale.x * sizeMul, monster.scale.y * sizeMul);
			proxy.alpha = monster.alpha;
			proxy.translation = monster.translation;
			proxy.target = monster;
			proxy.master = self;
			proxy.tracer = invoker;
			proxy.special1 = gametic + 210;

			invoker.activeExecutionTarget = monster;
			invoker.activeExecutionProxy = proxy;
			invoker.activeExecutionAnchor = monster.pos;
			invoker.activeExecutionDeadline = gametic + 210;
			PB_PinExecutionTarget();
		}
		else
		{
			monster.A_Stop();
			double spd = max(48.0, radius + monster.radius + 8.0);
			monster.A_SetPitch(pitchToMonster, SPF_INTERPOLATE);
			monster.A_SetAngle(angleToMonster + 180, SPF_INTERPOLATE);
			vector3 neworigin = Vec3Offset(cos(angleToMonster) * spd, sin(angleToMonster) * spd, sin(pitchToMonster) * spd);
			monster.SetOrigin(neworigin, true);
			A_SetAngle(AngleTo(monster));
			delta = (monster.pos.x - pos.x, monster.pos.y - pos.y, monster.pos.z - pos.z);
			pitchToMonster = VectorAngle(sqrt(delta.y * delta.y + delta.x * delta.x), delta.z);
			A_SetPitch(-pitchToMonster);
		}

		PB_SetPlayerExecutionProperties();
		A_SetCrosshair(5);
		if (dedicated)
		{
			monster.GiveInventory("ExecutionToken", 1);
			monster.A_Die("Execution");
		}
		else
		{
			monster.TakeInventory("ExecutionToken", 0x7FFFFFFF);
		}
		PB_Achievements.OnExecution();
		return next;
	}

	// Non-action cleanup for weapon swap / interrupt paths (ExecutionToken lives on the player).
	void ClearOrphanedExecutionLock(PlayerPawn pp)
	{
		if (!pp || !pp.player)
			return;
		if (pp.CountInv("ExecutionToken") >= 1 || executingEnemy)
		{
			let ppb = PlayerPawnBase(pp);
			if (ppb)
				ppb.PB_ClearExecutionPlayerProperties();
			else
				pp.TakeInventory("ExecutionToken", 1);
		}
		executingEnemy = false;
		usingMelee = false;
		usingKick = false;
		usingEquipment = false;
		meleeReturnState = null;
		kickReturnState = null;
		meleeReturnWeapon = 'None';
		kickReturnWeapon = 'None';
		meatHookChordArm = 0;
		executeLockStartTic = 0;
		PB_ClearActiveGenericExecution();
	}

	action void PB_ClearOrphanedExecutionLockOnDeselect()
	{
		let pp = PlayerPawn(invoker.owner);
		if (pp)
			invoker.ClearOrphanedExecutionLock(pp);
	}
	
	
	action StateLabel PB_ExecuteZombieMan() {
		StateLabel result;
		int selector = (random(1, 6));
		FLineTraceData RemoteRay;
		bool wallcheck = LineTrace(
		   angle,
		   120,
		   pitch,
		   TRF_THRUACTORS,
		   offsetz: height-12,
		   data: RemoteRay
		);
		
		if((Pos.Z-floorz) > 8) {
			A_Warp(AAPTR_PLAYER_GETTARGET, 0, 0, 54, WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION);
			result = "Execution_Zombieman4";
			return result;
		}
		
		if(wallcheck && RemoteRay.HitType == TRACE_HitWall) {
			result = "Execution_Zombieman3";
			return result;
		}
		
		switch (selector) {
		case 1: result = "Execution_Zombieman1"; break;
		case 2: result = "Execution_Zombieman2"; break;
		case 3: result = "Execution_Zombieman5"; break;
		case 4: result = "Execution_Zombieman6"; break;
		case 5: result = "Execution_Zombieman_CrossImp1"; break;
		case 6: result = "Execution_Zombieman_CrossImp2"; break;
		default: result = "Execution_Zombieman1"; break;
		}
		return result;
	}
	
