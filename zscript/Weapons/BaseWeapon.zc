	action state PB_Execute() {
		if (PB_PlayerOnPossessionRide(self))
			return null;

		CVar experimental_settings = CVar.FindCVar('pb_experimental');
		if (!experimental_settings || !experimental_settings.GetBool())
			return null;

		Actor monster = GetPointer(AAPTR_PLAYER_GETTARGET);
		if (!monster || monster.health <= 0)
			return null;
		if (!PB_IsExperimentalExecutionTarget(monster))
			return null;
		if (!PB_ActorCanBeExecuted(monster, self))
			return null;

		LookExParams look;
		look.FOV = 110;
		if (!monster.IsVisible(self, false, look) || GetDistance(True, AAPTR_PLAYER_GETTARGET) >= 250)
			return null;

		StateLabel st = PB_ExecutionHandlerString(monster);
		State resolved = ResolveState(st);
		bool forceGeneric = st == "Execution_Generic";
		// Missing authored labels degrade to the shared living-target Generic strip.
		if (!resolved)
		{
			resolved = ResolveState("Execution_Generic");
			forceGeneric = true;
			if (!resolved)
			{
				return null;
			}
		}
		invoker.pendingExecutionTarget = monster;
		invoker.pendingExecutionState = resolved;
		invoker.pendingExecutionGeneric = forceGeneric;
		invoker.pendingExecutionDedicated = PB_HasExperimentalExecutionKit(monster) && !forceGeneric;
		invoker.pendingExecutionTic = gametic;
		return ResolveState("PB_ExecutionCommit");
	}

	// Single owner for every primary-fire finisher hook. Legacy helpers delegate here;
	// PlayerPawnBase.autoFinisherClaimTic makes repeated calls on one press idempotent.
	action State PB_DispatchAutoFireFinisher()
	{
		if (!JustPressed(BT_ATTACK))
			return resolveState(null);

		let po = invoker.Owner;
		if (po == null || !(po is "PlayerPawn"))
			return resolveState(null);
		let pp = PlayerPawn(po);
		if (!pp || !pp.player || invoker.CountInv("NoFatality") != 0)
			return resolveState(null);
		if (PB_PlayerOnPossessionRide(pp))
			return resolveState(null);
		if (PB_usingMelee() || PB_usingEquipment())
			return resolveState(null);
		if (pp.CountInv("GoFatality") >= 1 || pp.CountInv("ExecutionToken") >= 1 || invoker.executingEnemy)
			return resolveState(null);
		if (pp.CountInv("ShieldSawThrowAnim") >= 1 || pp.CountInv("CantFire") >= 1)
			return resolveState(null);

		let cvAuto = CVar.FindCVar("pb_auto_fatality_fire");
		if (!cvAuto || !cvAuto.GetBool())
			return resolveState(null);

		let ppb = PlayerPawnBase(pp);
		if (!ppb || ppb.autoFinisherClaimTic == gametic)
			return resolveState(null);
		ppb.autoFinisherClaimTic = gametic;

		double autoDist = 120.;
		let cvDist = CVar.FindCVar("pb_auto_fatality_dist");
		if (cvDist)
			autoDist = double(cvDist.GetInt());
		// Glory Kill punch range is hardcoded 150 in PermormGloryKill — don't enter GK when punch can't connect.
		double gkDist = autoDist;
		if (gkDist > 150.)
			gkDist = 150.;
		if (PB_ResolveFinisherMonster(gkDist) != null)
			return ResolveState("PermormGloryKill");

		let exp = CVar.FindCVar("pb_experimental");
		if (!exp || !exp.GetBool())
			return resolveState(null);
		State st = PB_Execute();
		if (st)
			return st;
		return resolveState(null);
	}

	// Compatibility entry for existing weapon Fire states.
	action State PB_TryAutoFatalityOnFire()
	{
		return PB_DispatchAutoFireFinisher();
	}

	// Dual-wield overlays cannot return a PSP_WEAPON state; apply Auto-Fire onto the
	// main weapon layer and clear hand overlays when a finisher is selected.
	action bool PB_TryApplyAutoFatalityOnWeapon()
	{
		State st = PB_DispatchAutoFireFinisher();
		if (!st)
			return false;
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		pl.SetPSprite(PSP_WEAPON, st);
		A_ClearOverlays(10, 11);
		return true;
	}
	
	// Shoutout to Matt on ZDoom forums for the helpful weapon functions.
	// Read input via invoker.owner.player — bare `player` is null from DECORATE + Inventory.Tick (UZDoom 4.14.x).
	PlayerInfo PB_WeaponActionPlayer()
	{
		if (!owner || !owner.player)
			return null;
		return owner.player;
	}

    action bool PressingFire()
	{
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		if (invoker.owner && (invoker.owner.CountInv("ShieldSawThrowAnim") >= 1
			|| invoker.owner.CountInv("CantFire") >= 1))
			return false;
		if (invoker.usingMelee)
			return false;
		return !!(pl.cmd.buttons & BT_ATTACK);
	}
    action bool PressingAltfire()
	{
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		if (invoker.owner && (invoker.owner.CountInv("ShieldSawThrowAnim") >= 1
			|| invoker.owner.CountInv("CantFire") >= 1))
			return false;
		if (invoker.usingMelee)
			return false;
		return !!(pl.cmd.buttons & BT_ALTATTACK);
	}
	action bool PressingReload()
	{
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		return !!(pl.cmd.buttons & BT_RELOAD);
	}
	action bool PressingUser1()
	{
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		return !!(pl.cmd.buttons & BT_USER1);
	}
	action bool PressingUser4()
	{
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		return !!(pl.cmd.buttons & BT_USER4);
	}

	action bool PB_FistSlamChordHeld()
	{
		let pl = invoker.owner ? invoker.owner.player : null;
		if (!pl)
			return false;
		return !!(pl.cmd.buttons & BT_ATTACK) && !!(pl.cmd.buttons & BT_ALTATTACK);
	}

	// FistSlam / ReadyFists: clear leaked PSP + player presentation after BloodBonk hits.
	action void PB_ResetFistWeaponPresentation()
	{
		A_ZoomFactor(1.0);
		A_SetRoll(0);
		A_WeaponOffset(0, 32);
		A_TakeInventory("PB_LockScreenTilt", 1);

		A_OverlayFlags(PSP_WEAPON, PSPF_RENDERSTYLE, true);
		A_OverlayRenderStyle(PSP_WEAPON, STYLE_Normal);
		A_OverlayAlpha(PSP_WEAPON, 1.0);
		A_OverlayFlags(PSP_WEAPON, PSPF_PLAYERTRANSLATED, false);

		A_OverlayFlags(1, PSPF_RENDERSTYLE, true);
		A_OverlayRenderStyle(1, STYLE_Normal);
		A_OverlayAlpha(1, 1.0);
		A_OverlayFlags(1, PSPF_PLAYERTRANSLATED, false);

		A_SetRenderStyle(1.0, STYLE_Normal);
		bBRIGHT = false;
		LightLevel = 0;

		if (!player)
			return;

		if (CountInv("PowerBloodOnVisor") >= 1)
			A_SetWeaponSprite("P1NG");
		else if (CountInv("PowerBlueBloodOnVisor") >= 1)
			A_SetWeaponSprite("P2NG");
		else if (CountInv("PowerGreenBloodOnVisor") >= 1)
			A_SetWeaponSprite("P3NG");
		else
			A_SetWeaponSprite("P0NG");
	}

	action bool PB_OwnsMeatHook()
	{
		return CountInv("PB_HookToken") >= 1
			|| CountInv("HookAmmo") >= 1
			|| CountInv("AlreadyHaveMeatHook") >= 1;
	}

	action bool PB_MeatHookChordHeld()
	{
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		return !!(pl.cmd.buttons & BT_USER2) && !!(pl.cmd.buttons & BT_USER4);
	}

	// Quick Melee + Kick chord → Meat Hook only. Edge = either button JustPressed while both held.
	action bool PB_TryMeatHookChord()
	{
		if (!PB_OwnsMeatHook() || !PB_MeatHookChordHeld())
			return false;
		if (!JustPressed(BT_USER2) && !JustPressed(BT_USER4))
			return false;
		if (PB_executingEnemy() || PB_usingEquipment()
			|| CheckInventory("Zoomed", 1) || CheckInventory("GoFatality", 1))
			return false;

		A_GiveInventory("PB_FireGrapplePulse", 1);
		invoker.meatHookChordArm = 0;

		if (PB_usingKick())
		{
			PB_SetUsingKick(false);
			invoker.PB_ConsumeMeleeReturnState(true);
			A_ClearOverlays(-999, -999);
			PB_RestoreWeaponMiniOverlays();
		}
		if (PB_usingMelee())
		{
			State restore = invoker.PB_ConsumeMeleeReturnState(false);
			PB_SetUsingMelee(false);
			A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
			if (invoker.owner && invoker.owner.player && restore)
				invoker.owner.player.SetPSprite(PSP_WEAPON, restore);
			else if (invoker.ResolveState("Ready3"))
				A_Overlay(PSP_WEAPON, "Ready3");
			else
				A_Overlay(PSP_WEAPON, "Ready");
		}
		return true;
	}
	
	action void PB_WeaponRecoilBasic(float pitchDelta, float angleDelta = 0)
	{
        A_SetPitch(self.pitch+(pitchDelta * pb_weapon_recoil_mod_vertical), SPF_INTERPOLATE);
        A_SetAngle(self.angle+(angleDelta * pb_weapon_recoil_mod_horizontal), SPF_INTERPOLATE);
	}
	
	action void PB_WeaponRecoil(float pitchDelta, float angleDelta, float powerMod = 0.5)
	{
        if (invoker.OwnerHasBerserk())
            PB_WeaponRecoilBasic(pitchDelta * powerMod, angleDelta * powerMod);
        else
            PB_WeaponRecoilBasic(pitchDelta, angleDelta);
	}
	
	Action State PB_SpawnCasing(String Missile,Double ShellX,Double ShellY,Double ShellZ,Double ShellV_X,Double ShellV_Y,Double ShellV_Z)
	{
		A_SpawnItemEX(Missile,cos(pitch)*ShellX,ShellY,((ShellZ)*players[consoleplayer].Crouchfactor)-(sin(pitch)*ShellX),ShellV_X,ShellV_Y,ShellV_Z,0,SXF_TRANSFERPITCH,0);
	Return Null;
	}
	
	bool OwnerHasBerserk()
	{
        return (owner.CountInv("PowerStrength") >= 1);
	}
	
	action void PB_WeaponRecoilSpecial(float pitchDelta, float angleDelta, float pitchDeltaBerserk, float angleDeltaBerserk)
	{
        if (invoker.OwnerHasBerserk())
            PB_WeaponRecoilBasic(pitchDeltaBerserk, angleDeltaBerserk);
        else
            PB_WeaponRecoilBasic(pitchDelta, angleDelta);
	}
	
    action bool JustPressed(int which)
    {
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
        return !!(pl.cmd.buttons & which) && !(pl.oldbuttons & which);
    }
    action bool JustReleased(int which)
    {
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
        return !(pl.cmd.buttons & which) && !!(pl.oldbuttons & which);
    }
	
    action bool IsPressingInput(int which)
	{
		let pl = invoker.PB_WeaponActionPlayer();
		if (!pl)
			return false;
		return !!(pl.cmd.buttons & which);
	}
	
	void PB_RefillMonsterSourcedWeaponWear(PlayerPawn p)
	{
		if (!p || !p.player)
			return;
		Name cn = GetClassName();
		if (cn == 'MastermindChaingun')
		{
			let inv = p.FindInventory("MastermindCGDurability");
			if (!inv || inv.Amount < 100)
				p.GiveInventory("MastermindCGDurability", 100);
		}
		else if (cn == 'MancubusFlameCannon')
		{
			let inv = p.FindInventory("MancubusFlameCannonDurability");
			if (!inv || inv.Amount < 60)
				p.GiveInventory("MancubusFlameCannonDurability", 60);
		}
		else if (cn == 'MarauderSSG')
		{
			let inv = p.FindInventory("MarauderSSGDurability");
			if (!inv || inv.Amount < 80)
				p.GiveInventory("MarauderSSGDurability", 80);
		}
		else if (cn == 'PB_ObsidianDragonSlayer')
		{
			let inv = p.FindInventory("ObsidianDragonSlayerDurability");
			if (!inv || inv.Amount < 40)
				p.GiveInventory("ObsidianDragonSlayerDurability", 40);
		}
	}

	override bool HandlePickup(Inventory item)
	{
		let pl = PlayerPawn(owner);
		if (pl && pl.player && item && item.GetClass() == GetClass())
			PB_RefillMonsterSourcedWeaponWear(pl);
		return Super.HandlePickup(item);
	}

	Default
	{
		PB_WeaponBase.UnloaderToken "HasUnloaded";
	}

	override void AttachToOwner(Actor Other)
	{
		let pp = PlayerPawn(Other);
		if (pp)
			ClearOrphanedExecutionLock(pp);
		PB_RefillMonsterSourcedWeaponWear(pp);
		Super.AttachToOwner(Other);
		let toucher = Other;
		bool IsAlreadyPicked = false;
		if (toucher.FindInventory("PB_PDAWeaponContainer",true))
		{
			PB_PDAWeaponContainer pdaweapContainer = PB_PDAWeaponContainer(toucher.FindInventory("PB_PDAWeaponContainer",true));
			pdaweapContainer.CollectedWeapons.Push(self.GetClassName());
			EventHandler.SendNetworkEvent("Foundweapon:"..self.GetClassName());
		}
		if (pp && level.maptime >= 35 && !bCHEATNOTWEAPON)
			PB_ArmorRockOn.TryPlay(Other);
	}
	
