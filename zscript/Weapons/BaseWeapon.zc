	action void A_SetFlashWeaponSprite(String str)
	{
		let psp = player.GetPSprite(PSP_FLASH);
		psp.sprite = GetSpriteIndex(str);
	}

	action void A_SetSpawnSprite(String str)
	{
	   sprite = GetSpriteIndex(str);
	}
	
	action void LedgeReach(float HeightDecrease)
	{
		let plr = PlayerPawnBase(self);
		plr.LedgeHeightMax = (plr.LedgeHeight - Height * HeightDecrease * 1.0f);
		A_Stop();
		SetOrigin((Pos.X, Pos.Y, plr.LedgeHeightMax), True);
	}
	
	// Respect / inspect / raise flourishes: NextState walk from label, stop before ready/deselect.
	// Do not use bare InStateSequence(WeaponRespect) — Goto Ready* tails poison that test.
	bool PB_VisualSelectChainContains(State cur, StateLabel label)
	{
		if (cur == null)
			return false;
		State s = FindState(label);
		if (s == null)
			return false;
		State stopReady = FindState('Ready');
		State stopReady2 = FindState('Ready2');
		State stopReady3 = FindState('Ready3');
		State stopDual = FindState('ReadyDualWield');
		State stopDeselect = FindState('Deselect');
		State stopSteady = FindState('Steady');
		for (int i = 0; i < 128 && s != null; i++)
		{
			if (s == cur)
				return true;
			State nx = s.NextState;
			if (nx == null)
				break;
			if (stopReady && nx == stopReady) break;
			if (stopReady2 && nx == stopReady2) break;
			if (stopReady3 && nx == stopReady3) break;
			if (stopDual && nx == stopDual) break;
			if (stopDeselect && nx == stopDeselect) break;
			if (stopSteady && nx == stopSteady) break;
			s = nx;
		}
		return false;
	}

	bool PB_IsInterruptibleVisualSelectState(State cur)
	{
		if (cur == null)
			return false;
		if (PB_VisualSelectChainContains(cur, 'WeaponRespect'))
			return true;
		if (PB_VisualSelectChainContains(cur, 'InspectUpgrade'))
			return true;
		if (PB_VisualSelectChainContains(cur, 'SelectAnimation'))
			return true;
		if (PB_VisualSelectChainContains(cur, 'SelectAnimationDualWield'))
			return true;
		return false;
	}

	// Engine DropWeapon mirror for blocked visual-select frames (always-on instant switch).
	play void PB_TryInterruptVisualSelectForPending(PlayerInfo pi)
	{
		if (!pi || !owner || pi.mo != owner)
			return;
		if (!pi.ReadyWeapon || pi.ReadyWeapon != self)
			return;
		if (pi.PendingWeapon == null || pi.PendingWeapon == WP_NOCHANGE)
			return;
		if (pi.PendingWeapon == pi.ReadyWeapon)
			return;

		Actor mo = owner;
		if (mo.CountInv("GoFatality") >= 1
			|| mo.CountInv("ExecutionToken") >= 1
			|| mo.CountInv("CameraRunner") >= 1
			|| mo.CountInv("DoGloryMelee") >= 1
			|| PB_PlayerOnPossessionRide(mo))
			return;
		if (executingEnemy || usingMelee || usingKick || usingEquipment)
			return;
		// Saw-in-flight alone must not trap raise/respect; only the throw/catch anim tokens block.
		if (mo.CountInv("ShieldSawThrowAnim") >= 1 || mo.CountInv("CantFire") >= 1)
			return;
		if (pi.cheats & CF_TOTALLYFROZEN)
			return;

		let psp = pi.GetPSprite(PSP_WEAPON);
		if (!psp || !psp.CurState)
			return;
		if (!PB_IsInterruptibleVisualSelectState(psp.CurState))
			return;

		// GetDownState only — Weapon.OnDeselect is post-4.14 and fatal on GZDoom/LZDoom/UZDoom 4.14.x.
		State down = GetDownState();
		if (down)
			pi.SetPsprite(PSP_WEAPON, down);
	}

	action state PB_RespectIfNeeded()
	{
		Actor own = invoker.owner;
		if (own && own.CountInv("PB_SkipWeaponSelectAnim") >= 1)
		{
			own.TakeInventory("PB_SkipWeaponSelectAnim", 1);
			return null;
		}
		CVar cvNoHelmet = CVar.FindCVar("pb_NoHelmetAnimation");
		bool helmetDisabled = cvNoHelmet && cvNoHelmet.GetInt() != 0;
		bool needIntroToken = own.CountInv("IntroductionSequence") == 0;
		bool shouldRespect = invoker.respectInventoryItem != "" && own.CountInv(invoker.respectInventoryItem) == 0;
		bool dontRespect = Cvar.FindCVar('pb_respectweapons').GetBool() == false && own.CountInv(invoker.respectInventoryItem) == 0;
		if (needIntroToken)
		{
			own.GiveInventory("IntroductionSequence", 1);
			if (!helmetDisabled)
				return invoker.resolveState("HelmetAnimation");
		}
		if (dontRespect)
		{
			own.GiveInventory(invoker.respectInventoryItem,1);
			if(!invoker.owner || !invoker.owner.player || !invoker.owner.player.ReadyWeapon)
				return invoker.A_Jump(256,"SelectAnimation");
			let rw = invoker.owner.player.ReadyWeapon;
			if(rw.GetClassName() == "PB_MG42") {
				own.SetInventory("MG42HeatLevel",0);
				return invoker.A_Jump(256,"SelectAnimation");
			}
			if(rw.GetClassName() == "PB_SuperGL"){
				A_SetCurrentGrenadeType("Impact");
				return invoker.A_Jump(256,"SelectAnimation");
				}
			if(rw.GetClassName() == "PB_RocketLauncher"){
				PB_SetCurrentRocketMode("Standard");
				return invoker.A_Jump(256,"SelectAnimation");
				}
			return invoker.A_Jump(256,"SelectAnimation");
		}
		if (shouldRespect)
		{
			own.GiveInventory(invoker.respectInventoryItem,1);
			return invoker.resolveState("WeaponRespect");
		}
		return invoker.A_Jump(256,"SelectAnimation");
	}

	// PB_IncrementHeat — BaseWeapon_StagingShim.zsc
	action void PB_AmmoIntoMag(name mag, name pool, int magMax, int per)
	{
		int n;
		for (n = 0; n < 512 && CountInv(mag) < magMax && CountInv(pool) >= per; n++)
		{
			A_TakeInventory(pool, per);
			A_GiveInventory(mag, per);
		}
	}
	action void PB_SpawnLooseRounds(class<Actor> cls, int count, double xoff = 8, double zoff = 20)
	{
		if (!cls || count < 1)
			return;
		if (!player || !player.mo)
			return;

		for (int i = 0; i < count; i++)
		{
			double ox = xoff + frandom(-3, 3);
			double oz = zoff + frandom(-3, 3);
			double vx = frandom(2.0, 7.0);
			double vy = frandom(-5.0, 5.0);
			double vz = frandom(1.0, 8.0);
			A_SpawnItemEx(cls, ox, 0, oz, vx, vy, vz, random(0, 359), SXF_ABSOLUTEMOMENTUM);
		}
	}
	action void PB_DumpMagToPool(name mag, name pool, int per, class<Actor> looseFx = null)
	{
		int n;
		for (n = 0; n < 512 && CountInv(mag) > 0; n++)
		{
			int before = CountInv(mag);
			A_TakeInventory(mag, per);
			int taken = before - CountInv(mag);
			if (taken < 1)
				break;
			A_GiveInventory(pool, taken);
			if (looseFx)
				PB_SpawnLooseRounds(looseFx, taken);
		}
	}
	// PB_CheckBarrel* + barrel carry states — BaseWeapon_Barrels.zsc
	action void PB_ReFire (StateLabel st = 'Fire')
	{
		A_Refire (st);
	}
	action void PB_FireBullets (name type, int amount, double angle, double offs, double height, double pitch)
	{
		Vector2 spread;
		for (int i = amount; i > 0; i--)
		{
			spread.x = frandom(-angle, angle);
			spread.y = frandom(-pitch, pitch);
			if (i == amount)
			{
				spread.x *= PB_HitFeedback_Math.LinearMap(pb_weapon_recoil_mod_horizontal, 0.0, 1.0, 1.0, 0.2);
				spread.y *= PB_HitFeedback_Math.LinearMap(pb_weapon_recoil_mod_vertical, 0.0, 1.0, 1.0, 0.2);
			}
			A_FireProjectile (type, spread.x, 0, offs, height, FPF_NOAUTOAIM, spread.y);
		}
	}
	action void PB_CheckAmmoFire() {}
	action void PB_UnloadMag(name mag, name pool, int per,
							 int goal = 0,
							 double xoff = 0, double zoff = 0,
							 class<Actor> spawnRound = null,
							 bool secondary = false)
	{
		if (CountInv(mag) < goal + per)
			return;
		A_TakeInventory(mag, per);
		A_GiveInventory(pool, per);
		if (spawnRound)
			PB_SpawnLooseRounds(spawnRound, per, xoff, zoff);
	}
	action void PB_FireOffset() {}
	action void PB_GunSmoke(double x, double y, double z)
	{
		let ow = invoker.owner;
		if (!ow || ow.CountInv("LowGraphicsMode") > 0)
			return;
		A_FireCustomMissile("GunFireSmoke", 0, 0, x, y, 0, 0);
	}
	action void PB_FireAltBFGRail()
	{
		PlayerPawn pp = PlayerPawn(invoker.owner);
		if (!pp || !pp.player)
			return;

		FLineTraceData t;
		double vz = pp.height * 0.5 - pp.floorclip + pp.AttackZOffset * pp.player.crouchFactor;
		bool hit = pp.LineTrace(pp.angle, 8000, pp.pitch, 0, vz, data: t);

		Vector3 startpos = (pp.pos.XY, pp.pos.Z + vz);
		Vector3 destpos = t.HitLocation;
		Vector3 toHit = Level.Vec3Diff(startpos, destpos);
		double toHitLen = toHit.length();
		Vector3 dirToHit = toHitLen > 0 ? toHit.unit() : (1, 0, 0);

		if (t.HitType == TRACE_HitWall && t.HitLine)
		{
			double na = atan2(t.HitLine.delta.Y, t.HitLine.delta.X) - 90.;
			if (t.LineSide == 1)
				na += 180.;
			Vector3 wallN = (cos(na), sin(na), 0);
			destpos -= wallN * 2;
		}
		else
			destpos -= dirToHit * 2;

		Vector3 dif = Level.Vec3Diff(startpos, destpos);
		Vector3 dir = dif.unit();
		double dis = dif.length();

		int q = int(dis / 30) + 1;

		Vector3 actpos = (pp.pos.XY, pp.pos.Z + vz);
		double alf = clamp(0.5 + sin(level.time * 15), 0.25, 1.0);
		for (int i = 1; i <= q; i++)
		{
			actpos += dir * 30;
			PB_DrawBFGrailparticle(actpos, alf, i, min(i, 20));
		}

		if (t.HitActor)
		{
			Actor v = t.HitActor;
			int dmg = 40 * random(1, 2);
			if (v && v.bIsMonster && v.health > 0 && !v.IsFriend(pp))
				v.DamageMobj(pp, pp, dmg, 'Desintegrate');
		}

		if (hit)
		{
			Actor p = Spawn("BFGBeamPuff", destpos);
			if (p)
				p.target = pp;
		}
	}

	action void PB_DrawBFGrailparticle(vector3 where, double alfa = 1.0, int it = 0, int spac = 30)
	{
		PlayerPawn pp = PlayerPawn(invoker.owner);
		if (!pp)
			return;

		FSpawnParticleParams bfgrail;
		int fm = random(1, 5);
		bfgrail.Texture = TexMan.CheckForTexture(String.Format("DLI%dG0R0", fm));
		bfgrail.Color1 = "FFFFFF";
		bfgrail.Style = STYLE_Add;
		bfgrail.Flags = SPF_ROLL | SPF_FULLBRIGHT | SPF_NOTIMEFREEZE;
		bfgrail.Vel = (0, 0, 0);
		bfgrail.Startroll = random(0, 360);
		bfgrail.RollVel = randompick(-15, 15, 30, -30);
		bfgrail.StartAlpha = 1.0;
		bfgrail.FadeStep = 0.1;
		bfgrail.Size = random(20, 32);
		bfgrail.SizeStep = -12;
		bfgrail.Lifetime = random(2, 3);
		bfgrail.Pos = where + (random(-spac, spac), random(-spac, spac), random(-spac, spac));
		Level.SpawnParticle(bfgrail);

		FSpawnParticleParams BFGFLAR;
		string flart = "LENGA0";
		switch (random(1, 4))
		{
		case 1:
			break;
		case 2:
			flart = "L2NGA0";
			break;
		case 3:
			flart = "DB59L0";
			break;
		case 4:
			flart = "SRKGN0";
			break;
		}
		BFGFLAR.Texture = TexMan.CheckForTexture(flart);
		BFGFLAR.Color1 = "FFFFFF";
		BFGFLAR.Style = STYLE_Add;
		BFGFLAR.Flags = SPF_ROLL | SPF_FULLBRIGHT | SPF_NOTIMEFREEZE;
		BFGFLAR.Vel = (0, 0, 0);
		BFGFLAR.Startroll = random(0, 360);
		BFGFLAR.RollVel = 0;
		BFGFLAR.StartAlpha = alfa;
		BFGFLAR.FadeStep = alfa > 0.1 ? 0.1 : 0.0;
		BFGFLAR.Size = random(25, 30);
		BFGFLAR.SizeStep = -5;
		BFGFLAR.Lifetime = 2;
		BFGFLAR.Pos = where;
		Level.SpawnParticle(BFGFLAR);

		FSpawnParticleParams ciclepx;
		ciclepx.Texture = TexMan.CheckForTexture("YAE6A0");
		ciclepx.Color1 = "FFFFFF";
		ciclepx.Style = STYLE_Add;
		ciclepx.Flags = SPF_ROLL | SPF_FULLBRIGHT;
		ciclepx.Vel = (0, 0, 0);
		ciclepx.Startroll = it * 2;
		ciclepx.RollVel = 0;
		ciclepx.StartAlpha = 0.90;
		ciclepx.FadeStep = 0.1;
		ciclepx.Size = 30;
		ciclepx.SizeStep = 0;
		ciclepx.Lifetime = 1;

		ciclepx.Pos = where;

		double ps = -it * spac;
		ps += (level.time * 20) % 360;

		Quat fr = Quat.FromAngles(pp.angle, pp.pitch, ps);

		Vector3 ofss = fr * (0, 0, spac);
		ciclepx.Pos += ofss;

		Level.SpawnParticle(ciclepx);
	}
	
	States
	{	
		FlashKicking:
		FlashAirKicking:
		FlashSlideKicking:
		FlashSlideKickingStop:
			TNT1 A 1;
			Stop;

		FlashPunching:
			TNT1 A 1;
			Stop;

		HelmetAnimation:
			TNT1 A 0
			{
				A_GiveInventory("sae_extcam", 1);
				A_GiveInventory("sae_deathcam", 1);
				A_SetCrosshair(5);
			}
			H3L6 H 1 A_SetBlend("00 00 00", 1, 35, "00 00 00", 0);
			TNT1 A 34 A_StartSound("IronSights",CHAN_AUTO);
			H3L1 ABCDE 1 A_SetRoll(roll+10, SPF_INTERPOLATE);
			TNT1 A 0 A_StartSound("RSUP1",CHAN_AUTO);
			H3L1 FGHIJK 1 A_SetRoll(roll+5, SPF_INTERPOLATE);
			H3L1 LMNOP 1 A_SetRoll(roll-3, SPF_INTERPOLATE);
			H3L1 QRSTUVWXYZ 1;
			H3L2 ABCD 1;
			H3L2 E 1 A_StartSound("IronSights",CHAN_AUTO);
			H3L2 FGHIJKLMNOPQRSTUVWXYZ 1 A_SetRoll(roll-3, SPF_INTERPOLATE);
			H3L3 ABCD 1;
			H3L3 E 1 A_StartSound("IronSights",CHAN_AUTO);
			H3L3 FGHIJ 1 A_SetRoll(roll-1.5, SPF_INTERPOLATE);
			H3L3 JKLMN 1 A_SetRoll(roll+1.5, SPF_INTERPOLATE);
			H3L3 OPQRS 1 A_SetRoll(roll+3, SPF_INTERPOLATE);
			H3L3 TUVWXYZ 1 A_SetRoll(roll+3, SPF_INTERPOLATE);
			H3L4 ABC 1 A_SetRoll(roll+3, SPF_INTERPOLATE);
			H3L4 DEFGH 1 A_SetRoll(roll+3.5, SPF_INTERPOLATE);
			H3L4 I 1
			{
				A_StartSound("helmet/swipe");
				A_SetRoll(roll+2.5, SPF_INTERPOLATE);
			}
			H3L4 JKLMNOP 1 A_SetRoll(roll+2.5, SPF_INTERPOLATE);
			H3L4 Q 1
			{
				A_StartSound("helmet/swipe");
				A_SetRoll(roll+2, SPF_INTERPOLATE);
			}
			H3L4 RSTUVWXYZ 1 A_SetRoll(roll+2, SPF_INTERPOLATE);
			H3L5 ABC 1 A_SetRoll(roll+3, SPF_INTERPOLATE);
			H3L5 DEF 1 A_SetRoll(roll+4, SPF_INTERPOLATE);
			H3L5 GH 1 A_SetRoll(roll+5, SPF_INTERPOLATE);
			H3L5 I 1
			{
				A_StartSound("RSUP2",CHAN_AUTO);
				A_SetRoll(roll+5, SPF_INTERPOLATE);
			}
			H3L5 JKL 1 A_SetRoll(roll+2.5, SPF_INTERPOLATE);
			H3L5 MNO 1 A_SetRoll(roll+1, SPF_INTERPOLATE);
			H3L5 P 1 A_StartSound("marine/superfist6",CHAN_AUTO);
			H3L5 QRS 1;
			H3L5 T 8;
			H3L5 UVXYZ 1;
			TNT1 A 0 A_SetBlend("00 00 00", 0, 8, "00 00 00", 1);
			H3L6 A 1
			{
				A_StartSound("HLMTPUT",CHAN_AUTO);
				A_SetRoll(roll+(frandom(-2,2)), SPF_INTERPOLATE);
			}
			H3L6 BCDEF 1 A_SetRoll(roll+(frandom(-2,2)), SPF_INTERPOLATE);
			H3L6 G 1
			{
				A_StartSound("HLMTBEP",CHAN_AUTO);
				A_SetRoll(roll+(frandom(-2,2)), SPF_INTERPOLATE);
			}
			H3L6 H 8 A_SetBlend("00 00 00", 1, 10, "51 92 99", 1);
			TNT1 A 1 A_StartSound("HLMTBPP",CHAN_AUTO);
			TNT1 A 20 A_SetBlend("51 92 99", 1, 20, "51 92 99", 0);
			TNT1 A 0
			{
				A_TakeInventory("sae_extcam", 1);
				A_TakeInventory("sae_deathcam", 1);
			}
			TNT1 A 0 A_Raise(9999);
			TNT1 A 0 A_Jump(256,"SelectAnimation");
			Goto Ready3;
		WeaponRespect:
		Ready3:
			TNT1 A 0 A_Jump(256, "SelectAnimation");
			Stop;	
		
		Flash:
			TNT1 A 1;
			Stop;
			
		StainedLedgeClimb:
			3L1M A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4);
			2L1M A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3);
			1L1M A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2);
		LedgeClimb:
			CL1M A 0;
			"####" A 0 A_OverlayFlags(1,PSPF_PLAYERTRANSLATED, false);
			"####" A 0 A_ClearOverlays(-5, 80);
			"####" A 0 A_Stop();
			"####" A 0 A_ZoomFactor(1.0);
			"####" A 0 A_GunFlash("LedgeGrabFlash");
			"####" A 0 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH);
			"####" A 0 SetPlayerProperty(0,1,PROP_TOTALLYFROZEN);
			"####" A 0 A_StartSound("ledgeclimb",5);
			"####" ABC 1 {
				let plr = PlayerPawnBase(self);
				
				if(Pos.Z < (plr.LedgeHeight - Height * 0.78f))
				{
					A_SetPitch(pitch-pitch/2, SPF_INTERPOLATE);
					Vel = Vel.Length() ? (0, 0, plr.velz) : (0, 0, 0);
				}
				else if(Pos.Z < (plr.LedgeHeight - Height * 0.76f))
				{
					LedgeReach(0.751);
					return ResolveState("LedgeReach");
				}
				return ResolveState(null);
			}
		LedgeReach:
			"####" A 0 A_OverlayFlags(1,PSPF_PLAYERTRANSLATED, false);
			"####" D 1 {
				let plr = PlayerPawnBase(self);
				if(Pos.Z >= (plr.LedgeHeight - Height * 0.78f))
				{
					A_SetPitch(pitch-pitch/2, SPF_INTERPOLATE);
					SetInventory("Grabbing_A_Ledge",1); // sv_unlimited_pickup: SetInventory avoids ledge-grab re-entry loop
					LedgeReach(0.751);
				}
				else if(Pos.Z < (plr.LedgeHeight - Height * 0.78f))
				{
					Vel = Vel.Length() ? (0, 0, plr.velz) : (0, 0, 0);
				}
			}
			"####" A 0 A_JumpIf(CountInv("Grabbing_A_Ledge")==1, 1);
			Goto LedgeReach;
			
			"####" E 1 {
				let plr = PlayerPawnBase(self);
				plr.velz = 3.6;
				A_SetPitch(0, SPF_INTERPOLATE);
				LedgeReach(0.751);
				A_StopSound(CHAN_WEAPON);
				plr.LedgeAngle = Angle;
				plr.LedgeCheck = False;
				plr.LedgeGrabbed = True;
			}
			"####" F 1 {
				A_SetPitch(pitch-0.5, SPF_INTERPOLATE);
				Vel = Vel.Length() ? (0, 0, 0.62) : (0, 0, 0);
			}
			"####" G 1 {
				let plr = PlayerPawnBase(self);
				A_SetPitch(pitch+3, SPF_INTERPOLATE);
				Vel = Vel.Length() ? (0, 0, plr.velz) : (0, 0, 0);
			}
			"####" HI 1 {
				let plr = PlayerPawnBase(self);
				A_SetPitch(pitch+4, SPF_INTERPOLATE);
				plr.velz += 0.5;
				
				Vel = Vel.Length() ? (0, 0, plr.velz) : (0, 0, 0);
			}
		FinishClimb:
			3L1M A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4);
			2L1M A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3);
			1L1M A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2);
			CL1M A 0;
			"####" A 0 A_OverlayFlags(1,PSPF_PLAYERTRANSLATED, false);
			"####" A 0 A_ClearOverlays(-5, 80);
			"####" A 0 A_GunFlash("LedgeGrabFlash");
			"####" JK 1 {
				let plr = PlayerPawnBase(self);
				plr.velz = 3.6;
				A_SetPitch(pitch-3, SPF_INTERPOLATE);
				Vel = Vel.Length() ? (0, 0, plr.velz) : (0, 0, 0);
			}
			"####" LM 1 A_SetPitch(pitch-2, SPF_INTERPOLATE);
			TNT1 AA 1 {
				A_SetPitch(pitch-pitch/2, SPF_INTERPOLATE);
				A_WeaponReady();
			}
			TNT1 A 0 A_SetPitch(0, SPF_INTERPOLATE);
			TNT1 A 0 SetPlayerProperty(0,0,PROP_TOTALLYFROZEN);
			TNT1 A 0 SetInventory("Grabbing_A_Ledge", 0);
			TNT1 A 0 A_Jump(256,"SelectAnimation");
			Goto Ready3;
				
		Equipment_Toggle_Handler_Overlay:
			TNT1 A 1 {
				if (CountInv("ToggleEquipment") == 1)
					return ResolveState("SwitchEquipment");
				return ResolveState(null);
			}
			Loop;

		Melee_Equipment_Handler_Overlay:
			TNT1 A 1 {
				// Runs every tic even when PSP_WEAPON is not on a Ready loop that calls A_DoPBWeaponAction.
				PB_HealOrphanedShieldSawThrowAnim();

				if (PB_usingMelee() || PB_ShieldSawThrowAnimBusy())
					PB_BlockWeaponFireInput();
				// Catch strip owns PSP_WEAPON until End — do not steal it.
				if (PB_ShieldSawThrowAnimBusy())
					return ResolveState(null);

				if (JustPressed(BT_USER1) && !PB_usingMelee() && !PB_usingKick() && !PB_executingEnemy() && !PB_usingEquipment()
					&& !CheckInventory("GoFatality", 1))
				{
					A_OverlayOffset(PSP_WEAPON, 0, 32);
					PB_SetUsingEquipment(true);
					A_Overlay(PSP_WEAPON, "UseEquipment");
					A_OverlayOffset(PSP_WEAPON, 0, 32);
				}

				if (PB_TryMeatHookChord())
				{ }
				else if (PB_OwnsMeatHook() && PB_MeatHookChordHeld())
				{
					invoker.meatHookChordArm = 0;
				}
				else if (PB_OwnsMeatHook()
					&& JustPressed(BT_USER2) && !PB_usingMelee() && !PB_usingKick() && !PB_executingEnemy() && !PB_usingEquipment()
					&& !CheckInventory("Zoomed", 1) && !CheckInventory("GoFatality", 1))
				{
					invoker.meatHookChordArm = 1;
				}
				else if (invoker.meatHookChordArm > 0)
				{
					if (PB_TryMeatHookChord())
					{ }
					else
					{
						invoker.meatHookChordArm--;
						if (invoker.meatHookChordArm <= 0
							&& !PB_MeatHookChordHeld()
							&& !PB_usingMelee() && !PB_usingKick() && !PB_executingEnemy() && !PB_usingEquipment()
							&& !CheckInventory("Zoomed", 1) && !CheckInventory("GoFatality", 1))
						{
							let pl = invoker.PB_WeaponActionPlayer();
							if (pl && (pl.cmd.buttons & BT_USER2))
							{
								A_OverlayOffset(PSP_WEAPON, 0, 32);
								invoker.PB_SaveMeleeReturnState(false);
								A_Overlay(PSP_WEAPON, "QuickMelee");
								A_OverlayOffset(PSP_WEAPON, 0, 32);
							}
						}
					}
				}
				else if (!PB_OwnsMeatHook()
					&& JustPressed(BT_USER2) && !PB_usingMelee() && !PB_usingKick() && !PB_executingEnemy() && !PB_usingEquipment()
					&& !CheckInventory("Zoomed", 1) && !CheckInventory("GoFatality", 1))
				{
					A_OverlayOffset(PSP_WEAPON, 0, 32);
					invoker.PB_SaveMeleeReturnState(false);
					A_Overlay(PSP_WEAPON, "QuickMelee");
					A_OverlayOffset(PSP_WEAPON, 0, 32);
				}
				return ResolveState(null);
			}
			Loop;

		KickHandler_Overlay:
			TNT1 A 1 {
				if (PB_ShieldSawThrowAnimBusy())
					return ResolveState(null);
				if (PB_TryMeatHookChord())
				{ }
				else if (PB_OwnsMeatHook() && PB_MeatHookChordHeld())
				{
					invoker.meatHookChordArm = 0;
				}
				else if (PB_OwnsMeatHook()
					&& JustPressed(BT_USER4) && !PB_usingKick() && !PB_executingEnemy()
					&& !CheckInventory("Zoomed", 1) && PB_MeleeAttackKickCheck()
					&& !CheckInventory("GoFatality", 1) && !PB_usingMelee())
				{
					invoker.meatHookChordArm = -1;
				}
				else if (invoker.meatHookChordArm < 0)
				{
					if (PB_TryMeatHookChord())
					{ }
					else
					{
						invoker.meatHookChordArm++;
						if (invoker.meatHookChordArm >= 0
							&& !PB_MeatHookChordHeld()
							&& !PB_usingKick() && !PB_executingEnemy()
							&& !CheckInventory("Zoomed", 1) && PB_MeleeAttackKickCheck()
							&& !CheckInventory("GoFatality", 1) && !PB_usingMelee())
						{
							let pl = invoker.PB_WeaponActionPlayer();
							if (pl && (pl.cmd.buttons & BT_USER4))
							{
								invoker.PB_SaveMeleeReturnState(true);
								PB_SetUsingKick(true);
								A_OverlayOffset(-999, 0, 32);
								A_Overlay(-999, "DoKick");
								A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, true);
							}
						}
					}
				}
				else if (!PB_OwnsMeatHook()
					&& JustPressed(BT_USER4) && !PB_usingKick() && !PB_executingEnemy()
					&& !CheckInventory("Zoomed", 1) && PB_MeleeAttackKickCheck()
					&& !CheckInventory("GoFatality", 1) && !PB_usingMelee())
				{
					invoker.PB_SaveMeleeReturnState(true);
					PB_SetUsingKick(true);
					A_OverlayOffset(-999, 0, 32);
					A_Overlay(-999, "DoKick");
					A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, true);
				}
				return ResolveState(null);
			}
			Loop;

		SelectFirstPersonLegs:
			TNT1 A 0 { return PB_PossessionRideGotoReady(); }
			TNT1 A 0 PB_ResetInterruptedFlashActions(true, true);
			TNT1 A 0 A_StopSound(1);
			TNT1 A 0 A_StopSound(5);
			TNT1 A 0 A_StopSound(6);
			TNT1 A 0 A_TakeInventory("Spin", 1);
			TNT1 A 0 A_TakeInventory("CantWeaponSpecial", 1);
			TNT1 A 0 A_TakeInventory("MG42Selected", 1);
			TNT1 A 0 A_SetInventory("Grabbing_A_Ledge", 0);
			TNT1 A 0 A_TakeInventory("RandomHeadExploder", 1);
			TNT1 A 0 A_TakeInventory("DualFireReload", 2);
			TNT1 A 0 A_Overlay(-777, "Melee_Equipment_Handler_Overlay");
			TNT1 A 0 A_Overlay(-778, "KickHandler_Overlay");
			TNT1 A 0 A_Overlay(-779, "Equipment_Toggle_Handler_Overlay");
			TNT1 A 0 A_Overlay(-10, "FirstPersonLegsStand");
			TNT1 A 0 A_JumpIfInventory("Hayulti", 1, "Hayulti");
			TNT1 A 0 A_JumpIfInventory("Hayberserk", 1, "Hayberserk");
			TNT1 A 0 A_Jump(255, "SelectContinue");
			Loop;

		// Brutal Doom Plus Hayulti / Hayberserk — shared for ZScript-only PB_WeaponBase weapons
		Hayulti:
			TNT1 A 0 { return PB_AbortHayultiOnPossessionRide(); }
			TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1);
			TNT1 A 0 SetPlayerProperty(0, 1, 0);
			TNT1 A 0 A_PlayerScream;
			JOJO A 1 A_Print("$PB_HAYULTI_FURY");
			JOJO BC 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO DE 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO FG 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO HI 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO PQ 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO RS 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO TU 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO PQ 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO RS 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO PQ 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO RS 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO TU 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO PQ 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO RS 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO TU 1;
			JOJO PQ 1;
			JOJO PQ 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO RS 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO TU 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO PQ 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO RS 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO PQ 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO RS 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO TU 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			JOJO TU 1;
			JOJO VW 1;
			JOJO XY 1;
			JOJO Z 1;
			JOJP AB 1;
			TNT1 A 0 A_GiveInventory("PowerStrength", 1);
			TNT1 A 0 A_ChangeFlag("INVULNERABLE", 0);
			TNT1 A 0 SetPlayerProperty(0, 0, 0);
			TNT1 A 0 SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
			TNT1 A 0 A_TakeInventory("Hayulti", 1);
			TNT1 A 0 PB_RestoreWeaponMiniOverlays();
			TNT1 A 0 A_Jump(256, "GoingToReady");
			TNT1 A 0 A_Jump(256, "SelectContinue");
			TNT1 A 0 A_Jump(256, "Ready3");
			Goto Ready3;

		Hayberserk:
			TNT1 A 0 { return PB_AbortHayberserkOnPossessionRide(); }
			TNT1 A 0 A_SelectWeapon("Melee_Attacks");
			TNT1 A 0 A_GiveInventory("PB_HayberserkInvuln", 1);
			TNT1 A 0 A_Jump(100, "HayberserkAlt");
			TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1);
			TNT1 A 0 SetPlayerProperty(0, 1, 0);
			TNT1 A 0 A_AlertMonsters;
			MIPA ABCEGI 1;
			MIPA JK 1;
			TNT1 A 0 A_Print("$PB_RIP_AND_TEAR_ANIM");
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			MIPA JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA JK 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA LM 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA NO 1;
			TNT1 A 0 A_Quake(2, 8, 0, 256);
			MIPA IGECBA 1;
			TNT1 A 0 A_ChangeFlag("INVULNERABLE", 0);
			TNT1 A 0 SetPlayerProperty(0, 0, 0);
			TNT1 A 0 SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
			TNT1 A 0 A_TakeInventory("Hayberserk", 1);
			TNT1 A 0 PB_RestoreWeaponMiniOverlays();
			TNT1 A 0 A_Jump(256, "GoingToReady");
			TNT1 A 0 A_Jump(256, "SelectContinue");
			TNT1 A 0 A_Jump(256, "Ready3");
			Goto Ready3;

		HayberserkAlt:
			TNT1 A 0 { return PB_AbortHayberserkOnPossessionRide(); }
			TNT1 A 0 A_SelectWeapon("Melee_Attacks");
			TNT1 A 0 A_GiveInventory("PB_HayberserkInvuln", 1);
			TNT1 A 0 A_ChangeFlag("INVULNERABLE", 1);
			TNT1 A 0 SetPlayerProperty(0, 1, 0);
			TNT1 A 0 A_Print("$PB_RIP_AND_TEAR_ANIM");
			TNT1 A 0 A_AlertMonsters;
			PONG RQP 1;
			PUNS CDEEF 1;
			TNT1 A 0 A_AlertMonsters;
			TNT1 A 0 A_PlaySound("KNUCKLED");
			PUNS G 1;
			PUNS G 1;
			PUNS G 1;
			PUNS G 2;
			PUNS FE 1;
			PUNS D 7;
			PUNS IJKKL 1;
			TNT1 A 0 A_PlaySound("KNUCKLED");
			PUNS M 1;
			TNT1 A 0 A_AlertMonsters;
			PUNS M 1;
			PUNS M 1;
			PUNS M 7;
			PUNS A 0;
			PUNS LKJ 1;
			PUNS I 2;
			PUNS BA 1;
			PONG PQR 1;
			TNT1 A 0 A_ChangeFlag("INVULNERABLE", 0);
			TNT1 A 0 SetPlayerProperty(0, 0, 0);
			TNT1 A 0 SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
			TNT1 A 0 A_TakeInventory("Hayberserk", 1);
			TNT1 A 0 PB_RestoreWeaponMiniOverlays();
			TNT1 A 0 A_Jump(256, "GoingToReady");
			TNT1 A 0 A_Jump(256, "SelectContinue");
			TNT1 A 0 A_Jump(256, "Ready3");
			Goto Ready3;

		FirstPersonLegsStand:
			TNT1 A 1;
			Loop;
		FirstPersonLegsKickRight:
			TNT1 A 1;
			Loop;

		Steady:
			Goto PB_FinisherCleanup;

		PB_FinisherCleanup:
			TNT1 A 1 {
				PB_SetUsingKick(false);
				PB_SetUsingMelee(false);
				PB_SetUsingEquipment(false);
			}
			TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "PB_FinisherCleanup");
			TNT1 A 0 PB_UnsetPlayerExecutionProperties();
			Goto GoingToReady;

		PB_ExecutionCommit:
			TNT1 A 0 { return PB_CommitPendingExecution(); }
			Goto GoingToReady2;

		GoingToReady2:
			TNT1 A 0 { return PB_PossessionRideGotoReady(); }
			TNT1 A 0 PB_ResetInterruptedFlashActions(true, true);
			TNT1 A 0 PB_RestoreWeaponMiniOverlays();
			TNT1 A 0 A_JumpIfInventory("Hayulti", 1, "Hayulti");
			TNT1 A 0 A_JumpIfInventory("Hayberserk", 1, "Hayberserk");
			TNT1 A 0 A_JumpIfInventory("GrabbedBarrel", 1, "IdleBarrel");
			TNT1 A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, "IdleFlameBarrel");
			TNT1 A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, "IdleIceBarrel");
			TNT1 A 0 {
				// Do not strip execute locks while 3rd-person GoFatality is active.
				if (CountInv("GoFatality") < 1)
				{
					PB_UnsetPlayerExecutionProperties();
				}
				A_TakeInventory("KeepLaserDeactivated", 1);
				A_TakeInventory("ToggleEquipment", 1);
			}
			TNT1 A 0 A_JumpIfInventory("SawSelected", 1, "OnLoop");
			TNT1 AAAA 0 A_Jump(256, "SelectAnimation");
			TNT1 AAAA 1 A_Jump(256, "Ready3");
			Loop;

		DoFatality:
			TNT1 A 0 A_TakeInventory("Fear", 1);
			TNT1 A 0 {
				if (GetCVar("be_Protection") == 1)
					A_GiveInventory("Superarmor", 1);
			}
			Goto GloryKillPunchWait;

		GloryKillPunchWait:
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			TNT1 A 1 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			Goto PB_FinisherCleanup;

		DoingFatality:
			TNT1 A 1 SetPlayerProperty(0, 1, 0);
			TNT1 A 0 {
				if (GetCVar("be_Protection") == 1)
					A_GiveInventory("Superarmor", 1);
			}
			TNT1 A 0 {
				PB_SetUsingMelee(false);
			}
			TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "DoingFatality");
			Goto PB_FinisherCleanup;

		PermormGloryKill:
			TNT1 A 0 {
				PB_SetUsingMelee(true);
				PB_Achievements.OnGloryKill();
				A_PlaySound("GloryKill", CHAN_UI);
				if (GetCVar("be_Protection") == 1)
					A_GiveInventory("Superarmor", 1);
				if (GetCVar("be_Fear") == 1)
					A_GiveInventory("Fear", 1);
			}
			TNT1 A 0 {
				PB_SetUsingMelee(false);
			}
			TNT1 A 0 A_CustomPunch(10000, 1, 0, "GloryKillPuff", 150, 0, 0);
			TNT1 A 0;
			Goto DoFatality;

		QuickMelee:
			TNT1 A 0 {
				PB_SetUsingMelee(true);
				if (PB_GloryKillOpportunityReady())
					return ResolveState("PermormGloryKill");
				return ResolveState(null);
			}
			TNT1 A 0 {
				if (CountInv("BPToken") == 5 && ResolveState("BloodPunch"))
				{
					PB_Achievements.OnBloodPunch();
					A_TakeInventory("Zoomed", 1);
					A_ZoomFactor(1.0);
					A_TakeInventory("ADSmode", 1);
					A_TakeInventory("BloodPunchKilled", 1);
					return ResolveState("BloodPunch");
				}
				return ResolveState(null);
			}
			TNT1 A 0 A_ClearOverlays(3, 65);
			TNT1 A 0 A_GunFlash("Null");
			TNT1 A 1 {
				State st = PB_Execute();
				if (st)
					return st;
				return ResolveState(null);
			}
			TNT1 A 0 A_JumpIfInventory("ShieldSawThrown", 1, "QuickMeleePunchSetup");
			TNT1 A 0 {
				if (PB_QuickMeleeAimWithinPunchRange())
					return ResolveState("QuickMeleePunchSetup");
				return ResolveState(null);
			}
			TNT1 A 0 A_JumpIfCloser(128, "QuickMeleePunchSetup");
			TNT1 A 0 {
				State st = PB_ResolveQuickMeleeShieldThrow();
				if (st)
					return st;
				return ResolveState(null);
			}
			TNT1 A 0 A_JumpIfInventory("ShieldSawThrown", 1, "QuickMeleePunchSetup");
			TNT1 A 0 {
				if (PB_QuickMeleeAimWithinPunchRange())
					return ResolveState("QuickMeleePunchSetup");
				return ResolveState(null);
			}
			TNT1 A 0 A_JumpIfCloser(128, "QuickMeleePunchSetup");
		QuickMeleePunchSetup:
			TNT1 A 0 A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
			TNT1 A 0 { return PB_PickRandomQuickMeleeOrReturn(); }

		ThrowShieldSaw:
			TNT1 A 1 {
				State st = PB_Execute();
				if (st)
					return st;
				return ResolveState(null);
			}
			TNT1 A 0 {
				if (PB_QuickMeleeAimWithinPunchRange())
					return ResolveState("QuickMeleePunchSetup");
				return ResolveState(null);
			}
			TNT1 A 0 A_JumpIfCloser(128, "QuickMeleePunchSetup");
			TNT1 A 0 {
				if (CountInv("ShieldSawReady") < 1 || CountInv("ShieldSawThrown") >= 1)
					return ResolveState("QuickMeleePunchSetup");
				return ResolveState(null);
			}
			TNT1 A 0 {
				PB_UnsetPlayerExecutionProperties();
				SetPlayerProperty(0, 0, 0);
				SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
			}
			TNT1 A 0 A_JumpIfInventory("PlayerIsDead", 1, "FailOverlay");
			TNT1 A 0 A_JumpIfHealthLower(0, "FailOverlay");
			// Instant throw. FPS SHIE strip disabled.
			TNT1 A 0 {
				A_WeaponOffset(0, 32);
				A_SetRoll(0);
				PB_CommitShieldSawThrow();
			}
			Goto ReturnFromShieldSawAnim;

		ReturnFromShieldSawAnim:
			TNT1 A 0 {
				let st = PB_ReturnFromShieldSawToReady();
				if (st)
					return st;
				return ResolveState(null);
			}
			Stop;

		// Catch FPS strip kept for restore; CatchPending no longer granted (see ShieldSawNotify.zc).
		ShieldSawCatchAnim:
			TNT1 A 0 {
				A_WeaponOffset(0, 32);
				A_SetRoll(0);
				A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
				A_ClearOverlays(1006, 1006, false);
				PB_StartShieldSawThrowAnim();
				A_GiveInventory("HasCutingWeapon", 1);
			}
			SHIE K 2 A_WeaponOffset(160, 118);
			SHIE J 2 A_WeaponOffset(140, 96);
			SHIE K 1 A_WeaponOffset(100, 74);
			SHIE J 1 A_WeaponOffset(70, 74);
			SHIE K 1 A_WeaponOffset(50, 74);
			SHIE J 1 A_WeaponOffset(20, 74);
			SHIE I 0 {
				A_WeaponOffset(0, 32);
				A_StartSound("ShieldSawBack", 5, CHANF_DEFAULT, 1.0, 1.5);
			}
			TNT1 A 0 {
				A_TakeInventory("HasCutingWeapon", 1);
				PB_EndShieldSawThrowAnim();
				A_ClearOverlays(1006, 1006, false);
				A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
			}
			TNT1 A 0 PB_RestoreWeaponMiniOverlays();
			Goto ReturnFromShieldSawAnim;

		DoKick:
			TNT1 A 0 {
				A_Overlay(-10, "FirstPersonLegsKickRight");
				A_TakeInventory("Zoomed", 1);
				A_TakeInventory("ADSmode", 1);
				A_ZoomFactor(1.0);
				A_GiveInventory("Kicking", 1);
			}
			TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady");
			NULL A 0 A_JumpIfInventory("CanSlideKick", 1, "SlideKick");
			NULL A 0 A_JumpIf(vel.Z != 0, "AirKick");
			TNT1 A 0 A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, true);
			KIC1 A 1 {
				A_PlaySoundEx("KICK", "Auto");
				SetPlayerProperty(0, 1, 0);
				// Staging: FlashBarrel* while holding; else FlashKicking (mid-fire blank).
				PB_KickOverlayWeaponFlash(0);
				A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
				A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
				A_SetRoll(roll - 2);
				A_ZoomFactor(0.98);
			}
			KIC1 B 1 {
				A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
				A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
				A_SetRoll(roll - 2);
				A_ZoomFactor(0.970);
			}
			KIC1 C 1 {
				A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
				A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
				A_SetRoll(roll - 2);
				A_ZoomFactor(0.965);
			}
			KIC1 D 1 {
				A_SetPitch(+1.25 + pitch, SPF_INTERPOLATE);
				A_ZoomFactor(0.950);
			}
			KIC1 E 1 A_Recoil(-1);
			KIC1 F 1 {
				A_PB_KickClientsideEjecta();
				if (CountInv("PowerStrength") == 1)
					A_FireCustomMissile("SuperKickAttack", 0, 0, 0, -7);
				else
					A_FireCustomMissile("KickAttack", 0, 0, 0, -7);
			}
			KIC1 GG 1;
			KIC1 I 1 {
				A_ZoomFactor(0.965);
				A_SetAngle(+1 + angle, SPF_INTERPOLATE);
				A_TakeInventory("Kicking", 1);
			}
			KIC1 H 1 {
				A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
				A_SetAngle(+1 + angle, SPF_INTERPOLATE);
				A_SetRoll(roll + 2);
				A_ZoomFactor(0.970);
			}
			KIC1 J 1 {
				A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
				A_SetRoll(roll + 2);
				A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
				A_ZoomFactor(0.98);
			}
			KIC1 K 1 {
				A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
				A_SetRoll(roll + 2);
				A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
				A_ZoomFactor(0.99);
			}
			KIC1 L 1 {
				A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
				A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
				A_ZoomFactor(1.0);
			}
			KIC1 A 1 {
				A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
				A_SetPitch(-1.25 + pitch, SPF_INTERPOLATE);
				SetPlayerProperty(0, 0, 0);
				SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
				PB_SetUsingKick(false);
			}
			TNT1 A 0 {
				A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, false);
				A_Overlay(-10, "FirstPersonLegsStand");
			}
			TNT1 A 0 PB_KickRestoreWeaponLayer();
			Stop;

		SlideKick:
			TNT1 A 0 {
				A_GiveInventory("KeepLaserDeactivated", 1);
				A_GiveInventory("IsSlideKicking", 1);
				PB_KickOverlayWeaponFlash(2);
				A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, true);
			}
			SLDK A 1 A_ZoomFactor(0.90);
			SLDK B 1 A_ZoomFactor(0.85);
			SLDK C 1 A_ZoomFactor(0.80);
			SLDK D 1 A_ZoomFactor(0.75);
			SLDK EF 1;
			NULL A 0 A_JumpIf(Height > 54, "LowerKick");
			TNT1 A 0 A_JumpIfInventory("KickHasHitAnObject", 1, "LowerKick");
			SLDK GHIJKLMNMLKJ 1 {
				if (CountInv("PowerStrength") == 1)
					A_FireCustomMissile("SuperKickAttack", 0, 0, 0, -31);
				else
					A_FireCustomMissile("KickAttack", 0, 0, 0, -31);
				if (CountInv("KickHasHitAnObject") == 1) return ResolveState("LowerKick");
				if (Height > 50) return ResolveState("LowerKick");
				return ResolveState(null);
			}
		LowerKick:
			TNT1 A 0 {
				PB_KickOverlayWeaponFlash(3);
				A_ZoomFactor(1.0);
				A_PlaySoundEx("SlideKick/End", "Auto");
				A_TakeInventory("Kicking", 1);
				A_TakeInventory("KickHasHitAnObject", 1);
				A_TakeInventory("IsSlideKicking", 1);
				A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, true);
			}
			SLDK OPQRSTU 1;
			TNT1 A 0 {
				A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, false);
				A_Overlay(-10, "FirstPersonLegsStand");
				PB_SetUsingKick(false);
			}
			TNT1 A 0 PB_KickRestoreWeaponLayer();
			Stop;

		AirKick:
			TNT1 A 0 {
				A_PlaySound("KICK", 6);
				A_PB_AirMeleeLunge(20);
				A_Recoil(-6);
				PB_KickOverlayWeaponFlash(1);
				A_ZoomFactor(0.95);
				A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, true);
			}
			AKCK A 1 A_SetRoll(roll - 2, SPF_INTERPOLATE);
			AKCK B 1 A_SetRoll(roll - 2, SPF_INTERPOLATE);
			AKCK C 1 A_SetRoll(roll - 2, SPF_INTERPOLATE);
			AKCK DEFGH 1;
			RIFF A 0 {
				if (CountInv("PowerStrength") == 1)
					A_FireCustomMissile("SuperAirKickAttack", 0, 0, 0, -31);
				else
					A_FireCustomMissile("AirKickAttack", 0, 0, 0, -31);
			}
			TNT1 A 0 A_ZoomFactor(0.975);
			AKCK IJK 1;
			TNT1 A 0 A_ZoomFactor(0.995);
			TNT1 A 0 A_TakeInventory("Kicking", 1);
			AKCK LM 1;
			AKCK N 1 A_SetRoll(roll + 2, SPF_INTERPOLATE);
			AKCK O 1 A_SetRoll(roll + 2, SPF_INTERPOLATE);
			TNT1 A 1 A_SetRoll(roll + 2, SPF_INTERPOLATE);
			TNT1 A 0 {
				A_ZoomFactor(1.0);
				A_OverlayFlags(-999, PSPF_PLAYERTRANSLATED, false);
				PB_SetUsingKick(false);
				A_Overlay(-10, "FirstPersonLegsStand");
			}
			TNT1 A 0 PB_KickRestoreWeaponLayer();
			Stop;

		Flash:
			TNT1 A 1;
			Stop;

		FailOverlay:
			TNT1 A 0 PB_ResetInterruptedFlashActions(false, true);
			TNT1 A 0 A_JumpIf(Health <= 0, "StopFail");
			Goto Ready3;
		StopFail:
			TNT1 A 0;
			TNT1 A 1;
			Stop;

	}
}

extend class PB_WeaponBase
{
	action void PB_FireShieldSawThrown()
	{
		// GK / PBWP: forward spawn 7, height -2 (do not use large negative Z — drops the disc below aim).
		A_FireProjectile("ShieldSawProjectile", frandom(1.5, -1.5), 0, 7, -2, 0, frandom(1.5, -1.5));
	}

	action void A_PB_AchShoulderFlame()
	{
		PB_Achievements.OnShoulderFlame();
	}

	action void A_PB_AchShoulderIce()
	{
		PB_Achievements.OnShoulderIce();
	}
}

class PB_UpgradeItem : CustomInventory
{
	action void A_SetSpawnSprite(String str)
	{
	   sprite = GetSpriteIndex(str);
	}
}

class PB_WeaponAmmo : Ammo
{
	Default
	{
		Inventory.Amount 0;
		Ammo.BackpackAmount 0;
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
		+INVENTORY.IGNORESKILL
	}
	override class<Ammo> GetParentAmmo()
	{
		class<Object> type = GetClass();
		while (type.GetParentClass() != "PB_WeaponAmmo" && type.GetParentClass() != null)
			type = type.GetParentClass();
		return (class<Ammo>)(type);
	}
}
