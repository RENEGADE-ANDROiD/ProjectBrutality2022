class PB_GenericExecutionProxy : Actor
{
	override void Tick()
	{
		Super.Tick();
		if (!master || !target || target.health <= 0 || gametic >= special1)
			Destroy();
	}

	Default
	{
		Radius 1;
		Height 1;
		+NOINTERACTION
		+NOBLOCKMAP
		+NOGRAVITY
		+FORCEXYBILLBOARD
	}

	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}
}

