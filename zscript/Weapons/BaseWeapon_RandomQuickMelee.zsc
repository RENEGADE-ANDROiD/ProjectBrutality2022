// Random Quick Melee pool — fist CustomMelee ports + gated blade strips
// from ArgentSith / BeamKatana / VorpalBlade primary attack states.
// Always: Backhand + Uppercut.
// ArgentMelee if PB_ArgentSith; BeamMelee if PB_BeamKatana;
// VorpalMelee if VorpalBlade; Saw if PB_Chainsaw.

extend class PB_WeaponBase
{
	action void PB_QM_BeginAttack()
	{
		PB_SetUsingMelee(true);
		A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
		A_PB_AirMeleeLunge(10);
		A_TakeInventory("Zoomed", 1);
		A_ZoomFactor(1.0);
		A_TakeInventory("ADSmode", 1);
		A_SetRoll(0);
		A_WeaponOffset(0, 32);
		A_Overlay(-10, "FirstPersonLegsStand");
	}

	action void PB_QM_EndAttack()
	{
		A_TakeInventory("HasCutingWeapon", 1);
		A_TakeInventory("HasIncendiaryWeapon", 1);
		A_TakeInventory("PB_LockScreenTilt", 1);
		A_SetRoll(0);
		A_WeaponOffset(0, 32);
		PB_SetUsingMelee(false);
		A_ClearOverlays(PSP_FLASH, PSP_FLASH, false);
	}

	// Extra shove so Kick deaths slide into walls (Death.Kick + SLIDESONWALLS).
	action void PB_QM_ThrustVictim(double force = 32, double zforce = 14)
	{
		if (!player)
			return;
		FLineTraceData lt;
		LineTrace(angle, 200, pitch, 0, player.viewheight, data: lt);
		Actor v = lt.hitActor;
		int aimCheck = -6;
		while (aimCheck++ < 6 && (!v || !v.bSHOOTABLE))
		{
			LineTrace(angle + (aimCheck * 8), 200, pitch, 0, player.viewheight, data: lt);
			v = lt.hitActor;
		}
		if (!v || !v.bSHOOTABLE)
			return;
		Vector3 dir = BDPMeleeVecFromAngles(angle, pitch, 1);
		v.vel += dir * force;
		v.vel.z += zforce;
	}

	// Sweep attack (lifesteal sword swing) — lifted from VorpalBlade for Quick Melee.
	action void hxa_CustomRollAttack(int damage = 0, double healfactor = 1, bool PierceEnemies = false,
		double roll = 0, int area = 90, int dist = 1024,
		name PuffActor = "null", sound HitActorSound = "null", sound HitWallSound = "null")
	{
		if (!player) return;

		bool PlaySoundEnemy = false;
		bool PlaySoundWall = false;
		Array<Actor> Targets;
		for (int i = 0; i < area; i++)
		{
			double horAng = angle - area*cos(roll)/2;
			double pit = pitch - area*sin(roll)/2;
			int hdif = 10;
			LineAttack(horAng+(i*cos(roll)), dist, pit+(i*sin(roll)), 0, 'Melee', PuffActor, true, offsetz: height-hdif);
			FLineTraceData h;
			LineTrace(horAng+(i*cos(roll)), dist, pit+(i*sin(roll)), offsetz: height-hdif, data:h);
			if (h.hitActor != null && h.hitActor.bSHOOTABLE)
			{
				PlaySoundEnemy = true;
				h.hitActor.DamageMobj(self, self, damage, 'damagetype', DMG_THRUSTLESS);
				A_DamageSelf(-damage * healfactor);
				if (PierceEnemies)
				{
					h.hitActor.bSHOOTABLE = false;
					Targets.Push(h.hitActor);
				}
			}
			else if ((h.HitType == TRACE_HitWall || h.HitType == TRACE_HitCeiling || h.HitType == TRACE_HitFloor) &&
				(pitch > 20 || pit+(i*sin(roll)) < 10))
			{
				PlaySoundWall = true;
			}
		}
		if (PlaySoundEnemy) A_StartSound(HitActorSound, pitch:frandom(.9,1.1));
		if (PlaySoundWall)  A_StartSound(HitWallSound, pitch:frandom(.9,1.1));
		for (int z = 0; z < Targets.Size(); z++)
			Targets[z].bSHOOTABLE = true;
	}

	// Pool codes: 0 Backhand, 1 Uppercut, 2 ArgentMelee, 3 BeamMelee, 4 VorpalMelee, 5 Saw
	action state PB_PickRandomQuickMelee()
	{
		Array<int> pool;
		pool.Push(0);
		pool.Push(1);
		if (CountInv("PB_ArgentSith") > 0)
			pool.Push(2);
		if (CountInv("PB_BeamKatana") > 0)
			pool.Push(3);
		if (CountInv("VorpalBlade") > 0)
			pool.Push(4);
		if (CountInv("PB_Chainsaw") > 0)
			pool.Push(5);

		int pick = pool[random(0, pool.Size() - 1)];
		if (pick == 0)
			return ResolveState("RandomMelee_Backhand");
		if (pick == 1)
			return ResolveState("RandomMelee_Uppercut");
		if (pick == 2)
			return ResolveState("RandomMelee_ArgentMelee");
		if (pick == 3)
			return ResolveState("RandomMelee_BeamMelee");
		if (pick == 4)
			return ResolveState("RandomMelee_VorpalMelee");
		return ResolveState("RandomMelee_Saw");
	}

	States
	{
	// ArgentSith Fire (primary hand) + FinishCuttingAnimation — no hand-switch / barrel / fatality.
	RandomMelee_ArgentMelee:
		TNT1 A 0 PB_QM_BeginAttack();
		BVAT A 1 BRIGHT;
		BVAT C 1 BRIGHT;
		BVAT D 1 BRIGHT A_StartSound("ArgKatana/Swing", CHAN_WEAPON);
		BVAT A 0 A_JumpIfInventory("PowerStrength", 1, "RandomMelee_ArgentMeleeBerserk");
		BVAT E 0 A_CustomPunch(5, true, CPF_STEALARMOR, "ArgSithSawPuff", 140, 1, 150, "ArmorShard", "ArgKatana/Hit", "ArgKatana/Swing");
		BVAT E 1 BRIGHT A_CustomPunch(40, true, 0, "ArgSithSawPuff", 180, 0, 0, "none", "ArgKatana/Hit", "ArgKatana/Swing");
		Goto RandomMelee_ArgentMeleeFinish;

	RandomMelee_ArgentMeleeBerserk:
		BVAT E 0 A_StartSound("ArgKatana/Swing", CHAN_WEAPON);
		BVAT E 0 A_CustomPunch(5, true, CPF_STEALARMOR, "ArgSithSawPuff", 140, 1, 250, "ArmorShard", "ArgKatana/Hit", "ArgKatana/Swing");
		BVAT E 1 BRIGHT A_CustomPunch(110, true, 0, "ArgSithSawPuff", 180, 0, 0, "none", "ArgKatana/Hit", "ArgKatana/Swing");
		Goto RandomMelee_ArgentMeleeFinish;

	RandomMelee_ArgentMeleeFinish:
		BVAT G 1 BRIGHT;
		BVAT H 1 BRIGHT;
		BVAT I 1 BRIGHT;
		BVAT J 1 BRIGHT;
		BVAT Q 1 BRIGHT;
		BVAT P 1 BRIGHT;
		BVAT O 1 BRIGHT;
		BVAT N 1 BRIGHT;
		BVAT M 1 BRIGHT;
		BVAT L 1 BRIGHT;
		TNT1 A 0 {
			PB_QM_EndAttack();
			State barrel = PB_CheckBarrelIdle1();
			if (barrel)
				return barrel;
			return PB_ReturnFromQuickMelee();
		}
		Goto Ready3;

	// BeamKatana Fire (primary hand) + FinishCuttingAnimation.
	RandomMelee_BeamMelee:
		TNT1 A 0 PB_QM_BeginAttack();
		BKAT A 1 Bright;
		BKAT C 1 Bright;
		BKAT D 1 Bright A_StartSound("CybKatana/Swing", CHAN_WEAPON);
		BKAT A 0 A_JumpIfInventory("PowerStrength", 1, "RandomMelee_BeamMeleeBerserk");
		BKAT E 0 A_CustomPunch(5, true, CPF_STEALARMOR, "BeamKatanaSSawPuff4", 140, 1, 150, "ArmorShard", "CybKatana/Hit", "CybKatana/Swing");
		BKAT E 1 Bright A_CustomPunch(70, true, 0, "BeamKatanaSSawPuff4", 180, 0, 0, "none", "CybKatana/Hit", "CybKatana/Swing");
		Goto RandomMelee_BeamMeleeFinish;

	RandomMelee_BeamMeleeBerserk:
		BKAT E 0 A_StartSound("CybKatana/Swing", CHAN_WEAPON);
		BKAT E 0 A_CustomPunch(5, true, CPF_STEALARMOR, "BeamKatanaSSawPuff4", 140, 1, 250, "ArmorShard", "CybKatana/Hit", "CybKatana/Swing");
		BKAT E 1 Bright A_CustomPunch(110, true, 0, "BeamKatanaSSawPuff4", 180, 0, 0, "none", "CybKatana/Hit", "CybKatana/Swing");
		Goto RandomMelee_BeamMeleeFinish;

	RandomMelee_BeamMeleeFinish:
		BKAT G 1 Bright;
		BKAT H 1 Bright;
		BKAT I 1 Bright;
		BKAT J 1 Bright;
		BKAT Q 1 Bright;
		BKAT P 1 Bright;
		BKAT O 1 Bright;
		BKAT N 1 Bright;
		BKAT M 1 Bright;
		BKAT L 1 Bright;
		TNT1 A 0 {
			PB_QM_EndAttack();
			State barrel = PB_CheckBarrelIdle1();
			if (barrel)
				return barrel;
			return PB_ReturnFromQuickMelee();
		}
		Goto Ready3;

	// VorpalBlade SwingRighty — no A_Refire / PreReady / PB_Execute.
	RandomMelee_VorpalMelee:
		TNT1 A 0 PB_QM_BeginAttack();
		VORR A 0 Offset(15, 32);
		VORR A 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE);
		TNT1 A 0 A_PlaySound("Sword/Swing", CHAN_WEAPON, 1.0, 0, 2);
		TNT1 A 0 hxa_CustomRollAttack(damage: 2, healfactor: 0.5, PierceEnemies: false,
			roll: 45, area: 45, dist: 48,
			PuffActor: "KyreiPuffRight",
			HitActorSound: "Sword/HitMeat",
			HitWallSound: "Sword/HitWall");
		TNT1 A 0 A_FireCustomMissile("RedParticleSpawner");
		VORR B 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE);
		VORR C 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE);
		VORR D 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE);
		VORR E 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE);
		TNT1 A 3 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE);
		TNT1 A 0 {
			PB_QM_EndAttack();
			State barrel = PB_CheckBarrelIdle1();
			if (barrel)
				return barrel;
			return PB_ReturnFromQuickMelee();
		}
		Goto Ready3;

	RandomMelee_Backhand:
		TNT1 A 0 PB_QM_BeginAttack();
		TNT1 A 2;
		TNT1 A 0 A_PlaySound("weapons/fistwhoosh", 5);
		1PUN KLMN 1 A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
		TNT1 A 0 {
			A_BDPMelee(200, "QM_BackhandStrike", -7, true);
			PB_QM_ThrustVictim(36, 16);
		}
		1PUN OP 1;
		1PUN QRST 1 A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
		TNT1 A 2;
		TNT1 A 0 {
			PB_QM_EndAttack();
			State barrel = PB_CheckBarrelIdle1();
			if (barrel)
				return barrel;
			return PB_ReturnFromQuickMelee();
		}
		Goto Ready3;

	RandomMelee_Uppercut:
		TNT1 A 0 {
			PB_QM_BeginAttack();
			A_GiveInventory("HasCutingWeapon", 1);
		}
		TNT1 A 0 A_PlaySound("weapons/fistwhoosh", 5);
		0PUN U 1 A_BDPMeleeStart();
		0PUN V 1 {
			A_BDPMeleeStart();
			A_SetPitch(pitch - 1, SPF_INTERPOLATE);
		}
		0PUN W 1 {
			A_BDPMeleeStart();
			A_SetPitch(pitch - 1, SPF_INTERPOLATE);
		}
		TNT1 A 0 A_BDPMelee(200, "QM_UppercutStrike", 5, true);
		0PUN XX 1 {
			A_BDPMeleeStart();
			A_SetPitch(pitch - 1, SPF_INTERPOLATE);
		}
		0PUN YZ 1 A_BDPMeleeStart();
		TNT1 AAAA 1 A_SetPitch(pitch + 1, SPF_INTERPOLATE);
		TNT1 A 0 {
			PB_QM_EndAttack();
			State barrel = PB_CheckBarrelIdle1();
			if (barrel)
				return barrel;
			return PB_ReturnFromQuickMelee();
		}
		Goto Ready3;

	RandomMelee_Saw:
		TNT1 A 0 {
			PB_QM_BeginAttack();
			A_GiveInventory("HasCutingWeapon", 1);
			A_StartSound("sawswing");
		}
		1SAW F 1 {
			A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			A_BDPMeleeStart();
		}
		TNT1 A 0 A_BDPMelee(200, "QM_SawSwing", -7, true);
		1SAW G 1 {
			A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			A_BDPMeleeStart();
		}
		TNT1 A 0 A_FireCustomMissile("QM_SawSwing", -10, 0, 0, 0);
		1SAW HI 1 A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
		TNT1 A 0 A_FireCustomMissile("QM_SawSwing", 0, 0, 0, 0);
		1SAW JK 1 A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
		TNT1 A 0 A_FireCustomMissile("QM_SawSwing", 10, 0, 0, 0);
		1SAW LM 1 A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
		TNT1 A 0 A_FireCustomMissile("QM_SawSwing", 20, 0, 0, 0);
		1SAW N 1 A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
		TNT1 A 0 A_StartSound("weapons/chainsaw/stop");
		TNT1 AAAAAAAAAA 1 A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
		TNT1 A 0 {
			PB_QM_EndAttack();
			State barrel = PB_CheckBarrelIdle1();
			if (barrel)
				return barrel;
			return PB_ReturnFromQuickMelee();
		}
		Goto Ready3;
	}
}
