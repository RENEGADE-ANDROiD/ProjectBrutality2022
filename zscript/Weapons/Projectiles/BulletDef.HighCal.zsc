class PB_556x45mm : PB_Projectile
{
	Default
	{
		PB_Projectile.BaseDamage 22;
		PB_Projectile.RipperCount 3;
		PB_Projectile.PenetrationCount 3;
		+PB_Projectile.WHIZCRACK;
		Obituary "%o was filled with holes by %k.";
	}
}

class PB_556x45mmAP : PB_Projectile
{
	Default
	{
		PB_Projectile.BaseDamage 25;
		PB_Projectile.RipperCount 5;
		PB_Projectile.PenetrationCount 3;
		+PB_Projectile.WHIZCRACK;
		+PB_Projectile.SMALLIMPACT;
