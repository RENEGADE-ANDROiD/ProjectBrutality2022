// Instant weapon select (Doom CF_INSTANTWEAPSWITCH): always on.
// Snaps A_Lower; respect / SelectAnimation still play but can be interrupted when
// PendingWeapon is queued (Next/Prev) via OnDeselect + GetDownState (engine DropWeapon mirror).
// Legacy cvar pb_instantweaponswitch is ignored (kept in CVARINFO for old configs).

class PB_InstantWeaponSwitchHandler : StaticEventHandler
{
	override void WorldTick()
	{
		if (gamestate != GS_LEVEL)
			return;
		if (level.isFrozen())
			return;

		for (int i = 0; i < MAXPLAYERS; i++)
		{
			if (!playeringame[i])
				continue;

			let p = players[i];
			if (p == null || p.mo == null)
				continue;

			p.cheats = p.cheats | CF_INSTANTWEAPSWITCH;

			let pbw = PB_WeaponBase(p.ReadyWeapon);
			if (pbw)
				pbw.PB_TryInterruptVisualSelectForPending(p);
		}
	}
}
