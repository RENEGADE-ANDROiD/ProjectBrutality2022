		// Project Survival equipment-select raise (hand+item); weapon aside via FlashPunching on 799.
		EquipSelectShowFrag:
			TNT1 A 0 PB_EquipSelectShowStart();
			EQFR MLKJ 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			EQFR AAAAAA 1 PB_EquipSelectShowKeepOffset();
			EQFR JKLM 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		EquipSelectShowStun:
			TNT1 A 0 PB_EquipSelectShowStart();
			CLUS NOPQRS 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			CLUS SSSSSS 1 PB_EquipSelectShowKeepOffset();
			CLUS TUV 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		EquipSelectShowShield:
			TNT1 A 0 PB_EquipSelectShowStart();
			SHIG QRSTUV 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			SHIG VVVV 1 PB_EquipSelectShowKeepOffset();
			SHIG UTSRQ 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		EquipSelectShowVoid:
			TNT1 A 0 PB_EquipSelectShowStart();
			VGR1 JIHG 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			VGR1 GGGGGGGG 1 PB_EquipSelectShowKeepOffset();
			VGR1 HIJ 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		EquipSelectShowMine:
			TNT1 A 0 PB_EquipSelectShowStart();
			REMT QPON 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			REMT MMMMMM 1 PB_EquipSelectShowKeepOffset();
			REMT NOPQ 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		EquipSelectShowGeneric:
			TNT1 A 0 PB_EquipSelectShowStart();
			EQPR ABCD 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			EQPR DDDDDDDD 1 PB_EquipSelectShowKeepOffset();
			EQPR CBA 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		// Rock-on flourish on body armor / sphere / weapon pickups (SPRITES/Flourish/RockOn/RKON*).
		ArmorRockOnShow:
			TNT1 A 0 PB_EquipSelectShowStart();
			RKON ABCDEFG 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			RKON HIJKLM 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		// Ouch flourish on heavy damage (SPRITES/Flourish/Ouch/OUON*).
		OuchFlourishShow:
			TNT1 A 0 PB_EquipSelectShowStart();
			OUON ABCDEF 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			OUON GHIJK 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		// Do-thing flourish on successful Use (SPRITES/Flourish/DoThing/DOON*).
		DoThingFlourishShow:
			TNT1 A 0 PB_EquipSelectShowStart();
			DOON ABCDEF 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			DOON GHIJK 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		// HealthYeah flourish on backpack / healing health pickups (SPRITES/Flourish/HealthYeah/HYON*).
		HealthYeahFlourishShow:
			TNT1 A 0 PB_EquipSelectShowStart();
			HYON ABCDEF 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll - 0.8, SPF_INTERPOLATE);
			}
			HYON GHIJK 1 {
				PB_EquipSelectShowKeepOffset();
				A_SetRoll(roll + 0.8, SPF_INTERPOLATE);
			}
			TNT1 A 0 PB_EquipSelectShowFinish();
			Goto GoingToReady;

		// PDA open/close hand (SPRITES/WEAPONS/PDA/ADRO*). Raise A→E, hold E, lower E→A then restore weapon.
		PDARaiseShow:
			TNT1 A 0 PB_EquipSelectShowStart();
			ADRO ABCD 2 PB_EquipSelectShowKeepOffset();
			Goto PDAOpenLoop;
		PDAOpenLoop:
			ADRO E 2 PB_EquipSelectShowKeepOffset();
			Loop;
		PDALowerShow:
			ADRO EDCBA 2 PB_EquipSelectShowKeepOffset();
			TNT1 A 0 {
				PB_EquipSelectShowFinish();
				A_TakeInventory("PB_PDAHandActive", 1);
			}
			Goto GoingToReady;

	LeechBeam:
		SYNP WXYZWXYZWXYZ 1 BRIGHT;
		SYNP WXYZWXYZWXYZ 1 BRIGHT;
		SYNP WXYZWXYZWXYZ 1 BRIGHT;
		SYNP WXYZWXYZWXYZ 1 BRIGHT;
		Stop;

	ThrowLeech:
		TNT1 A 0 A_ZoomFactor(1.0);
		TNT1 A 0 A_TakeInventory("ADSMode", 1);
		TNT1 A 0 A_TakeInventory("UseEquipment", 1);
		TNT1 A 0 A_JumpIfInventory("PB_DTech", 4, 2);
		TNT1 A 0 A_Print("\coNot enough \ctdemon tech \c-");
		Goto GoingToReady;
		TNT1 A 0 A_PlaySound("SiphonGrowl");
		SYNP GHIJGHIHIJGJIHG 2;
		SYNP G 1 Offset(-2,40);
		SYNP H 1 Offset(-4,50);
		SYNP I 1 Offset(-6,60);
		SYNP J 1 Offset(-8,70);
		TNT1 A 0 Offset(0,32);
		SYNP KLMNO 1;

		TNT1 A 0 A_Overlay(-5, "LeechBeam");
		TNT1 A 0 A_PlaySound("SiphonActive", 3, 1.0, true);

	LeechHold:
		SYNP ABCDEF 2 {
			A_FireBullets(0, 0, -1, 3, "SiphonPuff", FBF_NORANDOM);
			A_TakeInventory("PB_DTech", 4);
		}
		TNT1 A 0 A_JumpIfInventory("PB_DTech", 4, "LeechCheckHold");
		Goto LeechRelease;

	LeechCheckHold:
		TNT1 A 0 A_JumpIf(PressingUser1(), "LeechHold");
		Goto LeechRelease;

	LeechRelease:
		TNT1 A 0 A_StopSound(3);
		TNT1 A 0 A_PlaySound("SiphonGrowl", 3);
		SYNP ONMLK 1;
		TNT1 A 0 A_WeaponOffset(0,32);
		TNT1 A 0 A_TakeInventory("UseEquipment", 1);
		TNT1 A 0 A_TakeInventory("ToggleEquipment", 1);
		Goto GoingToReady2;
		
			
	ThrowStun:
		TNT1 A 0 A_ZoomFactor(1.0);
		TNT1 A 0 A_TakeInventory("ADSMode", 1);
		TNT1 A 0 A_TakeInventory("UseEquipment", 1);
		TNT1 A 0 A_JumpIfInventory("StunGrenadeAmmo", 1, 2);
		TNT1 A 0 A_Print("\cgNo \ctstun grenades \c-left");
		Goto GoingToReady;
		STND BCDEF 1;
		STND F 1 Offset(-2,34);
		TNT1 A 0 A_PlaySound("StunGrenadeArm", 2);
		STND GHGHGHGHGHGH 1;
		
		HND1 I 1 A_PlaySound("THRGRN", 1);
		TNT1 A 0 A_TakeInventory("StunGrenadeAmmo", 1);
		HND1 J 1 A_FireCustomMissile("ThrownStunGrenade",0,0,0,0,0,0);
		HND1 KLMNOPQ 1;
		TNT1 A 0 A_TakeInventory("UseEquipment", 1);
		TNT1 A 0 A_TakeInventory("ToggleEquipment", 1);
		Goto GoingToReady2;
		
