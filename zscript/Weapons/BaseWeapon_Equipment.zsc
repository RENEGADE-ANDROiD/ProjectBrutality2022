		TNT1 A 0 A_TakeInventory("PB_SentryAmmo_QSSG", 1);
		TNT1 A 0 A_SpawnItemEx("PB_SentryGun_QSSG", 56, 0, 8, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION);
		TNT1 A 0 A_TakeInventory("UseEquipment", 1);
		TNT1 A 0 A_TakeInventory("ToggleEquipment", 1);
		Goto GoingToReady2;

