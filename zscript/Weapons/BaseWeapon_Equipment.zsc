extend class PB_WeaponBase
{
	// Project Survival–style equipment wheel select: tip weapon via FlashPunching on 799, hand+item on PSP_WEAPON.
	// Select strips are shorter below hotspot than HNDF throw hands; Y 42 clips the arm base without burying the item (ready is 32).
	action void PB_EquipSelectShowKeepOffset()
	{
		A_WeaponOffset(0, 42);
	}

	action void PB_EquipSelectShowStart()
	{
		A_GiveInventory("PB_LockScreenTilt", 1);
		A_ZoomFactor(1.0);
		PB_EquipSelectShowKeepOffset();
		// Dual-wield guns live on overlays 10/11 (and some on 60-65). Tip-aside must
		// clear those first; spawning FlashPunching on 799 while they are up makes
		// always-dual weapons (e.g. Portal Blasters) clear the guns into a melee strip.
		bool hadDual = false;
		if (player)
		{
			if (player.FindPSprite(10) || player.FindPSprite(11))
				hadDual = true;
		}
		A_ClearOverlays(10, 11);
		A_ClearOverlays(60, 65);
		if (!hadDual && FindState("FlashPunching"))
			A_Overlay(799, "FlashPunching");
	}

	action void PB_EquipSelectShowFinish()
	{
		A_ClearOverlays(799, 799);
		A_SetRoll(0);
		A_TakeInventory("PB_LockScreenTilt", 1);
		A_TakeInventory("CantFire", 1);
		PB_SetUsingMelee(false);
		PB_SetUsingKick(false);
		A_WeaponOffset(0, 32);
		PB_RestoreWeaponMiniOverlays();
	}

	action state PB_EquipSelectAndCancel(statelabel show)
	{
		A_Overlay(PSP_WEAPON, show);
		return ResolveState("WheelCancelEquipment");
	}

	States
	{
		//NEW EQUIPMENT SYSTEM
		UseEquipment:
			TNT1 A 0 {
				A_ClearOverlays(3,65);
				A_GunFlash("Null"); //Fixes the Minigun heat overlay oversight
