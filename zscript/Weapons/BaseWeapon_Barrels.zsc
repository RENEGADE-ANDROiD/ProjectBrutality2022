// PB Staging barrel carry / throw / place (folded for PB 2022 Nukage barrel tokens).
// Uses HasBarrel / HasBurningBarrel / HasIceBarrel + Grabbed* + Grab1..10 / FGrab / IGrab.

extend class PB_WeaponBase
{
	string pbBarrelPlaceClass;

	// Staging: A_WeaponReady routes Fire / AltFire / weapon-lower through these
	// while Grabbed* is held (see PB_Staging BaseWeapon_Functions.zsc).
	override state GetAtkState(bool hold)
	{
		if (owner && owner.FindInventory("GrabbedBarrel"))
			return ResolveState("ThrowBarrel");
		if (owner && owner.FindInventory("GrabbedBurningBarrel"))
			return ResolveState("ThrowFlameBarrel");
		if (owner && owner.FindInventory("GrabbedIceBarrel"))
			return ResolveState("ThrowIceBarrel");
		return Super.GetAtkState(hold);
	}

	override state GetAltAtkState(bool hold)
	{
		if (owner && owner.FindInventory("GrabbedBarrel"))
			return ResolveState("PlaceBarrel");
		if (owner && owner.FindInventory("GrabbedBurningBarrel"))
			return ResolveState("PlaceFlameBarrel");
		if (owner && owner.FindInventory("GrabbedIceBarrel"))
			return ResolveState("PlaceIceBarrel");
		return Super.GetAltAtkState(hold);
	}

	override state GetDownState()
	{
		if (owner && owner.FindInventory("GrabbedBarrel"))
			return ResolveState("PlaceBarrel");
		if (owner && owner.FindInventory("GrabbedBurningBarrel"))
			return ResolveState("PlaceFlameBarrel");
		if (owner && owner.FindInventory("GrabbedIceBarrel"))
			return ResolveState("PlaceIceBarrel");
		return Super.GetDownState();
	}

	action void PB_BarrelReady1()
	{
		A_ClearOverlays(-10, 65);
		A_Overlay(-10, "FirstPersonLegsStand");
		A_StopSound(1);
		A_StopSound(CHAN_VOICE);
		A_StopSound(5);
		A_StopSound(6);
		A_TakeInventory("Zoomed", 1);
		A_ZoomFactor(1.0);
		A_SetCrosshair(-1);
		PB_SetReloading(false);
	}

	action void PB_BarrelPickupNukage()
	{
		A_TakeInventory("HasBarrel", 1);
		A_GiveInventory("GrabbedBarrel", 1);
	}

	action void PB_BarrelPickupBurning()
	{
		A_TakeInventory("HasBurningBarrel", 1);
		A_GiveInventory("GrabbedBurningBarrel", 1);
	}

	action void PB_BarrelPickupIce()
	{
		A_TakeInventory("HasIceBarrel", 1);
		A_GiveInventory("GrabbedIceBarrel", 1);
	}

	// Grab indices match TheNukageBarrel.dec Grab* / FGrab* / IGrab* grants
	// (Grab2 = holes, Grab3 = cut — same as Staging place map).
	action void PB_BarrelResolvePlaceClass(string grabPrefix)
	{
		invoker.pbBarrelPlaceClass = "";
		if (grabPrefix == "F")
		{
			if (CountInv("FGrab1") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrel";
			else if (CountInv("FGrab2") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelHoles";
			else if (CountInv("FGrab3") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelCut";
			else if (CountInv("FGrab4") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelDented";
			else if (CountInv("FGrab5") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrel_RedBlood";
			else if (CountInv("FGrab6") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelHoles_RedBlood";
			else if (CountInv("FGrab7") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelCut_RedBlood";
			else if (CountInv("FGrab8") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelDented_RedBlood";
			else if (CountInv("FGrab9") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelDented_RedBlood";
			else if (CountInv("FGrab10") >= 1) invoker.pbBarrelPlaceClass = "FlameBarrelDented_RedBlood";
		}
		else if (grabPrefix == "I")
		{
			if (CountInv("IGrab1") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozen";
			else if (CountInv("IGrab2") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenHoles";
			else if (CountInv("IGrab3") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenCut";
			else if (CountInv("IGrab4") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenDented";
			else if (CountInv("IGrab5") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozen_RedBlood";
			else if (CountInv("IGrab6") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenHoles_RedBlood";
			else if (CountInv("IGrab7") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenCut_RedBlood";
			else if (CountInv("IGrab8") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenDented_RedBlood";
			else if (CountInv("IGrab9") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenDented_RedBlood";
			else if (CountInv("IGrab10") >= 1) invoker.pbBarrelPlaceClass = "BarrelFrozenDented_RedBlood";
		}
		else
		{
			if (CountInv("Grab1") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrel";
			else if (CountInv("Grab2") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelHoles";
			else if (CountInv("Grab3") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelCut";
			else if (CountInv("Grab4") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelDented";
			else if (CountInv("Grab5") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrel_RedBlood";
			else if (CountInv("Grab6") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelHoles_RedBlood";
			else if (CountInv("Grab7") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelCut_RedBlood";
			else if (CountInv("Grab8") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelDented_RedBlood";
			else if (CountInv("Grab9") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelDented_RedBlood";
			else if (CountInv("Grab10") >= 1) invoker.pbBarrelPlaceClass = "NukageBarrelDented_RedBlood";
		}
	}

	action void PB_BarrelClearGrabTokens(string grabPrefix)
	{
		int i;
		for (i = 10; i > 0; i--)
		{
			if (grabPrefix == "F")
				A_TakeInventory(String.Format("FGrab%d", i), 1);
			else if (grabPrefix == "I")
				A_TakeInventory(String.Format("IGrab%d", i), 1);
			else
				A_TakeInventory(String.Format("Grab%d", i), 1);
		}
	}

	action void PB_BarrelPlaceSpawn(string grabPrefix, string grabbedToken)
	{
		PB_BarrelResolvePlaceClass(grabPrefix);
		if (invoker.pbBarrelPlaceClass == "")
		{
			if (grabPrefix == "F")
				invoker.pbBarrelPlaceClass = "FlameBarrel";
			else if (grabPrefix == "I")
				invoker.pbBarrelPlaceClass = "BarrelFrozen";
			else
				invoker.pbBarrelPlaceClass = "NukageBarrel";
		}
		A_SpawnItemEx(invoker.pbBarrelPlaceClass, 17, 0, 0, 12, 0, 0, 0, SXF_NOCHECKPOSITION, 0);
		A_StartSound("barrel/pain", CHAN_AUTO);
		PB_BarrelClearGrabTokens(grabPrefix);
		A_TakeInventory(grabbedToken, 1);
	}

	action void PB_BarrelThrowMissile(string grabPrefix, string grabbedToken, string missileClass)
	{
		A_FireCustomMissile(missileClass, 0, 1, 0, 0, FPF_NOAUTOAIM);
		PB_BarrelClearGrabTokens(grabPrefix);
		A_TakeInventory(grabbedToken, 1);
	}

	action state PB_CheckBarrelThrow1()
	{
		if (CountInv("GrabbedBarrel") >= 1)
			return ResolveState("ThrowBarrel");
		if (CountInv("GrabbedBurningBarrel") >= 1)
			return ResolveState("ThrowFlameBarrel");
		if (CountInv("GrabbedIceBarrel") >= 1)
			return ResolveState("ThrowIceBarrel");
		return ResolveState(null);
	}

	action state PB_CheckBarrelPlace1()
	{
		if (CountInv("GrabbedBarrel") >= 1)
			return ResolveState("PlaceBarrel");
		if (CountInv("GrabbedBurningBarrel") >= 1)
			return ResolveState("PlaceFlameBarrel");
		if (CountInv("GrabbedIceBarrel") >= 1)
			return ResolveState("PlaceIceBarrel");
		return ResolveState(null);
	}

	action state PB_CheckBarrelIdle1()
	{
		if (CountInv("GrabbedBarrel") >= 1)
			return ResolveState("IdleBarrel");
		if (CountInv("GrabbedBurningBarrel") >= 1)
			return ResolveState("IdleFlameBarrel");
		if (CountInv("GrabbedIceBarrel") >= 1)
			return ResolveState("IdleIceBarrel");
		return ResolveState(null);
	}

	// Idle hold: Fire/Alt/Pending without CheckAmmo gate (Staging uses GetAtk*;
	// 2022 hardens with explicit routing). Unload suppressed like PB_NOUNLOAD.
	action state PB_BarrelIdleTick()
	{
		A_TakeInventory("Unloading", CountInv("Unloading"));
		if (player && player.PendingWeapon != WP_NOCHANGE)
		{
			State stPlace = PB_CheckBarrelPlace1();
			if (stPlace) return stPlace;
		}
		if ((JustPressed(BT_ATTACK) || PressingFire()) && !A_IsFiringLeftWeapon())
		{
			State stThrow = PB_CheckBarrelThrow1();
			if (stThrow) return stThrow;
		}
		if ((JustPressed(BT_ALTATTACK) || PressingAltfire()) && !A_IsFiringRightWeapon())
		{
			State stAlt = PB_CheckBarrelPlace1();
			if (stAlt) return stAlt;
		}
		A_WeaponReady(WRF_NOFIRE | WRF_NOSECONDARY);
		return ResolveState(null);
	}

	// Kick PSP_WEAPON: Staging FlashBarrel* if holding; else visual-only FlashKicking*.
	// kind: 0 kick, 1 air, 2 slide, 3 slide-stop.
	action void PB_KickOverlayWeaponFlash(int kind)
	{
		if (!invoker.kickReturnState)
			invoker.PB_SaveMeleeReturnState(true);
		bool holding = CountInv("GrabbedBarrel") >= 1
			|| CountInv("GrabbedBurningBarrel") >= 1
			|| CountInv("GrabbedIceBarrel") >= 1;
		if (holding)
		{
			if (kind == 1)
				A_Overlay(PSP_WEAPON, "FlashBarrelAirKicking");
			else if (kind == 2)
				A_Overlay(PSP_WEAPON, "FlashBarrelSlideKicking");
			else if (kind == 3)
				A_Overlay(PSP_WEAPON, "FlashBarrelSlideKickingStop");
			else
				A_Overlay(PSP_WEAPON, "FlashBarrelKicking");
		}
		else
		{
			if (kind == 1)
				A_Overlay(PSP_WEAPON, "FlashAirKicking");
			else if (kind == 2)
				A_Overlay(PSP_WEAPON, "FlashSlideKicking");
			else if (kind == 3)
				A_Overlay(PSP_WEAPON, "FlashSlideKickingStop");
			else
				A_Overlay(PSP_WEAPON, "FlashKicking");
		}
		A_OverlayOffset(PSP_WEAPON, 0, 32);
	}

	action void PB_KickRestoreWeaponLayer()
	{
		A_WeaponOffset(0, 32);
		A_SetRoll(0);
		// Never yank PSP_WEAPON out from under an active Quick Melee.
		if (PB_usingMelee())
		{
			if (invoker)
				invoker.PB_ConsumeMeleeReturnState(true);
			return;
		}
		State restore = invoker.PB_ConsumeMeleeReturnState(true);
		if (CountInv("GrabbedBarrel") >= 1)
			A_Overlay(PSP_WEAPON, "IdleBarrel");
		else if (CountInv("GrabbedBurningBarrel") >= 1)
			A_Overlay(PSP_WEAPON, "IdleFlameBarrel");
		else if (CountInv("GrabbedIceBarrel") >= 1)
			A_Overlay(PSP_WEAPON, "IdleIceBarrel");
		else
		{
			if (player && restore)
				player.SetPSprite(PSP_WEAPON, restore);
			else
				A_Overlay(PSP_WEAPON, "Ready3");
		}
		A_OverlayOffset(PSP_WEAPON, 0, 32);
	}

	States
	{
		ReadyBarrel:
			TNT1 A 0 PB_BarrelReady1();
			BANE ABCDEFG 1;
			TNT1 A 0 PB_BarrelPickupNukage();
			Goto IdleBarrel;

		ReadyFlameBarrel:
			TNT1 A 0 PB_BarrelReady1();
			BAFE ABCDEFG 1;
			TNT1 A 0 PB_BarrelPickupBurning();
			Goto IdleFlameBarrel;

		ReadyIceBarrel:
			TNT1 A 0 PB_BarrelReady1();
			BAIE ABCDEFG 1;
			TNT1 A 0 PB_BarrelPickupIce();
			Goto IdleIceBarrel;

		IdleBarrel:
			TNT1 A 0
			{
				A_SetInventory("CantWeaponSpecial", 1);
				A_TakeInventory("GoWeaponSpecialAbility", 1);
				A_TakeInventory("Unloading", 1);
				A_TakeInventory("Zoomed", 1);
				A_TakeInventory("ADSmode", 1);
				A_ZoomFactor(1.0);
				A_ClearOverlays(10, 11);
			}
			THRG LKJIHHIJKL 2 { return PB_BarrelIdleTick(); }
			Loop;

		IdleFlameBarrel:
			TNT1 A 0
			{
				A_SetInventory("CantWeaponSpecial", 1);
				A_TakeInventory("GoWeaponSpecialAbility", 1);
				A_TakeInventory("Unloading", 1);
				A_TakeInventory("Zoomed", 1);
				A_TakeInventory("ADSmode", 1);
				A_ZoomFactor(1.0);
				A_ClearOverlays(10, 11);
			}
			THRG DEFGFED 2 { return PB_BarrelIdleTick(); }
			Loop;

		IdleIceBarrel:
			TNT1 A 0
			{
				A_SetInventory("CantWeaponSpecial", 1);
				A_TakeInventory("GoWeaponSpecialAbility", 1);
				A_TakeInventory("Unloading", 1);
				A_TakeInventory("Zoomed", 1);
				A_TakeInventory("ADSmode", 1);
				A_ZoomFactor(1.0);
				A_ClearOverlays(10, 11);
			}
			THRG M 1 { return PB_BarrelIdleTick(); }
			Loop;

		ThrowBarrel:
			BANE HIJKLMN 1;
			TNT1 A 0 A_StartSound("weapons/fistwhoosh", CHAN_AUTO);
			BANE ONLJH 1;
			TNT1 A 0 PB_BarrelThrowMissile("", "GrabbedBarrel", "ThrowedBarrel");
			THRF ABCDEF 2;
			TNT1 A 0 A_SetInventory("CantWeaponSpecial", 0);
			Goto GoingToReady2;

		ThrowFlameBarrel:
			BAFE HIJKLMN 1;
			TNT1 A 0 A_StartSound("weapons/fistwhoosh", CHAN_AUTO);
			BAFE ONLJH 1;
			TNT1 A 0 PB_BarrelThrowMissile("F", "GrabbedBurningBarrel", "ThrowedBurningBarrel");
			THRF ABCDEF 2;
			TNT1 A 0 A_SetInventory("CantWeaponSpecial", 0);
			Goto GoingToReady2;

		ThrowIceBarrel:
			BAIE HIJKLMN 1;
			TNT1 A 0 A_StartSound("weapons/fistwhoosh", CHAN_AUTO);
			BAIE ONLJH 1;
			TNT1 A 0 PB_BarrelThrowMissile("I", "GrabbedIceBarrel", "ThrowedIceBarrel");
			THRF ABCDEF 2;
			TNT1 A 0 A_SetInventory("CantWeaponSpecial", 0);
			Goto GoingToReady2;

		PlaceBarrel:
			BANE GFEDCBA 1;
			TNT1 A 0 PB_BarrelPlaceSpawn("", "GrabbedBarrel");
			Goto CompletePlacement;

		PlaceFlameBarrel:
			BAFE GFEDCBA 1;
			TNT1 A 0 PB_BarrelPlaceSpawn("F", "GrabbedBurningBarrel");
			Goto CompletePlacement;

		PlaceIceBarrel:
			BAIE GFEDCBA 1;
			TNT1 A 0 PB_BarrelPlaceSpawn("I", "GrabbedIceBarrel");
			Goto CompletePlacement;

		CompletePlacement:
			PKPB HGFEDCBA 1;
			TNT1 A 2;
			TNT1 A 0 A_SetInventory("CantWeaponSpecial", 0);
			TNT1 A 0 A_JumpIf(player.PendingWeapon != WP_NOCHANGE, 1);
			Goto GoingToReady2;
			TNT1 A 0 A_Lower();
			Wait;

		FlashBarrelKicking:
			BAIE A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, 3);
			BAFE A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, 2);
			BANE A 0;
			"####" IJKLMNOONMLKJI 1;
			TNT1 A 0
			{
				if (CountInv("GrabbedBarrel")) return ResolveState("IdleBarrel");
				if (CountInv("GrabbedIceBarrel")) return ResolveState("IdleIceBarrel");
				if (CountInv("GrabbedBurningBarrel")) return ResolveState("IdleFlameBarrel");
				return ResolveState(null);
			}
			Stop;

		FlashBarrelPunching:
			BAIQ A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, 3);
			BAFQ A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, 2);
			BANQ A 0;
			"####" IJKL 1;
			"####" M 6;
			"####" LKJI 1;
			TNT1 A 0
			{
				if (CountInv("GrabbedBarrel")) return ResolveState("IdleBarrel");
				if (CountInv("GrabbedIceBarrel")) return ResolveState("IdleIceBarrel");
				if (CountInv("GrabbedBurningBarrel")) return ResolveState("IdleFlameBarrel");
				return ResolveState(null);
			}
			Stop;

		FlashBarrelAirKicking:
			BAIE A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, 3);
			BAFE A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, 2);
			BANE A 0;
			"####" IJKLMNOOOOONMLKJI 1;
			TNT1 A 0
			{
				if (CountInv("GrabbedBarrel")) return ResolveState("IdleBarrel");
				if (CountInv("GrabbedIceBarrel")) return ResolveState("IdleIceBarrel");
				if (CountInv("GrabbedBurningBarrel")) return ResolveState("IdleFlameBarrel");
				return ResolveState(null);
			}
			Stop;

		FlashBarrelSlideKicking:
			BAIE A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, 3);
			BAFE A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, 2);
			BANE A 0;
			"####" IJKLMNOOOOOOOOOOOOOOOOOOOO 1;
			TNT1 A 0
			{
				if (CountInv("GrabbedBarrel")) return ResolveState("IdleBarrel");
				if (CountInv("GrabbedIceBarrel")) return ResolveState("IdleIceBarrel");
				if (CountInv("GrabbedBurningBarrel")) return ResolveState("IdleFlameBarrel");
				return ResolveState(null);
			}
			Stop;

		FlashBarrelSlideKickingStop:
			BAIE A 0 A_JumpIfInventory("GrabbedIceBarrel", 1, 3);
			BAFE A 0 A_JumpIfInventory("GrabbedBurningBarrel", 1, 2);
			BANE A 0;
			"####" ONMLKJI 1;
			TNT1 A 0
			{
				if (CountInv("GrabbedBarrel")) return ResolveState("IdleBarrel");
				if (CountInv("GrabbedIceBarrel")) return ResolveState("IdleIceBarrel");
				if (CountInv("GrabbedBurningBarrel")) return ResolveState("IdleFlameBarrel");
				return ResolveState(null);
			}
			Stop;
	}
}
